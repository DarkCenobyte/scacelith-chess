options.handover.cut = Natychmiastowa
options.handover.flight = Przelot, {0} s
options.handover.help = Dwóch graczy przy jednym komputerze: jak po każdym ruchu widok przechodzi z oczu jednego gracza do oczu drugiego. Natychmiastowa zmiana pomija ruch kamery.
options.game_cursor = Kursor gry
options.game_cursor.help = Przy stole gra rysuje własny kursor, który pokazuje, co zrobi kliknięcie. Wyłączone: zwykła strzałka systemowa.

