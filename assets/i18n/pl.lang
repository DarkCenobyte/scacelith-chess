options.voice_volume.help = Głośność głosu trenera w trybie „Trener”.
options.subtitles = Napisy
options.subtitles.auto = Automatycznie
options.subtitles.help = Słowa trenera wyświetlane u dołu ekranu. Automatycznie: widoczne, gdy trener nie mówi w języku menu (przy chińskim menu mówi po angielsku). Zawsze widoczne, gdy jego głos nie jest zainstalowany.

options.legal_moves = Pokazuj dozwolone ruchy
options.legal_moves.help = Podświetla pola, na które może przejść dotknięta bierka. Gdy ta opcja jest wyłączona, nic nie podpowiada, czy ruch jest dozwolony: za nieprawidłowy ruch sędzia ukarze cię, gdy tylko naciśniesz zegar.
options.coordinates = Współrzędne szachownicy
options.auto_press = Automatyczne naciskanie zegara
options.auto_press.help = Twój robot sam naciska zegar, gdy tylko twój ruch jest na szachownicy. W partiach online decyduje serwer, a w grze bezpośredniej – gospodarz gry.
options.thinking_time = Realistyczny czas namysłu
options.thinking_time.help = Przeciwnik zastanawia się nad ruchem jak żywy gracz, zamiast grać natychmiast.
options.ignore_head = Ignoruj ruchy głowy przeciwnika
options.ignore_head.help = W partiach online i w grze bezpośredniej robot przeciwnika patrzy tam, gdzie patrzy jego gracz. Gdy ta opcja jest włączona, robot sam porusza głową, jak w grze ze Stockfishem.
options.mouse_sensitivity = Czułość myszy
options.invert_look = Odwróć oś pionową
