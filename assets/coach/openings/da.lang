# ---- Families
opening.family.kings_pawn = Kongebondeåbning
opening.family.kings_pawn.def = en kongebondeåbning
opening.family.kings_pawn.beginner = Når kongebonden går to felter frem, tager den centrum og giver dronningen og en løber fri bane på én gang: det mest populære første træk.
opening.family.kings_pawn.beginner.spoken = Når kongebonden går to felter frem, tager den centrum og giver dronningen og en løber fri bane på én gang: det mest populære første træk.
opening.family.kings_pawn.advanced = e4 fører til åbne, taktiske partier efter e5 og til skarpe, ubalancerede kampe mod siciliansk, fransk eller Caro-Kann.
opening.family.kings_pawn.advanced.spoken = é fire fører til åbne, taktiske partier efter é fem og til skarpe, ubalancerede kampe mod siciliansk, fransk eller Caro-Kann.
opening.family.queens_pawn = Dronningebondeåbning
opening.family.queens_pawn.def = en dronningebondeåbning
opening.family.queens_pawn.beginner = Dronningebonden tager centrum på d4, hvor dronningen allerede dækker den: partierne er som regel langsommere og mere strategiske end efter e4.
opening.family.queens_pawn.beginner.spoken = Dronningebonden tager centrum på dé fire, hvor dronningen allerede dækker den: partierne er som regel langsommere og mere strategiske end efter é fire.
opening.family.queens_pawn.advanced = Dronningebondeåbninger fører til lukkede stillinger, hvor brikkernes placering, bondestrukturen og bruddene c4 og e4 betyder mere end tidlig taktik.
opening.family.queens_pawn.advanced.spoken = Dronningebondeåbninger fører til lukkede stillinger, hvor brikkernes placering, bondestrukturen og bruddene se fire og é fire betyder mere end tidlig taktik.
opening.family.kings_knight = Kongespringeråbning
opening.family.kings_knight.def = en kongespringeråbning
opening.family.kings_knight.beginner = Springeren kommer ud og angriber bonden på e5: det mest naturlige udviklingstræk, og som regel dækker sort med den anden springer.
opening.family.kings_knight.beginner.spoken = Springeren kommer ud og angriber bonden på é fem: det mest naturlige udviklingstræk, og som regel dækker sort med den anden springer.
opening.family.kings_knight.advanced = Springeren på f3 holder alle de klassiske veje åbne, spansk, italiensk, skotsk eller firspringerspil, og tvinger sort til at bestemme sig for hvordan e5 skal dækkes.
opening.family.kings_knight.advanced.spoken = Springeren på æf tre holder alle de klassiske veje åbne, spansk, italiensk, skotsk eller firspringerspil, og tvinger sort til at bestemme sig for hvordan é fem skal dækkes.
opening.family.sicilian = Siciliansk forsvar
opening.family.sicilian.def = siciliansk forsvar
opening.family.sicilian.beginner = Sort svarer med c-bonden i stedet for e-bonden og skaber ubalance: regn med en skarp kamp, hvor hver side angriber på sin egen fløj.
opening.family.sicilian.beginner.spoken = Sort svarer med se-bonden i stedet for é-bonden og skaber ubalance: regn med en skarp kamp, hvor hver side angriber på sin egen fløj.
opening.family.sicilian.advanced = Efter d4 og bondeafbytningen får sort den halvåbne c-linje og flere centrumbønder, mens hvid får hurtigere udvikling og angrebschancer på kongefløjen.
opening.family.sicilian.advanced.spoken = Efter dé fire og bondeafbytningen får sort den halvåbne se-linje og flere centrumbønder, mens hvid får hurtigere udvikling og angrebschancer på kongefløjen.
opening.family.french = Fransk forsvar
opening.family.french.def = fransk forsvar
opening.family.french.beginner = Sort forbereder d5 med e6: et solidt forsvar, men den hvidfeltede løber bliver ofte spærret inde bag sine egne bønder.
opening.family.french.beginner.spoken = Sort forbereder dé fem med é seks: et solidt forsvar, men den hvidfeltede løber bliver ofte spærret inde bag sine egne bønder.
opening.family.french.advanced = Når hvid går videre til e5, opstår der en låst bondekæde: hvid angriber på kongefløjen, og sort undergraver kæden med c5 og f6.
opening.family.french.advanced.spoken = Når hvid går videre til é fem, opstår der en låst bondekæde: hvid angriber på kongefløjen, og sort undergraver kæden med se fem og æf seks.
opening.family.caro_kann = Caro-Kann
opening.family.caro_kann.spoken = Caro-Kann
opening.family.caro_kann.def = Caro-Kann
opening.family.caro_kann.def.spoken = Caro-Kann
opening.family.caro_kann.beginner = Sort forbereder d5 med c6 og holder den hvidfeltede løber fri: et meget solidt forsvar med få svagheder.
opening.family.caro_kann.beginner.spoken = Sort forbereder dé fem med se seks og holder den hvidfeltede løber fri: et meget solidt forsvar med få svagheder.
opening.family.caro_kann.advanced = Sort får en sund bondestruktur og en aktiv hvidfeltet løber; hvid tager plads eller et lille udviklingsforspring, og sort sigter mod c5 eller et godt slutspil.
opening.family.caro_kann.advanced.spoken = Sort får en sund bondestruktur og en aktiv hvidfeltet løber; hvid tager plads eller et lille udviklingsforspring, og sort sigter mod se fem eller et godt slutspil.
opening.family.scandinavian = Skandinavisk forsvar
opening.family.scandinavian.def = skandinavisk forsvar
opening.family.scandinavian.beginner = Sort angriber straks bonden på e4 med d5; når dronningen slår tilbage, vinder hvid tid ved at jage den, så den skal have et sikkert felt.
opening.family.scandinavian.beginner.spoken = Sort angriber straks bonden på é fire med dé fem; når dronningen slår tilbage, vinder hvid tid ved at jage den, så den skal have et sikkert felt.
opening.family.scandinavian.advanced = En struktur som i Caro-Kann, men med den hvidfeltede løber uden for bondekæden: hvid beholder lidt mere plads, og sort får en solid, enkel opstilling.
opening.family.scandinavian.advanced.spoken = En struktur som i Caro-Kann, men med den hvidfeltede løber uden for bondekæden: hvid beholder lidt mere plads, og sort får en solid, enkel opstilling.
opening.family.italian = Italiensk parti
opening.family.italian.def = italiensk parti
opening.family.italian.beginner = Hvid sætter løberen på c4 og sigter mod det svage felt f7: en klassisk åbning, hvor begge sider udvikler sig hurtigt og rokerer.
opening.family.italian.beginner.spoken = Hvid sætter løberen på se fire og sigter mod det svage felt æf syv: en klassisk åbning, hvor begge sider udvikler sig hurtigt og rokerer.
opening.family.italian.advanced = Moderne italienske partier er langsomme manøvrekampe med c3 og d3 som forberedelse til et senere d4; Evans-gambit og springerudfaldet til g5 er de skarpe forsøg.
opening.family.italian.advanced.spoken = Moderne italienske partier er langsomme manøvrekampe med se tre og dé tre som forberedelse til et senere dé fire; Evans-gambit og springerudfaldet til ge fem er de skarpe forsøg.
opening.family.ruy_lopez = Spansk parti
opening.family.ruy_lopez.def = spansk parti
opening.family.ruy_lopez.beginner = Hvids løber angriber springeren der dækker e5: en af de ældste og dybeste åbninger, rig på langsomt, strategisk spil.
opening.family.ruy_lopez.beginner.spoken = Hvids løber angriber springeren der dækker é fem: en af de ældste og dybeste åbninger, rig på langsomt, strategisk spil.
opening.family.ruy_lopez.advanced = Hvid opbygger et varigt pres mod e5 og centrum med c3 og d4, mens sort vinder plads på dronningefløjen med a6 og b5; Marshall-angrebet er den skarpe undtagelse.
opening.family.ruy_lopez.advanced.spoken = Hvid opbygger et varigt pres mod é fem og centrum med se tre og dé fire, mens sort vinder plads på dronningefløjen med a seks og be fem; Marshall-angrebet er den skarpe undtagelse.
opening.family.scotch = Skotsk parti
opening.family.scotch.def = skotsk parti
opening.family.scotch.beginner = Hvid åbner centrum med det samme med d4: brikkerne kommer hurtigt ud, og stillingen åbner sig tidligt.
opening.family.scotch.beginner.spoken = Hvid åbner centrum med det samme med dé fire: brikkerne kommer hurtigt ud, og stillingen åbner sig tidligt.
opening.family.scotch.advanced = Spændingen i centrum forsvinder med det samme; kampen handler om sorts aktive udvikling og bondestrukturerne efter en afbytning på c6.
opening.family.scotch.advanced.spoken = Spændingen i centrum forsvinder med det samme; kampen handler om sorts aktive udvikling og bondestrukturerne efter en afbytning på se seks.
opening.family.philidor = Philidors forsvar
opening.family.philidor.def = Philidors forsvar
opening.family.philidor.beginner = Sort dækker e5 med d-bonden: solidt, men lidt passivt, fordi den sortfeltede løber bliver spærret inde.
opening.family.philidor.beginner.spoken = Sort dækker é fem med dé-bonden: solidt, men lidt passivt, fordi den sortfeltede løber bliver spærret inde.
opening.family.philidor.advanced = Sort opgiver plads for at holde e5 sikkert; hvid har et behageligt pres i centrum, og taktiske tricks mod f7 er almindelige på klubniveau.
opening.family.philidor.advanced.spoken = Sort opgiver plads for at holde é fem sikkert; hvid har et behageligt pres i centrum, og taktiske tricks mod æf syv er almindelige på klubniveau.
opening.family.petrov = Petrovs forsvar
opening.family.petrov.def = Petrovs forsvar
opening.family.petrov.beginner = Sort dækker ikke e5, men går til modangreb på e4 med springeren: et solidt, symmetrisk forsvar; bare lad være med at efterligne hvids træk for længe.
opening.family.petrov.beginner.spoken = Sort dækker ikke é fem, men går til modangreb på é fire med springeren: et solidt, symmetrisk forsvar; bare lad være med at efterligne hvids træk for længe.
opening.family.petrov.advanced = Petrovs forsvar fører til symmetriske, ofte remisagtige strukturer: hvid beholder et lille initiativ, og sort udvikler sig hurtigt og går efter udlignende afbytninger.
opening.family.four_knights = Firspringerspil
opening.family.four_knights.def = firspringerspil
opening.family.four_knights.beginner = Begge sider udvikler først deres springere: en sund, rolig åbning som følger reglerne for udvikling.
opening.family.four_knights.advanced = En symmetrisk, afbalanceret åbning: hvid vælger en behandling som i spansk, skotsk eller italiensk, og sort bør kende Rubinsteins modgambit.
opening.family.english = Engelsk åbning
opening.family.english.def = engelsk åbning
opening.family.english.beginner = Hvid begynder med c-bonden og kontrollerer d5 fra siden: en fleksibel åbning, hvor der kæmpes om centrum med brikkerne.
opening.family.english.beginner.spoken = Hvid begynder med se-bonden og kontrollerer dé fem fra siden: en fleksibel åbning, hvor der kæmpes om centrum med brikkerne.
opening.family.english.advanced = Engelsk åbning går ofte over i dronningebondeåbninger; dens egne varianter byder på fianchettomanøvrer, pres mod d5 og spil på dronningefløjen.
opening.family.english.advanced.spoken = Engelsk åbning går ofte over i dronningebondeåbninger; dens egne varianter byder på fianchettomanøvrer, pres mod dé fem og spil på dronningefløjen.
opening.family.zukertort = Zukertort-åbning
opening.family.zukertort.def = Zukertort-åbningen
opening.family.zukertort.beginner = Kongespringeren kommer ud først og holder øje med centrum, uden at hvid endnu binder sig til et bondetræk.
opening.family.zukertort.advanced = Et redskab til at styre trækfølgen: det kan blive til Réti-åbningen, engelsk, katalansk eller dronninggambit og går samtidig uden om nogle af sorts forsvarssystemer.
opening.family.zukertort.advanced.spoken = Et redskab til at styre trækfølgen: det kan blive til Réti-åbningen, engelsk, katalansk eller dronninggambit og går samtidig uden om nogle af sorts forsvarssystemer.
opening.family.queens_gambit = Dronninggambit
opening.family.queens_gambit.def = dronninggambit
opening.family.queens_gambit.beginner = Hvid tilbyder c-bonden for at lokke sorts bonde væk fra centrum; det er ikke et rigtigt offer, for hvid kan som regel vinde den tilbage.
opening.family.queens_gambit.beginner.spoken = Hvid tilbyder se-bonden for at lokke sorts bonde væk fra centrum; det er ikke et rigtigt offer, for hvid kan som regel vinde den tilbage.
opening.family.queens_gambit.advanced = c4 angriber støttepunktet d5: enten holder sort det, som i afslået dronninggambit eller slavisk, eller også opgiver sort det for fri udvikling, som i antaget dronninggambit.
opening.family.queens_gambit.advanced.spoken = se fire angriber støttepunktet dé fem: enten holder sort det, som i afslået dronninggambit eller slavisk, eller også opgiver sort det for fri udvikling, som i antaget dronninggambit.
opening.family.qgd = Afslået dronninggambit
opening.family.qgd.def = afslået dronninggambit
opening.family.qgd.beginner = Sort beholder bonden på d5 og støtter den med e6: meget solidt, men den hvidfeltede løber kræver omtanke.
opening.family.qgd.beginner.spoken = Sort beholder bonden på dé fem og støtter den med é seks: meget solidt, men den hvidfeltede løber kræver omtanke.
opening.family.qgd.advanced = Klassiske strukturer: Karlsbad-strukturen med hvids minoritetsangreb, sorts befriende brud med c5 eller e5 og det evige problem med den hvidfeltede løber.
opening.family.qgd.advanced.spoken = Klassiske strukturer: Karlsbad-strukturen med hvids minoritetsangreb, sorts befriende brud med se fem eller é fem og det evige problem med den hvidfeltede løber.
opening.family.qga = Antaget dronninggambit
opening.family.qga.def = antaget dronninggambit
opening.family.qga.beginner = Sort slår bonden, men prøver ikke at beholde den: pointen er at udvikle sig frit og angribe hvids centrum med c5.
opening.family.qga.beginner.spoken = Sort slår bonden, men prøver ikke at beholde den: pointen er at udvikle sig frit og angribe hvids centrum med se fem.
opening.family.qga.advanced = Hvid vinder bonden tilbage og ender ofte med en isoleret d-bonde: aktive brikker mod en langsigtet strukturel svaghed.
opening.family.qga.advanced.spoken = Hvid vinder bonden tilbage og ender ofte med en isoleret dé-bonde: aktive brikker mod en langsigtet strukturel svaghed.
opening.family.slav = Slavisk forsvar
opening.family.slav.def = slavisk forsvar
opening.family.slav.beginner = Sort støtter d5 med c6 og lader den hvidfeltede løber være fri til at komme ud: et meget solidt forsvar.
opening.family.slav.beginner.spoken = Sort støtter dé fem med se seks og lader den hvidfeltede løber være fri til at komme ud: et meget solidt forsvar.
opening.family.slav.advanced = Slavisk forsvar holder d5 uden at spærre den hvidfeltede løber inde; hovedvarianterne drejer sig om at sort slår på c4 og udvikler netop den løber til f5 eller g4.
opening.family.slav.advanced.spoken = Slavisk forsvar holder dé fem uden at spærre den hvidfeltede løber inde; hovedvarianterne drejer sig om at sort slår på se fire og udvikler netop den løber til æf fem eller ge fire.
opening.family.semi_slav = Semislavisk forsvar
opening.family.semi_slav.def = semislavisk forsvar
opening.family.semi_slav.beginner = Sort kombinerer den slaviske bonde på c6 med bonden på e6: det ser roligt ud, men det fører til meget skarpe varianter.
opening.family.semi_slav.beginner.spoken = Sort kombinerer den slaviske bonde på se seks med bonden på é seks: det ser roligt ud, men det fører til meget skarpe varianter.
opening.family.semi_slav.advanced = Semislavisk forsvar forgrener sig i Meran-varianten, med ekspansion på dronningefløjen via b5, og de ultraskarpe Botvinnik- og Moskva-gambitter.
opening.family.semi_slav.advanced.spoken = Semislavisk forsvar forgrener sig i Meran-varianten, med ekspansion på dronningefløjen via be fem, og de ultraskarpe Botvinnik- og Moskva-gambitter.
opening.family.indian = Indisk forsvar
opening.family.indian.def = et indisk forsvar
opening.family.indian.beginner = Sort svarer med springeren i stedet for en bonde og holder mulighederne åbne: indgangen til alle de indiske forsvar.
opening.family.indian.advanced = Springeren på f6 forhindrer e4 indtil videre; med de næste træk vælger sort mellem kongeindisk, nimzoindisk, dronningindisk, Grünfeld eller en Benoni.
opening.family.indian.advanced.spoken = Springeren på æf seks forhindrer é fire indtil videre; med de næste træk vælger sort mellem kongeindisk, nimzoindisk, dronningindisk, Grünfeld eller en Benoni.
opening.family.kings_indian = Kongeindisk forsvar
opening.family.kings_indian.def = kongeindisk forsvar
opening.family.kings_indian.beginner = Sort lader hvid bygge et stort centrum, sætter løberen på g7 og går senere til modangreb: et dynamisk, kamplystent forsvar.
opening.family.kings_indian.beginner.spoken = Sort lader hvid bygge et stort centrum, sætter løberen på ge syv og går senere til modangreb: et dynamisk, kamplystent forsvar.
opening.family.kings_indian.advanced = Sort angriber centrum med e5 eller c5; når det lukker sig, angriber hvid på dronningefløjen, mens sort stormer frem på kongefløjen med f5, f4 og g5.
opening.family.kings_indian.advanced.spoken = Sort angriber centrum med é fem eller se fem; når det lukker sig, angriber hvid på dronningefløjen, mens sort stormer frem på kongefløjen med æf fem, æf fire og ge fem.
opening.family.london = London-system
opening.family.london.def = London-systemet
opening.family.london.beginner = Hvid stiller op med d4, løberen på f4, e3, springeren på f3 og c3 mod næsten alt: let at lære, solidt og med en klar plan.
opening.family.london.beginner.spoken = Hvid stiller op med dé fire, løberen på æf fire, é tre, springeren på æf tre og se tre mod næsten alt: let at lære, solidt og med en klar plan.
opening.family.london.advanced = En stabil bondepyramide med løberen uden for kæden: hvid spiller for initiativ på kongefløjen eller et langsomt kvælertag, og et tidligt c5 er sorts mest prøvende svar.
opening.family.london.advanced.spoken = En stabil bondepyramide med løberen uden for kæden: hvid spiller for initiativ på kongefløjen eller et langsomt kvælertag, og et tidligt se fem er sorts mest prøvende svar.
opening.family.modern = Moderne forsvar
opening.family.modern.def = moderne forsvar
opening.family.modern.beginner = Sort sætter kongeløberen på g7 efter g6 og lader hvid tage centrum med planen om at angribe det senere.
opening.family.modern.beginner.spoken = Sort sætter kongeløberen på ge syv efter ge seks og lader hvid tage centrum med planen om at angribe det senere.
opening.family.modern.advanced = Hypermoderne og fleksibelt: sort venter med springeren til f6 og holder c6, a6 og b5, eller e5, i reserve, mens hvid bygger et stort centrum.
opening.family.modern.advanced.spoken = Hypermoderne og fleksibelt: sort venter med springeren til æf seks og holder se seks, a seks og be fem, eller é fem, i reserve, mens hvid bygger et stort centrum.
opening.family.pirc = Pirc-forsvar
opening.family.pirc.spoken = Pirc-forsvar
opening.family.pirc.def = Pirc-forsvaret
opening.family.pirc.def.spoken = Pirc-forsvaret
opening.family.pirc.beginner = Sort spiller d6, springeren til f6 og g6, lader hvid bygge et centrum og angriber det bagefter: et fleksibelt, kamplystent forsvar.
opening.family.pirc.beginner.spoken = Sort spiller dé seks, springeren til æf seks og ge seks, lader hvid bygge et centrum og angriber det bagefter: et fleksibelt, kamplystent forsvar.
opening.family.pirc.advanced = Hvid får et bredt centrum; de vigtigste kampe er østrigsk angreb med f4 og angrebene med dronning og løber, mens sort går til modangreb med c5 eller e5.
opening.family.pirc.advanced.spoken = Hvid får et bredt centrum; de vigtigste kampe er østrigsk angreb med æf fire og angrebene med dronning og løber, mens sort går til modangreb med se fem eller é fem.
opening.family.vienna = Wienerparti
opening.family.vienna.def = wienerparti
opening.family.vienna.beginner = Hvid udvikler først dronningespringeren og følger ofte op med f4: en livlig åbning med hurtige angrebschancer.
opening.family.vienna.beginner.spoken = Hvid udvikler først dronningespringeren og følger ofte op med æf fire: en livlig åbning med hurtige angrebschancer.
opening.family.vienna.advanced = Wienerpartiet forbereder f4, altså wienergambit, eller en rolig opstilling; sorts hovedsvar er springeren til f6 med et modstød i centrum med d5.
opening.family.vienna.advanced.spoken = Wienerpartiet forbereder æf fire, altså wienergambit, eller en rolig opstilling; sorts hovedsvar er springeren til æf seks med et modstød i centrum med dé fem.
opening.family.bishops_opening = Løberspil
opening.family.bishops_opening.def = løberspil
opening.family.bishops_opening.beginner = Hvid udvikler løberen til c4 før springeren, sigter mod f7 og holder f-bonden fri.
opening.family.bishops_opening.beginner.spoken = Hvid udvikler løberen til se fire før springeren, sigter mod æf syv og holder æf-bonden fri.
opening.family.bishops_opening.advanced = En fleksibel trækfølge som ofte går over i italiensk parti eller wienerparti; dens vigtigste selvstændige idé er rolige opstillinger med d3.
opening.family.bishops_opening.advanced.spoken = En fleksibel trækfølge som ofte går over i italiensk parti eller wienerparti; dens vigtigste selvstændige idé er rolige opstillinger med dé tre.
opening.family.alekhine = Aljechins forsvar
opening.family.alekhine.spoken = Aljechins forsvar
opening.family.alekhine.def = Aljechins forsvar
opening.family.alekhine.def.spoken = Aljechins forsvar
opening.family.alekhine.beginner = Sort angriber e4 med springeren for at lokke hvids bønder frem: de vinder plads, men de kan blive angrebsmål.
opening.family.alekhine.beginner.spoken = Sort angriber é fire med springeren for at lokke hvids bønder frem: de vinder plads, men de kan blive angrebsmål.
opening.family.alekhine.advanced = Sort inviterer bønderne frem og undergraver derefter det for vidt fremskudte centrum med d6 og c5; den rolige moderne variant er hvids hovedvariant.
opening.family.alekhine.advanced.spoken = Sort inviterer bønderne frem og undergraver derefter det for vidt fremskudte centrum med dé seks og se fem; den rolige moderne variant er hvids hovedvariant.
opening.family.kings_gambit = Kongegambit
opening.family.kings_gambit.def = kongegambit
opening.family.kings_gambit.beginner = Hvid ofrer f-bonden for at åbne f-linjen og tage centrum: en romantisk angrebsåbning fra det nittende århundrede.
opening.family.kings_gambit.beginner.spoken = Hvid ofrer æf-bonden for at åbne æf-linjen og tage centrum: en romantisk angrebsåbning fra det nittende århundrede.
opening.family.kings_gambit.advanced = Hvid giver en bonde for centrum og f-linjen; sort kan holde bonden med g5, give den tilbage med d5 eller afslå gambitten.
opening.family.kings_gambit.advanced.spoken = Hvid giver en bonde for centrum og æf-linjen; sort kan holde bonden med ge fem, give den tilbage med dé fem eller afslå gambitten.
opening.family.kga = Antaget kongegambit
opening.family.kga.def = antaget kongegambit
opening.family.kga.beginner = Sort slår f-bonden: partiet bliver meget skarpt, og begge konger står lidt udsat.
opening.family.kga.beginner.spoken = Sort slår æf-bonden: partiet bliver meget skarpt, og begge konger står lidt udsat.
opening.family.kga.advanced = Sort prøver enten at beholde bonden med g5 eller giver den tilbage for hurtig udvikling; hvid bygger på f-linjen og et udviklingsforspring.
opening.family.kga.advanced.spoken = Sort prøver enten at beholde bonden med ge fem eller giver den tilbage for hurtig udvikling; hvid bygger på æf-linjen og et udviklingsforspring.
opening.family.kgd = Afslået kongegambit
opening.family.kgd.def = afslået kongegambit
opening.family.kgd.beginner = Sort afslår bonden og udvikler i stedet, ofte med løberen til c5, som i et stykke tid forhindrer hvid i at rokere.
opening.family.kgd.beginner.spoken = Sort afslår bonden og udvikler i stedet, ofte med løberen til se fem, som i et stykke tid forhindrer hvid i at rokere.
opening.family.kgd.advanced = Løberen på c5 holder hvids kongefløj nede, og Falkbeer-modgambitten går til modangreb i centrum; begge undgår de lange, forcerede varianter i den antagne gambit.
opening.family.kgd.advanced.spoken = Løberen på se fem holder hvids kongefløj nede, og Falkbeer-modgambitten går til modangreb i centrum; begge undgår de lange, forcerede varianter i den antagne gambit.
opening.family.nimzowitsch_def = Nimzowitsch-forsvar
opening.family.nimzowitsch_def.spoken = Nimzowitsch-forsvar
opening.family.nimzowitsch_def.def = Nimzowitsch-forsvaret
opening.family.nimzowitsch_def.def.spoken = Nimzowitsch-forsvaret
opening.family.nimzowitsch_def.beginner = Sort svarer med dronningespringeren: et usædvanligt, men spilbart forsvar som ofte går over i andre åbninger.
opening.family.nimzowitsch_def.advanced = Det lægger op til strukturer med d4 og d5 eller e5, eller det går over i de åbne spil; dets værdi ligger i overraskelsen og det fleksible brikspil.
opening.family.nimzowitsch_def.advanced.spoken = Det lægger op til strukturer med dé fire og dé fem eller é fem, eller det går over i de åbne spil; dets værdi ligger i overraskelsen og det fleksible brikspil.
opening.family.owen = Owens forsvar
opening.family.owen.def = Owens forsvar
opening.family.owen.beginner = Sort sætter dronningeløberen på b7 for at angribe e4 på afstand; hvid bør simpelthen tage centrum.
opening.family.owen.beginner.spoken = Sort sætter dronningeløberen på be syv for at angribe é fire på afstand; hvid bør simpelthen tage centrum.
opening.family.owen.advanced = En hypermoderne opstilling med b6, løberen på b7 og e6, som tidligt opgiver centrum; hvid vinder plads og skal holde øje med den lange diagonal.
opening.family.owen.advanced.spoken = En hypermoderne opstilling med be seks, løberen på be syv og é seks, som tidligt opgiver centrum; hvid vinder plads og skal holde øje med den lange diagonal.
opening.family.horwitz = Horwitz-forsvar
opening.family.horwitz.def = Horwitz-forsvaret
opening.family.horwitz.beginner = Sort spiller e6 og holder mulighederne åbne: som regel bliver det til fransk, afslået dronninggambit eller hollandsk.
opening.family.horwitz.beginner.spoken = Sort spiller é seks og holder mulighederne åbne: som regel bliver det til fransk, afslået dronninggambit eller hollandsk.
opening.family.horwitz.advanced = En trækfølge med mange trækomstillinger; dens egne varianter er kænguruen, med løberskak på b4, og opstillinger som i engelsk forsvar med b6.
opening.family.horwitz.advanced.spoken = En trækfølge med mange trækomstillinger; dens egne varianter er kænguruen, med løberskak på be fire, og opstillinger som i engelsk forsvar med be seks.
opening.family.vant_kruijs = Van 't Kruijs-åbning
opening.family.vant_kruijs.def = Van 't Kruijs-åbningen
opening.family.vant_kruijs.beginner = Når kongebonden går ét felt frem, åbner den for løberen, men tager ikke meget af centrum: en rolig start.
opening.family.vant_kruijs.beginner.spoken = Når kongebonden går ét felt frem, åbner den for løberen, men tager ikke meget af centrum: en rolig start.
opening.family.vant_kruijs.advanced = Den går som regel over i opstillinger som omvendt fransk, Colle eller Stonewall og overlader sort kampen om centrum uden nogen reel risiko.
opening.family.center_game = Centrumspil
opening.family.center_game.def = centrumspil
opening.family.center_game.beginner = Hvid åbner centrum med d4 i andet træk, men efter afbytningen slår dronningen tidligt tilbage og kan blive jaget.
opening.family.center_game.beginner.spoken = Hvid åbner centrum med dé fire i andet træk, men efter afbytningen slår dronningen tidligt tilbage og kan blive jaget.
opening.family.center_game.advanced = Sort udvikler med tempo mod dronningen; hvid sætter den som regel på e3, udvikler dronningefløjen og spiller lang rokade for at angribe.
opening.family.center_game.advanced.spoken = Sort udvikler med tempo mod dronningen; hvid sætter den som regel på é tre, udvikler dronningefløjen og spiller lang rokade for at angribe.
opening.family.englund = Englund-gambit
opening.family.englund.def = Englund-gambit
opening.family.englund.beginner = Sort tilbyder e-bonden og håber på fælder: objektivt tvivlsomt, men farligt hvis hvid ikke kender gambitten.
opening.family.englund.beginner.spoken = Sort tilbyder é-bonden og håber på fælder: objektivt tvivlsomt, men farligt hvis hvid ikke kender gambitten.
opening.family.englund.advanced = Gambitten bygger på dronningetricks på e7 og b4; hvid beholder en sund merbonde med rolig, omhyggelig udvikling.
opening.family.englund.advanced.spoken = Gambitten bygger på dronningetricks på é syv og be fire; hvid beholder en sund merbonde med rolig, omhyggelig udvikling.
opening.family.dutch = Hollandsk forsvar
opening.family.dutch.def = hollandsk forsvar
opening.family.dutch.beginner = Sort spiller f5 for at kontrollere e4 og sigte mod kongefløjen: ambitiøst, men det svækker sorts konge en smule.
opening.family.dutch.beginner.spoken = Sort spiller æf fem for at kontrollere é fire og sigte mod kongefløjen: ambitiøst, men det svækker sorts konge en smule.
opening.family.dutch.advanced = Leningrad-, Stonewall- eller klassiske opstillinger: sort kæmper om e4 og for et angreb på kongefløjen, og hvid sigter mod e4 og det svækkede felt e6.
opening.family.dutch.advanced.spoken = Leningrad-, Stonewall- eller klassiske opstillinger: sort kæmper om é fire og for et angreb på kongefløjen, og hvid sigter mod é fire og det svækkede felt é seks.
opening.family.nimzo_indian = Nimzoindisk forsvar
opening.family.nimzo_indian.spoken = Nimzoindisk forsvar
opening.family.nimzo_indian.def = nimzoindisk forsvar
opening.family.nimzo_indian.def.spoken = nimzoindisk forsvar
opening.family.nimzo_indian.beginner = Sort binder springeren på c3 med løberen for at forhindre e4: et højt respekteret forsvar som ofte efterlader hvid med dobbeltbønder.
opening.family.nimzo_indian.beginner.spoken = Sort binder springeren på se tre med løberen for at forhindre é fire: et højt respekteret forsvar som ofte efterlader hvid med dobbeltbønder.
opening.family.nimzo_indian.advanced = Sort giver løber for springer for at kontrollere e4 og skade hvids bondestruktur; hvid får løberparret og muligheder i centrum.
opening.family.nimzo_indian.advanced.spoken = Sort giver løber for springer for at kontrollere é fire og skade hvids bondestruktur; hvid får løberparret og muligheder i centrum.
opening.family.queens_indian = Dronningindisk forsvar
opening.family.queens_indian.def = dronningindisk forsvar
opening.family.queens_indian.beginner = Sort sætter dronningeløberen på b7 for at kontrollere de hvide felter i centrum: solidt og fleksibelt.
opening.family.queens_indian.beginner.spoken = Sort sætter dronningeløberen på be syv for at kontrollere de hvide felter i centrum: solidt og fleksibelt.
opening.family.queens_indian.advanced = Sort kæmper om e4 og d5 med brikkerne; typiske idéer er løberen til a6 mod c4, pindsvineopstillinger og bruddene c5 eller d5.
opening.family.queens_indian.advanced.spoken = Sort kæmper om é fire og dé fem med brikkerne; typiske idéer er løberen til a seks mod se fire, pindsvineopstillinger og bruddene se fem eller dé fem.
opening.family.grunfeld = Grünfeld-indisk forsvar
opening.family.grunfeld.spoken = Grünfeld-indisk forsvar
opening.family.grunfeld.def = Grünfeld-indisk forsvar
opening.family.grunfeld.def.spoken = Grünfeld-indisk forsvar
opening.family.grunfeld.beginner = Sort lader hvid bygge et stort bondecentrum og angriber det derefter med brikkerne og løberen på g7: et dynamisk, moderne forsvar.
opening.family.grunfeld.beginner.spoken = Sort lader hvid bygge et stort bondecentrum og angriber det derefter med brikkerne og løberen på ge syv: et dynamisk, moderne forsvar.
opening.family.grunfeld.advanced = I afbytningsvarianterne får hvid et stort centrum, og sort angriber d4 med løberen, c5 og springerne: meget konkret teori.
opening.family.grunfeld.advanced.spoken = I afbytningsvarianterne får hvid et stort centrum, og sort angriber dé fire med løberen, se fem og springerne: meget konkret teori.
opening.family.catalan = Katalansk åbning
opening.family.catalan.def = katalansk åbning
opening.family.catalan.beginner = Hvid kombinerer dronninggambit med en løber på g2 der presser sorts dronningefløj langs den lange diagonal.
opening.family.catalan.beginner.spoken = Hvid kombinerer dronninggambit med en løber på ge to der presser sorts dronningefløj langs den lange diagonal.
opening.family.catalan.advanced = Hvid opgiver bonden på c4 eller venter med at vinde den tilbage for at få pres på den lange diagonal, og slutspillene er ofte til fordel for hvids løber.
opening.family.catalan.advanced.spoken = Hvid opgiver bonden på se fire eller venter med at vinde den tilbage for at få pres på den lange diagonal, og slutspillene er ofte til fordel for hvids løber.
opening.family.benoni = Benoni-forsvar
opening.family.benoni.def = Benoni-forsvaret
opening.family.benoni.beginner = Sort spiller c5 og accepterer et blokeret centrum til gengæld for et bondeflertal på dronningefløjen: et ambitiøst, ubalanceret forsvar.
opening.family.benoni.beginner.spoken = Sort spiller se fem og accepterer et blokeret centrum til gengæld for et bondeflertal på dronningefløjen: et ambitiøst, ubalanceret forsvar.
opening.family.benoni.advanced = En asymmetrisk struktur: sort har flertallet på dronningefløjen og løberen på g7, hvid har flertallet i centrum og bruddet e5.
opening.family.benoni.advanced.spoken = En asymmetrisk struktur: sort har flertallet på dronningefløjen og løberen på ge syv, hvid har flertallet i centrum og bruddet é fem.
opening.family.benko = Benkø-gambit
opening.family.benko.def = Benkø-gambit
opening.family.benko.beginner = Sort giver en bonde på dronningefløjen for at åbne a-linjen og b-linjen for tårnene: langvarigt pres snarere end hurtig taktik.
opening.family.benko.beginner.spoken = Sort giver en bonde på dronningefløjen for at åbne a-linjen og be-linjen for tårnene: langvarigt pres snarere end hurtig taktik.
opening.family.benko.advanced = En bonde for varigt pres på dronningefløjen fra tårnene og løberen på g7; sort er ofte godt tilfreds i et slutspil med en bonde mindre.
opening.family.benko.advanced.spoken = En bonde for varigt pres på dronningefløjen fra tårnene og løberen på ge syv; sort er ofte godt tilfreds i et slutspil med en bonde mindre.
opening.family.reti = Réti-åbning
opening.family.reti.spoken = Réti-åbning
opening.family.reti.def = Réti-åbningen
opening.family.reti.def.spoken = Réti-åbningen
opening.family.reti.beginner = Hvid udvikler springeren og angriber derefter sorts centrum fra siden med c4: en fleksibel, hypermoderne åbning.
opening.family.reti.beginner.spoken = Hvid udvikler springeren og angriber derefter sorts centrum fra siden med se fire: en fleksibel, hypermoderne åbning.
opening.family.reti.advanced = Réti-åbningen presser d5 med c4 og en fianchetto på g2 og går ofte over i strukturer fra katalansk, engelsk eller dronninggambit.
opening.family.reti.advanced.spoken = Réti-åbningen presser dé fem med se fire og en fianchetto på ge to og går ofte over i strukturer fra katalansk, engelsk eller dronninggambit.
opening.family.kings_indian_attack = Kongeindisk angreb
opening.family.kings_indian_attack.def = kongeindisk angreb
opening.family.kings_indian_attack.beginner = Hvid stiller op med springeren på f3, fianchetto på g2, rokade, d3 og e4 mod næsten alt: et system med en klar plan på kongefløjen.
opening.family.kings_indian_attack.beginner.spoken = Hvid stiller op med springeren på æf tre, fianchetto på ge to, rokade, dé tre og é fire mod næsten alt: et system med en klar plan på kongefløjen.
opening.family.kings_indian_attack.advanced = Kongeindisk med ombyttede farver og et ekstra tempo; hvid går ofte frem til e5 og angriber kongen, mens sort ekspanderer på dronningefløjen.
opening.family.kings_indian_attack.advanced.spoken = Kongeindisk med ombyttede farver og et ekstra tempo; hvid går ofte frem til é fem og angriber kongen, mens sort ekspanderer på dronningefløjen.
opening.family.bird = Birds åbning
opening.family.bird.def = Birds åbning
opening.family.bird.beginner = Hvid begynder med f-bonden for at kontrollere e5: en usædvanlig åbning som fører til hollandske stillinger med ombyttede farver.
opening.family.bird.beginner.spoken = Hvid begynder med æf-bonden for at kontrollere é fem: en usædvanlig åbning som fører til hollandske stillinger med ombyttede farver.
opening.family.bird.advanced = Hvid går efter en opstilling på kongefløjen med løberen på b2 eller en fianchetto på g2; sorts skarpeste svar er Froms gambit med e5.
opening.family.bird.advanced.spoken = Hvid går efter en opstilling på kongefløjen med løberen på be to eller en fianchetto på ge to; sorts skarpeste svar er Froms gambit med é fem.
opening.family.ponziani = Ponziani-åbning
opening.family.ponziani.def = Ponziani-åbningen
opening.family.ponziani.beginner = Hvid forbereder d4 med c3 for at bygge et bondecentrum: en gammel og ret sjælden åbning.
opening.family.ponziani.beginner.spoken = Hvid forbereder dé fire med se tre for at bygge et bondecentrum: en gammel og ret sjælden åbning.
opening.family.ponziani.advanced = c3 forbereder d4, men tager springerens bedste felt; sort udligner med et modangreb, enten med springeren til f6 eller med d5.
opening.family.ponziani.advanced.spoken = se tre forbereder dé fire, men tager springerens bedste felt; sort udligner med et modangreb, enten med springeren til æf seks eller med dé fem.
opening.family.three_knights = Trespringerspil
opening.family.three_knights.def = trespringerspil
opening.family.three_knights.beginner = Hvid udvikler tidligt en tredje springer; hvis sort svarer med den fjerde springer, bliver det til firspringerspil.
opening.family.three_knights.advanced = En trækfølge med mange trækomstillinger; sorts selvstændige forsøg er løberen til b4 og en fianchetto med g6.
opening.family.three_knights.advanced.spoken = En trækfølge med mange trækomstillinger; sorts selvstændige forsøg er løberen til be fire og en fianchetto med ge seks.
opening.family.danish = Nordisk gambit
opening.family.danish.def = nordisk gambit
opening.family.danish.beginner = Hvid giver én eller endda to bønder for et stort udviklingsforspring og to løbere som sigter mod sorts konge.
opening.family.danish.advanced = Hvid giver bønder for åbne linjer og løbere på c4 og b2; at give materiale tilbage med d5 er sorts sikreste svar.
opening.family.danish.advanced.spoken = Hvid giver bønder for åbne linjer og løbere på se fire og be to; at give materiale tilbage med dé fem er sorts sikreste svar.
opening.family.blackmar_diemer = Blackmar-Diemer-gambit
opening.family.blackmar_diemer.spoken = Blackmar-Diemer-gambit
opening.family.blackmar_diemer.def = Blackmar-Diemer-gambit
opening.family.blackmar_diemer.def.spoken = Blackmar-Diemer-gambit
opening.family.blackmar_diemer.beginner = Hvid ofrer en bonde med e4 og f3 for at åbne f-linjen og angribe hurtigt.
opening.family.blackmar_diemer.beginner.spoken = Hvid ofrer en bonde med é fire og æf tre for at åbne æf-linjen og angribe hurtigt.
opening.family.blackmar_diemer.advanced = En bonde for udvikling og den halvåbne f-linje; teorien er på sorts side hvis sort udvikler sig fornuftigt.
opening.family.blackmar_diemer.advanced.spoken = En bonde for udvikling og den halvåbne æf-linje; teorien er på sorts side hvis sort udvikler sig fornuftigt.
opening.family.trompowsky = Trompowsky-angreb
opening.family.trompowsky.spoken = Trompowsky-angreb
opening.family.trompowsky.def = Trompowsky-angrebet
opening.family.trompowsky.def.spoken = Trompowsky-angrebet
opening.family.trompowsky.beginner = Hvid angriber straks springeren på f6 med løberen: en tidlig overraskelse som fører sort væk fra de vante veje.
opening.family.trompowsky.beginner.spoken = Hvid angriber straks springeren på æf seks med løberen: en tidlig overraskelse som fører sort væk fra de vante veje.
opening.family.trompowsky.advanced = Løberen truer med at give sort dobbeltbønder; sort svarer med springeren til e4, med e6 eller med c5, og spillet bliver ubalanceret.
opening.family.trompowsky.advanced.spoken = Løberen truer med at give sort dobbeltbønder; sort svarer med springeren til é fire, med é seks eller med se fem, og spillet bliver ubalanceret.
opening.family.torre = Torre-angreb
opening.family.torre.def = Torre-angrebet
opening.family.torre.beginner = Hvid udvikler løberen til g5 for at binde springeren og bygger et solidt centrum med e3 og c3.
opening.family.torre.beginner.spoken = Hvid udvikler løberen til ge fem for at binde springeren og bygger et solidt centrum med é tre og se tre.
opening.family.torre.advanced = Et system som sigter mod e4 med løberen på g5; sort svarer som regel med c5 eller et tidligt h6.
opening.family.torre.advanced.spoken = Et system som sigter mod é fire med løberen på ge fem; sort svarer som regel med se fem eller et tidligt hå seks.
opening.family.colle = Colle-system
opening.family.colle.def = Colle-systemet
opening.family.colle.beginner = Hvid bygger bondetrekanten d4, e3 og c3 med løberen på d3 og forbereder e4: et enkelt, solidt angrebssystem.
opening.family.colle.beginner.spoken = Hvid bygger bondetrekanten dé fire, é tre og se tre med løberen på dé tre og forbereder é fire: et enkelt, solidt angrebssystem.
opening.family.colle.advanced = Hvid forbereder e4 til et angreb på kongefløjen eller udvikler den anden løber til b2; ulempen er den passive løber på c1.
opening.family.colle.advanced.spoken = Hvid forbereder é fire til et angreb på kongefløjen eller udvikler den anden løber til be to; ulempen er den passive løber på se ét.
opening.family.tarrasch_def = Tarrasch-forsvar
opening.family.tarrasch_def.def = Tarrasch-forsvaret
opening.family.tarrasch_def.beginner = Sort spiller c5 mod dronninggambit og accepterer en isoleret bonde til gengæld for frit brikspil.
opening.family.tarrasch_def.beginner.spoken = Sort spiller se fem mod dronninggambit og accepterer en isoleret bonde til gengæld for frit brikspil.
opening.family.tarrasch_def.advanced = Sort påtager sig bevidst en isoleret dronningebonde for at få aktivitet; hvid blokerer d5 og fianchetterer, og sort søger brikspil og fremstødet til d4.
opening.family.tarrasch_def.advanced.spoken = Sort påtager sig bevidst en isoleret dronningebonde for at få aktivitet; hvid blokerer dé fem og fianchetterer, og sort søger brikspil og fremstødet til dé fire.
opening.family.budapest = Budapest-gambit
opening.family.budapest.def = Budapest-gambit
opening.family.budapest.beginner = Sort giver e-bonden for at udvikle sig hurtigt; bonden bliver som regel vundet tilbage.
opening.family.budapest.beginner.spoken = Sort giver é-bonden for at udvikle sig hurtigt; bonden bliver som regel vundet tilbage.
opening.family.budapest.advanced = I de fleste varianter vinder sort bonden tilbage med springeren på g4; hvid beholder en lille fordel, og Fajarowicz-varianten er en mere lumsk sidevariant.
opening.family.budapest.advanced.spoken = I de fleste varianter vinder sort bonden tilbage med springeren på ge fire; hvid beholder en lille fordel, og Fajarowicz-varianten er en mere lumsk sidevariant.
opening.family.bogo_indian = Bogoindisk forsvar
opening.family.bogo_indian.spoken = Bogoindisk forsvar
opening.family.bogo_indian.def = bogoindisk forsvar
opening.family.bogo_indian.def.spoken = bogoindisk forsvar
opening.family.bogo_indian.beginner = Sort giver skak med løberen på b4 for at forstyrre hvids udvikling: et solidt, enkelt forsvar.
opening.family.bogo_indian.beginner.spoken = Sort giver skak med løberen på be fire for at forstyrre hvids udvikling: et solidt, enkelt forsvar.
opening.family.bogo_indian.advanced = Som regel en løberafbytning på d2 eller en struktur som i nimzoindisk, men uden bindingen; sort går efter en solid opstilling med d5 eller med d6 og e5.
opening.family.bogo_indian.advanced.spoken = Som regel en løberafbytning på dé to eller en struktur som i nimzoindisk, men uden bindingen; sort går efter en solid opstilling med dé fem eller med dé seks og é fem.
opening.family.old_indian = Gammelindisk forsvar
opening.family.old_indian.def = gammelindisk forsvar
opening.family.old_indian.beginner = Sort spiller d6 og e5 uden fianchetto: et solidt, men lidt passivt forsvar.
opening.family.old_indian.beginner.spoken = Sort spiller dé seks og é fem uden fianchetto: et solidt, men lidt passivt forsvar.
opening.family.old_indian.advanced = Kongeindisk med løberen på e7: solidt, men trangt, med spil i centrum baseret på e5.
opening.family.old_indian.advanced.spoken = Kongeindisk med løberen på é syv: solidt, men trangt, med spil i centrum baseret på é fem.
opening.family.chigorin = Tjigorin-forsvar
opening.family.chigorin.def = Tjigorin-forsvaret
opening.family.chigorin.beginner = Sort udvikler dronningespringeren til c6 mod dronninggambit og spiller for aktive brikker.
opening.family.chigorin.beginner.spoken = Sort udvikler dronningespringeren til se seks mod dronninggambit og spiller for aktive brikker.
opening.family.chigorin.advanced = Sort opgiver soliditet i centrum for aktive brikker og bytter ofte den hvidfeltede løber mod springeren på f3 for at presse d4.
opening.family.chigorin.advanced.spoken = Sort opgiver soliditet i centrum for aktive brikker og bytter ofte den hvidfeltede løber mod springeren på æf tre for at presse dé fire.
opening.family.albin = Albin-modgambit
opening.family.albin.def = Albin-modgambit
opening.family.albin.beginner = Sort ofrer selv e-bonden for at rykke frem til d4 og give hvid trange forhold: skarpt og fuldt af fælder.
opening.family.albin.beginner.spoken = Sort ofrer selv é-bonden for at rykke frem til dé fire og give hvid trange forhold: skarpt og fuldt af fælder.
opening.family.albin.advanced = Sort bygger på bondekilen på d4 og hurtig udvikling; hvid gør bedst i at udvikle roligt med fianchetto og give materiale tilbage når det er nødvendigt.
opening.family.albin.advanced.spoken = Sort bygger på bondekilen på dé fire og hurtig udvikling; hvid gør bedst i at udvikle roligt med fianchetto og give materiale tilbage når det er nødvendigt.
opening.family.latvian = Lettisk gambit
opening.family.latvian.def = lettisk gambit
opening.family.latvian.beginner = Sort spiller f5 i andet træk: en meget risikabel gambit som svækker sorts egen konge.
opening.family.latvian.beginner.spoken = Sort spiller æf fem i andet træk: en meget risikabel gambit som svækker sorts egen konge.
opening.family.latvian.advanced = Objektivt tvivlsom: hvid får et stærkt initiativ ved at slå på e5 eller med løberen på c4.
opening.family.latvian.advanced.spoken = Objektivt tvivlsom: hvid får et stærkt initiativ ved at slå på é fem eller med løberen på se fire.
opening.family.elephant = Elefantgambit
opening.family.elephant.def = elefantgambit
opening.family.elephant.beginner = Sort går straks til modangreb med d5 og tilbyder en bonde for at åbne linjer: risikabelt, men lumsk.
opening.family.elephant.beginner.spoken = Sort går straks til modangreb med dé fem og tilbyder en bonde for at åbne linjer: risikabelt, men lumsk.
opening.family.elephant.advanced = Objektivt ukorrekt: efter afbytningen på d5 beholder hvid et godt spil med omhyggelig udvikling.
opening.family.elephant.advanced.spoken = Objektivt ukorrekt: efter afbytningen på dé fem beholder hvid et godt spil med omhyggelig udvikling.
opening.family.nimzo_larsen = Nimzo-Larsen-angreb
opening.family.nimzo_larsen.spoken = Nimzo-Larsen-angreb
opening.family.nimzo_larsen.def = Nimzo-Larsen-angrebet
opening.family.nimzo_larsen.def.spoken = Nimzo-Larsen-angrebet
opening.family.nimzo_larsen.beginner = Hvid sætter dronningeløberen på den lange diagonal efter b3 for at kontrollere e5 og centrum på afstand.
opening.family.nimzo_larsen.beginner.spoken = Hvid sætter dronningeløberen på den lange diagonal efter be tre for at kontrollere é fem og centrum på afstand.
opening.family.nimzo_larsen.advanced = En hypermoderne fløjopstilling: sort besætter centrum med e5 eller d5, og hvid presser det med løberen, e3 og f4 eller c4.
opening.family.nimzo_larsen.advanced.spoken = En hypermoderne fløjopstilling: sort besætter centrum med é fem eller dé fem, og hvid presser det med løberen, é tre og æf fire eller se fire.
opening.family.polish = Polsk åbning
opening.family.polish.def = polsk åbning
opening.family.polish.beginner = Hvid begynder med b4, et usædvanligt fløjtræk som vinder plads på dronningefløjen.
opening.family.polish.beginner.spoken = Hvid begynder med be fire, et usædvanligt fløjtræk som vinder plads på dronningefløjen.
opening.family.polish.advanced = Løberen går til b2 bag bonden; bonden på b4 kan blive et angrebsmål, men åbningen er spilbar og overraskende.
opening.family.polish.advanced.spoken = Løberen går til be to bag bonden; bonden på be fire kan blive et angrebsmål, men åbningen er spilbar og overraskende.
opening.family.grob = Grob-åbning
opening.family.grob.def = Grob-åbningen
opening.family.grob.beginner = Hvid flytter g-bonden to felter frem i første træk: en provokerende åbning som svækker hvids egen konge.
opening.family.grob.beginner.spoken = Hvid flytter ge-bonden to felter frem i første træk: en provokerende åbning som svækker hvids egen konge.
opening.family.grob.advanced = Hvid sigter mod den lange diagonal og b7; sort svarer med d5 og e5 og bør straffe den svækkede kongefløj.
opening.family.grob.advanced.spoken = Hvid sigter mod den lange diagonal og be syv; sort svarer med dé fem og é fem og bør straffe den svækkede kongefløj.
opening.family.hungarian = Ungarsk åbning
opening.family.hungarian.def = ungarsk åbning
opening.family.hungarian.beginner = Hvid forbereder en fianchetto med g3: en fleksibel start som ofte bliver til kongeindisk angreb eller engelsk.
opening.family.hungarian.beginner.spoken = Hvid forbereder en fianchetto med ge tre: en fleksibel start som ofte bliver til kongeindisk angreb eller engelsk.
opening.family.hungarian.advanced = Fuld af trækomstillinger: opstillinger fra Réti, engelsk og kongeindisk angreb eller et omvendt moderne forsvar.
opening.family.hungarian.advanced.spoken = Fuld af trækomstillinger: opstillinger fra Réti, engelsk og kongeindisk angreb eller et omvendt moderne forsvar.
opening.family.mieses = Mieses-åbning
opening.family.mieses.def = Mieses-åbningen
opening.family.mieses.beginner = Hvid begynder meget beskedent med d3 og åbner for den sortfeltede løber uden at tage centrum.
opening.family.mieses.beginner.spoken = Hvid begynder meget beskedent med dé tre og åbner for den sortfeltede løber uden at tage centrum.
opening.family.mieses.advanced = Den fører ofte til omvendt Pirc eller opstillinger som i kongeindisk angreb; sort kan frit tage centrum.
opening.family.mieses.advanced.spoken = Den fører ofte til omvendt Pirc eller opstillinger som i kongeindisk angreb; sort kan frit tage centrum.
opening.family.saragossa = Saragossa-åbning
opening.family.saragossa.def = Saragossa-åbningen
opening.family.saragossa.beginner = Hvid begynder med c3, et meget sjældent og roligt første træk.
opening.family.saragossa.beginner.spoken = Hvid begynder med se tre, et meget sjældent og roligt første træk.
opening.family.saragossa.advanced = c3 forbereder et støttet d4 og kan gå over i strukturer som omvendt Caro-Kann eller omvendt slavisk.
opening.family.saragossa.advanced.spoken = se tre forbereder et støttet dé fire og kan gå over i strukturer som omvendt Caro-Kann eller omvendt slavisk.
opening.family.van_geet = Van Geet-åbning
opening.family.van_geet.def = Van Geet-åbningen
opening.family.van_geet.beginner = Hvid udvikler først dronningespringeren, et usædvanligt træk som holder e4 eller d4 i reserve.
opening.family.van_geet.beginner.spoken = Hvid udvikler først dronningespringeren, et usædvanligt træk som holder é fire eller dé fire i reserve.
opening.family.van_geet.advanced = Den går ofte over i stillinger af typen wienerparti, omvendt siciliansk eller Pirc.
opening.family.van_geet.advanced.spoken = Den går ofte over i stillinger af typen wienerparti, omvendt siciliansk eller Pirc.
opening.family.jobava_london = Jobava-London-system
opening.family.jobava_london.spoken = Jobava-London-system
opening.family.jobava_london.def = Jobava-London-systemet
opening.family.jobava_london.def.spoken = Jobava-London-systemet
opening.family.jobava_london.beginner = Hvid kombinerer springeren på c3 med løberen på f4: et aggressivt system som sigter mod c7 med et springerhop til b5.
opening.family.jobava_london.beginner.spoken = Hvid kombinerer springeren på se tre med løberen på æf fire: et aggressivt system som sigter mod se syv med et springerhop til be fem.
opening.family.jobava_london.advanced = Hvid spiller ofte lang rokade og angriber med h4 eller g4; sort skal holde øje med c7 og fremstødet til e4.
opening.family.jobava_london.advanced.spoken = Hvid spiller ofte lang rokade og angriber med hå fire eller ge fire; sort skal holde øje med se syv og fremstødet til é fire.
opening.family.stonewall_attack = Stonewall-angreb
opening.family.stonewall_attack.def = Stonewall-angrebet
opening.family.stonewall_attack.beginner = Hvid sætter bønder på d4, e3 og f4 og løberen på d3 og går efter et angreb på kongefløjen med en springer på e5.
opening.family.stonewall_attack.beginner.spoken = Hvid sætter bønder på dé fire, é tre og æf fire og løberen på dé tre og går efter et angreb på kongefløjen med en springer på é fem.
opening.family.stonewall_attack.advanced = e5 er solidt kontrolleret, men e4 og c4 bliver svage; sort gør bedst i at spille c5 hurtigt eller bytte hvids hvidfeltede løber af.
opening.family.stonewall_attack.advanced.spoken = é fem er solidt kontrolleret, men é fire og se fire bliver svage; sort gør bedst i at spille se fem hurtigt eller bytte hvids hvidfeltede løber af.
opening.family.richter_veresov = Richter-Veresov-angreb
opening.family.richter_veresov.spoken = Richter-Veresov-angreb
opening.family.richter_veresov.def = Richter-Veresov-angrebet
opening.family.richter_veresov.def.spoken = Richter-Veresov-angrebet
opening.family.richter_veresov.beginner = Hvid udvikler tidligt dronningespringeren til c3 og løberen til g5 og sigter mod e4.
opening.family.richter_veresov.beginner.spoken = Hvid udvikler tidligt dronningespringeren til se tre og løberen til ge fem og sigter mod é fire.
opening.family.richter_veresov.advanced = Springeren blokerer c-bonden, men støtter f3 og e4; sort klarer sig godt med c5 eller med løberen til f5.
opening.family.richter_veresov.advanced.spoken = Springeren blokerer se-bonden, men støtter æf tre og é fire; sort klarer sig godt med se fem eller med løberen til æf fem.
opening.family.st_george = Sankt Georg-forsvar
opening.family.st_george.def = Sankt Georg-forsvaret
opening.family.st_george.beginner = Sort begynder med a6 og b5, en sjælden fløjopstilling som blev berømt med Miles' sejr over Karpov.
opening.family.st_george.beginner.spoken = Sort begynder med a seks og be fem, en sjælden fløjopstilling som blev berømt med Miles' sejr over Karpov.
opening.family.st_george.advanced = Sort går efter løberen på b7 og ekspansion på dronningefløjen og opgiver centrum; hvid beholder et vist overtag med enkel udvikling i centrum.
opening.family.st_george.advanced.spoken = Sort går efter løberen på be syv og ekspansion på dronningefløjen og opgiver centrum; hvid beholder et vist overtag med enkel udvikling i centrum.
opening.family.borg = Borg-forsvar
opening.family.borg.def = Borg-forsvaret
opening.family.borg.beginner = Sort flytter g-bonden to felter frem: en provokerende åbning som svækker sorts egen konge.
opening.family.borg.beginner.spoken = Sort flytter ge-bonden to felter frem: en provokerende åbning som svækker sorts egen konge.
opening.family.borg.advanced = Grob-åbningen med ombyttede farver; hvid vinder plads og tid med d4 og pres mod g5.
opening.family.borg.advanced.spoken = Grob-åbningen med ombyttede farver; hvid vinder plads og tid med dé fire og pres mod ge fem.
opening.family.hippopotamus = Flodhesteforsvar
opening.family.hippopotamus.def = flodhesteforsvaret
opening.family.hippopotamus.beginner = Sort stiller bønderne på sjette række, fianchetterer begge løbere og venter på at hvid går for vidt.
opening.family.hippopotamus.advanced = En fleksibel venteopstilling: sund mod langsomt spil, trang mod et bredt centrum.
opening.family.english_defense = Engelsk forsvar
opening.family.english_defense.def = engelsk forsvar
opening.family.english_defense.beginner = Sort svarer med b6 og løberen på b7 for at kæmpe om e4 med brikkerne.
opening.family.english_defense.beginner.spoken = Sort svarer med be seks og løberen på be syv for at kæmpe om é fire med brikkerne.
opening.family.english_defense.advanced = Sort lader hvid bygge et stort centrum og angriber det derefter med løberskak på b4, med f5 og med pres mod e4.
opening.family.english_defense.advanced.spoken = Sort lader hvid bygge et stort centrum og angriber det derefter med løberskak på be fire, med æf fem og med pres mod é fire.
opening.family.pterodactyl = Pterodaktylforsvar
opening.family.pterodactyl.def = pterodaktylforsvaret
opening.family.pterodactyl.beginner = Sort fianchetterer kongeløberen, spiller derefter c5 og fører tidligt dronningen til a5: et utraditionelt, aggressivt system.
opening.family.pterodactyl.beginner.spoken = Sort fianchetterer kongeløberen, spiller derefter se fem og fører tidligt dronningen til a fem: et utraditionelt, aggressivt system.
opening.family.pterodactyl.advanced = En blanding af idéer fra moderne forsvar og siciliansk: dronningen på a5 angriber springeren på c3 langs diagonalen.
opening.family.pterodactyl.advanced.spoken = En blanding af idéer fra moderne forsvar og siciliansk: dronningen på a fem angriber springeren på se tre langs diagonalen.
opening.family.bongcloud = Bongcloud-angreb
opening.family.bongcloud.def = Bongcloud-angrebet
opening.family.bongcloud.beginner = Hvid flytter kongen i andet træk: en åbning for sjov som bryder de grundlæggende regler, for kongen skal stå sikkert og rokere.
opening.family.bongcloud.advanced = Kongen spærrer for løberen og dronningen og giver afkald på rokaden; åbningen spilles for sjov og bør ikke efterlignes.

# ---- Notable variations
opening.variation.open_sicilian = Åben siciliansk
opening.variation.open_sicilian.def = åben siciliansk
opening.variation.open_sicilian.advanced = Hvid åbner centrum med d4 og slår tilbage med springeren: den vigtigste slagmark i siciliansk, skarp og fuld af teori.
opening.variation.open_sicilian.advanced.spoken = Hvid åbner centrum med dé fire og slår tilbage med springeren: den vigtigste slagmark i siciliansk, skarp og fuld af teori.
opening.variation.closed_sicilian = Lukket siciliansk
opening.variation.closed_sicilian.def = lukket siciliansk
opening.variation.closed_sicilian.advanced = Hvid undgår d4, fianchetterer på g2 og spiller ofte f4 med et langsomt angreb på kongefløjen for øje.
opening.variation.closed_sicilian.advanced.spoken = Hvid undgår dé fire, fianchetterer på ge to og spiller ofte æf fire med et langsomt angreb på kongefløjen for øje.
opening.variation.alapin = Alapin-variant
opening.variation.alapin.def = Alapin-varianten
opening.variation.alapin.advanced = c3 forbereder d4 for at bygge et fuldt bondecentrum og gå uden om sicilianskens hovedteori; sort svarer med d5 eller springeren til f6.
opening.variation.alapin.advanced.spoken = se tre forbereder dé fire for at bygge et fuldt bondecentrum og gå uden om sicilianskens hovedteori; sort svarer med dé fem eller springeren til æf seks.
opening.variation.smith_morra = Smith-Morra-gambit
opening.variation.smith_morra.def = Smith-Morra-gambit
opening.variation.smith_morra.beginner = Hvid giver en bonde for at udvikle sig hurtigt og åbne linjer mod sorts konge: sort skal udvikle sig forsigtigt.
opening.variation.smith_morra.advanced = En bonde for hurtig udvikling og den åbne c-linje og d-linje; sort udvikler sig sundt og giver ofte bonden tilbage på det rigtige tidspunkt.
opening.variation.smith_morra.advanced.spoken = En bonde for hurtig udvikling og den åbne se-linje og dé-linje; sort udvikler sig sundt og giver ofte bonden tilbage på det rigtige tidspunkt.
opening.variation.grand_prix = Grand Prix-angreb
opening.variation.grand_prix.def = Grand Prix-angrebet
opening.variation.grand_prix.advanced = Hvid spiller springeren til c3 og f4 for et hurtigt angreb på kongefløjen med f5 og undgår dermed åben siciliansk.
opening.variation.grand_prix.advanced.spoken = Hvid spiller springeren til se tre og æf fire for et hurtigt angreb på kongefløjen med æf fem og undgår dermed åben siciliansk.
opening.variation.rossolimo = Rossolimo-variant
opening.variation.rossolimo.def = Rossolimo-varianten
opening.variation.rossolimo.advanced = Løberen på b5 binder springeren på c6 eller bytter sig af mod den for at give sort dobbeltbønder og holde partiet positionelt.
opening.variation.rossolimo.advanced.spoken = Løberen på be fem binder springeren på se seks eller bytter sig af mod den for at give sort dobbeltbønder og holde partiet positionelt.
opening.variation.najdorf = Najdorf-variant
opening.variation.najdorf.spoken = Najdorf-variant
opening.variation.najdorf.def = Najdorf-varianten
opening.variation.najdorf.def.spoken = Najdorf-varianten
opening.variation.najdorf.advanced = a6 giver den mest berømte variant af siciliansk: fleksibel og dyb, med strukturer med e5 eller e6 mod hvids skarpe angreb.
opening.variation.najdorf.advanced.spoken = a seks giver den mest berømte variant af siciliansk: fleksibel og dyb, med strukturer med é fem eller é seks mod hvids skarpe angreb.
opening.variation.dragon = Dragevariant
opening.variation.dragon.def = dragevarianten
opening.variation.dragon.advanced = Sort fianchetterer på g7; det jugoslaviske angreb fører til berømte kapløb mellem angreb på hver sin fløj.
opening.variation.dragon.advanced.spoken = Sort fianchetterer på ge syv; det jugoslaviske angreb fører til berømte kapløb mellem angreb på hver sin fløj.
opening.variation.accelerated_dragon = Accelereret drage
opening.variation.accelerated_dragon.def = den accelererede drage
opening.variation.accelerated_dragon.advanced = Sort fianchetterer før d6 for at kunne spille d5 i ét træk; Maróczy-opstillingen med c4 er hvids positionelle modgift.
opening.variation.accelerated_dragon.advanced.spoken = Sort fianchetterer før dé seks for at kunne spille dé fem i ét træk; Maróczy-opstillingen med se fire er hvids positionelle modgift.
opening.variation.scheveningen = Scheveningen-variant
opening.variation.scheveningen.spoken = Scheveningen-variant
opening.variation.scheveningen.def = Scheveningen-varianten
opening.variation.scheveningen.def.spoken = Scheveningen-varianten
opening.variation.scheveningen.advanced = Sort bygger det lille centrum med e6 og d6, en fleksibel defensiv skal; hvid angriber ofte med g4.
opening.variation.scheveningen.advanced.spoken = Sort bygger det lille centrum med é seks og dé seks, en fleksibel defensiv skal; hvid angriber ofte med ge fire.
opening.variation.sveshnikov = Svesjnikov-variant
opening.variation.sveshnikov.def = Svesjnikov-varianten
opening.variation.sveshnikov.advanced = Sort spiller e5 og accepterer et hul på d5 og en tilbageblevet d-bonde for aktivitet og løberparret: meget dynamisk.
opening.variation.sveshnikov.advanced.spoken = Sort spiller é fem og accepterer et hul på dé fem og en tilbageblevet dé-bonde for aktivitet og løberparret: meget dynamisk.
opening.variation.taimanov = Tajmanov-variant
opening.variation.taimanov.def = Tajmanov-varianten
opening.variation.taimanov.advanced = Sort kombinerer e6 og springeren på c6 med et fleksibelt a6 og dronningen på c7 og holder d6 i reserve.
opening.variation.taimanov.advanced.spoken = Sort kombinerer é seks og springeren på se seks med et fleksibelt a seks og dronningen på se syv og holder dé seks i reserve.
opening.variation.kan = Kan-variant
opening.variation.kan.def = Kan-varianten
opening.variation.kan.advanced = Sort spiller e6 og a6, lader springerne blive hjemme og går ofte efter en pindsvineopstilling.
opening.variation.kan.advanced.spoken = Sort spiller é seks og a seks, lader springerne blive hjemme og går ofte efter en pindsvineopstilling.
opening.variation.classical_sicilian = Klassisk variant
opening.variation.classical_sicilian.def = den klassiske variant
opening.variation.classical_sicilian.advanced = Sort udvikler begge springere og spiller d6; hvids vigtigste svar er Richter-Rauzer og Sozin.
opening.variation.classical_sicilian.advanced.spoken = Sort udvikler begge springere og spiller dé seks; hvids vigtigste svar er Richter-Rauzer og Sozin.
opening.variation.french_advance = Fremstødsvariant
opening.variation.french_advance.def = fremstødsvarianten
opening.variation.french_advance.advanced = Hvid låser centrum med e5 og vinder plads; sort angriber d4, kædens basis, med c5 og brikkerne.
opening.variation.french_advance.advanced.spoken = Hvid låser centrum med é fem og vinder plads; sort angriber dé fire, kædens basis, med se fem og brikkerne.
opening.variation.french_exchange = Afbytningsvariant
opening.variation.french_exchange.def = afbytningsvarianten
opening.variation.french_exchange.advanced = Bondeafbytningen på d5 udløser spændingen: en symmetrisk, rolig struktur hvor sorts hvidfeltede løber bliver befriet.
opening.variation.french_exchange.advanced.spoken = Bondeafbytningen på dé fem udløser spændingen: en symmetrisk, rolig struktur hvor sorts hvidfeltede løber bliver befriet.
opening.variation.french_tarrasch = Tarrasch-variant
opening.variation.french_tarrasch.def = Tarrasch-varianten
opening.variation.french_tarrasch.advanced = Springeren går til d2 for at undgå bindingen fra Winawer-varianten; sort accepterer ofte en isoleret d-bonde efter c5 eller låser centrum.
opening.variation.french_tarrasch.advanced.spoken = Springeren går til dé to for at undgå bindingen fra Winawer-varianten; sort accepterer ofte en isoleret dé-bonde efter se fem eller låser centrum.
opening.variation.winawer = Winawer-variant
opening.variation.winawer.spoken = Winawer-variant
opening.variation.winawer.def = Winawer-varianten
opening.variation.winawer.def.spoken = Winawer-varianten
opening.variation.winawer.advanced = Løberen på b4 binder springeren; sort giver som regel løber for springer, så hvid får dobbeltbønder, men også løberparret.
opening.variation.winawer.advanced.spoken = Løberen på be fire binder springeren; sort giver som regel løber for springer, så hvid får dobbeltbønder, men også løberparret.
opening.variation.french_classical = Klassisk variant
opening.variation.french_classical.def = den klassiske variant
opening.variation.french_classical.advanced = Sort udvikler springeren til f6; spillet drejer sig om bondekæden med e5 og bindingen med en løber på g5.
opening.variation.french_classical.advanced.spoken = Sort udvikler springeren til æf seks; spillet drejer sig om bondekæden med é fem og bindingen med en løber på ge fem.
opening.variation.french_rubinstein = Rubinstein-variant
opening.variation.french_rubinstein.def = Rubinstein-varianten
opening.variation.french_rubinstein.advanced = Sort slår på e4 og opgiver centrum for en solid, kompakt stilling med c5 som mål senere.
opening.variation.french_rubinstein.advanced.spoken = Sort slår på é fire og opgiver centrum for en solid, kompakt stilling med se fem som mål senere.
opening.variation.ck_advance = Fremstødsvariant
opening.variation.ck_advance.def = fremstødsvarianten
opening.variation.ck_advance.advanced = Hvid vinder plads med e5; sort udvikler løberen til f5 før e6 og kæmper imod med c5.
opening.variation.ck_advance.advanced.spoken = Hvid vinder plads med é fem; sort udvikler løberen til æf fem før é seks og kæmper imod med se fem.
opening.variation.ck_exchange = Afbytningsvariant
opening.variation.ck_exchange.def = afbytningsvarianten
opening.variation.ck_exchange.advanced = En Karlsbad-struktur med ombyttede farver: hvid opstiller sig på kongefløjen, og sort spiller for et minoritetsangreb på dronningefløjen.
opening.variation.ck_panov = Panov-angreb
opening.variation.ck_panov.def = Panov-angrebet
opening.variation.ck_panov.advanced = Hvid spiller c4 og accepterer en isoleret d-bonde til gengæld for aktive brikker og angrebschancer.
opening.variation.ck_panov.advanced.spoken = Hvid spiller se fire og accepterer en isoleret dé-bonde til gengæld for aktive brikker og angrebschancer.
opening.variation.ck_classical = Klassisk variant
opening.variation.ck_classical.def = den klassiske variant
opening.variation.ck_classical.advanced = Løberen kommer til f5 med tempo mod springeren; hvid vinder plads med h4 og h5, og modsat rokade er almindelig.
opening.variation.ck_classical.advanced.spoken = Løberen kommer til æf fem med tempo mod springeren; hvid vinder plads med hå fire og hå fem, og modsat rokade er almindelig.
opening.variation.ck_two_knights = Tospringerangreb
opening.variation.ck_two_knights.def = tospringerangrebet
opening.variation.ck_two_knights.advanced = Hvid udvikler begge springere før d4, holder sig fleksibel og undgår hovedvarianterne.
opening.variation.ck_two_knights.advanced.spoken = Hvid udvikler begge springere før dé fire, holder sig fleksibel og undgår hovedvarianterne.
opening.variation.two_knights = Tospringerforsvar
opening.variation.two_knights.def = tospringerforsvaret
opening.variation.two_knights.beginner = Sort går til modangreb på e4 med springeren i stedet for at efterligne hvid; pas på springerudfaldet til g5, som angriber f7.
opening.variation.two_knights.beginner.spoken = Sort går til modangreb på é fire med springeren i stedet for at efterligne hvid; pas på springerudfaldet til ge fem, som angriber æf syv.
opening.variation.two_knights.advanced = Sorts mest aktive svar på italiensk: det inviterer til det skarpe springerudfald til g5 eller det rolige d3.
opening.variation.two_knights.advanced.spoken = Sorts mest aktive svar på italiensk: det inviterer til det skarpe springerudfald til ge fem eller det rolige dé tre.
opening.variation.giuoco_piano = Giuoco Piano
opening.variation.giuoco_piano.spoken = Giuoco Piano
opening.variation.giuoco_piano.def = Giuoco Piano
opening.variation.giuoco_piano.def.spoken = Giuoco Piano
opening.variation.giuoco_piano.beginner = »Det stille spil« på italiensk: begge løbere sigter mod modstanderens f-bonde, og partiet udvikler sig roligt.
opening.variation.giuoco_piano.beginner.spoken = »Det stille spil« på italiensk: begge løbere sigter mod modstanderens æf-bonde, og partiet udvikler sig roligt.
opening.variation.giuoco_piano.advanced = Sorts løber spejler hvids; hvid vælger mellem spil i centrum med c3 og d4, det langsomme d3 eller Evans-gambit.
opening.variation.giuoco_piano.advanced.spoken = Sorts løber spejler hvids; hvid vælger mellem spil i centrum med se tre og dé fire, det langsomme dé tre eller Evans-gambit.
opening.variation.giuoco_pianissimo = Giuoco Pianissimo
opening.variation.giuoco_pianissimo.spoken = Giuoco Pianissimo
opening.variation.giuoco_pianissimo.def = Giuoco Pianissimo
opening.variation.giuoco_pianissimo.def.spoken = Giuoco Pianissimo
opening.variation.giuoco_pianissimo.advanced = Det moderne, langsomme italienske parti med d3, c3 og rokade: lange manøvrer og et udskudt brud med d4.
opening.variation.giuoco_pianissimo.advanced.spoken = Det moderne, langsomme italienske parti med dé tre, se tre og rokade: lange manøvrer og et udskudt brud med dé fire.
opening.variation.evans = Evans-gambit
opening.variation.evans.def = Evans-gambit
opening.variation.evans.advanced = b4 giver en bonde for at aflede løberen og hurtigt bygge et centrum med c3 og d4: meget skarpt og en yndlingsåbning i romantikkens tid.
opening.variation.evans.advanced.spoken = be fire giver en bonde for at aflede løberen og hurtigt bygge et centrum med se tre og dé fire: meget skarpt og en yndlingsåbning i romantikkens tid.
opening.variation.fried_liver = Fegatello-angreb
opening.variation.fried_liver.def = Fegatello-angrebet
opening.variation.fried_liver.beginner = Hvid ofrer springeren på f7 for at trække sorts konge ud i det fri: meget farligt hvis sort har slået på d5 med springeren.
opening.variation.fried_liver.beginner.spoken = Hvid ofrer springeren på æf syv for at trække sorts konge ud i det fri: meget farligt hvis sort har slået på dé fem med springeren.
opening.variation.fried_liver.advanced = Efter springerofret på f7 får hvid et voldsomt angreb; hovedvarianten undgår det ved at angribe løberen med springeren på a5.
opening.variation.fried_liver.advanced.spoken = Efter springerofret på æf syv får hvid et voldsomt angreb; hovedvarianten undgår det ved at angribe løberen med springeren på a fem.
opening.variation.traxler = Traxler-modangreb
opening.variation.traxler.def = Traxler-modangrebet
opening.variation.traxler.advanced = Sort ignorerer truslen mod f7 og angriber i stedet f2: vild taktik hvor præcis viden afgør sagen.
opening.variation.traxler.advanced.spoken = Sort ignorerer truslen mod æf syv og angriber i stedet æf to: vild taktik hvor præcis viden afgør sagen.
opening.variation.berlin = Berlinerforsvar
opening.variation.berlin.def = berlinerforsvaret
opening.variation.berlin.advanced = Springeren går til modangreb på e4; det berømte berlinerslutspil, hvor dronningerne tidligt er byttet af og sorts konge står i centrum, er ekstremt solidt.
opening.variation.berlin.advanced.spoken = Springeren går til modangreb på é fire; det berømte berlinerslutspil, hvor dronningerne tidligt er byttet af og sorts konge står i centrum, er ekstremt solidt.
opening.variation.morphy = Morphy-forsvar
opening.variation.morphy.def = Morphy-forsvaret
opening.variation.morphy.advanced = a6 stiller straks løberen spørgsmålet: indgangen til hovedvarianterne, lukket spansk, åben spansk og Marshall-angrebet.
opening.variation.morphy.advanced.spoken = a seks stiller straks løberen spørgsmålet: indgangen til hovedvarianterne, lukket spansk, åben spansk og Marshall-angrebet.
opening.variation.closed_ruy = Lukket spansk
opening.variation.closed_ruy.def = lukket spansk
opening.variation.closed_ruy.advanced = Den klassiske hovedvariant: langsomme manøvrer fra hvid mod sorts planer på dronningefløjen, som Breyer-, Zajtsev- eller Tjigorin-varianten.
opening.variation.marshall = Marshall-angreb
opening.variation.marshall.def = Marshall-angrebet
opening.variation.marshall.advanced = Sort ofrer en bonde med d5 for et varigt angreb på kongefløjen; angrebet er dybt analyseret og et respekteret remisvåben på topniveau.
opening.variation.marshall.advanced.spoken = Sort ofrer en bonde med dé fem for et varigt angreb på kongefløjen; angrebet er dybt analyseret og et respekteret remisvåben på topniveau.
opening.variation.ruy_exchange = Afbytningsvariant
opening.variation.ruy_exchange.def = afbytningsvarianten
opening.variation.ruy_exchange.advanced = Slaget på c6 giver sort løberparret, men dobbeltbønder; hvid går efter et slutspil med et sundt bondeflertal på kongefløjen.
opening.variation.ruy_exchange.advanced.spoken = Slaget på se seks giver sort løberparret, men dobbeltbønder; hvid går efter et slutspil med et sundt bondeflertal på kongefløjen.
opening.variation.ruy_open = Åben spansk
opening.variation.ruy_open.def = åben spansk
opening.variation.ruy_open.advanced = Sort slår bonden på e4 for at få aktivt brikspil; brikkerne er livlige, men e-linjen og bonden på d5 kræver omtanke.
opening.variation.ruy_open.advanced.spoken = Sort slår bonden på é fire for at få aktivt brikspil; brikkerne er livlige, men é-linjen og bonden på dé fem kræver omtanke.
opening.variation.schliemann = Schliemann-forsvar
opening.variation.schliemann.def = Schliemann-forsvaret
opening.variation.schliemann.advanced = f5 er en kongegambit med ombyttede farver: skarpt og risikabelt for begge sider.
opening.variation.schliemann.advanced.spoken = æf fem er en kongegambit med ombyttede farver: skarpt og risikabelt for begge sider.
opening.variation.scotch_gambit = Skotsk gambit
opening.variation.scotch_gambit.def = skotsk gambit
opening.variation.scotch_gambit.advanced = Hvid udvikler løberen til c4 i stedet for at slå tilbage på d4 og tilbyder en bonde for hurtig udvikling; det går ofte over i tospringerforsvaret.
opening.variation.scotch_gambit.advanced.spoken = Hvid udvikler løberen til se fire i stedet for at slå tilbage på dé fire og tilbyder en bonde for hurtig udvikling; det går ofte over i tospringerforsvaret.
opening.variation.vienna_gambit = Wienergambit
opening.variation.vienna_gambit.def = wienergambit
opening.variation.vienna_gambit.advanced = f4 i wienerpartiet, en kongegambit med springeren allerede på c3; sorts bedste svar er modstødet d5 i centrum.
opening.variation.vienna_gambit.advanced.spoken = æf fire i wienerpartiet, en kongegambit med springeren allerede på se tre; sorts bedste svar er modstødet dé fem i centrum.
opening.variation.stafford = Stafford-gambit
opening.variation.stafford.def = Stafford-gambit
opening.variation.stafford.beginner = En gambit fuld af fælder, populær på nettet: sort giver en bonde og håber at hvid falder for tricks mod f2 og e4.
opening.variation.stafford.beginner.spoken = En gambit fuld af fælder, populær på nettet: sort giver en bonde og håber at hvid falder for tricks mod æf to og é fire.
opening.variation.stafford.advanced = Sort får hurtig udvikling og fælder mod f2; med rolige træk beholder hvid simpelthen en ren merbonde.
opening.variation.stafford.advanced.spoken = Sort får hurtig udvikling og fælder mod æf to; med rolige træk beholder hvid simpelthen en ren merbonde.
opening.variation.wayward_queen = Parham-angreb
opening.variation.wayward_queen.def = Parham-angrebet
opening.variation.wayward_queen.beginner = Et tidligt dronningetogt mod f7, idéen bag skolematten: sort dækker med springeren og g6 og jager derefter dronningen med brikkerne.
opening.variation.wayward_queen.beginner.spoken = Et tidligt dronningetogt mod æf syv, idéen bag skolematten: sort dækker med springeren og ge seks og jager derefter dronningen med brikkerne.
opening.variation.wayward_queen.advanced = Det tidlige dronningetræk bryder reglerne for udvikling; sort vinder tid ved at jage dronningen rundt og bør komme bedst ud af det.
opening.variation.halloween = Halloween-gambit
opening.variation.halloween.def = Halloween-gambit
opening.variation.halloween.advanced = Hvid giver en springer for to bønder og et stort centrum: objektivt ukorrekt, men farligt i hurtige partier.
opening.variation.qgd_orthodox = Ortodoks forsvar
opening.variation.qgd_orthodox.def = ortodoks forsvar
opening.variation.qgd_orthodox.advanced = Den klassiske opstilling med løberen på e7, rokade og springeren på d7: solid, men passiv; befrielsen kommer med c5 eller e5.
opening.variation.qgd_orthodox.advanced.spoken = Den klassiske opstilling med løberen på é syv, rokade og springeren på dé syv: solid, men passiv; befrielsen kommer med se fem eller é fem.
opening.variation.qgd_exchange = Afbytningsvariant
opening.variation.qgd_exchange.def = afbytningsvarianten
opening.variation.qgd_exchange.advanced = Afbytningen på d5 skaber Karlsbad-strukturen; hvids klassiske plan er minoritetsangrebet med b4 og b5.
opening.variation.qgd_exchange.advanced.spoken = Afbytningen på dé fem skaber Karlsbad-strukturen; hvids klassiske plan er minoritetsangrebet med be fire og be fem.
opening.variation.semi_tarrasch = Semi-Tarrasch-forsvar
opening.variation.semi_tarrasch.def = Semi-Tarrasch-forsvaret
opening.variation.semi_tarrasch.advanced = Sort spiller c5 og slår tilbage på d5 med en brik og undgår dermed den isolerede bonde fra Tarrasch-forsvaret; hvid får et bevægeligt centrum.
opening.variation.semi_tarrasch.advanced.spoken = Sort spiller se fem og slår tilbage på dé fem med en brik og undgår dermed den isolerede bonde fra Tarrasch-forsvaret; hvid får et bevægeligt centrum.
opening.variation.meran = Meran-variant
opening.variation.meran.def = Meran-varianten
opening.variation.meran.advanced = Sort slår på c4 og vinder plads på dronningefløjen med b5 og tempo; spillet drejer sig om bruddet c5 og hvids fremstød til e5.
opening.variation.meran.advanced.spoken = Sort slår på se fire og vinder plads på dronningefløjen med be fem og tempo; spillet drejer sig om bruddet se fem og hvids fremstød til é fem.
opening.variation.kid_classical = Klassisk variant
opening.variation.kid_classical.def = den klassiske variant
opening.variation.kid_classical.advanced = Hvid udvikler roligt og rokerer; efter e5 og d5 begynder det berømte kapløb, hvid på dronningefløjen, sort på kongefløjen.
opening.variation.kid_classical.advanced.spoken = Hvid udvikler roligt og rokerer; efter é fem og dé fem begynder det berømte kapløb, hvid på dronningefløjen, sort på kongefløjen.
opening.variation.kid_samisch = Sämisch-variant
opening.variation.kid_samisch.spoken = Sämisch-variant
opening.variation.kid_samisch.def = Sämisch-varianten
opening.variation.kid_samisch.def.spoken = Sämisch-varianten
opening.variation.kid_samisch.advanced = f3 støtter e4 og forbereder en bondestorm på kongefløjen; sort svarer med c5, e5 eller en plan på dronningefløjen med b5.
opening.variation.kid_samisch.advanced.spoken = æf tre støtter é fire og forbereder en bondestorm på kongefløjen; sort svarer med se fem, é fem eller en plan på dronningefløjen med be fem.
opening.variation.kid_four_pawns = Firbondeangreb
opening.variation.kid_four_pawns.def = firbondeangrebet
opening.variation.kid_four_pawns.advanced = Hvid bygger en mur af bønder på c4, d4, e4 og f4; sort undergraver den straks med c5 og e6.
opening.variation.kid_four_pawns.advanced.spoken = Hvid bygger en mur af bønder på se fire, dé fire, é fire og æf fire; sort undergraver den straks med se fem og é seks.
opening.variation.kid_fianchetto = Fianchettovariant
opening.variation.kid_fianchetto.def = fianchettovarianten
opening.variation.kid_fianchetto.advanced = Fianchettoen på g2 dæmper sorts løber på g7, og partiet bliver mere positionelt.
opening.variation.kid_fianchetto.advanced.spoken = Fianchettoen på ge to dæmper sorts løber på ge syv, og partiet bliver mere positionelt.
opening.variation.nimzo_rubinstein = Rubinstein-variant
opening.variation.nimzo_rubinstein.def = Rubinstein-varianten
opening.variation.nimzo_rubinstein.advanced = e3 udvikler roligt og holder flere opstillinger i reserve: den mest populære måde at møde nimzoindisk på.
opening.variation.nimzo_rubinstein.advanced.spoken = é tre udvikler roligt og holder flere opstillinger i reserve: den mest populære måde at møde nimzoindisk på.
opening.variation.nimzo_classical = Klassisk variant
opening.variation.nimzo_classical.def = den klassiske variant
opening.variation.nimzo_classical.advanced = Dronningen går til c2 for at kunne slå tilbage på c3 uden dobbeltbønder; hvid får løberparret, sort hurtig udvikling.
opening.variation.nimzo_classical.advanced.spoken = Dronningen går til se to for at kunne slå tilbage på se tre uden dobbeltbønder; hvid får løberparret, sort hurtig udvikling.
opening.variation.nimzo_samisch = Sämisch-variant
opening.variation.nimzo_samisch.spoken = Sämisch-variant
opening.variation.nimzo_samisch.def = Sämisch-varianten
opening.variation.nimzo_samisch.def.spoken = Sämisch-varianten
opening.variation.nimzo_samisch.advanced = a3 tvinger straks afbytningen på c3: hvid accepterer dobbeltbønder for løberparret og et stort centrum.
opening.variation.nimzo_samisch.advanced.spoken = a tre tvinger straks afbytningen på se tre: hvid accepterer dobbeltbønder for løberparret og et stort centrum.
opening.variation.grunfeld_exchange = Afbytningsvariant
opening.variation.grunfeld_exchange.def = afbytningsvarianten
opening.variation.grunfeld_exchange.advanced = Hvid bygger et stort centrum med e4; sort angriber d4 med c5 og brikkerne, og slutspillene er ofte til fordel for sorts flertal på dronningefløjen.
opening.variation.grunfeld_exchange.advanced.spoken = Hvid bygger et stort centrum med é fire; sort angriber dé fire med se fem og brikkerne, og slutspillene er ofte til fordel for sorts flertal på dronningefløjen.
opening.variation.leningrad = Leningrad-variant
opening.variation.leningrad.def = Leningrad-varianten
opening.variation.leningrad.advanced = Sort fianchetterer på g7: en hollandsk i kongeindisk stil, hvor sort spiller for e5 og spil på kongefløjen.
opening.variation.leningrad.advanced.spoken = Sort fianchetterer på ge syv: en hollandsk i kongeindisk stil, hvor sort spiller for é fem og spil på kongefløjen.
opening.variation.stonewall_dutch = Stonewall-variant
opening.variation.stonewall_dutch.def = Stonewall-varianten
opening.variation.stonewall_dutch.advanced = Bønderne på c6, d5, e6 og f5 giver sort et klippefast greb om e4, men det koster et hul på e5 og en passiv hvidfeltet løber.
opening.variation.stonewall_dutch.advanced.spoken = Bønderne på se seks, dé fem, é seks og æf fem giver sort et klippefast greb om é fire, men det koster et hul på é fem og en passiv hvidfeltet løber.
opening.variation.modern_benoni = Moderne Benoni
opening.variation.modern_benoni.def = moderne Benoni
opening.variation.modern_benoni.advanced = Sort får et flertal på dronningefløjen mod hvids flertal i centrum; taktikken omkring e5 og løberen på g7 dominerer.
opening.variation.modern_benoni.advanced.spoken = Sort får et flertal på dronningefløjen mod hvids flertal i centrum; taktikken omkring é fem og løberen på ge syv dominerer.
opening.variation.catalan_open = Åben katalansk
opening.variation.catalan_open.def = åben katalansk
opening.variation.catalan_open.advanced = Sort slår bonden på c4; hvid vinder den tilbage og beholder presset på den lange diagonal, mens sort går efter c5 eller b5.
opening.variation.catalan_open.advanced.spoken = Sort slår bonden på se fire; hvid vinder den tilbage og beholder presset på den lange diagonal, mens sort går efter se fem eller be fem.
opening.variation.catalan_closed = Lukket katalansk
opening.variation.catalan_closed.def = lukket katalansk
opening.variation.catalan_closed.advanced = Sort beholder bonden på d5 i en kompakt opstilling: en langsom positionel kamp om de befriende brud e5 eller c5.
opening.variation.catalan_closed.advanced.spoken = Sort beholder bonden på dé fem i en kompakt opstilling: en langsom positionel kamp om de befriende brud é fem eller se fem.
opening.variation.english_symmetrical = Symmetrisk variant
opening.variation.english_symmetrical.def = den symmetriske variant
opening.variation.english_symmetrical.advanced = Sort kopierer hvid med c5: langsomt manøvrespil med fianchettoer og pres mod d4 og d5.
opening.variation.english_symmetrical.advanced.spoken = Sort kopierer hvid med se fem: langsomt manøvrespil med fianchettoer og pres mod dé fire og dé fem.
opening.variation.kings_english = Omvendt siciliansk
opening.variation.kings_english.def = omvendt siciliansk
opening.variation.kings_english.advanced = e5 gør engelsk til siciliansk med et ekstra tempo til hvid; typiske planer er en fianchetto og et fremstød på dronningefløjen.
opening.variation.kings_english.advanced.spoken = é fem gør engelsk til siciliansk med et ekstra tempo til hvid; typiske planer er en fianchetto og et fremstød på dronningefløjen.
opening.variation.alekhine_four_pawns = Firbondeangreb
opening.variation.alekhine_four_pawns.def = firbondeangrebet
opening.variation.alekhine_four_pawns.advanced = Hvid jager springeren med bønderne og bygger et enormt, men for vidt fremskudt centrum; sort går til modangreb med c5 og brikkerne.
opening.variation.alekhine_four_pawns.advanced.spoken = Hvid jager springeren med bønderne og bygger et enormt, men for vidt fremskudt centrum; sort går til modangreb med se fem og brikkerne.
opening.variation.alekhine_modern = Moderne variant
opening.variation.alekhine_modern.def = den moderne variant
opening.variation.alekhine_modern.advanced = Hvid beholder en solid pladsfordel uden at gå for vidt; sort binder springeren eller fianchetterer.
opening.variation.pirc_austrian = Østrigsk angreb
opening.variation.pirc_austrian.def = østrigsk angreb
opening.variation.pirc_austrian.advanced = f4 bygger et stort centrum med henblik på e5 eller et angreb på kongefløjen; sort går til modangreb med c5 eller e5.
opening.variation.pirc_austrian.advanced.spoken = æf fire bygger et stort centrum med henblik på é fem eller et angreb på kongefløjen; sort går til modangreb med se fem eller é fem.
opening.variation.falkbeer = Falkbeer-modgambit
opening.variation.falkbeer.def = Falkbeer-modgambit
opening.variation.falkbeer.advanced = d5 går til modangreb i centrum i stedet for at slå på f4; moderne praksis foretrækker først at slå på d5.
opening.variation.falkbeer.advanced.spoken = dé fem går til modangreb i centrum i stedet for at slå på æf fire; moderne praksis foretrækker først at slå på dé fem.

