opening.variation.traxler.advanced.spoken = Juodieji nekreipia dėmesio į grėsmę ef septyni ir patys smogia į ef du: laukinė taktika, kurioje lemia tikslios žinios.
opening.variation.berlin = Berlyno gynyba
opening.variation.berlin.def = Berlyno gynyba
