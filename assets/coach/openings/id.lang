opening.variation.grand_prix = Serangan Grand Prix
opening.variation.grand_prix.def = Serangan Grand Prix
opening.variation.grand_prix.advanced = Putih memainkan kuda ke c3 dan f4 untuk serangan cepat di sayap raja dengan f5, sambil menghindari Sisilia Terbuka.
opening.variation.grand_prix.advanced.spoken = Putih memainkan kuda ke ce tiga dan ef empat untuk serangan cepat di sayap raja dengan ef lima, sambil menghindari Sisilia Terbuka.
opening.variation.rossolimo = Varian Rossolimo
opening.variation.rossolimo.def = Varian Rossolimo
opening.variation.rossolimo.advanced = Gajah di b5 mengunci atau menukar kuda di c6 untuk memberi Hitam pion ganda dan menjaga permainan tetap posisional.
opening.variation.rossolimo.advanced.spoken = Gajah di be lima mengunci atau menukar kuda di ce enam untuk memberi Hitam pion ganda dan menjaga permainan tetap posisional.
opening.variation.najdorf = Varian Najdorf
opening.variation.najdorf.spoken = Varian Najdorf
opening.variation.najdorf.def = Varian Najdorf
opening.variation.najdorf.def.spoken = Varian Najdorf
opening.variation.najdorf.advanced = Langkah a6 menghasilkan varian Sisilia yang paling terkenal: fleksibel dan dalam, dengan struktur e5 atau e6 melawan serangan tajam Putih.
opening.variation.najdorf.advanced.spoken = Langkah a enam menghasilkan varian Sisilia yang paling terkenal: fleksibel dan dalam, dengan struktur e lima atau e enam melawan serangan tajam Putih.
opening.variation.dragon = Varian Naga
opening.variation.dragon.def = Varian Naga
opening.variation.dragon.advanced = Hitam melakukan fianchetto di g7; Serangan Yugoslavia menghasilkan adu cepat yang terkenal antara serangan di sayap yang berlawanan.
opening.variation.dragon.advanced.spoken = Hitam melakukan fianchetto di ge tujuh; Serangan Yugoslavia menghasilkan adu cepat yang terkenal antara serangan di sayap yang berlawanan.
opening.variation.accelerated_dragon = Varian Naga Dipercepat
opening.variation.accelerated_dragon.def = Varian Naga Dipercepat
opening.variation.accelerated_dragon.advanced = Hitam melakukan fianchetto sebelum d6 agar bisa memainkan d5 dalam satu langkah; formasi Maróczy dengan c4 adalah penangkal posisional dari Putih.
opening.variation.accelerated_dragon.advanced.spoken = Hitam melakukan fianchetto sebelum de enam agar bisa memainkan de lima dalam satu langkah; formasi Maróczy dengan ce empat adalah penangkal posisional dari Putih.
opening.variation.scheveningen = Varian Scheveningen
opening.variation.scheveningen.spoken = Varian Scheveningen
opening.variation.scheveningen.def = Varian Scheveningen
opening.variation.scheveningen.def.spoken = Varian Scheveningen
opening.variation.scheveningen.advanced = Hitam membangun pusat kecil dengan e6 dan d6, susunan bertahan yang fleksibel; Putih sering menyerang dengan g4.
opening.variation.scheveningen.advanced.spoken = Hitam membangun pusat kecil dengan e enam dan de enam, susunan bertahan yang fleksibel; Putih sering menyerang dengan ge empat.
opening.variation.sveshnikov = Varian Sveshnikov
opening.variation.sveshnikov.def = Varian Sveshnikov
opening.variation.sveshnikov.advanced = Hitam memainkan e5, menerima lubang di d5 dan pion d yang terbelakang demi aktivitas dan pasangan gajah: sangat dinamis.
opening.variation.sveshnikov.advanced.spoken = Hitam memainkan e lima, menerima lubang di de lima dan pion de yang terbelakang demi aktivitas dan pasangan gajah: sangat dinamis.
opening.variation.taimanov = Varian Taimanov
opening.variation.taimanov.def = Varian Taimanov
opening.variation.taimanov.advanced = Hitam memadukan e6 dan kuda di c6 dengan a6 yang fleksibel dan menteri di c7, sambil menyimpan d6 sebagai cadangan.
opening.variation.taimanov.advanced.spoken = Hitam memadukan e enam dan kuda di ce enam dengan a enam yang fleksibel dan menteri di ce tujuh, sambil menyimpan de enam sebagai cadangan.
opening.variation.kan = Varian Kan
opening.variation.kan.def = Varian Kan
opening.variation.kan.advanced = Hitam memainkan e6 dan a6, membiarkan kuda-kuda tetap di tempat, dan sering mengincar susunan Landak.
opening.variation.kan.advanced.spoken = Hitam memainkan e enam dan a enam, membiarkan kuda-kuda tetap di tempat, dan sering mengincar susunan Landak.
opening.variation.classical_sicilian = Varian Klasik
opening.variation.classical_sicilian.def = Varian Klasik
opening.variation.classical_sicilian.advanced = Hitam mengembangkan kedua kuda dan memainkan d6; jawaban utama Putih adalah Varian Richter-Rauzer dan Serangan Sozin.
opening.variation.classical_sicilian.advanced.spoken = Hitam mengembangkan kedua kuda dan memainkan de enam; jawaban utama Putih adalah Varian Richter-Rauzer dan Serangan Sozin.
opening.variation.french_advance = Varian Maju
opening.variation.french_advance.def = Varian Maju
opening.variation.french_advance.advanced = Putih menutup pusat dengan e5 dan merebut ruang; Hitam menyerang d4, pangkal rantai pion, dengan c5 dan buah-buahnya.
opening.variation.french_advance.advanced.spoken = Putih menutup pusat dengan e lima dan merebut ruang; Hitam menyerang de empat, pangkal rantai pion, dengan ce lima dan buah-buahnya.
opening.variation.french_exchange = Varian Pertukaran
opening.variation.french_exchange.def = Varian Pertukaran
opening.variation.french_exchange.advanced = Pertukaran pion di d5 meredakan ketegangan: struktur yang simetris dan tenang, dengan gajah petak putih milik Hitam yang kini bebas.
opening.variation.french_exchange.advanced.spoken = Pertukaran pion di de lima meredakan ketegangan: struktur yang simetris dan tenang, dengan gajah petak putih milik Hitam yang kini bebas.
opening.variation.french_tarrasch = Varian Tarrasch
opening.variation.french_tarrasch.def = Varian Tarrasch
opening.variation.french_tarrasch.advanced = Kuda pergi ke d2 untuk menghindari kuncian Varian Winawer; Hitam sering menerima pion d terisolasi setelah c5, atau menutup pusat.
opening.variation.french_tarrasch.advanced.spoken = Kuda pergi ke de dua untuk menghindari kuncian Varian Winawer; Hitam sering menerima pion de terisolasi setelah ce lima, atau menutup pusat.
opening.variation.winawer = Varian Winawer
opening.variation.winawer.spoken = Varian Winawer
opening.variation.winawer.def = Varian Winawer
opening.variation.winawer.def.spoken = Varian Winawer
opening.variation.winawer.advanced = Gajah di b4 mengunci kuda; Hitam biasanya menukar gajah dengan kuda, sehingga Putih mendapat pion ganda tetapi juga pasangan gajah.
opening.variation.winawer.advanced.spoken = Gajah di be empat mengunci kuda; Hitam biasanya menukar gajah dengan kuda, sehingga Putih mendapat pion ganda tetapi juga pasangan gajah.
opening.variation.french_classical = Varian Klasik
opening.variation.french_classical.def = Varian Klasik
opening.variation.french_classical.advanced = Hitam mengembangkan kuda ke f6; permainan berkisar pada rantai pion e5 dan kuncian oleh gajah di g5.
opening.variation.french_classical.advanced.spoken = Hitam mengembangkan kuda ke ef enam; permainan berkisar pada rantai pion e lima dan kuncian oleh gajah di ge lima.
opening.variation.french_rubinstein = Varian Rubinstein
opening.variation.french_rubinstein.def = Varian Rubinstein
opening.variation.french_rubinstein.advanced = Hitam memakan di e4 dan melepaskan pusat demi posisi yang kokoh dan rapat, dengan rencana memainkan c5 nanti.
opening.variation.french_rubinstein.advanced.spoken = Hitam memakan di e empat dan melepaskan pusat demi posisi yang kokoh dan rapat, dengan rencana memainkan ce lima nanti.
opening.variation.ck_advance = Varian Maju
opening.variation.ck_advance.def = Varian Maju
opening.variation.ck_advance.advanced = Putih merebut ruang dengan e5; Hitam mengembangkan gajah ke f5 sebelum e6 dan melawan balik dengan c5.
opening.variation.ck_advance.advanced.spoken = Putih merebut ruang dengan e lima; Hitam mengembangkan gajah ke ef lima sebelum e enam dan melawan balik dengan ce lima.
opening.variation.ck_exchange = Varian Pertukaran
opening.variation.ck_exchange.def = Varian Pertukaran
opening.variation.ck_exchange.advanced = Struktur Carlsbad dengan warna terbalik: Putih menyusun kekuatan di sayap raja, Hitam mengincar serangan minoritas di sayap menteri.
opening.variation.ck_panov = Serangan Panov
opening.variation.ck_panov.def = Serangan Panov
opening.variation.ck_panov.advanced = Putih memainkan c4 dan menerima pion d terisolasi sebagai ganti buah-buah yang aktif dan peluang menyerang.
opening.variation.ck_panov.advanced.spoken = Putih memainkan ce empat dan menerima pion de terisolasi sebagai ganti buah-buah yang aktif dan peluang menyerang.
opening.variation.ck_classical = Varian Klasik
opening.variation.ck_classical.def = Varian Klasik
opening.variation.ck_classical.advanced = Gajah datang ke f5 sambil mendapat tempo dengan menyerang kuda; Putih merebut ruang dengan h4 dan h5, dan rokade berlawanan arah sering terjadi.
opening.variation.ck_classical.advanced.spoken = Gajah datang ke ef lima sambil mendapat tempo dengan menyerang kuda; Putih merebut ruang dengan ha empat dan ha lima, dan rokade berlawanan arah sering terjadi.
opening.variation.ck_two_knights = Serangan Dua Kuda
opening.variation.ck_two_knights.def = Serangan Dua Kuda
opening.variation.ck_two_knights.advanced = Putih mengembangkan kedua kuda sebelum d4, tetap fleksibel dan menghindari varian-varian utama.
opening.variation.ck_two_knights.advanced.spoken = Putih mengembangkan kedua kuda sebelum de empat, tetap fleksibel dan menghindari varian-varian utama.
opening.variation.two_knights = Pertahanan Dua Kuda
opening.variation.two_knights.def = Pertahanan Dua Kuda
opening.variation.two_knights.beginner = Hitam balas menyerang e4 dengan kuda alih-alih meniru Putih; waspadai lompatan kuda ke g5 yang menyerang f7.
opening.variation.two_knights.beginner.spoken = Hitam balas menyerang e empat dengan kuda alih-alih meniru Putih; waspadai lompatan kuda ke ge lima yang menyerang ef tujuh.
opening.variation.two_knights.advanced = Jawaban paling aktif Hitam terhadap Pembukaan Italia, yang mengundang lompatan kuda yang tajam ke g5 atau d3 yang tenang.
opening.variation.two_knights.advanced.spoken = Jawaban paling aktif Hitam terhadap Pembukaan Italia, yang mengundang lompatan kuda yang tajam ke ge lima atau de tiga yang tenang.
opening.variation.giuoco_piano = Giuoco Piano
opening.variation.giuoco_piano.spoken = Giuoco Piano
opening.variation.giuoco_piano.def = Giuoco Piano
opening.variation.giuoco_piano.def.spoken = Giuoco Piano
opening.variation.giuoco_piano.beginner = Namanya berarti "permainan yang tenang" dalam bahasa Italia: kedua gajah mengincar pion f lawan, dan permainan berkembang dengan tenang.
opening.variation.giuoco_piano.beginner.spoken = Namanya berarti "permainan yang tenang" dalam bahasa Italia: kedua gajah mengincar pion ef lawan, dan permainan berkembang dengan tenang.
opening.variation.giuoco_piano.advanced = Gajah Hitam mencerminkan gajah Putih; Putih memilih antara permainan di pusat dengan c3 dan d4, d3 yang lambat, atau Gambit Evans.
opening.variation.giuoco_piano.advanced.spoken = Gajah Hitam mencerminkan gajah Putih; Putih memilih antara permainan di pusat dengan ce tiga dan de empat, de tiga yang lambat, atau Gambit Evans.
opening.variation.giuoco_pianissimo = Giuoco Pianissimo
opening.variation.giuoco_pianissimo.spoken = Giuoco Pianissimo
opening.variation.giuoco_pianissimo.def = Giuoco Pianissimo
opening.variation.giuoco_pianissimo.def.spoken = Giuoco Pianissimo
opening.variation.giuoco_pianissimo.advanced = Pembukaan Italia modern yang lambat dengan d3, c3, dan rokade: manuver panjang dan terobosan d4 yang ditunda.
opening.variation.giuoco_pianissimo.advanced.spoken = Pembukaan Italia modern yang lambat dengan de tiga, ce tiga, dan rokade: manuver panjang dan terobosan de empat yang ditunda.
opening.variation.evans = Gambit Evans
opening.variation.evans.def = Gambit Evans
opening.variation.evans.advanced = Langkah b4 memberikan satu pion untuk membelokkan gajah dan cepat membangun pusat dengan c3 dan d4: sangat tajam, favorit era romantis.
opening.variation.evans.advanced.spoken = Langkah be empat memberikan satu pion untuk membelokkan gajah dan cepat membangun pusat dengan ce tiga dan de empat: sangat tajam, favorit era romantis.
opening.variation.fried_liver = Serangan Fried Liver
opening.variation.fried_liver.def = Serangan Fried Liver
opening.variation.fried_liver.beginner = Putih mengorbankan kuda di f7 untuk menyeret raja Hitam ke tempat terbuka: sangat berbahaya jika Hitam sudah memakan di d5 dengan kuda.
opening.variation.fried_liver.beginner.spoken = Putih mengorbankan kuda di ef tujuh untuk menyeret raja Hitam ke tempat terbuka: sangat berbahaya jika Hitam sudah memakan di de lima dengan kuda.
opening.variation.fried_liver.advanced = Setelah pengorbanan kuda di f7, Putih mendapat serangan yang ganas; jalur utama menghindarinya dengan menyerang gajah memakai kuda di a5.
opening.variation.fried_liver.advanced.spoken = Setelah pengorbanan kuda di ef tujuh, Putih mendapat serangan yang ganas; jalur utama menghindarinya dengan menyerang gajah memakai kuda di a lima.
opening.variation.traxler = Serangan Balik Traxler
opening.variation.traxler.def = Serangan Balik Traxler
opening.variation.traxler.advanced = Hitam mengabaikan ancaman terhadap f7 dan justru menyerang f2: taktik liar, dan pengetahuan yang tepat menjadi penentu.
opening.variation.traxler.advanced.spoken = Hitam mengabaikan ancaman terhadap ef tujuh dan justru menyerang ef dua: taktik liar, dan pengetahuan yang tepat menjadi penentu.
opening.variation.berlin = Pertahanan Berlin
opening.variation.berlin.def = Pertahanan Berlin
opening.variation.berlin.advanced = Kuda balas menyerang e4; permainan akhir Berlin yang terkenal, dengan menteri-menteri ditukar sejak dini dan raja Hitam di tengah, sangat kokoh.
opening.variation.berlin.advanced.spoken = Kuda balas menyerang e empat; permainan akhir Berlin yang terkenal, dengan menteri-menteri ditukar sejak dini dan raja Hitam di tengah, sangat kokoh.
opening.variation.morphy = Pertahanan Morphy
opening.variation.morphy.def = Pertahanan Morphy
opening.variation.morphy.advanced = Langkah a6 langsung menantang gajah: pintu masuk ke jalur-jalur utama, yaitu Ruy Lopez Tertutup, Varian Terbuka, dan Serangan Marshall.
opening.variation.morphy.advanced.spoken = Langkah a enam langsung menantang gajah: pintu masuk ke jalur-jalur utama, yaitu Ruy Lopez Tertutup, Varian Terbuka, dan Serangan Marshall.
opening.variation.closed_ruy = Ruy Lopez Tertutup
opening.variation.closed_ruy.def = Ruy Lopez Tertutup
opening.variation.closed_ruy.advanced = Jalur utama klasik: manuver lambat Putih melawan rencana Hitam di sayap menteri, seperti Varian Breyer, Zaitsev, atau Chigorin.
opening.variation.marshall = Serangan Marshall
opening.variation.marshall.def = Serangan Marshall
opening.variation.marshall.advanced = Hitam mengorbankan satu pion dengan d5 demi serangan jangka panjang di sayap raja; setelah dianalisis secara mendalam, varian ini menjadi senjata remis yang disegani di level tertinggi.
opening.variation.marshall.advanced.spoken = Hitam mengorbankan satu pion dengan de lima demi serangan jangka panjang di sayap raja; setelah dianalisis secara mendalam, varian ini menjadi senjata remis yang disegani di level tertinggi.
opening.variation.ruy_exchange = Varian Pertukaran
opening.variation.ruy_exchange.def = Varian Pertukaran
opening.variation.ruy_exchange.advanced = Memakan di c6 memberi Hitam pasangan gajah, tetapi juga pion ganda; Putih mengincar permainan akhir dengan mayoritas pion yang sehat di sayap raja.
opening.variation.ruy_exchange.advanced.spoken = Memakan di ce enam memberi Hitam pasangan gajah, tetapi juga pion ganda; Putih mengincar permainan akhir dengan mayoritas pion yang sehat di sayap raja.
opening.variation.ruy_open = Varian Terbuka
opening.variation.ruy_open.def = Varian Terbuka
opening.variation.ruy_open.advanced = Hitam memakan pion e4 demi permainan buah yang aktif; buah-buahnya lincah, tetapi lajur e dan pion d5 perlu diperhatikan.
opening.variation.ruy_open.advanced.spoken = Hitam memakan pion e empat demi permainan buah yang aktif; buah-buahnya lincah, tetapi lajur e dan pion de lima perlu diperhatikan.
opening.variation.schliemann = Pertahanan Schliemann
opening.variation.schliemann.def = Pertahanan Schliemann
opening.variation.schliemann.advanced = Langkah f5 adalah Gambit Raja dengan warna terbalik: tajam dan berisiko bagi kedua pihak.
opening.variation.schliemann.advanced.spoken = Langkah ef lima adalah Gambit Raja dengan warna terbalik: tajam dan berisiko bagi kedua pihak.
opening.variation.scotch_gambit = Gambit Skotlandia
opening.variation.scotch_gambit.def = Gambit Skotlandia
opening.variation.scotch_gambit.advanced = Putih mengembangkan gajah ke c4 alih-alih memakan kembali di d4, dan menawarkan satu pion demi pengembangan cepat; varian ini sering bertransposisi ke Pertahanan Dua Kuda.
opening.variation.scotch_gambit.advanced.spoken = Putih mengembangkan gajah ke ce empat alih-alih memakan kembali di de empat, dan menawarkan satu pion demi pengembangan cepat; varian ini sering bertransposisi ke Pertahanan Dua Kuda.
opening.variation.vienna_gambit = Gambit Wina
opening.variation.vienna_gambit.def = Gambit Wina
opening.variation.vienna_gambit.advanced = Langkah f4 dalam Pembukaan Wina, yaitu Gambit Raja dengan kuda yang sudah berada di c3; jawaban terbaik Hitam adalah serangan balik di pusat dengan d5.
opening.variation.vienna_gambit.advanced.spoken = Langkah ef empat dalam Pembukaan Wina, yaitu Gambit Raja dengan kuda yang sudah berada di ce tiga; jawaban terbaik Hitam adalah serangan balik di pusat dengan de lima.
opening.variation.stafford = Gambit Stafford
opening.variation.stafford.def = Gambit Stafford
opening.variation.stafford.beginner = Gambit penuh jebakan yang populer di catur daring: Hitam memberikan satu pion dan berharap Putih terjebak trik terhadap f2 dan e4.
opening.variation.stafford.beginner.spoken = Gambit penuh jebakan yang populer di catur daring: Hitam memberikan satu pion dan berharap Putih terjebak trik terhadap ef dua dan e empat.
opening.variation.stafford.advanced = Hitam mendapat pengembangan cepat dan jebakan terhadap f2; dengan langkah-langkah tenang, Putih tetap unggul satu pion bersih.
opening.variation.stafford.advanced.spoken = Hitam mendapat pengembangan cepat dan jebakan terhadap ef dua; dengan langkah-langkah tenang, Putih tetap unggul satu pion bersih.
opening.variation.wayward_queen = Serangan Parham
opening.variation.wayward_queen.def = Serangan Parham
opening.variation.wayward_queen.beginner = Serbuan menteri yang dini ke arah f7, ide skakmat empat langkah: Hitam bertahan dengan kuda dan g6, lalu mengusir menteri dengan buah-buahnya.
opening.variation.wayward_queen.beginner.spoken = Serbuan menteri yang dini ke arah ef tujuh, ide skakmat empat langkah: Hitam bertahan dengan kuda dan ge enam, lalu mengusir menteri dengan buah-buahnya.
opening.variation.wayward_queen.advanced = Langkah menteri yang terlalu dini melanggar aturan pengembangan buah; Hitam mendapat tempo dengan terus mengusik menteri dan semestinya keluar dengan posisi lebih baik.
opening.variation.halloween = Gambit Halloween
opening.variation.halloween.def = Gambit Halloween
opening.variation.halloween.advanced = Putih memberikan kuda demi dua pion dan pusat yang besar: secara objektif tidak sehat, tetapi berbahaya dalam permainan cepat.
opening.variation.qgd_orthodox = Pertahanan Ortodoks
opening.variation.qgd_orthodox.def = Pertahanan Ortodoks
opening.variation.qgd_orthodox.advanced = Susunan klasik dengan gajah di e7, rokade, dan kuda di d7: kokoh tetapi pasif, dan dibebaskan dengan c5 atau e5.
opening.variation.qgd_orthodox.advanced.spoken = Susunan klasik dengan gajah di e tujuh, rokade, dan kuda di de tujuh: kokoh tetapi pasif, dan dibebaskan dengan ce lima atau e lima.
opening.variation.qgd_exchange = Varian Pertukaran
opening.variation.qgd_exchange.def = Varian Pertukaran
opening.variation.qgd_exchange.advanced = Pertukaran di d5 menciptakan struktur Carlsbad; rencana klasik Putih adalah serangan minoritas dengan b4 dan b5.
opening.variation.qgd_exchange.advanced.spoken = Pertukaran di de lima menciptakan struktur Carlsbad; rencana klasik Putih adalah serangan minoritas dengan be empat dan be lima.
opening.variation.semi_tarrasch = Pertahanan Semi-Tarrasch
opening.variation.semi_tarrasch.def = Pertahanan Semi-Tarrasch
opening.variation.semi_tarrasch.advanced = Hitam memainkan c5 dan memakan kembali di d5 dengan buah, sehingga terhindar dari pion terisolasi Pertahanan Tarrasch; Putih mendapat pusat pion yang leluasa bergerak.
opening.variation.semi_tarrasch.advanced.spoken = Hitam memainkan ce lima dan memakan kembali di de lima dengan buah, sehingga terhindar dari pion terisolasi Pertahanan Tarrasch; Putih mendapat pusat pion yang leluasa bergerak.
opening.variation.meran = Varian Meran
opening.variation.meran.def = Varian Meran
opening.variation.meran.advanced = Hitam memakan di c4 dan merebut ruang di sayap menteri dengan b5 sambil mendapat tempo; permainan berkisar pada terobosan c5 dan dorongan Putih ke e5.
opening.variation.meran.advanced.spoken = Hitam memakan di ce empat dan merebut ruang di sayap menteri dengan be lima sambil mendapat tempo; permainan berkisar pada terobosan ce lima dan dorongan Putih ke e lima.
opening.variation.kid_classical = Varian Klasik
opening.variation.kid_classical.def = Varian Klasik
opening.variation.kid_classical.advanced = Putih mengembangkan buah dengan tenang dan melakukan rokade; setelah e5 dan d5, dimulailah adu cepat yang terkenal: Putih di sayap menteri, Hitam di sayap raja.
opening.variation.kid_classical.advanced.spoken = Putih mengembangkan buah dengan tenang dan melakukan rokade; setelah e lima dan de lima, dimulailah adu cepat yang terkenal: Putih di sayap menteri, Hitam di sayap raja.
opening.variation.kid_samisch = Varian Sämisch
opening.variation.kid_samisch.spoken = Varian Sämisch
opening.variation.kid_samisch.def = Varian Sämisch
opening.variation.kid_samisch.def.spoken = Varian Sämisch
opening.variation.kid_samisch.advanced = Langkah f3 menopang e4 dan menyiapkan serbuan pion di sayap raja; Hitam menjawab dengan c5, e5, atau rencana di sayap menteri dengan b5.
opening.variation.kid_samisch.advanced.spoken = Langkah ef tiga menopang e empat dan menyiapkan serbuan pion di sayap raja; Hitam menjawab dengan ce lima, e lima, atau rencana di sayap menteri dengan be lima.
opening.variation.kid_four_pawns = Serangan Empat Pion
opening.variation.kid_four_pawns.def = Serangan Empat Pion
opening.variation.kid_four_pawns.advanced = Putih membangun tembok pion di c4, d4, e4, dan f4; Hitam langsung menggerogotinya dengan c5 dan e6.
opening.variation.kid_four_pawns.advanced.spoken = Putih membangun tembok pion di ce empat, de empat, e empat, dan ef empat; Hitam langsung menggerogotinya dengan ce lima dan e enam.
opening.variation.kid_fianchetto = Varian Fianchetto
opening.variation.kid_fianchetto.def = Varian Fianchetto
opening.variation.kid_fianchetto.advanced = Fianchetto di g2 menumpulkan gajah Hitam di g7, dan permainan menjadi lebih posisional.
opening.variation.kid_fianchetto.advanced.spoken = Fianchetto di ge dua menumpulkan gajah Hitam di ge tujuh, dan permainan menjadi lebih posisional.
opening.variation.nimzo_rubinstein = Varian Rubinstein
opening.variation.nimzo_rubinstein.def = Varian Rubinstein
opening.variation.nimzo_rubinstein.advanced = Langkah e3 mengembangkan buah dengan tenang dan menyimpan beberapa susunan sebagai cadangan: cara paling populer menghadapi Pertahanan Nimzo-India.
opening.variation.nimzo_rubinstein.advanced.spoken = Langkah e tiga mengembangkan buah dengan tenang dan menyimpan beberapa susunan sebagai cadangan: cara paling populer menghadapi Pertahanan Nimzo-India.
opening.variation.nimzo_classical = Varian Klasik
opening.variation.nimzo_classical.def = Varian Klasik
opening.variation.nimzo_classical.advanced = Menteri pergi ke c2 agar bisa memakan kembali di c3 tanpa pion ganda; Putih mendapat pasangan gajah, Hitam mendapat pengembangan yang cepat.
opening.variation.nimzo_classical.advanced.spoken = Menteri pergi ke ce dua agar bisa memakan kembali di ce tiga tanpa pion ganda; Putih mendapat pasangan gajah, Hitam mendapat pengembangan yang cepat.
opening.variation.nimzo_samisch = Varian Sämisch
opening.variation.nimzo_samisch.spoken = Varian Sämisch
opening.variation.nimzo_samisch.def = Varian Sämisch
opening.variation.nimzo_samisch.def.spoken = Varian Sämisch
opening.variation.nimzo_samisch.advanced = Langkah a3 langsung memaksa pertukaran di c3: Putih menerima pion ganda demi pasangan gajah dan pusat yang besar.
opening.variation.nimzo_samisch.advanced.spoken = Langkah a tiga langsung memaksa pertukaran di ce tiga: Putih menerima pion ganda demi pasangan gajah dan pusat yang besar.
opening.variation.grunfeld_exchange = Varian Pertukaran
opening.variation.grunfeld_exchange.def = Varian Pertukaran
opening.variation.grunfeld_exchange.advanced = Putih membangun pusat yang besar dengan e4; Hitam menyerang d4 dengan c5 dan buah-buahnya, dan permainan akhir sering menguntungkan mayoritas pion Hitam di sayap menteri.
opening.variation.grunfeld_exchange.advanced.spoken = Putih membangun pusat yang besar dengan e empat; Hitam menyerang de empat dengan ce lima dan buah-buahnya, dan permainan akhir sering menguntungkan mayoritas pion Hitam di sayap menteri.
opening.variation.leningrad = Varian Leningrad
opening.variation.leningrad.def = Varian Leningrad
opening.variation.leningrad.advanced = Hitam melakukan fianchetto di g7: Pertahanan Belanda ala India Raja, dengan Hitam mengincar e5 dan permainan di sayap raja.
opening.variation.leningrad.advanced.spoken = Hitam melakukan fianchetto di ge tujuh: Pertahanan Belanda ala India Raja, dengan Hitam mengincar e lima dan permainan di sayap raja.
opening.variation.stonewall_dutch = Varian Stonewall
opening.variation.stonewall_dutch.def = Varian Stonewall
opening.variation.stonewall_dutch.advanced = Pion di c6, d5, e6, dan f5 memberi Hitam cengkeraman yang sangat kokoh atas e4, meski harus menanggung lubang di e5 dan gajah petak putih yang pasif.
opening.variation.stonewall_dutch.advanced.spoken = Pion di ce enam, de lima, e enam, dan ef lima memberi Hitam cengkeraman yang sangat kokoh atas e empat, meski harus menanggung lubang di e lima dan gajah petak putih yang pasif.
opening.variation.modern_benoni = Benoni Modern
opening.variation.modern_benoni.def = Benoni Modern
opening.variation.modern_benoni.advanced = Hitam mendapat mayoritas pion di sayap menteri melawan mayoritas Putih di pusat; taktik seputar e5 dan gajah di g7 mendominasi.
opening.variation.modern_benoni.advanced.spoken = Hitam mendapat mayoritas pion di sayap menteri melawan mayoritas Putih di pusat; taktik seputar e lima dan gajah di ge tujuh mendominasi.
opening.variation.catalan_open = Katalan Terbuka
opening.variation.catalan_open.def = Katalan Terbuka
opening.variation.catalan_open.advanced = Hitam memakan pion c4; Putih merebutnya kembali dan mempertahankan tekanan di diagonal panjang, sementara Hitam mengincar c5 atau b5.
opening.variation.catalan_open.advanced.spoken = Hitam memakan pion ce empat; Putih merebutnya kembali dan mempertahankan tekanan di diagonal panjang, sementara Hitam mengincar ce lima atau be lima.
opening.variation.catalan_closed = Katalan Tertutup
opening.variation.catalan_closed.def = Katalan Tertutup
opening.variation.catalan_closed.advanced = Hitam mempertahankan pion di d5 dengan susunan yang rapat: pertarungan posisional yang lambat seputar terobosan pembebasan e5 atau c5.
opening.variation.catalan_closed.advanced.spoken = Hitam mempertahankan pion di de lima dengan susunan yang rapat: pertarungan posisional yang lambat seputar terobosan pembebasan e lima atau ce lima.
opening.variation.english_symmetrical = Varian Simetris
opening.variation.english_symmetrical.def = Varian Simetris
opening.variation.english_symmetrical.advanced = Hitam meniru Putih dengan c5: manuver lambat dengan fianchetto dan tekanan pada d4 dan d5.
opening.variation.english_symmetrical.advanced.spoken = Hitam meniru Putih dengan ce lima: manuver lambat dengan fianchetto dan tekanan pada de empat dan de lima.
opening.variation.kings_english = Sisilia Terbalik
opening.variation.kings_english.def = Sisilia Terbalik
opening.variation.kings_english.advanced = Langkah e5 mengubah Pembukaan Inggris menjadi Pertahanan Sisilia dengan satu tempo ekstra bagi Putih; rencana khasnya adalah fianchetto dan dorongan di sayap menteri.
opening.variation.kings_english.advanced.spoken = Langkah e lima mengubah Pembukaan Inggris menjadi Pertahanan Sisilia dengan satu tempo ekstra bagi Putih; rencana khasnya adalah fianchetto dan dorongan di sayap menteri.
opening.variation.alekhine_four_pawns = Serangan Empat Pion
opening.variation.alekhine_four_pawns.def = Serangan Empat Pion
opening.variation.alekhine_four_pawns.advanced = Putih mengusir kuda dengan pion-pion dan membangun pusat yang sangat besar, tetapi terlalu maju; Hitam melawan dengan c5 dan buah-buahnya.
opening.variation.alekhine_four_pawns.advanced.spoken = Putih mengusir kuda dengan pion-pion dan membangun pusat yang sangat besar, tetapi terlalu maju; Hitam melawan dengan ce lima dan buah-buahnya.
opening.variation.alekhine_modern = Varian Modern
opening.variation.alekhine_modern.def = Varian Modern
opening.variation.alekhine_modern.advanced = Putih mempertahankan keunggulan ruang yang kokoh tanpa maju terlalu jauh; Hitam mengunci kuda atau melakukan fianchetto.
opening.variation.pirc_austrian = Serangan Austria
opening.variation.pirc_austrian.def = Serangan Austria
opening.variation.pirc_austrian.advanced = Langkah f4 membangun pusat yang besar untuk e5 atau serangan di sayap raja; Hitam membalas dengan c5 atau e5.
opening.variation.pirc_austrian.advanced.spoken = Langkah ef empat membangun pusat yang besar untuk e lima atau serangan di sayap raja; Hitam membalas dengan ce lima atau e lima.
opening.variation.falkbeer = Gambit Balasan Falkbeer
opening.variation.falkbeer.def = Gambit Balasan Falkbeer
opening.variation.falkbeer.advanced = Langkah d5 menyerang balik di pusat alih-alih memakan di f4; praktik modern lebih memilih memakan di d5 terlebih dahulu.
opening.variation.falkbeer.advanced.spoken = Langkah de lima menyerang balik di pusat alih-alih memakan di ef empat; praktik modern lebih memilih memakan di de lima terlebih dahulu.

