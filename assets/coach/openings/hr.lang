opening.variation.kid_samisch.def.spoken = Sämischova varijanta
opening.variation.kid_samisch.advanced = Potez f3 podupire e4 i priprema pješački juriš na kraljevom krilu; crni odgovara s c5, e5 ili planom na daminom krilu s b5.
opening.variation.kid_samisch.advanced.spoken = Potez ef tri podupire e četiri i priprema pješački juriš na kraljevom krilu; crni odgovara s ce pet, e pet ili planom na daminom krilu s be pet.
opening.variation.kid_four_pawns = Napad četiri pješaka
opening.variation.kid_four_pawns.def = napad četiri pješaka
opening.variation.kid_four_pawns.advanced = Bijeli gradi zid od pješaka na c4, d4, e4 i f4; crni ga odmah potkopava potezima c5 i e6.
opening.variation.kid_four_pawns.advanced.spoken = Bijeli gradi zid od pješaka na ce četiri, de četiri, e četiri i ef četiri; crni ga odmah potkopava potezima ce pet i e šest.
opening.variation.kid_fianchetto = Varijanta s fijanketom
opening.variation.kid_fianchetto.def = varijanta s fijanketom
opening.variation.kid_fianchetto.advanced = Fijanketo na g2 otupljuje lovca crnog na g7, a igra postaje pozicijskija.
opening.variation.kid_fianchetto.advanced.spoken = Fijanketo na ge dva otupljuje lovca crnog na ge sedam, a igra postaje pozicijskija.
opening.variation.nimzo_rubinstein = Rubinsteinova varijanta
opening.variation.nimzo_rubinstein.def = Rubinsteinova varijanta
opening.variation.nimzo_rubinstein.advanced = Potez e3 omogućuje miran razvoj i drži nekoliko postava u rezervi: najpopularniji način igre protiv nimzoindijske obrane.
opening.variation.nimzo_rubinstein.advanced.spoken = Potez e tri omogućuje miran razvoj i drži nekoliko postava u rezervi: najpopularniji način igre protiv nimzoindijske obrane.
opening.variation.nimzo_classical = Klasična varijanta
opening.variation.nimzo_classical.def = klasična varijanta
opening.variation.nimzo_classical.advanced = Dama odlazi na c2 kako bi na c3 uzela natrag bez dvostrukih pješaka; bijeli dobiva par lovaca, a crni brz razvoj.
opening.variation.nimzo_classical.advanced.spoken = Dama odlazi na ce dva kako bi na ce tri uzela natrag bez dvostrukih pješaka; bijeli dobiva par lovaca, a crni brz razvoj.
opening.variation.nimzo_samisch = Sämischova varijanta
opening.variation.nimzo_samisch.spoken = Sämischova varijanta
opening.variation.nimzo_samisch.def = Sämischova varijanta
opening.variation.nimzo_samisch.def.spoken = Sämischova varijanta
opening.variation.nimzo_samisch.advanced = Potez a3 odmah iznuđuje zamjenu na c3: bijeli prihvaća dvostruke pješake za par lovaca i velik centar.
opening.variation.nimzo_samisch.advanced.spoken = Potez a tri odmah iznuđuje zamjenu na ce tri: bijeli prihvaća dvostruke pješake za par lovaca i velik centar.
opening.variation.grunfeld_exchange = Varijanta zamjene
opening.variation.grunfeld_exchange.def = varijanta zamjene
opening.variation.grunfeld_exchange.advanced = Bijeli potezom e4 gradi velik centar; crni napada d4 potezom c5 i figurama, a završnice često idu u prilog većini crnog na daminom krilu.
opening.variation.grunfeld_exchange.advanced.spoken = Bijeli potezom e četiri gradi velik centar; crni napada de četiri potezom ce pet i figurama, a završnice često idu u prilog većini crnog na daminom krilu.
opening.variation.leningrad = Lenjingradska varijanta
opening.variation.leningrad.def = lenjingradska varijanta
opening.variation.leningrad.advanced = Crni postavlja lovca u fijanketo na g7: nizozemska obrana u stilu kraljeve indijske, u kojoj crni teži potezu e5 i igri na kraljevom krilu.
opening.variation.leningrad.advanced.spoken = Crni postavlja lovca u fijanketo na ge sedam: nizozemska obrana u stilu kraljeve indijske, u kojoj crni teži potezu e pet i igri na kraljevom krilu.
opening.variation.stonewall_dutch = Stonewall varijanta
opening.variation.stonewall_dutch.def = Stonewall varijanta
opening.variation.stonewall_dutch.advanced = Pješaci na c6, d5, e6 i f5 daju crnom nadzor nad e4 čvrst poput stijene, ali po cijenu rupe na e5 i pasivnog bjelopoljnog lovca.
opening.variation.stonewall_dutch.advanced.spoken = Pješaci na ce šest, de pet, e šest i ef pet daju crnom nadzor nad e četiri čvrst poput stijene, ali po cijenu rupe na e pet i pasivnog bjelopoljnog lovca.
opening.variation.modern_benoni = Moderna Benoni obrana
opening.variation.modern_benoni.def = moderna Benoni obrana
opening.variation.modern_benoni.advanced = Crni dobiva većinu na daminom krilu protiv većine bijelog u centru; prevladava taktika oko e5 i lovca na g7.
opening.variation.modern_benoni.advanced.spoken = Crni dobiva većinu na daminom krilu protiv većine bijelog u centru; prevladava taktika oko e pet i lovca na ge sedam.
opening.variation.catalan_open = Otvorena varijanta katalonskog otvaranja
opening.variation.catalan_open.def = otvorena varijanta katalonskog otvaranja
opening.variation.catalan_open.advanced = Crni uzima pješaka na c4; bijeli ga osvaja natrag i zadržava pritisak po dugoj dijagonali, a crni teži potezu c5 ili b5.
opening.variation.catalan_open.advanced.spoken = Crni uzima pješaka na ce četiri; bijeli ga osvaja natrag i zadržava pritisak po dugoj dijagonali, a crni teži potezu ce pet ili be pet.
opening.variation.catalan_closed = Zatvorena varijanta katalonskog otvaranja
opening.variation.catalan_closed.def = zatvorena varijanta katalonskog otvaranja
opening.variation.catalan_closed.advanced = Crni zbijenom postavom zadržava pješaka na d5: spora pozicijska borba oko oslobađajućih proboja e5 ili c5.
opening.variation.catalan_closed.advanced.spoken = Crni zbijenom postavom zadržava pješaka na de pet: spora pozicijska borba oko oslobađajućih proboja e pet ili ce pet.
opening.variation.english_symmetrical = Simetrična varijanta
opening.variation.english_symmetrical.def = simetrična varijanta
opening.variation.english_symmetrical.advanced = Crni potezom c5 kopira bijelog: spori manevri s fijanketima i pritisak na d4 i d5.
opening.variation.english_symmetrical.advanced.spoken = Crni potezom ce pet kopira bijelog: spori manevri s fijanketima i pritisak na de četiri i de pet.
opening.variation.kings_english = Sicilijanska obrana s obrnutim bojama
opening.variation.kings_english.def = sicilijanska obrana s obrnutim bojama
opening.variation.kings_english.advanced = Potez e5 pretvara englesko otvaranje u sicilijansku obranu s tempom više za bijelog; tipični su planovi fijanketo i prodor na daminom krilu.
opening.variation.kings_english.advanced.spoken = Potez e pet pretvara englesko otvaranje u sicilijansku obranu s tempom više za bijelog; tipični su planovi fijanketo i prodor na daminom krilu.
opening.variation.alekhine_four_pawns = Napad četiri pješaka
opening.variation.alekhine_four_pawns.def = napad četiri pješaka
opening.variation.alekhine_four_pawns.advanced = Bijeli pješacima tjera skakača i gradi golem, ali previše isturen centar; crni uzvraća potezom c5 i figurama.
opening.variation.alekhine_four_pawns.advanced.spoken = Bijeli pješacima tjera skakača i gradi golem, ali previše isturen centar; crni uzvraća potezom ce pet i figurama.
opening.variation.alekhine_modern = Moderna varijanta
opening.variation.alekhine_modern.def = moderna varijanta
opening.variation.alekhine_modern.advanced = Bijeli zadržava solidnu prostornu prednost bez pretjeranog isturanja pješaka; crni veže skakača ili postavlja lovca u fijanketo.
opening.variation.pirc_austrian = Austrijski napad
opening.variation.pirc_austrian.def = austrijski napad
opening.variation.pirc_austrian.advanced = Potez f4 gradi velik centar za e5 ili napad na kraljevom krilu; crni uzvraća udarac s c5 ili e5.
opening.variation.pirc_austrian.advanced.spoken = Potez ef četiri gradi velik centar za e pet ili napad na kraljevom krilu; crni uzvraća udarac s ce pet ili e pet.
opening.variation.falkbeer = Falkbeerov protugambit
opening.variation.falkbeer.def = Falkbeerov protugambit
opening.variation.falkbeer.advanced = Potez d5 uzvraća udarac u centru umjesto uzimanja na f4; suvremena praksa daje prednost tome da se najprije uzme na d5.
opening.variation.falkbeer.advanced.spoken = Potez de pet uzvraća udarac u centru umjesto uzimanja na ef četiri; suvremena praksa daje prednost tome da se najprije uzme na de pet.

