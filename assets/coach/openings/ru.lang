opening.variation.nimzo_samisch = Вариант Земиша
opening.variation.nimzo_samisch.spoken = Вариант Земиша
opening.variation.nimzo_samisch.def = вариант Земиша
opening.variation.nimzo_samisch.def.spoken = вариант Земиша
