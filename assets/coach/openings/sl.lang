opening.variation.kid_samisch.def.spoken = Sämischeva varianta
opening.variation.kid_samisch.advanced = Poteza f3 podpre e4 in pripravi kmečki juriš na kraljevem krilu; črni odgovori s potezo c5 ali e5 ali z načrtom na daminem krilu s potezo b5.
opening.variation.kid_samisch.advanced.spoken = Poteza ef tri podpre e štiri in pripravi kmečki juriš na kraljevem krilu; črni odgovori s potezo ce pet ali e pet ali z načrtom na daminem krilu s potezo be pet.
opening.variation.kid_four_pawns = Napad štirih kmetov
opening.variation.kid_four_pawns.def = napad štirih kmetov
opening.variation.kid_four_pawns.advanced = Beli zgradi zid kmetov na c4, d4, e4 in f4; črni ga takoj spodkopava s potezama c5 in e6.
opening.variation.kid_four_pawns.advanced.spoken = Beli zgradi zid kmetov na ce štiri, de štiri, e štiri in ef štiri; črni ga takoj spodkopava s potezama ce pet in e šest.
opening.variation.kid_fianchetto = Varianta s fianketom
opening.variation.kid_fianchetto.def = varianta s fianketom
opening.variation.kid_fianchetto.advanced = Fianketo na g2 otopi črnega lovca na g7, igra pa postane bolj pozicijska.
opening.variation.kid_fianchetto.advanced.spoken = Fianketo na ge dva otopi črnega lovca na ge sedem, igra pa postane bolj pozicijska.
opening.variation.nimzo_rubinstein = Rubinsteinova varianta
opening.variation.nimzo_rubinstein.def = Rubinsteinova varianta
opening.variation.nimzo_rubinstein.advanced = Poteza e3 omogoča miren razvoj in ohrani več postavitev v rezervi: najbolj priljubljen odgovor na nimcoindijsko obrambo.
opening.variation.nimzo_rubinstein.advanced.spoken = Poteza e tri omogoča miren razvoj in ohrani več postavitev v rezervi: najbolj priljubljen odgovor na nimcoindijsko obrambo.
opening.variation.nimzo_classical = Klasična varianta
opening.variation.nimzo_classical.def = klasična varianta
opening.variation.nimzo_classical.advanced = Dama gre na c2, da na c3 vzame nazaj brez dvojnih kmetov; beli dobi par lovcev, črni pa hiter razvoj.
opening.variation.nimzo_classical.advanced.spoken = Dama gre na ce dva, da na ce tri vzame nazaj brez dvojnih kmetov; beli dobi par lovcev, črni pa hiter razvoj.
opening.variation.nimzo_samisch = Sämischeva varianta
opening.variation.nimzo_samisch.spoken = Sämischeva varianta
opening.variation.nimzo_samisch.def = Sämischeva varianta
opening.variation.nimzo_samisch.def.spoken = Sämischeva varianta
opening.variation.nimzo_samisch.advanced = Poteza a3 takoj izsili menjavo na c3: beli sprejme dvojne kmete v zameno za par lovcev in velik center.
opening.variation.nimzo_samisch.advanced.spoken = Poteza a tri takoj izsili menjavo na ce tri: beli sprejme dvojne kmete v zameno za par lovcev in velik center.
opening.variation.grunfeld_exchange = Menjalna varianta
opening.variation.grunfeld_exchange.def = menjalna varianta
opening.variation.grunfeld_exchange.advanced = Beli s potezo e4 zgradi velik center; črni napada d4 s potezo c5 in figurami, končnice pa so pogosto ugodne za kmečko večino črnega na daminem krilu.
opening.variation.grunfeld_exchange.advanced.spoken = Beli s potezo e štiri zgradi velik center; črni napada de štiri s potezo ce pet in figurami, končnice pa so pogosto ugodne za kmečko večino črnega na daminem krilu.
opening.variation.leningrad = Leningrajska varianta
opening.variation.leningrad.def = leningrajska varianta
opening.variation.leningrad.advanced = Črni postavi lovca v fianketo na g7: holandska obramba v slogu kraljeve indijske, v kateri črni teži k e5 in igri na kraljevem krilu.
opening.variation.leningrad.advanced.spoken = Črni postavi lovca v fianketo na ge sedem: holandska obramba v slogu kraljeve indijske, v kateri črni teži k e pet in igri na kraljevem krilu.
opening.variation.stonewall_dutch = Varianta Stonewall
opening.variation.stonewall_dutch.def = varianta Stonewall
opening.variation.stonewall_dutch.advanced = Kmetje na c6, d5, e6 in f5 dajo črnemu izjemno trden nadzor nad e4, za ceno luknje na e5 in pasivnega belopoljnega lovca.
opening.variation.stonewall_dutch.advanced.spoken = Kmetje na ce šest, de pet, e šest in ef pet dajo črnemu izjemno trden nadzor nad e štiri, za ceno luknje na e pet in pasivnega belopoljnega lovca.
opening.variation.modern_benoni = Moderna obramba Benoni
opening.variation.modern_benoni.def = moderna obramba Benoni
opening.variation.modern_benoni.advanced = Črni dobi večino na daminem krilu proti večini belega v centru; prevladuje taktika okoli e5 in lovca na g7.
opening.variation.modern_benoni.advanced.spoken = Črni dobi večino na daminem krilu proti večini belega v centru; prevladuje taktika okoli e pet in lovca na ge sedem.
opening.variation.catalan_open = Odprta katalonska otvoritev
opening.variation.catalan_open.def = odprta katalonska otvoritev
opening.variation.catalan_open.advanced = Črni vzame kmeta na c4; beli ga dobi nazaj in ohrani pritisk po dolgi diagonali, črni pa teži k c5 ali b5.
opening.variation.catalan_open.advanced.spoken = Črni vzame kmeta na ce štiri; beli ga dobi nazaj in ohrani pritisk po dolgi diagonali, črni pa teži k ce pet ali be pet.
opening.variation.catalan_closed = Zaprta katalonska otvoritev
opening.variation.catalan_closed.def = zaprta katalonska otvoritev
opening.variation.catalan_closed.advanced = Črni s strnjeno postavitvijo obdrži kmeta na d5: počasen pozicijski boj okoli osvobajajočih prodorov e5 ali c5.
opening.variation.catalan_closed.advanced.spoken = Črni s strnjeno postavitvijo obdrži kmeta na de pet: počasen pozicijski boj okoli osvobajajočih prodorov e pet ali ce pet.
opening.variation.english_symmetrical = Simetrična varianta
opening.variation.english_symmetrical.def = simetrična varianta
opening.variation.english_symmetrical.advanced = Črni s potezo c5 posnema belega: počasno manevriranje s fianketi in pritisk na d4 in d5.
opening.variation.english_symmetrical.advanced.spoken = Črni s potezo ce pet posnema belega: počasno manevriranje s fianketi in pritisk na de štiri in de pet.
opening.variation.kings_english = Sicilijanska obramba z zamenjanimi barvami
opening.variation.kings_english.def = sicilijanska obramba z zamenjanimi barvami
opening.variation.kings_english.advanced = Poteza e5 spremeni angleško otvoritev v sicilijansko obrambo s tempom več za belega; tipična načrta sta fianketo in prodor na daminem krilu.
opening.variation.kings_english.advanced.spoken = Poteza e pet spremeni angleško otvoritev v sicilijansko obrambo s tempom več za belega; tipična načrta sta fianketo in prodor na daminem krilu.
opening.variation.alekhine_four_pawns = Napad štirih kmetov
opening.variation.alekhine_four_pawns.def = napad štirih kmetov
opening.variation.alekhine_four_pawns.advanced = Beli s kmeti preganja skakača in zgradi ogromen, vendar preveč razpotegnjen center; črni se upre s potezo c5 in figurami.
opening.variation.alekhine_four_pawns.advanced.spoken = Beli s kmeti preganja skakača in zgradi ogromen, vendar preveč razpotegnjen center; črni se upre s potezo ce pet in figurami.
opening.variation.alekhine_modern = Moderna varianta
opening.variation.alekhine_modern.def = moderna varianta
opening.variation.alekhine_modern.advanced = Beli ohrani trdno prostorsko prednost, ne da bi se preveč razpotegnil; črni veže skakača ali postavi lovca v fianketo.
opening.variation.pirc_austrian = Avstrijski napad
opening.variation.pirc_austrian.def = avstrijski napad
opening.variation.pirc_austrian.advanced = Poteza f4 zgradi velik center za e5 ali za napad na kraljevem krilu; črni udari nazaj s potezo c5 ali e5.
opening.variation.pirc_austrian.advanced.spoken = Poteza ef štiri zgradi velik center za e pet ali za napad na kraljevem krilu; črni udari nazaj s potezo ce pet ali e pet.
opening.variation.falkbeer = Falkbeerjev protigambit
opening.variation.falkbeer.def = Falkbeerjev protigambit
opening.variation.falkbeer.advanced = Poteza d5 udari nazaj v centru, namesto da bi črni vzel na f4; sodobna praksa daje prednost temu, da se najprej vzame na d5.
opening.variation.falkbeer.advanced.spoken = Poteza de pet udari nazaj v centru, namesto da bi črni vzel na ef štiri; sodobna praksa daje prednost temu, da se najprej vzame na de pet.

