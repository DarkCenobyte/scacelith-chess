opening.family.english_defense = Angleška obramba
opening.family.english_defense.def = angleška obramba
opening.family.english_defense.beginner = Črni odgovori z b6 in lovcem na b7, da se s figurami bori za e4.
opening.family.english_defense.beginner.spoken = Črni odgovori z be šest in lovcem na be sedem, da se s figurami bori za e štiri.
opening.family.english_defense.advanced = Črni povabi belega k velikemu centru, nato pa ga napade s šahom z lovcem na b4, s potezo f5 in s pritiskom na e4.
opening.family.english_defense.advanced.spoken = Črni povabi belega k velikemu centru, nato pa ga napade s šahom z lovcem na be štiri, s potezo ef pet in s pritiskom na e štiri.
opening.family.pterodactyl = Obramba pterodaktila
opening.family.pterodactyl.def = obramba pterodaktila
