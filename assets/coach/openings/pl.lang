opening.variation.traxler.def = kontratak Traxlera
opening.variation.traxler.advanced = Czarne ignorują groźbę na f7 i same uderzają w f2: dzika taktyka, w której decyduje dokładna znajomość wariantów.
opening.variation.traxler.advanced.spoken = Czarne ignorują groźbę na ef siedem i same uderzają w ef dwa: dzika taktyka, w której decyduje dokładna znajomość wariantów.
opening.variation.berlin = Obrona berlińska
opening.variation.berlin.def = obrona berlińska
opening.variation.berlin.advanced = Skoczek kontratakuje e4; słynna końcówka berlińska, z wczesną wymianą hetmanów i królem czarnych w centrum, jest niezwykle solidna.
opening.variation.berlin.advanced.spoken = Skoczek kontratakuje e cztery; słynna końcówka berlińska, z wczesną wymianą hetmanów i królem czarnych w centrum, jest niezwykle solidna.
opening.variation.morphy = Obrona Morphy'ego
opening.variation.morphy.def = obrona Morphy'ego
opening.variation.morphy.advanced = Ruch a6 od razu stawia gońcowi pytanie: to brama do głównych wariantów – zamkniętego, otwartego i ataku Marshalla.
opening.variation.morphy.advanced.spoken = Ruch aa sześć od razu stawia gońcowi pytanie: to brama do głównych wariantów – zamkniętego, otwartego i ataku Marshalla.
opening.variation.closed_ruy = Wariant zamknięty
opening.variation.closed_ruy.def = wariant zamknięty
opening.variation.closed_ruy.advanced = Klasyczny wariant główny: powolne manewry białych przeciw planom czarnych na skrzydle hetmańskim, takim jak wariant Breyera, Zajcewa czy Czigorina.
opening.variation.marshall = Atak Marshalla
opening.variation.marshall.def = atak Marshalla
opening.variation.marshall.advanced = Czarne poświęcają pionka ruchem d5 za trwały atak na skrzydle królewskim; głęboko przeanalizowany, jest cenioną bronią remisową w światowej czołówce.
opening.variation.marshall.advanced.spoken = Czarne poświęcają pionka ruchem de pięć za trwały atak na skrzydle królewskim; głęboko przeanalizowany, jest cenioną bronią remisową w światowej czołówce.
opening.variation.ruy_exchange = Wariant wymienny
opening.variation.ruy_exchange.def = wariant wymienny
opening.variation.ruy_exchange.advanced = Bicie na c6 daje czarnym parę gońców, ale i zdwojone pionki; białe dążą do końcówki ze zdrową przewagą pionków na skrzydle królewskim.
opening.variation.ruy_exchange.advanced.spoken = Bicie na ce sześć daje czarnym parę gońców, ale i zdwojone pionki; białe dążą do końcówki ze zdrową przewagą pionków na skrzydle królewskim.
opening.variation.ruy_open = Wariant otwarty
opening.variation.ruy_open.def = wariant otwarty
opening.variation.ruy_open.advanced = Czarne biorą pionka e4 w zamian za aktywną grę figurami; figury są żywe, ale trzeba uważać na kolumnę e i pionka d5.
opening.variation.ruy_open.advanced.spoken = Czarne biorą pionka e cztery w zamian za aktywną grę figurami; figury są żywe, ale trzeba uważać na kolumnę e i pionka de pięć.
opening.variation.schliemann = Gambit Schliemanna
opening.variation.schliemann.def = gambit Schliemanna
opening.variation.schliemann.advanced = Ruch f5 to gambit królewski z odwróconymi kolorami: ostro i ryzykownie dla obu stron.
opening.variation.schliemann.advanced.spoken = Ruch ef pięć to gambit królewski z odwróconymi kolorami: ostro i ryzykownie dla obu stron.
opening.variation.scotch_gambit = Gambit szkocki
opening.variation.scotch_gambit.def = gambit szkocki
opening.variation.scotch_gambit.advanced = Zamiast odbić na d4, białe rozwijają gońca na c4 i oferują pionka za szybki rozwój; często przechodzi to w obronę dwóch skoczków.
opening.variation.scotch_gambit.advanced.spoken = Zamiast odbić na de cztery, białe rozwijają gońca na ce cztery i oferują pionka za szybki rozwój; często przechodzi to w obronę dwóch skoczków.
opening.variation.vienna_gambit = Gambit wiedeński
opening.variation.vienna_gambit.def = gambit wiedeński
opening.variation.vienna_gambit.advanced = Ruch f4 w partii wiedeńskiej, czyli gambit królewski ze skoczkiem już na c3; najlepszą odpowiedzią czarnych jest uderzenie w centrum ruchem d5.
opening.variation.vienna_gambit.advanced.spoken = Ruch ef cztery w partii wiedeńskiej, czyli gambit królewski ze skoczkiem już na ce trzy; najlepszą odpowiedzią czarnych jest uderzenie w centrum ruchem de pięć.
opening.variation.stafford = Gambit Stafforda
opening.variation.stafford.def = gambit Stafforda
opening.variation.stafford.beginner = Gambit pełen pułapek, popularny w internecie: czarne oddają pionka i liczą, że białe dadzą się złapać na sztuczki przeciw f2 i e4.
opening.variation.stafford.beginner.spoken = Gambit pełen pułapek, popularny w internecie: czarne oddają pionka i liczą, że białe dadzą się złapać na sztuczki przeciw ef dwa i e cztery.
opening.variation.stafford.advanced = Czarne mają szybki rozwój i pułapki na f2; spokojnymi ruchami białe po prostu zostają z czystym pionkiem więcej.
opening.variation.stafford.advanced.spoken = Czarne mają szybki rozwój i pułapki na ef dwa; spokojnymi ruchami białe po prostu zostają z czystym pionkiem więcej.
opening.variation.wayward_queen = Atak Parhama
opening.variation.wayward_queen.def = atak Parhama
opening.variation.wayward_queen.beginner = Wczesny wypad hetmana z celem na f7, czyli pomysł mata szewskiego: czarne bronią się skoczkiem i ruchem g6, a potem przeganiają hetmana figurami.
opening.variation.wayward_queen.beginner.spoken = Wczesny wypad hetmana z celem na ef siedem, czyli pomysł mata szewskiego: czarne bronią się skoczkiem i ruchem gie sześć, a potem przeganiają hetmana figurami.
opening.variation.wayward_queen.advanced = Wczesny ruch hetmanem łamie zasady rozwoju; czarne zyskują tempa, nękając go, i powinny wyjść z tego z lepszą pozycją.
opening.variation.halloween = Gambit Halloween
opening.variation.halloween.def = gambit Halloween
opening.variation.halloween.advanced = Białe oddają skoczka za dwa pionki i duże centrum: obiektywnie niepoprawne, ale groźne w szybkich partiach.
opening.variation.qgd_orthodox = Obrona ortodoksyjna
opening.variation.qgd_orthodox.def = obrona ortodoksyjna
opening.variation.qgd_orthodox.advanced = Klasyczne ustawienie z gońcem na e7, roszadą i skoczkiem na d7: solidne, ale pasywne; uwalnia je c5 lub e5.
opening.variation.qgd_orthodox.advanced.spoken = Klasyczne ustawienie z gońcem na e siedem, roszadą i skoczkiem na de siedem: solidne, ale pasywne; uwalnia je ce pięć lub e pięć.
opening.variation.qgd_exchange = Wariant wymienny
opening.variation.qgd_exchange.def = wariant wymienny
opening.variation.qgd_exchange.advanced = Wymiana na d5 tworzy strukturę karlsbadzką; klasyczny plan białych to atak mniejszości ruchami b4 i b5.
opening.variation.qgd_exchange.advanced.spoken = Wymiana na de pięć tworzy strukturę karlsbadzką; klasyczny plan białych to atak mniejszości ruchami be cztery i be pięć.
opening.variation.semi_tarrasch = Obrona pół-Tarrascha
opening.variation.semi_tarrasch.def = obrona pół-Tarrascha
opening.variation.semi_tarrasch.advanced = Czarne grają c5 i odbijają na d5 figurą, unikając izolowanego pionka z obrony Tarrascha; białe dostają ruchliwe centrum.
opening.variation.semi_tarrasch.advanced.spoken = Czarne grają ce pięć i odbijają na de pięć figurą, unikając izolowanego pionka z obrony Tarrascha; białe dostają ruchliwe centrum.
opening.variation.meran = Wariant merański
opening.variation.meran.def = wariant merański
opening.variation.meran.advanced = Czarne biją na c4 i z tempem zdobywają przestrzeń na skrzydle hetmańskim ruchem b5; gra toczy się wokół uderzenia c5 i pchnięcia białych na e5.
opening.variation.meran.advanced.spoken = Czarne biją na ce cztery i z tempem zdobywają przestrzeń na skrzydle hetmańskim ruchem be pięć; gra toczy się wokół uderzenia ce pięć i pchnięcia białych na e pięć.
opening.variation.kid_classical = Wariant klasyczny
opening.variation.kid_classical.def = wariant klasyczny
opening.variation.kid_classical.advanced = Białe spokojnie rozwijają figury i robią roszadę; po e5 i d5 zaczyna się słynny wyścig: białe na skrzydle hetmańskim, czarne na królewskim.
opening.variation.kid_classical.advanced.spoken = Białe spokojnie rozwijają figury i robią roszadę; po e pięć i de pięć zaczyna się słynny wyścig: białe na skrzydle hetmańskim, czarne na królewskim.
opening.variation.kid_samisch = Wariant Sämischa
opening.variation.kid_samisch.spoken = Wariant Sämischa
opening.variation.kid_samisch.def = wariant Sämischa
opening.variation.kid_samisch.def.spoken = wariant Sämischa
opening.variation.kid_samisch.advanced = Ruch f3 wspiera e4 i przygotowuje szturm pionków na skrzydle królewskim; czarne odpowiadają ruchem c5, e5 albo planem na skrzydle hetmańskim z b5.
opening.variation.kid_samisch.advanced.spoken = Ruch ef trzy wspiera e cztery i przygotowuje szturm pionków na skrzydle królewskim; czarne odpowiadają ruchem ce pięć, e pięć albo planem na skrzydle hetmańskim z be pięć.
opening.variation.kid_four_pawns = Atak czterech pionków
opening.variation.kid_four_pawns.def = atak czterech pionków
opening.variation.kid_four_pawns.advanced = Białe budują mur pionków na c4, d4, e4 i f4; czarne od razu podważają go ruchami c5 i e6.
opening.variation.kid_four_pawns.advanced.spoken = Białe budują mur pionków na ce cztery, de cztery, e cztery i ef cztery; czarne od razu podważają go ruchami ce pięć i e sześć.
opening.variation.kid_fianchetto = Wariant z fianchettem
opening.variation.kid_fianchetto.def = wariant z fianchettem
opening.variation.kid_fianchetto.advanced = Fianchetto na g2 neutralizuje gońca czarnych na g7, a gra nabiera bardziej pozycyjnego charakteru.
opening.variation.kid_fianchetto.advanced.spoken = Fianchetto na gie dwa neutralizuje gońca czarnych na gie siedem, a gra nabiera bardziej pozycyjnego charakteru.
opening.variation.nimzo_rubinstein = Wariant Rubinsteina
opening.variation.nimzo_rubinstein.def = wariant Rubinsteina
opening.variation.nimzo_rubinstein.advanced = Ruch e3 spokojnie rozwija grę i zostawia w odwodzie kilka ustawień: to najpopularniejsza odpowiedź na obronę nimzoindyjską.
opening.variation.nimzo_rubinstein.advanced.spoken = Ruch e trzy spokojnie rozwija grę i zostawia w odwodzie kilka ustawień: to najpopularniejsza odpowiedź na obronę nimzoindyjską.
opening.variation.nimzo_classical = Wariant klasyczny
opening.variation.nimzo_classical.def = wariant klasyczny
opening.variation.nimzo_classical.advanced = Hetman idzie na c2, żeby odbić na c3 bez zdwojenia pionków; białe dostają parę gońców, czarne – szybki rozwój.
opening.variation.nimzo_classical.advanced.spoken = Hetman idzie na ce dwa, żeby odbić na ce trzy bez zdwojenia pionków; białe dostają parę gońców, czarne – szybki rozwój.
opening.variation.nimzo_samisch = Wariant Sämischa
opening.variation.nimzo_samisch.spoken = Wariant Sämischa
opening.variation.nimzo_samisch.def = wariant Sämischa
opening.variation.nimzo_samisch.def.spoken = wariant Sämischa
opening.variation.nimzo_samisch.advanced = Ruch a3 od razu wymusza wymianę na c3: białe godzą się na zdwojone pionki w zamian za parę gońców i duże centrum.
opening.variation.nimzo_samisch.advanced.spoken = Ruch aa trzy od razu wymusza wymianę na ce trzy: białe godzą się na zdwojone pionki w zamian za parę gońców i duże centrum.
opening.variation.grunfeld_exchange = Wariant wymienny
opening.variation.grunfeld_exchange.def = wariant wymienny
opening.variation.grunfeld_exchange.advanced = Białe budują duże centrum ruchem e4; czarne atakują d4 ruchem c5 i figurami, a w końcówkach często procentuje przewaga pionków czarnych na skrzydle hetmańskim.
opening.variation.grunfeld_exchange.advanced.spoken = Białe budują duże centrum ruchem e cztery; czarne atakują de cztery ruchem ce pięć i figurami, a w końcówkach często procentuje przewaga pionków czarnych na skrzydle hetmańskim.
opening.variation.leningrad = Wariant leningradzki
opening.variation.leningrad.def = wariant leningradzki
opening.variation.leningrad.advanced = Czarne robią fianchetto na g7: to obrona holenderska w stylu królewsko-indyjskim, w której czarne dążą do e5 i gry na skrzydle królewskim.
opening.variation.leningrad.advanced.spoken = Czarne robią fianchetto na gie siedem: to obrona holenderska w stylu królewsko-indyjskim, w której czarne dążą do e pięć i gry na skrzydle królewskim.
opening.variation.stonewall_dutch = Wariant Stonewall
opening.variation.stonewall_dutch.def = wariant Stonewall
opening.variation.stonewall_dutch.advanced = Pionki na c6, d5, e6 i f5 dają czarnym żelazną kontrolę nad e4 kosztem słabego pola e5 i pasywnego gońca białopolowego.
opening.variation.stonewall_dutch.advanced.spoken = Pionki na ce sześć, de pięć, e sześć i ef pięć dają czarnym żelazną kontrolę nad e cztery kosztem słabego pola e pięć i pasywnego gońca białopolowego.
opening.variation.modern_benoni = Nowoczesna obrona Benoni
opening.variation.modern_benoni.def = nowoczesna obrona Benoni
opening.variation.modern_benoni.advanced = Czarne mają przewagę pionków na skrzydle hetmańskim przeciw przewadze białych w centrum; dominuje taktyka wokół e5 i gońca na g7.
opening.variation.modern_benoni.advanced.spoken = Czarne mają przewagę pionków na skrzydle hetmańskim przeciw przewadze białych w centrum; dominuje taktyka wokół e pięć i gońca na gie siedem.
opening.variation.catalan_open = Otwarta partia katalońska
opening.variation.catalan_open.def = otwarta partia katalońska
opening.variation.catalan_open.advanced = Czarne biorą pionka c4; białe go odzyskują i utrzymują nacisk na długiej przekątnej, a czarne dążą do c5 lub b5.
opening.variation.catalan_open.advanced.spoken = Czarne biorą pionka ce cztery; białe go odzyskują i utrzymują nacisk na długiej przekątnej, a czarne dążą do ce pięć lub be pięć.
opening.variation.catalan_closed = Zamknięta partia katalońska
opening.variation.catalan_closed.def = zamknięta partia katalońska
opening.variation.catalan_closed.advanced = Czarne utrzymują pionka na d5 w zwartym ustawieniu: powolna walka pozycyjna wokół uwalniających uderzeń e5 lub c5.
opening.variation.catalan_closed.advanced.spoken = Czarne utrzymują pionka na de pięć w zwartym ustawieniu: powolna walka pozycyjna wokół uwalniających uderzeń e pięć lub ce pięć.
opening.variation.english_symmetrical = Wariant symetryczny
opening.variation.english_symmetrical.def = wariant symetryczny
opening.variation.english_symmetrical.advanced = Czarne odpowiadają symetrycznie ruchem c5: powolne manewry z fianchettami i nacisk na d4 i d5.
opening.variation.english_symmetrical.advanced.spoken = Czarne odpowiadają symetrycznie ruchem ce pięć: powolne manewry z fianchettami i nacisk na de cztery i de pięć.
opening.variation.kings_english = Obrona sycylijska z odwróconymi kolorami
opening.variation.kings_english.def = obrona sycylijska z odwróconymi kolorami
opening.variation.kings_english.advanced = Po e5 debiut angielski staje się obroną sycylijską z dodatkowym tempem dla białych; typowe plany to fianchetto i ofensywa na skrzydle hetmańskim.
opening.variation.kings_english.advanced.spoken = Po e pięć debiut angielski staje się obroną sycylijską z dodatkowym tempem dla białych; typowe plany to fianchetto i ofensywa na skrzydle hetmańskim.
opening.variation.alekhine_four_pawns = Atak czterech pionków
opening.variation.alekhine_four_pawns.def = atak czterech pionków
opening.variation.alekhine_four_pawns.advanced = Białe przeganiają skoczka pionkami i budują ogromne, ale nadmiernie wysunięte centrum; czarne kontrują ruchem c5 i figurami.
opening.variation.alekhine_four_pawns.advanced.spoken = Białe przeganiają skoczka pionkami i budują ogromne, ale nadmiernie wysunięte centrum; czarne kontrują ruchem ce pięć i figurami.
opening.variation.alekhine_modern = Wariant nowoczesny
opening.variation.alekhine_modern.def = wariant nowoczesny
opening.variation.alekhine_modern.advanced = Białe utrzymują solidną przewagę przestrzeni bez nadmiernego wysuwania pionków; czarne wiążą skoczka albo robią fianchetto.
opening.variation.pirc_austrian = Atak austriacki
opening.variation.pirc_austrian.def = atak austriacki
opening.variation.pirc_austrian.advanced = Ruch f4 buduje duże centrum z myślą o e5 albo o ataku na skrzydle królewskim; czarne kontratakują ruchem c5 lub e5.
opening.variation.pirc_austrian.advanced.spoken = Ruch ef cztery buduje duże centrum z myślą o e pięć albo o ataku na skrzydle królewskim; czarne kontratakują ruchem ce pięć lub e pięć.
opening.variation.falkbeer = Kontrgambit Falkbeera
opening.variation.falkbeer.def = kontrgambit Falkbeera
opening.variation.falkbeer.advanced = Ruch d5 kontratakuje w centrum zamiast bicia na f4; współczesna praktyka preferuje najpierw bicie na d5.
opening.variation.falkbeer.advanced.spoken = Ruch de pięć kontratakuje w centrum zamiast bicia na ef cztery; współczesna praktyka preferuje najpierw bicie na de pięć.

