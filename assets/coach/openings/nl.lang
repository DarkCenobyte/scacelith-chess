opening.family.vienna.def = de Weense partij
opening.family.vienna.beginner = Wit ontwikkelt eerst het damepaard en speelt daarna vaak f4: een levendige opening met snelle aanvalskansen.
opening.family.vienna.beginner.spoken = Wit ontwikkelt eerst het damepaard en speelt daarna vaak ef vier: een levendige opening met snelle aanvalskansen.
opening.family.vienna.advanced = De Weense partij bereidt f4 voor, het Weense gambiet, of een rustige opstelling; het belangrijkste antwoord van Zwart is het paard naar f6, met een tegenstoot in het centrum via d5.
opening.family.vienna.advanced.spoken = De Weense partij bereidt ef vier voor, het Weense gambiet, of een rustige opstelling; het belangrijkste antwoord van Zwart is het paard naar ef zes, met een tegenstoot in het centrum via dee vijf.
opening.family.bishops_opening = Loperspel
opening.family.bishops_opening.def = het loperspel
opening.family.bishops_opening.beginner = Wit ontwikkelt de loper naar c4 vóór het paard, mikt op f7 en houdt de f-pion vrij.
opening.family.bishops_opening.beginner.spoken = Wit ontwikkelt de loper naar cee vier vóór het paard, mikt op ef zeven en houdt de ef-pion vrij.
opening.family.bishops_opening.advanced = Een flexibele zetvolgorde die vaak overgaat in de Italiaanse of de Weense partij, met rustige opstellingen met d3 als belangrijkste eigen idee.
opening.family.bishops_opening.advanced.spoken = Een flexibele zetvolgorde die vaak overgaat in de Italiaanse of de Weense partij, met rustige opstellingen met dee drie als belangrijkste eigen idee.
opening.family.alekhine = Aljechin-verdediging
opening.family.alekhine.spoken = Aljechin-verdediging
opening.family.alekhine.def = de Aljechin-verdediging
opening.family.alekhine.def.spoken = de Aljechin-verdediging
opening.family.alekhine.beginner = Zwart valt e4 aan met het paard om de witte pionnen naar voren te lokken: ze winnen ruimte, maar kunnen een doelwit worden.
opening.family.alekhine.beginner.spoken = Zwart valt ee vier aan met het paard om de witte pionnen naar voren te lokken: ze winnen ruimte, maar kunnen een doelwit worden.
opening.family.alekhine.advanced = Zwart lokt de pionnen naar voren en ondermijnt daarna het overspannen centrum met d6 en c5; de rustige moderne variant is de hoofdvariant van Wit.
opening.family.alekhine.advanced.spoken = Zwart lokt de pionnen naar voren en ondermijnt daarna het overspannen centrum met dee zes en cee vijf; de rustige moderne variant is de hoofdvariant van Wit.
opening.family.kings_gambit = Koningsgambiet
opening.family.kings_gambit.def = het koningsgambiet
opening.family.kings_gambit.beginner = Wit offert de f-pion om de f-lijn te openen en het centrum te nemen: een romantische aanvalsopening uit de negentiende eeuw.
opening.family.kings_gambit.beginner.spoken = Wit offert de ef-pion om de ef-lijn te openen en het centrum te nemen: een romantische aanvalsopening uit de negentiende eeuw.
opening.family.kings_gambit.advanced = Wit ruilt een pion in voor het centrum en de f-lijn; Zwart kan de pion vasthouden met g5, teruggeven met d5 of het gambiet weigeren.
opening.family.kings_gambit.advanced.spoken = Wit ruilt een pion in voor het centrum en de ef-lijn; Zwart kan de pion vasthouden met gee vijf, teruggeven met dee vijf of het gambiet weigeren.
opening.family.kga = Aangenomen koningsgambiet
opening.family.kga.def = het aangenomen koningsgambiet
opening.family.kga.beginner = Zwart slaat de f-pion: de partij wordt zeer scherp, en beide koningen staan wat bloot.
opening.family.kga.beginner.spoken = Zwart slaat de ef-pion: de partij wordt zeer scherp, en beide koningen staan wat bloot.
opening.family.kga.advanced = Zwart probeert de pion te houden met g5 of geeft hem terug voor een snelle ontwikkeling; Wit rekent op de f-lijn en een ontwikkelingsvoorsprong.
opening.family.kga.advanced.spoken = Zwart probeert de pion te houden met gee vijf of geeft hem terug voor een snelle ontwikkeling; Wit rekent op de ef-lijn en een ontwikkelingsvoorsprong.
opening.family.kgd = Geweigerd koningsgambiet
opening.family.kgd.def = het geweigerde koningsgambiet
opening.family.kgd.beginner = Zwart weigert de pion en ontwikkelt liever, vaak met de loper naar c5, waardoor Wit een tijdje niet kan rokeren.
opening.family.kgd.beginner.spoken = Zwart weigert de pion en ontwikkelt liever, vaak met de loper naar cee vijf, waardoor Wit een tijdje niet kan rokeren.
opening.family.kgd.advanced = De loper op c5 houdt de witte koningsvleugel in bedwang en het Falkbeer-tegengambiet gaat in het centrum in de tegenaanval; beide vermijden de lange, geforceerde varianten van het aangenomen gambiet.
opening.family.kgd.advanced.spoken = De loper op cee vijf houdt de witte koningsvleugel in bedwang en het Falkbeer-tegengambiet gaat in het centrum in de tegenaanval; beide vermijden de lange, geforceerde varianten van het aangenomen gambiet.
opening.family.nimzowitsch_def = Nimzowitsch-verdediging
opening.family.nimzowitsch_def.spoken = Nimzowitsch-verdediging
opening.family.nimzowitsch_def.def = de Nimzowitsch-verdediging
opening.family.nimzowitsch_def.def.spoken = de Nimzowitsch-verdediging
opening.family.nimzowitsch_def.beginner = Zwart antwoordt met het damepaard: een ongebruikelijke maar speelbare verdediging die vaak overgaat in andere openingen.
opening.family.nimzowitsch_def.advanced = Deze verdediging leidt tot structuren met d4 en d5 of e5, of gaat over in de open spelen; ze leeft van de verrassing en van flexibel stukkenspel.
opening.family.nimzowitsch_def.advanced.spoken = Deze verdediging leidt tot structuren met dee vier en dee vijf of ee vijf, of gaat over in de open spelen; ze leeft van de verrassing en van flexibel stukkenspel.
opening.family.owen = Owen-verdediging
opening.family.owen.def = de Owen-verdediging
opening.family.owen.beginner = Zwart zet de dameloper op b7 om e4 van veraf onder vuur te nemen; Wit doet er goed aan gewoon het centrum in te nemen.
opening.family.owen.beginner.spoken = Zwart zet de dameloper op bee zeven om ee vier van veraf onder vuur te nemen; Wit doet er goed aan gewoon het centrum in te nemen.
opening.family.owen.advanced = Een hypermoderne opstelling met b6, de loper op b7 en e6, die het centrum vroeg opgeeft; Wit wint ruimte en moet op de lange diagonaal letten.
opening.family.owen.advanced.spoken = Een hypermoderne opstelling met bee zes, de loper op bee zeven en ee zes, die het centrum vroeg opgeeft; Wit wint ruimte en moet op de lange diagonaal letten.
opening.family.horwitz = Horwitz-verdediging
opening.family.horwitz.def = de Horwitz-verdediging
opening.family.horwitz.beginner = Zwart speelt e6 en houdt de opties open: meestal wordt het een Franse verdediging, een geweigerd damegambiet of een Hollandse verdediging.
opening.family.horwitz.beginner.spoken = Zwart speelt ee zes en houdt de opties open: meestal wordt het een Franse verdediging, een geweigerd damegambiet of een Hollandse verdediging.
opening.family.horwitz.advanced = Een zetvolgorde die vooral tot zetverwisselingen leidt; de eigen varianten zijn de Kangoeroe, met een loperschaak op b4, en opstellingen uit de Engelse verdediging met b6.
opening.family.horwitz.advanced.spoken = Een zetvolgorde die vooral tot zetverwisselingen leidt; de eigen varianten zijn de Kangoeroe, met een loperschaak op bee vier, en opstellingen uit de Engelse verdediging met bee zes.
opening.family.vant_kruijs = Van 't Kruijs-opening
opening.family.vant_kruijs.def = de Van 't Kruijs-opening
opening.family.vant_kruijs.beginner = De koningspion één veld vooruit opent de weg voor de loper, maar neemt weinig centrum in: een rustig begin.
opening.family.vant_kruijs.beginner.spoken = De koningspion één veld vooruit opent de weg voor de loper, maar neemt weinig centrum in: een rustig begin.
opening.family.vant_kruijs.advanced = Deze opening gaat meestal over in opstellingen uit het Frans, het Colle-systeem of de Stonewall met verwisselde kleuren, en laat Zwart zonder echt risico de strijd om het centrum aangaan.
opening.family.center_game = Middengambiet
opening.family.center_game.def = het middengambiet
opening.family.center_game.beginner = Wit opent het centrum al in de tweede zet met d4, maar na de ruil slaat de dame vroeg terug en kan ze opgejaagd worden.
opening.family.center_game.beginner.spoken = Wit opent het centrum al in de tweede zet met dee vier, maar na de ruil slaat de dame vroeg terug en kan ze opgejaagd worden.
opening.family.center_game.advanced = Zwart ontwikkelt met tempowinst tegen de dame; Wit brengt haar meestal naar e3, ontwikkelt de damevleugel en rokeert lang om aan te vallen.
opening.family.center_game.advanced.spoken = Zwart ontwikkelt met tempowinst tegen de dame; Wit brengt haar meestal naar ee drie, ontwikkelt de damevleugel en rokeert lang om aan te vallen.
opening.family.englund = Englund-gambiet
opening.family.englund.def = het Englund-gambiet
opening.family.englund.beginner = Zwart biedt de e-pion aan en hoopt op valstrikken: objectief twijfelachtig, maar gevaarlijk als Wit het niet kent.
opening.family.englund.beginner.spoken = Zwart biedt de ee-pion aan en hoopt op valstrikken: objectief twijfelachtig, maar gevaarlijk als Wit het niet kent.
opening.family.englund.advanced = Het gambiet leunt op trucs met de dame via e7 en b4; met een rustige, zorgvuldige ontwikkeling houdt Wit een gezonde extra pion.
opening.family.englund.advanced.spoken = Het gambiet leunt op trucs met de dame via ee zeven en bee vier; met een rustige, zorgvuldige ontwikkeling houdt Wit een gezonde extra pion.
opening.family.dutch = Hollandse verdediging
opening.family.dutch.def = de Hollandse verdediging
opening.family.dutch.beginner = Zwart speelt f5 om e4 te beheersen en op de koningsvleugel te mikken: ambitieus, maar het verzwakt de zwarte koningsstelling een beetje.
opening.family.dutch.beginner.spoken = Zwart speelt ef vijf om ee vier te beheersen en op de koningsvleugel te mikken: ambitieus, maar het verzwakt de zwarte koningsstelling een beetje.
opening.family.dutch.advanced = Leningrad-, Stonewall- of klassieke opstellingen: Zwart vecht om e4 en een aanval op de koningsvleugel, Wit mikt op e4 en het verzwakte veld e6.
opening.family.dutch.advanced.spoken = Leningrad-, Stonewall- of klassieke opstellingen: Zwart vecht om ee vier en een aanval op de koningsvleugel, Wit mikt op ee vier en het verzwakte veld ee zes.
opening.family.nimzo_indian = Nimzo-Indische verdediging
opening.family.nimzo_indian.spoken = Nimzo-Indische verdediging
opening.family.nimzo_indian.def = de Nimzo-Indische verdediging
opening.family.nimzo_indian.def.spoken = de Nimzo-Indische verdediging
opening.family.nimzo_indian.beginner = Zwart pent het paard op c3 met de loper om e4 te verhinderen: een zeer gerespecteerde verdediging waarbij Wit vaak dubbelpionnen overhoudt.
opening.family.nimzo_indian.beginner.spoken = Zwart pent het paard op cee drie met de loper om ee vier te verhinderen: een zeer gerespecteerde verdediging waarbij Wit vaak dubbelpionnen overhoudt.
opening.family.nimzo_indian.advanced = Zwart geeft loper voor paard om e4 te beheersen en de witte pionnenstructuur te beschadigen; Wit krijgt het loperpaar en mogelijkheden in het centrum.
opening.family.nimzo_indian.advanced.spoken = Zwart geeft loper voor paard om ee vier te beheersen en de witte pionnenstructuur te beschadigen; Wit krijgt het loperpaar en mogelijkheden in het centrum.
opening.family.queens_indian = Dame-Indische verdediging
opening.family.queens_indian.def = de Dame-Indische verdediging
opening.family.queens_indian.beginner = Zwart zet de dameloper op b7 om de witte velden in het centrum te beheersen: solide en flexibel.
opening.family.queens_indian.beginner.spoken = Zwart zet de dameloper op bee zeven om de witte velden in het centrum te beheersen: solide en flexibel.
opening.family.queens_indian.advanced = Zwart vecht met stukken om e4 en d5; typische ideeën zijn de loper naar a6 tegen c4, egelstellingen en de doorbraken c5 of d5.
opening.family.queens_indian.advanced.spoken = Zwart vecht met stukken om ee vier en dee vijf; typische ideeën zijn de loper naar aa zes tegen cee vier, egelstellingen en de doorbraken cee vijf of dee vijf.
opening.family.grunfeld = Grünfeld-Indische verdediging
opening.family.grunfeld.spoken = Grünfeld-Indische verdediging
opening.family.grunfeld.def = de Grünfeld-Indische verdediging
opening.family.grunfeld.def.spoken = de Grünfeld-Indische verdediging
opening.family.grunfeld.beginner = Zwart laat Wit een groot pionnencentrum opbouwen en valt het daarna aan met stukken en de loper op g7: een dynamische, moderne verdediging.
opening.family.grunfeld.beginner.spoken = Zwart laat Wit een groot pionnencentrum opbouwen en valt het daarna aan met stukken en de loper op gee zeven: een dynamische, moderne verdediging.
opening.family.grunfeld.advanced = In de ruilvarianten krijgt Wit een groot centrum en valt Zwart d4 aan met de loper, c5 en de paarden: zeer concrete theorie.
opening.family.grunfeld.advanced.spoken = In de ruilvarianten krijgt Wit een groot centrum en valt Zwart dee vier aan met de loper, cee vijf en de paarden: zeer concrete theorie.
opening.family.catalan = Catalaanse opening
opening.family.catalan.def = de Catalaanse opening
opening.family.catalan.beginner = Wit combineert het damegambiet met een loper op g2, die over de lange diagonaal druk zet op de zwarte damevleugel.
opening.family.catalan.beginner.spoken = Wit combineert het damegambiet met een loper op gee twee, die over de lange diagonaal druk zet op de zwarte damevleugel.
opening.family.catalan.advanced = Wit geeft de pion op c4 op of wint hem pas later terug, in ruil voor druk op de lange diagonaal; in de eindspelen is de witte loper vaak in het voordeel.
opening.family.catalan.advanced.spoken = Wit geeft de pion op cee vier op of wint hem pas later terug, in ruil voor druk op de lange diagonaal; in de eindspelen is de witte loper vaak in het voordeel.
opening.family.benoni = Benoni-verdediging
opening.family.benoni.def = de Benoni-verdediging
opening.family.benoni.beginner = Zwart speelt c5 en accepteert een geblokkeerd centrum in ruil voor een pionnenmeerderheid op de damevleugel: een ambitieuze, onevenwichtige verdediging.
opening.family.benoni.beginner.spoken = Zwart speelt cee vijf en accepteert een geblokkeerd centrum in ruil voor een pionnenmeerderheid op de damevleugel: een ambitieuze, onevenwichtige verdediging.
opening.family.benoni.advanced = Een asymmetrische structuur: Zwart heeft de meerderheid op de damevleugel en de loper op g7, Wit de meerderheid in het centrum en de doorbraak e5.
opening.family.benoni.advanced.spoken = Een asymmetrische structuur: Zwart heeft de meerderheid op de damevleugel en de loper op gee zeven, Wit de meerderheid in het centrum en de doorbraak ee vijf.
opening.family.benko = Benko-gambiet
opening.family.benko.def = het Benko-gambiet
opening.family.benko.beginner = Zwart geeft een pion op de damevleugel om de a-lijn en de b-lijn te openen voor de torens: langdurige druk in plaats van snelle tactiek.
opening.family.benko.beginner.spoken = Zwart geeft een pion op de damevleugel om de aa-lijn en de bee-lijn te openen voor de torens: langdurige druk in plaats van snelle tactiek.
opening.family.benko.advanced = Een pion voor blijvende druk op de damevleugel door de torens en de loper op g7; Zwart is vaak tevreden met een eindspel met een pion minder.
opening.family.benko.advanced.spoken = Een pion voor blijvende druk op de damevleugel door de torens en de loper op gee zeven; Zwart is vaak tevreden met een eindspel met een pion minder.
opening.family.reti = Réti-opening
opening.family.reti.spoken = Réti-opening
opening.family.reti.def = de Réti-opening
opening.family.reti.def.spoken = de Réti-opening
opening.family.reti.beginner = Wit ontwikkelt het paard en valt daarna het zwarte centrum vanaf de zijkant aan met c4: een flexibele, hypermoderne opening.
opening.family.reti.beginner.spoken = Wit ontwikkelt het paard en valt daarna het zwarte centrum vanaf de zijkant aan met cee vier: een flexibele, hypermoderne opening.
opening.family.reti.advanced = De Réti-opening zet druk op d5 met c4 en een fianchetto op g2, en gaat vaak over in structuren uit het Catalaans, het Engels of het damegambiet.
opening.family.reti.advanced.spoken = De Réti-opening zet druk op dee vijf met cee vier en een fianchetto op gee twee, en gaat vaak over in structuren uit het Catalaans, het Engels of het damegambiet.
opening.family.kings_indian_attack = Konings-Indische aanval
opening.family.kings_indian_attack.def = de Konings-Indische aanval
opening.family.kings_indian_attack.beginner = Wit kiest tegen bijna alles dezelfde opstelling: het paard op f3, een fianchetto op g2, rokade, d3 en e4; een systeem met een duidelijk plan op de koningsvleugel.
opening.family.kings_indian_attack.beginner.spoken = Wit kiest tegen bijna alles dezelfde opstelling: het paard op ef drie, een fianchetto op gee twee, rokade, dee drie en ee vier; een systeem met een duidelijk plan op de koningsvleugel.
opening.family.kings_indian_attack.advanced = Konings-Indisch met verwisselde kleuren en een tempo meer; Wit schuift vaak door naar e5 en valt de koning aan, terwijl Zwart uitbreidt op de damevleugel.
opening.family.kings_indian_attack.advanced.spoken = Konings-Indisch met verwisselde kleuren en een tempo meer; Wit schuift vaak door naar ee vijf en valt de koning aan, terwijl Zwart uitbreidt op de damevleugel.
opening.family.bird = Bird-opening
opening.family.bird.def = de Bird-opening
opening.family.bird.beginner = Wit begint met de f-pion om e5 te beheersen: een ongebruikelijke opening die leidt tot Hollandse stellingen met verwisselde kleuren.
opening.family.bird.beginner.spoken = Wit begint met de ef-pion om ee vijf te beheersen: een ongebruikelijke opening die leidt tot Hollandse stellingen met verwisselde kleuren.
opening.family.bird.advanced = Wit kiest een opstelling op de koningsvleugel met de loper op b2 of een fianchetto op g2; het scherpste antwoord van Zwart is het From-gambiet met e5.
opening.family.bird.advanced.spoken = Wit kiest een opstelling op de koningsvleugel met de loper op bee twee of een fianchetto op gee twee; het scherpste antwoord van Zwart is het From-gambiet met ee vijf.
opening.family.ponziani = Ponziani-opening
opening.family.ponziani.def = de Ponziani-opening
opening.family.ponziani.beginner = Wit bereidt met c3 de zet d4 voor om een pionnencentrum op te bouwen: een oude en vrij zeldzame opening.
opening.family.ponziani.beginner.spoken = Wit bereidt met cee drie de zet dee vier voor om een pionnencentrum op te bouwen: een oude en vrij zeldzame opening.
opening.family.ponziani.advanced = c3 bereidt d4 voor, maar neemt het paard zijn beste veld af; Zwart egaliseert met een tegenaanval, via het paard naar f6 of via d5.
opening.family.ponziani.advanced.spoken = cee drie bereidt dee vier voor, maar neemt het paard zijn beste veld af; Zwart egaliseert met een tegenaanval, via het paard naar ef zes of via dee vijf.
opening.family.three_knights = Driepaardenspel
opening.family.three_knights.def = het driepaardenspel
opening.family.three_knights.beginner = Wit brengt vroeg een derde paard in het spel; als Zwart het vierde paard erbij haalt, wordt het een vierpaardenspel.
opening.family.three_knights.advanced = Een zetvolgorde die vaak tot zetverwisseling leidt; de eigen pogingen van Zwart zijn de loper naar b4 en een fianchetto met g6.
opening.family.three_knights.advanced.spoken = Een zetvolgorde die vaak tot zetverwisseling leidt; de eigen pogingen van Zwart zijn de loper naar bee vier en een fianchetto met gee zes.
opening.family.danish = Deens gambiet
opening.family.danish.def = het Deense gambiet
opening.family.danish.beginner = Wit geeft één of zelfs twee pionnen voor een grote ontwikkelingsvoorsprong en twee lopers die op de zwarte koning gericht zijn.
opening.family.danish.advanced = Pionnen worden ingeruild voor open lijnen en lopers op c4 en b2; materiaal teruggeven met d5 is het veiligste antwoord van Zwart.
opening.family.danish.advanced.spoken = Pionnen worden ingeruild voor open lijnen en lopers op cee vier en bee twee; materiaal teruggeven met dee vijf is het veiligste antwoord van Zwart.
opening.family.blackmar_diemer = Blackmar-Diemer-gambiet
opening.family.blackmar_diemer.spoken = Blackmar-Diemer-gambiet
opening.family.blackmar_diemer.def = het Blackmar-Diemer-gambiet
opening.family.blackmar_diemer.def.spoken = het Blackmar-Diemer-gambiet
opening.family.blackmar_diemer.beginner = Wit offert een pion met e4 en f3 om de f-lijn te openen en snel aan te vallen.
opening.family.blackmar_diemer.beginner.spoken = Wit offert een pion met ee vier en ef drie om de ef-lijn te openen en snel aan te vallen.
opening.family.blackmar_diemer.advanced = Een pion voor ontwikkeling en de halfopen f-lijn; de theorie is gunstig voor Zwart, mits Zwart degelijk ontwikkelt.
opening.family.blackmar_diemer.advanced.spoken = Een pion voor ontwikkeling en de halfopen ef-lijn; de theorie is gunstig voor Zwart, mits Zwart degelijk ontwikkelt.
opening.family.trompowsky = Trompowsky-aanval
opening.family.trompowsky.spoken = Trompowsky-aanval
opening.family.trompowsky.def = de Trompowsky-aanval
opening.family.trompowsky.def.spoken = de Trompowsky-aanval
opening.family.trompowsky.beginner = Wit valt het paard op f6 meteen aan met de loper: een vroege verrassing die Zwart van de gebaande paden haalt.
opening.family.trompowsky.beginner.spoken = Wit valt het paard op ef zes meteen aan met de loper: een vroege verrassing die Zwart van de gebaande paden haalt.
opening.family.trompowsky.advanced = De loper dreigt de zwarte pionnen te verdubbelen; Zwart antwoordt met het paard naar e4, met e6 of met c5, en het spel wordt onevenwichtig.
opening.family.trompowsky.advanced.spoken = De loper dreigt de zwarte pionnen te verdubbelen; Zwart antwoordt met het paard naar ee vier, met ee zes of met cee vijf, en het spel wordt onevenwichtig.
opening.family.torre = Torre-aanval
opening.family.torre.def = de Torre-aanval
opening.family.torre.beginner = Wit ontwikkelt de loper naar g5 om het paard te penen en bouwt met e3 en c3 een solide centrum op.
opening.family.torre.beginner.spoken = Wit ontwikkelt de loper naar gee vijf om het paard te penen en bouwt met ee drie en cee drie een solide centrum op.
opening.family.torre.advanced = Een systeem dat met de loper op g5 naar e4 toewerkt; Zwart antwoordt meestal met c5 of speelt al vroeg h6.
opening.family.torre.advanced.spoken = Een systeem dat met de loper op gee vijf naar ee vier toewerkt; Zwart antwoordt meestal met cee vijf of speelt al vroeg ha zes.
opening.family.colle = Colle-systeem
opening.family.colle.def = het Colle-systeem
opening.family.colle.beginner = Wit bouwt de pionnendriehoek d4, e3 en c3 met de loper op d3 en bereidt e4 voor: een eenvoudig, solide aanvalssysteem.
opening.family.colle.beginner.spoken = Wit bouwt de pionnendriehoek dee vier, ee drie en cee drie met de loper op dee drie en bereidt ee vier voor: een eenvoudig, solide aanvalssysteem.
opening.family.colle.advanced = Wit bereidt e4 voor met het oog op een aanval op de koningsvleugel, of ontwikkelt de andere loper naar b2; het nadeel is de passieve loper op c1.
opening.family.colle.advanced.spoken = Wit bereidt ee vier voor met het oog op een aanval op de koningsvleugel, of ontwikkelt de andere loper naar bee twee; het nadeel is de passieve loper op cee één.
opening.family.tarrasch_def = Tarrasch-verdediging
opening.family.tarrasch_def.def = de Tarrasch-verdediging
opening.family.tarrasch_def.beginner = Zwart speelt c5 tegen het damegambiet en neemt een geïsoleerde pion op de koop toe in ruil voor vrij stukkenspel.
opening.family.tarrasch_def.beginner.spoken = Zwart speelt cee vijf tegen het damegambiet en neemt een geïsoleerde pion op de koop toe in ruil voor vrij stukkenspel.
opening.family.tarrasch_def.advanced = Zwart aanvaardt bewust een geïsoleerde damepion voor actief spel; Wit blokkeert d5 en fianchetteert, Zwart zoekt stukkenspel en de opmars naar d4.
opening.family.tarrasch_def.advanced.spoken = Zwart aanvaardt bewust een geïsoleerde damepion voor actief spel; Wit blokkeert dee vijf en fianchetteert, Zwart zoekt stukkenspel en de opmars naar dee vier.
opening.family.budapest = Boedapest-gambiet
opening.family.budapest.def = het Boedapest-gambiet
opening.family.budapest.beginner = Zwart geeft de e-pion om snel te ontwikkelen; meestal wint Zwart de pion terug.
opening.family.budapest.beginner.spoken = Zwart geeft de ee-pion om snel te ontwikkelen; meestal wint Zwart de pion terug.
opening.family.budapest.advanced = In de meeste varianten wint Zwart de pion terug met het paard op g4; Wit houdt een klein voordeel, en de Fajarowicz-variant is een venijniger zijpad.
opening.family.budapest.advanced.spoken = In de meeste varianten wint Zwart de pion terug met het paard op gee vier; Wit houdt een klein voordeel, en de Fajarowicz-variant is een venijniger zijpad.
opening.family.bogo_indian = Bogo-Indische verdediging
opening.family.bogo_indian.spoken = Bogo-Indische verdediging
opening.family.bogo_indian.def = de Bogo-Indische verdediging
opening.family.bogo_indian.def.spoken = de Bogo-Indische verdediging
opening.family.bogo_indian.beginner = Zwart geeft schaak met de loper op b4 om de witte ontwikkeling te storen: een solide, eenvoudige verdediging.
opening.family.bogo_indian.beginner.spoken = Zwart geeft schaak met de loper op bee vier om de witte ontwikkeling te storen: een solide, eenvoudige verdediging.
opening.family.bogo_indian.advanced = Meestal een loperruil op d2 of een structuur zoals in het Nimzo-Indisch, maar zonder penning; Zwart streeft naar een solide opstelling met d5, of met d6 en e5.
opening.family.bogo_indian.advanced.spoken = Meestal een loperruil op dee twee of een structuur zoals in het Nimzo-Indisch, maar zonder penning; Zwart streeft naar een solide opstelling met dee vijf, of met dee zes en ee vijf.
opening.family.old_indian = Oud-Indische verdediging
opening.family.old_indian.def = de Oud-Indische verdediging
opening.family.old_indian.beginner = Zwart speelt d6 en e5 zonder fianchetto: een solide maar wat passieve verdediging.
opening.family.old_indian.beginner.spoken = Zwart speelt dee zes en ee vijf zonder fianchetto: een solide maar wat passieve verdediging.
opening.family.old_indian.advanced = Een Konings-Indische opstelling met de loper op e7: solide maar krap, met centrumspel rond e5.
opening.family.old_indian.advanced.spoken = Een Konings-Indische opstelling met de loper op ee zeven: solide maar krap, met centrumspel rond ee vijf.
opening.family.chigorin = Tsjigorin-verdediging
opening.family.chigorin.def = de Tsjigorin-verdediging
opening.family.chigorin.beginner = Zwart ontwikkelt tegen het damegambiet het damepaard naar c6 en speelt op actieve stukken.
opening.family.chigorin.beginner.spoken = Zwart ontwikkelt tegen het damegambiet het damepaard naar cee zes en speelt op actieve stukken.
opening.family.chigorin.advanced = Zwart ruilt stevigheid in het centrum in voor actieve stukken en geeft vaak de witveldige loper voor het paard op f3 om druk te zetten op d4.
opening.family.chigorin.advanced.spoken = Zwart ruilt stevigheid in het centrum in voor actieve stukken en geeft vaak de witveldige loper voor het paard op ef drie om druk te zetten op dee vier.
opening.family.albin = Albin-tegengambiet
opening.family.albin.def = het Albin-tegengambiet
opening.family.albin.beginner = Zwart antwoordt met een tegenoffer van de e-pion om door te stoten naar d4 en Wit in te snoeren: scherp en vol valstrikken.
opening.family.albin.beginner.spoken = Zwart antwoordt met een tegenoffer van de ee-pion om door te stoten naar dee vier en Wit in te snoeren: scherp en vol valstrikken.
opening.family.albin.advanced = Zwart rekent op de pionnenwig op d4 en een snelle ontwikkeling; voor Wit is rustig ontwikkelen met een fianchetto het beste, waarbij materiaal zo nodig wordt teruggegeven.
opening.family.albin.advanced.spoken = Zwart rekent op de pionnenwig op dee vier en een snelle ontwikkeling; voor Wit is rustig ontwikkelen met een fianchetto het beste, waarbij materiaal zo nodig wordt teruggegeven.
opening.family.latvian = Lets gambiet
opening.family.latvian.def = het Letse gambiet
opening.family.latvian.beginner = Zwart speelt f5 al in de tweede zet: een zeer riskant gambiet dat de eigen koning verzwakt.
opening.family.latvian.beginner.spoken = Zwart speelt ef vijf al in de tweede zet: een zeer riskant gambiet dat de eigen koning verzwakt.
opening.family.latvian.advanced = Objectief twijfelachtig: Wit krijgt een sterk initiatief door op e5 te slaan of met de loper op c4.
opening.family.latvian.advanced.spoken = Objectief twijfelachtig: Wit krijgt een sterk initiatief door op ee vijf te slaan of met de loper op cee vier.
opening.family.elephant = Olifantengambiet
opening.family.elephant.def = het olifantengambiet
opening.family.elephant.beginner = Zwart gaat meteen in de tegenaanval met d5 en biedt een pion aan om lijnen te openen: riskant maar verraderlijk.
opening.family.elephant.beginner.spoken = Zwart gaat meteen in de tegenaanval met dee vijf en biedt een pion aan om lijnen te openen: riskant maar verraderlijk.
opening.family.elephant.advanced = Objectief incorrect: na de ruil op d5 houdt Wit met een zorgvuldige ontwikkeling een goede stelling.
opening.family.elephant.advanced.spoken = Objectief incorrect: na de ruil op dee vijf houdt Wit met een zorgvuldige ontwikkeling een goede stelling.
opening.family.nimzo_larsen = Nimzowitsch-Larsen-aanval
opening.family.nimzo_larsen.spoken = Nimzowitsch-Larsen-aanval
opening.family.nimzo_larsen.def = de Nimzowitsch-Larsen-aanval
opening.family.nimzo_larsen.def.spoken = de Nimzowitsch-Larsen-aanval
opening.family.nimzo_larsen.beginner = Wit zet na b3 de dameloper op de lange diagonaal om e5 en het centrum van veraf te beheersen.
opening.family.nimzo_larsen.beginner.spoken = Wit zet na bee drie de dameloper op de lange diagonaal om ee vijf en het centrum van veraf te beheersen.
opening.family.nimzo_larsen.advanced = Een hypermoderne flankopstelling: Zwart bezet het centrum met e5 of d5, en Wit zet er druk op met de loper, e3, en f4 of c4.
opening.family.nimzo_larsen.advanced.spoken = Een hypermoderne flankopstelling: Zwart bezet het centrum met ee vijf of dee vijf, en Wit zet er druk op met de loper, ee drie, en ef vier of cee vier.
opening.family.polish = Poolse opening
opening.family.polish.def = de Poolse opening
opening.family.polish.beginner = Wit begint met b4, een ongebruikelijke vleugelzet die ruimte wint op de damevleugel.
opening.family.polish.beginner.spoken = Wit begint met bee vier, een ongebruikelijke vleugelzet die ruimte wint op de damevleugel.
opening.family.polish.advanced = De loper gaat naar b2, achter de pion; de pion op b4 kan een doelwit worden, maar de opening is speelbaar en verrassend.
opening.family.polish.advanced.spoken = De loper gaat naar bee twee, achter de pion; de pion op bee vier kan een doelwit worden, maar de opening is speelbaar en verrassend.
opening.family.grob = Grob-opening
opening.family.grob.def = de Grob-opening
opening.family.grob.beginner = Wit speelt in de eerste zet de g-pion twee velden vooruit: een provocerende opening die de eigen koning verzwakt.
opening.family.grob.beginner.spoken = Wit speelt in de eerste zet de gee-pion twee velden vooruit: een provocerende opening die de eigen koning verzwakt.
opening.family.grob.advanced = Wit mikt op de lange diagonaal en b7; Zwart antwoordt met d5 en e5 en moet de verzwakte koningsvleugel afstraffen.
opening.family.grob.advanced.spoken = Wit mikt op de lange diagonaal en bee zeven; Zwart antwoordt met dee vijf en ee vijf en moet de verzwakte koningsvleugel afstraffen.
opening.family.hungarian = Hongaarse opening
opening.family.hungarian.def = de Hongaarse opening
opening.family.hungarian.beginner = Wit bereidt met g3 een fianchetto voor: een flexibel begin dat vaak een Konings-Indische aanval of een Engelse opening wordt.
opening.family.hungarian.beginner.spoken = Wit bereidt met gee drie een fianchetto voor: een flexibel begin dat vaak een Konings-Indische aanval of een Engelse opening wordt.
opening.family.hungarian.advanced = Zeer rijk aan zetverwisselingen: opstellingen uit de Réti-opening, het Engels en de Konings-Indische aanval, of een moderne verdediging met verwisselde kleuren.
opening.family.hungarian.advanced.spoken = Zeer rijk aan zetverwisselingen: opstellingen uit de Réti-opening, het Engels en de Konings-Indische aanval, of een moderne verdediging met verwisselde kleuren.
opening.family.mieses = Mieses-opening
opening.family.mieses.def = de Mieses-opening
opening.family.mieses.beginner = Wit begint heel bescheiden met d3: de weg voor de zwartveldige loper gaat open, maar het centrum blijft onbezet.
opening.family.mieses.beginner.spoken = Wit begint heel bescheiden met dee drie: de weg voor de zwartveldige loper gaat open, maar het centrum blijft onbezet.
opening.family.mieses.advanced = Deze opening leidt vaak tot opstellingen uit de Pirc-verdediging met verwisselde kleuren of uit de Konings-Indische aanval; Zwart kan vrij het centrum innemen.
opening.family.mieses.advanced.spoken = Deze opening leidt vaak tot opstellingen uit de Pirc-verdediging met verwisselde kleuren of uit de Konings-Indische aanval; Zwart kan vrij het centrum innemen.
opening.family.saragossa = Saragossa-opening
opening.family.saragossa.def = de Saragossa-opening
opening.family.saragossa.beginner = Wit begint met c3, een zeer zeldzame en rustige eerste zet.
opening.family.saragossa.beginner.spoken = Wit begint met cee drie, een zeer zeldzame en rustige eerste zet.
opening.family.saragossa.advanced = c3 bereidt een gesteunde opmars naar d4 voor en kan overgaan in structuren uit de Caro-Kann of het Slavisch met verwisselde kleuren.
opening.family.saragossa.advanced.spoken = cee drie bereidt een gesteunde opmars naar dee vier voor en kan overgaan in structuren uit de Caro-Kann of het Slavisch met verwisselde kleuren.
opening.family.van_geet = Van Geet-opening
opening.family.van_geet.def = de Van Geet-opening
opening.family.van_geet.beginner = Wit ontwikkelt eerst het damepaard, een ongebruikelijke zet die e4 of d4 achter de hand houdt.
opening.family.van_geet.beginner.spoken = Wit ontwikkelt eerst het damepaard, een ongebruikelijke zet die ee vier of dee vier achter de hand houdt.
opening.family.van_geet.advanced = Deze opening gaat vaak over in stellingen van het type Weens, omgekeerd Siciliaans of Pirc.
opening.family.van_geet.advanced.spoken = Deze opening gaat vaak over in stellingen van het type Weens, omgekeerd Siciliaans of Pirc.
opening.family.jobava_london = Rapport-Jobava-systeem
opening.family.jobava_london.spoken = Rapport-Jobava-systeem
opening.family.jobava_london.def = het Rapport-Jobava-systeem
opening.family.jobava_london.def.spoken = het Rapport-Jobava-systeem
opening.family.jobava_london.beginner = Wit combineert het paard op c3 met de loper op f4: een agressief systeem dat met een paardsprong naar b5 op c7 mikt.
opening.family.jobava_london.beginner.spoken = Wit combineert het paard op cee drie met de loper op ef vier: een agressief systeem dat met een paardsprong naar bee vijf op cee zeven mikt.
opening.family.jobava_london.advanced = Wit rokeert vaak lang en valt aan met h4 of g4; Zwart moet letten op c7 en de opmars naar e4.
opening.family.jobava_london.advanced.spoken = Wit rokeert vaak lang en valt aan met ha vier of gee vier; Zwart moet letten op cee zeven en de opmars naar ee vier.
opening.family.stonewall_attack = Stonewall-aanval
opening.family.stonewall_attack.def = de Stonewall-aanval
opening.family.stonewall_attack.beginner = Wit zet pionnen op d4, e3 en f4 en de loper op d3, en mikt op een aanval op de koningsvleugel met een paard op e5.
opening.family.stonewall_attack.beginner.spoken = Wit zet pionnen op dee vier, ee drie en ef vier en de loper op dee drie, en mikt op een aanval op de koningsvleugel met een paard op ee vijf.
opening.family.stonewall_attack.advanced = e5 is stevig in handen, maar e4 en c4 worden zwak; voor Zwart is het beste snel c5 te spelen of de witveldige loper van Wit af te ruilen.
opening.family.stonewall_attack.advanced.spoken = ee vijf is stevig in handen, maar ee vier en cee vier worden zwak; voor Zwart is het beste snel cee vijf te spelen of de witveldige loper van Wit af te ruilen.
opening.family.richter_veresov = Richter-Veresov-aanval
opening.family.richter_veresov.spoken = Richter-Veresov-aanval
opening.family.richter_veresov.def = de Richter-Veresov-aanval
opening.family.richter_veresov.def.spoken = de Richter-Veresov-aanval
opening.family.richter_veresov.beginner = Wit ontwikkelt vroeg het damepaard naar c3 en de loper naar g5, en werkt naar e4 toe.
opening.family.richter_veresov.beginner.spoken = Wit ontwikkelt vroeg het damepaard naar cee drie en de loper naar gee vijf, en werkt naar ee vier toe.
opening.family.richter_veresov.advanced = Het paard blokkeert de c-pion maar steunt f3 en e4; Zwart doet het goed met c5, of met de loper naar f5.
opening.family.richter_veresov.advanced.spoken = Het paard blokkeert de cee-pion maar steunt ef drie en ee vier; Zwart doet het goed met cee vijf, of met de loper naar ef vijf.
opening.family.st_george = Sint-Joris-verdediging
opening.family.st_george.def = de Sint-Joris-verdediging
opening.family.st_george.beginner = Zwart begint met a6 en b5, een zeldzame vleugelopstelling die beroemd werd door de overwinning van Miles op Karpov.
opening.family.st_george.beginner.spoken = Zwart begint met aa zes en bee vijf, een zeldzame vleugelopstelling die beroemd werd door de overwinning van Miles op Karpov.
opening.family.st_george.advanced = Zwart streeft naar een loper op b7 en uitbreiding op de damevleugel, en geeft het centrum op; Wit houdt met eenvoudige ontwikkeling in het centrum een klein voordeel.
opening.family.st_george.advanced.spoken = Zwart streeft naar een loper op bee zeven en uitbreiding op de damevleugel, en geeft het centrum op; Wit houdt met eenvoudige ontwikkeling in het centrum een klein voordeel.
opening.family.borg = Borg-verdediging
opening.family.borg.def = de Borg-verdediging
opening.family.borg.beginner = Zwart speelt de g-pion twee velden vooruit: een provocerende opening die de eigen koning verzwakt.
opening.family.borg.beginner.spoken = Zwart speelt de gee-pion twee velden vooruit: een provocerende opening die de eigen koning verzwakt.
opening.family.borg.advanced = De Grob-opening met verwisselde kleuren; Wit wint ruimte en tijd met d4 en druk op g5.
opening.family.borg.advanced.spoken = De Grob-opening met verwisselde kleuren; Wit wint ruimte en tijd met dee vier en druk op gee vijf.
opening.family.hippopotamus = Nijlpaardverdediging
opening.family.hippopotamus.def = de nijlpaardverdediging
opening.family.hippopotamus.beginner = Zwart zet de pionnen op de zesde rij, fianchetteert beide lopers en wacht tot Wit zich vergaloppeert.
opening.family.hippopotamus.advanced = Een flexibele, afwachtende opstelling: degelijk tegen rustig spel, krap tegen een breed centrum.
opening.family.english_defense = Engelse verdediging
opening.family.english_defense.def = de Engelse verdediging
opening.family.english_defense.beginner = Zwart antwoordt met b6 en de loper op b7 om met stukken om e4 te vechten.
opening.family.english_defense.beginner.spoken = Zwart antwoordt met bee zes en de loper op bee zeven om met stukken om ee vier te vechten.
opening.family.english_defense.advanced = Zwart nodigt Wit uit tot een groot centrum en valt het dan aan met een loperschaak op b4, met f5 en met druk op e4.
opening.family.english_defense.advanced.spoken = Zwart nodigt Wit uit tot een groot centrum en valt het dan aan met een loperschaak op bee vier, met ef vijf en met druk op ee vier.
opening.family.pterodactyl = Pterodactylus-verdediging
opening.family.pterodactyl.def = de pterodactylus-verdediging
opening.family.pterodactyl.beginner = Zwart fianchetteert de koningsloper, speelt dan c5 en brengt de dame vroeg naar a5: een ongewoon, agressief systeem.
opening.family.pterodactyl.beginner.spoken = Zwart fianchetteert de koningsloper, speelt dan cee vijf en brengt de dame vroeg naar aa vijf: een ongewoon, agressief systeem.
opening.family.pterodactyl.advanced = Een mengeling van ideeën uit de moderne verdediging en het Siciliaans: de dame op a5 valt via de diagonaal het paard op c3 aan.
opening.family.pterodactyl.advanced.spoken = Een mengeling van ideeën uit de moderne verdediging en het Siciliaans: de dame op aa vijf valt via de diagonaal het paard op cee drie aan.
opening.family.bongcloud = Bongcloud-aanval
opening.family.bongcloud.def = de Bongcloud-aanval
opening.family.bongcloud.beginner = Wit speelt in de tweede zet met de koning: een grapopening die de basisregels breekt, want de koning moet veilig blijven en rokeren.
opening.family.bongcloud.advanced = De koning staat de loper en de dame in de weg en geeft de rokade op; deze opening wordt als grap gespeeld en is geen voorbeeld om na te volgen.

# ---- Notable variations
opening.variation.open_sicilian = Open Siciliaans
opening.variation.open_sicilian.def = het open Siciliaans
opening.variation.open_sicilian.advanced = Wit opent het centrum met d4 en slaat terug met het paard: het belangrijkste strijdtoneel van het Siciliaans, scherp en vol theorie.
opening.variation.open_sicilian.advanced.spoken = Wit opent het centrum met dee vier en slaat terug met het paard: het belangrijkste strijdtoneel van het Siciliaans, scherp en vol theorie.
opening.variation.closed_sicilian = Gesloten Siciliaans
opening.variation.closed_sicilian.def = het gesloten Siciliaans
opening.variation.closed_sicilian.advanced = Wit vermijdt d4, fianchetteert op g2 en speelt vaak f4, met het oog op een langzame aanval op de koningsvleugel.
opening.variation.closed_sicilian.advanced.spoken = Wit vermijdt dee vier, fianchetteert op gee twee en speelt vaak ef vier, met het oog op een langzame aanval op de koningsvleugel.
opening.variation.alapin = Alapin-variant
opening.variation.alapin.def = de Alapin-variant
opening.variation.alapin.advanced = c3 bereidt d4 voor om een volledig pionnencentrum op te bouwen en de hoofdtheorie van het Siciliaans te omzeilen; Zwart antwoordt met d5 of het paard naar f6.
opening.variation.alapin.advanced.spoken = cee drie bereidt dee vier voor om een volledig pionnencentrum op te bouwen en de hoofdtheorie van het Siciliaans te omzeilen; Zwart antwoordt met dee vijf of het paard naar ef zes.
opening.variation.smith_morra = Smith-Morra-gambiet
opening.variation.smith_morra.def = het Smith-Morra-gambiet
opening.variation.smith_morra.beginner = Wit geeft een pion om snel te ontwikkelen en lijnen te openen tegen de zwarte koning: Zwart moet zorgvuldig ontwikkelen.
opening.variation.smith_morra.advanced = Een pion voor een snelle ontwikkeling en de open c-lijn en d-lijn; Zwart ontwikkelt degelijk en geeft de pion vaak op het juiste moment terug.
opening.variation.smith_morra.advanced.spoken = Een pion voor een snelle ontwikkeling en de open cee-lijn en dee-lijn; Zwart ontwikkelt degelijk en geeft de pion vaak op het juiste moment terug.
opening.variation.grand_prix = Grand Prix-aanval
opening.variation.grand_prix.def = de Grand Prix-aanval
opening.variation.grand_prix.advanced = Wit speelt het paard naar c3 en f4 voor een snelle aanval op de koningsvleugel met f5, en vermijdt zo het open Siciliaans.
opening.variation.grand_prix.advanced.spoken = Wit speelt het paard naar cee drie en ef vier voor een snelle aanval op de koningsvleugel met ef vijf, en vermijdt zo het open Siciliaans.
opening.variation.rossolimo = Rossolimo-variant
opening.variation.rossolimo.def = de Rossolimo-variant
opening.variation.rossolimo.advanced = De loper op b5 pent het paard op c6 of ruilt het af, om Zwart dubbelpionnen te bezorgen en de partij positioneel te houden.
opening.variation.rossolimo.advanced.spoken = De loper op bee vijf pent het paard op cee zes of ruilt het af, om Zwart dubbelpionnen te bezorgen en de partij positioneel te houden.
opening.variation.najdorf = Najdorf-variant
opening.variation.najdorf.spoken = Najdorf-variant
opening.variation.najdorf.def = de Najdorf-variant
opening.variation.najdorf.def.spoken = de Najdorf-variant
opening.variation.najdorf.advanced = a6 maakt er het beroemdste Siciliaans van: flexibel en diepgaand, met structuren met e5 of e6 tegen de scherpe aanvallen van Wit.
opening.variation.najdorf.advanced.spoken = aa zes maakt er het beroemdste Siciliaans van: flexibel en diepgaand, met structuren met ee vijf of ee zes tegen de scherpe aanvallen van Wit.
opening.variation.dragon = Drakenvariant
opening.variation.dragon.def = de drakenvariant
opening.variation.dragon.advanced = Zwart fianchetteert op g7; de Joegoslavische aanval leidt tot beroemde wedlopen tussen aanvallen op tegenovergestelde vleugels.
opening.variation.dragon.advanced.spoken = Zwart fianchetteert op gee zeven; de Joegoslavische aanval leidt tot beroemde wedlopen tussen aanvallen op tegenovergestelde vleugels.
opening.variation.accelerated_dragon = Versnelde draak
opening.variation.accelerated_dragon.def = de versnelde draak
opening.variation.accelerated_dragon.advanced = Zwart fianchetteert vóór d6 om d5 in één keer te kunnen spelen; de Maróczy-opstelling met c4 is het positionele tegengif van Wit.
opening.variation.accelerated_dragon.advanced.spoken = Zwart fianchetteert vóór dee zes om dee vijf in één keer te kunnen spelen; de Maróczy-opstelling met cee vier is het positionele tegengif van Wit.
opening.variation.scheveningen = Scheveningse variant
opening.variation.scheveningen.spoken = Scheveningse variant
opening.variation.scheveningen.def = de Scheveningse variant
opening.variation.scheveningen.def.spoken = de Scheveningse variant
opening.variation.scheveningen.advanced = Zwart bouwt het kleine centrum met e6 en d6, een flexibel verdedigingsbolwerk; Wit valt vaak aan met g4.
opening.variation.scheveningen.advanced.spoken = Zwart bouwt het kleine centrum met ee zes en dee zes, een flexibel verdedigingsbolwerk; Wit valt vaak aan met gee vier.
opening.variation.sveshnikov = Svesjnikov-variant
opening.variation.sveshnikov.def = de Svesjnikov-variant
opening.variation.sveshnikov.advanced = Zwart speelt e5 en accepteert een gat op d5 en een achtergebleven d-pion in ruil voor activiteit en het loperpaar: zeer dynamisch.
opening.variation.sveshnikov.advanced.spoken = Zwart speelt ee vijf en accepteert een gat op dee vijf en een achtergebleven dee-pion in ruil voor activiteit en het loperpaar: zeer dynamisch.
opening.variation.taimanov = Tajmanov-variant
opening.variation.taimanov.def = de Tajmanov-variant
opening.variation.taimanov.advanced = Zwart combineert e6 en het paard op c6 met flexibele zetten als a6 en de dame naar c7, en houdt d6 achter de hand.
opening.variation.taimanov.advanced.spoken = Zwart combineert ee zes en het paard op cee zes met flexibele zetten als aa zes en de dame naar cee zeven, en houdt dee zes achter de hand.
opening.variation.kan = Kan-variant
opening.variation.kan.def = de Kan-variant
opening.variation.kan.advanced = Zwart speelt e6 en a6, laat de paarden nog thuis en mikt vaak op een egelstelling.
opening.variation.kan.advanced.spoken = Zwart speelt ee zes en aa zes, laat de paarden nog thuis en mikt vaak op een egelstelling.
opening.variation.classical_sicilian = Klassieke variant
opening.variation.classical_sicilian.def = de klassieke variant
opening.variation.classical_sicilian.advanced = Zwart ontwikkelt beide paarden en speelt d6; de belangrijkste antwoorden van Wit zijn de Richter-Rauzer-aanval en de Sozin-aanval.
opening.variation.classical_sicilian.advanced.spoken = Zwart ontwikkelt beide paarden en speelt dee zes; de belangrijkste antwoorden van Wit zijn de Richter-Rauzer-aanval en de Sozin-aanval.
opening.variation.french_advance = Doorschuifvariant
opening.variation.french_advance.def = de doorschuifvariant
opening.variation.french_advance.advanced = Wit sluit het centrum met e5 en wint ruimte; Zwart valt d4, de basis van de keten, aan met c5 en stukken.
opening.variation.french_advance.advanced.spoken = Wit sluit het centrum met ee vijf en wint ruimte; Zwart valt dee vier, de basis van de keten, aan met cee vijf en stukken.
opening.variation.french_exchange = Ruilvariant
opening.variation.french_exchange.def = de ruilvariant
opening.variation.french_exchange.advanced = De pionruil op d5 haalt de spanning eruit: een symmetrische, rustige structuur waarin de witveldige loper van Zwart vrijkomt.
opening.variation.french_exchange.advanced.spoken = De pionruil op dee vijf haalt de spanning eruit: een symmetrische, rustige structuur waarin de witveldige loper van Zwart vrijkomt.
opening.variation.french_tarrasch = Tarrasch-variant
opening.variation.french_tarrasch.def = de Tarrasch-variant
opening.variation.french_tarrasch.advanced = Het paard gaat naar d2 om de penning van de Winawer-variant te vermijden; Zwart accepteert na c5 vaak een geïsoleerde d-pion, of sluit het centrum.
opening.variation.french_tarrasch.advanced.spoken = Het paard gaat naar dee twee om de penning van de Winawer-variant te vermijden; Zwart accepteert na cee vijf vaak een geïsoleerde dee-pion, of sluit het centrum.
opening.variation.winawer = Winawer-variant
opening.variation.winawer.spoken = Winawer-variant
opening.variation.winawer.def = de Winawer-variant
opening.variation.winawer.def.spoken = de Winawer-variant
opening.variation.winawer.advanced = De loper op b4 pent het paard; Zwart geeft meestal loper voor paard, waarna Wit dubbelpionnen heeft, maar ook het loperpaar.
opening.variation.winawer.advanced.spoken = De loper op bee vier pent het paard; Zwart geeft meestal loper voor paard, waarna Wit dubbelpionnen heeft, maar ook het loperpaar.
opening.variation.french_classical = Klassieke variant
opening.variation.french_classical.def = de klassieke variant
opening.variation.french_classical.advanced = Zwart ontwikkelt het paard naar f6; het spel draait om de pionnenketen met e5 en de penning door een loper op g5.
opening.variation.french_classical.advanced.spoken = Zwart ontwikkelt het paard naar ef zes; het spel draait om de pionnenketen met ee vijf en de penning door een loper op gee vijf.
opening.variation.french_rubinstein = Rubinstein-variant
opening.variation.french_rubinstein.def = de Rubinstein-variant
opening.variation.french_rubinstein.advanced = Zwart slaat op e4 en geeft het centrum op voor een solide, compacte stelling, en mikt later op c5.
opening.variation.french_rubinstein.advanced.spoken = Zwart slaat op ee vier en geeft het centrum op voor een solide, compacte stelling, en mikt later op cee vijf.
opening.variation.ck_advance = Doorschuifvariant
opening.variation.ck_advance.def = de doorschuifvariant
opening.variation.ck_advance.advanced = Wit wint ruimte met e5; Zwart ontwikkelt de loper naar f5 vóór e6 en vecht terug met c5.
opening.variation.ck_advance.advanced.spoken = Wit wint ruimte met ee vijf; Zwart ontwikkelt de loper naar ef vijf vóór ee zes en vecht terug met cee vijf.
opening.variation.ck_exchange = Ruilvariant
opening.variation.ck_exchange.def = de ruilvariant
opening.variation.ck_exchange.advanced = Een Karlsbad-structuur met verwisselde kleuren: Wit stelt zich op de koningsvleugel op, Zwart speelt op een minderheidsaanval op de damevleugel.
opening.variation.ck_panov = Panov-aanval
opening.variation.ck_panov.def = de Panov-aanval
opening.variation.ck_panov.advanced = Wit speelt c4 en accepteert een geïsoleerde d-pion in ruil voor actieve stukken en aanvalskansen.
opening.variation.ck_panov.advanced.spoken = Wit speelt cee vier en accepteert een geïsoleerde dee-pion in ruil voor actieve stukken en aanvalskansen.
opening.variation.ck_classical = Klassieke variant
opening.variation.ck_classical.def = de klassieke variant
opening.variation.ck_classical.advanced = De loper komt met tempowinst tegen het paard naar f5; Wit wint ruimte met h4 en h5, en tegengestelde rokades komen veel voor.
opening.variation.ck_classical.advanced.spoken = De loper komt met tempowinst tegen het paard naar ef vijf; Wit wint ruimte met ha vier en ha vijf, en tegengestelde rokades komen veel voor.
opening.variation.ck_two_knights = Tweepaardenaanval
opening.variation.ck_two_knights.def = de tweepaardenaanval
opening.variation.ck_two_knights.advanced = Wit ontwikkelt beide paarden vóór d4, blijft flexibel en vermijdt de hoofdvarianten.
opening.variation.ck_two_knights.advanced.spoken = Wit ontwikkelt beide paarden vóór dee vier, blijft flexibel en vermijdt de hoofdvarianten.
opening.variation.two_knights = Tweepaardenspel
opening.variation.two_knights.def = het tweepaardenspel
opening.variation.two_knights.beginner = Zwart gaat met het paard in de tegenaanval op e4 in plaats van Wit na te doen; let op de paardsprong naar g5, die f7 aanvalt.
opening.variation.two_knights.beginner.spoken = Zwart gaat met het paard in de tegenaanval op ee vier in plaats van Wit na te doen; let op de paardsprong naar gee vijf, die ef zeven aanvalt.
opening.variation.two_knights.advanced = Het actiefste antwoord van Zwart op het Italiaans: het nodigt uit tot de scherpe paardsprong naar g5 of tot rustig spel met d3.
opening.variation.two_knights.advanced.spoken = Het actiefste antwoord van Zwart op het Italiaans: het nodigt uit tot de scherpe paardsprong naar gee vijf of tot rustig spel met dee drie.
opening.variation.giuoco_piano = Giuoco Piano
opening.variation.giuoco_piano.spoken = Giuoco Piano
opening.variation.giuoco_piano.def = het Giuoco Piano
opening.variation.giuoco_piano.def.spoken = het Giuoco Piano
