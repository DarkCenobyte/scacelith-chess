opening.variation.meran.advanced.spoken = Zwart slaat op cee vier en wint met bee vijf ruimte en tempo op de damevleugel; het spel draait om de doorbraak cee vijf en de opmars van Wit naar ee vijf.
opening.variation.kid_classical = Klassieke variant
opening.variation.kid_classical.def = de klassieke variant
opening.variation.kid_classical.advanced = Wit ontwikkelt rustig en rokeert; na e5 en d5 begint de beroemde wedloop, Wit op de damevleugel, Zwart op de koningsvleugel.
opening.variation.kid_classical.advanced.spoken = Wit ontwikkelt rustig en rokeert; na ee vijf en dee vijf begint de beroemde wedloop, Wit op de damevleugel, Zwart op de koningsvleugel.
opening.variation.kid_samisch = Sämisch-variant
opening.variation.kid_samisch.spoken = Sämisch-variant
opening.variation.kid_samisch.def = de Sämisch-variant
opening.variation.kid_samisch.def.spoken = de Sämisch-variant
opening.variation.kid_samisch.advanced = f3 steunt e4 en bereidt een pionnenstorm op de koningsvleugel voor; Zwart antwoordt met c5, e5 of een plan op de damevleugel met b5.
opening.variation.kid_samisch.advanced.spoken = ef drie steunt ee vier en bereidt een pionnenstorm op de koningsvleugel voor; Zwart antwoordt met cee vijf, ee vijf of een plan op de damevleugel met bee vijf.
opening.variation.kid_four_pawns = Vierpionnenaanval
opening.variation.kid_four_pawns.def = de vierpionnenaanval
opening.variation.kid_four_pawns.advanced = Wit bouwt een muur van pionnen op c4, d4, e4 en f4; Zwart ondermijnt die meteen met c5 en e6.
opening.variation.kid_four_pawns.advanced.spoken = Wit bouwt een muur van pionnen op cee vier, dee vier, ee vier en ef vier; Zwart ondermijnt die meteen met cee vijf en ee zes.
opening.variation.kid_fianchetto = Fianchettovariant
opening.variation.kid_fianchetto.def = de fianchettovariant
opening.variation.kid_fianchetto.advanced = Met een fianchetto op g2 neutraliseert Wit de zwarte loper op g7, en de partij wordt positioneler.
opening.variation.kid_fianchetto.advanced.spoken = Met een fianchetto op gee twee neutraliseert Wit de zwarte loper op gee zeven, en de partij wordt positioneler.
opening.variation.nimzo_rubinstein = Rubinstein-variant
opening.variation.nimzo_rubinstein.def = de Rubinstein-variant
opening.variation.nimzo_rubinstein.advanced = e3 ontwikkelt rustig en houdt verschillende opstellingen achter de hand: de populairste manier om het Nimzo-Indisch te bestrijden.
opening.variation.nimzo_rubinstein.advanced.spoken = ee drie ontwikkelt rustig en houdt verschillende opstellingen achter de hand: de populairste manier om het Nimzo-Indisch te bestrijden.
opening.variation.nimzo_classical = Klassieke variant
opening.variation.nimzo_classical.def = de klassieke variant
opening.variation.nimzo_classical.advanced = De dame gaat naar c2 om op c3 terug te slaan zonder dubbelpionnen; Wit krijgt het loperpaar, Zwart een snelle ontwikkeling.
opening.variation.nimzo_classical.advanced.spoken = De dame gaat naar cee twee om op cee drie terug te slaan zonder dubbelpionnen; Wit krijgt het loperpaar, Zwart een snelle ontwikkeling.
opening.variation.nimzo_samisch = Sämisch-variant
opening.variation.nimzo_samisch.spoken = Sämisch-variant
opening.variation.nimzo_samisch.def = de Sämisch-variant
opening.variation.nimzo_samisch.def.spoken = de Sämisch-variant
opening.variation.nimzo_samisch.advanced = a3 dwingt meteen de ruil op c3 af: Wit accepteert dubbelpionnen voor het loperpaar en een groot centrum.
opening.variation.nimzo_samisch.advanced.spoken = aa drie dwingt meteen de ruil op cee drie af: Wit accepteert dubbelpionnen voor het loperpaar en een groot centrum.
opening.variation.grunfeld_exchange = Ruilvariant
opening.variation.grunfeld_exchange.def = de ruilvariant
opening.variation.grunfeld_exchange.advanced = Wit bouwt met e4 een groot centrum; Zwart valt d4 aan met c5 en stukken, en de eindspelen zijn vaak gunstig voor de zwarte meerderheid op de damevleugel.
opening.variation.grunfeld_exchange.advanced.spoken = Wit bouwt met ee vier een groot centrum; Zwart valt dee vier aan met cee vijf en stukken, en de eindspelen zijn vaak gunstig voor de zwarte meerderheid op de damevleugel.
opening.variation.leningrad = Leningrad-variant
opening.variation.leningrad.def = de Leningrad-variant
opening.variation.leningrad.advanced = Zwart fianchetteert op g7: een Hollandse verdediging in Konings-Indische stijl, waarin Zwart toewerkt naar e5 en naar spel op de koningsvleugel.
opening.variation.leningrad.advanced.spoken = Zwart fianchetteert op gee zeven: een Hollandse verdediging in Konings-Indische stijl, waarin Zwart toewerkt naar ee vijf en naar spel op de koningsvleugel.
opening.variation.stonewall_dutch = Stonewall-variant
opening.variation.stonewall_dutch.def = de Stonewall-variant
opening.variation.stonewall_dutch.advanced = Pionnen op c6, d5, e6 en f5 geven Zwart een ijzersterke greep op e4, ten koste van een gat op e5 en een passieve witveldige loper.
opening.variation.stonewall_dutch.advanced.spoken = Pionnen op cee zes, dee vijf, ee zes en ef vijf geven Zwart een ijzersterke greep op ee vier, ten koste van een gat op ee vijf en een passieve witveldige loper.
opening.variation.modern_benoni = Moderne Benoni
opening.variation.modern_benoni.def = de moderne Benoni
opening.variation.modern_benoni.advanced = Zwart krijgt een meerderheid op de damevleugel tegenover de witte meerderheid in het centrum; tactiek rond e5 en de loper op g7 overheerst.
opening.variation.modern_benoni.advanced.spoken = Zwart krijgt een meerderheid op de damevleugel tegenover de witte meerderheid in het centrum; tactiek rond ee vijf en de loper op gee zeven overheerst.
opening.variation.catalan_open = Open Catalaans
opening.variation.catalan_open.def = het open Catalaans
opening.variation.catalan_open.advanced = Zwart slaat de pion op c4; Wit wint hem terug en houdt druk op de lange diagonaal, terwijl Zwart mikt op c5 of b5.
opening.variation.catalan_open.advanced.spoken = Zwart slaat de pion op cee vier; Wit wint hem terug en houdt druk op de lange diagonaal, terwijl Zwart mikt op cee vijf of bee vijf.
opening.variation.catalan_closed = Gesloten Catalaans
opening.variation.catalan_closed.def = het gesloten Catalaans
opening.variation.catalan_closed.advanced = Zwart houdt de pion op d5 met een compacte opstelling: een langzame positionele strijd rond de bevrijdende doorbraken e5 of c5.
opening.variation.catalan_closed.advanced.spoken = Zwart houdt de pion op dee vijf met een compacte opstelling: een langzame positionele strijd rond de bevrijdende doorbraken ee vijf of cee vijf.
opening.variation.english_symmetrical = Symmetrische variant
opening.variation.english_symmetrical.def = de symmetrische variant
opening.variation.english_symmetrical.advanced = Zwart doet Wit na met c5: langzaam manoeuvreren met fianchetto's en druk op d4 en d5.
opening.variation.english_symmetrical.advanced.spoken = Zwart doet Wit na met cee vijf: langzaam manoeuvreren met fianchetto's en druk op dee vier en dee vijf.
opening.variation.kings_english = Omgekeerd Siciliaans
opening.variation.kings_english.def = het omgekeerde Siciliaans
opening.variation.kings_english.advanced = e5 maakt van de Engelse opening een Siciliaans met een tempo meer voor Wit; typische plannen zijn een fianchetto en een pionnenopmars op de damevleugel.
opening.variation.kings_english.advanced.spoken = ee vijf maakt van de Engelse opening een Siciliaans met een tempo meer voor Wit; typische plannen zijn een fianchetto en een pionnenopmars op de damevleugel.
opening.variation.alekhine_four_pawns = Vierpionnenaanval
opening.variation.alekhine_four_pawns.def = de vierpionnenaanval
opening.variation.alekhine_four_pawns.advanced = Wit jaagt het paard op met pionnen en bouwt een enorm maar overspannen centrum; Zwart reageert met c5 en stukken.
opening.variation.alekhine_four_pawns.advanced.spoken = Wit jaagt het paard op met pionnen en bouwt een enorm maar overspannen centrum; Zwart reageert met cee vijf en stukken.
opening.variation.alekhine_modern = Moderne variant
opening.variation.alekhine_modern.def = de moderne variant
opening.variation.alekhine_modern.advanced = Wit houdt een solide ruimtevoordeel zonder te ver door te schieten; Zwart pent het paard of fianchetteert.
opening.variation.pirc_austrian = Oostenrijkse aanval
opening.variation.pirc_austrian.def = de Oostenrijkse aanval
opening.variation.pirc_austrian.advanced = f4 bouwt een groot centrum op voor e5 of een aanval op de koningsvleugel; Zwart vecht terug met c5 of e5.
opening.variation.pirc_austrian.advanced.spoken = ef vier bouwt een groot centrum op voor ee vijf of een aanval op de koningsvleugel; Zwart vecht terug met cee vijf of ee vijf.
opening.variation.falkbeer = Falkbeer-tegengambiet
opening.variation.falkbeer.def = het Falkbeer-tegengambiet
opening.variation.falkbeer.advanced = d5 is een tegenstoot in het centrum in plaats van slaan op f4; de moderne praktijk geeft de voorkeur aan eerst slaan op d5.
opening.variation.falkbeer.advanced.spoken = dee vijf is een tegenstoot in het centrum in plaats van slaan op ef vier; de moderne praktijk geeft de voorkeur aan eerst slaan op dee vijf.

