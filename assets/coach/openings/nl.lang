opening.variation.marshall = Marshall-aanval
opening.variation.marshall.def = de Marshall-aanval
opening.variation.marshall.advanced = Zwart offert een pion met d5 voor een langdurige aanval op de koningsvleugel; diep geanalyseerd en aan de top een gerespecteerd remisewapen.
opening.variation.marshall.advanced.spoken = Zwart offert een pion met dee vijf voor een langdurige aanval op de koningsvleugel; diep geanalyseerd en aan de top een gerespecteerd remisewapen.
opening.variation.ruy_exchange = Ruilvariant
opening.variation.ruy_exchange.def = de ruilvariant
opening.variation.ruy_exchange.advanced = Slaan op c6 geeft Zwart het loperpaar, maar ook dubbelpionnen; Wit mikt op een eindspel met een gezonde meerderheid op de koningsvleugel.
opening.variation.ruy_exchange.advanced.spoken = Slaan op cee zes geeft Zwart het loperpaar, maar ook dubbelpionnen; Wit mikt op een eindspel met een gezonde meerderheid op de koningsvleugel.
opening.variation.ruy_open = Open Spaans
opening.variation.ruy_open.def = het open Spaans
