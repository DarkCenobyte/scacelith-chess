opening.family.kings_pawn = Kuningaetturi avang
opening.family.kings_pawn.def = kuningaetturi avang
opening.family.kings_pawn.beginner = Kuningaetturi käik kahe välja võrra haarab tsentri ning vabastab korraga lipu ja ühe oda: see on kõige populaarsem esimene käik.
opening.family.kings_pawn.beginner.spoken = Kuningaetturi käik kahe välja võrra haarab tsentri ning vabastab korraga lipu ja ühe oda: see on kõige populaarsem esimene käik.
