opening.family.trompowsky.beginner = Valge ründab kohe odaga ratsut väljal f6: varajane üllatus, mis viib musta tavalistelt radadelt kõrvale.
opening.family.trompowsky.beginner.spoken = Valge ründab kohe odaga ratsut väljal eff kuus: varajane üllatus, mis viib musta tavalistelt radadelt kõrvale.
opening.family.trompowsky.advanced = Oda ähvardab teha musta etturid kahekordseks; must vastab ratsuga väljale e4, käiguga e6 või c5 ning mäng muutub tasakaalustamata.
opening.family.trompowsky.advanced.spoken = Oda ähvardab teha musta etturid kahekordseks; must vastab ratsuga väljale ee neli, käiguga ee kuus või tsee viis ning mäng muutub tasakaalustamata.
opening.family.torre = Torre rünnak
opening.family.torre.def = Torre rünnak
opening.family.torre.beginner = Valge arendab oda väljale g5, et ratsu siduda, ja ehitab käikudega e3 ja c3 kindla tsentri.
opening.family.torre.beginner.spoken = Valge arendab oda väljale gee viis, et ratsu siduda, ja ehitab käikudega ee kolm ja tsee kolm kindla tsentri.
opening.family.torre.advanced = Süsteem, mis taotleb käiku e4, kui oda on väljal g5; must vastab tavaliselt käiguga c5 või varajase käiguga h6.
opening.family.torre.advanced.spoken = Süsteem, mis taotleb käiku ee neli, kui oda on väljal gee viis; must vastab tavaliselt käiguga tsee viis või varajase käiguga haa kuus.
opening.family.colle = Colle süsteem
opening.family.colle.def = Colle süsteem
opening.family.colle.beginner = Valge ehitab etturikolmnurga d4, e3 ja c3, viib oda väljale d3 ja valmistab ette käigu e4: lihtne ja kindel ründesüsteem.
opening.family.colle.beginner.spoken = Valge ehitab etturikolmnurga dee neli, ee kolm ja tsee kolm, viib oda väljale dee kolm ja valmistab ette käigu ee neli: lihtne ja kindel ründesüsteem.
opening.family.colle.advanced = Valge valmistab kuningatiivarünnakuks ette käigu e4 või arendab teise oda väljale b2; puuduseks on passiivne oda väljal c1.
opening.family.colle.advanced.spoken = Valge valmistab kuningatiivarünnakuks ette käigu ee neli või arendab teise oda väljale bee kaks; puuduseks on passiivne oda väljal tsee üks.
opening.family.tarrasch_def = Tarraschi kaitse
opening.family.tarrasch_def.def = Tarraschi kaitse
opening.family.tarrasch_def.beginner = Must mängib lipugambiidi vastu c5 ja nõustub isoleeritud etturiga, saades vastu vaba nuppudemängu.
opening.family.tarrasch_def.beginner.spoken = Must mängib lipugambiidi vastu tsee viis ja nõustub isoleeritud etturiga, saades vastu vaba nuppudemängu.
opening.family.tarrasch_def.advanced = Must võtab aktiivsuse nimel teadlikult isoleeritud lipuetturi; valge blokeerib välja d5 ja viib oda pikale diagonaalile, must otsib nuppudemängu ja läbimurret d4.
opening.family.tarrasch_def.advanced.spoken = Must võtab aktiivsuse nimel teadlikult isoleeritud lipuetturi; valge blokeerib välja dee viis ja viib oda pikale diagonaalile, must otsib nuppudemängu ja läbimurret dee neli.
opening.family.budapest = Budapesti gambiit
opening.family.budapest.def = Budapesti gambiit
opening.family.budapest.beginner = Must annab e-etturi, et kiiresti areneda; tavaliselt võidetakse ettur tagasi.
opening.family.budapest.beginner.spoken = Must annab ee-etturi, et kiiresti areneda; tavaliselt võidetakse ettur tagasi.
opening.family.budapest.advanced = Enamikus variantides võidab must etturi tagasi ratsuga väljal g4; valgel jääb väike eelis ning Fajarowiczi variant on trikirohkem kõrvalharu.
opening.family.budapest.advanced.spoken = Enamikus variantides võidab must etturi tagasi ratsuga väljal gee neli; valgel jääb väike eelis ning Fajarowiczi variant on trikirohkem kõrvalharu.
opening.family.bogo_indian = Bogo-India kaitse
opening.family.bogo_indian.spoken = Bogo-India kaitse
opening.family.bogo_indian.def = Bogo-India kaitse
opening.family.bogo_indian.def.spoken = Bogo-India kaitse
opening.family.bogo_indian.beginner = Must annab odaga väljalt b4 tuld, et segada valge arengut: kindel ja lihtne kaitse.
opening.family.bogo_indian.beginner.spoken = Must annab odaga väljalt bee neli tuld, et segada valge arengut: kindel ja lihtne kaitse.
opening.family.bogo_indian.advanced = Tavaliselt järgneb odade vahetus väljal d2 või Nimzo-India kaitsega sarnane struktuur ilma sidumiseta; must taotleb kindlat ülesehitust käiguga d5 või käikudega d6 ja e5.
opening.family.bogo_indian.advanced.spoken = Tavaliselt järgneb odade vahetus väljal dee kaks või Nimzo-India kaitsega sarnane struktuur ilma sidumiseta; must taotleb kindlat ülesehitust käiguga dee viis või käikudega dee kuus ja ee viis.
opening.family.old_indian = Vanaindia kaitse
opening.family.old_indian.def = vanaindia kaitse
opening.family.old_indian.beginner = Must mängib d6 ja e5, viimata oda pikale diagonaalile: kindel, kuid veidi passiivne kaitse.
opening.family.old_indian.beginner.spoken = Must mängib dee kuus ja ee viis, viimata oda pikale diagonaalile: kindel, kuid veidi passiivne kaitse.
opening.family.old_indian.advanced = Kuningaindia kaitsega sarnane seis, kus oda on väljal e7: kindel, kuid kitsas, ja mäng tsentris tugineb käigule e5.
opening.family.old_indian.advanced.spoken = Kuningaindia kaitsega sarnane seis, kus oda on väljal ee seitse: kindel, kuid kitsas, ja mäng tsentris tugineb käigule ee viis.
opening.family.chigorin = Tšigorini kaitse
opening.family.chigorin.def = Tšigorini kaitse
opening.family.chigorin.beginner = Must arendab lipugambiidi vastu lipuratsu väljale c6 ja taotleb aktiivseid nuppe.
opening.family.chigorin.beginner.spoken = Must arendab lipugambiidi vastu lipuratsu väljale tsee kuus ja taotleb aktiivseid nuppe.
opening.family.chigorin.advanced = Must loobub tsentri kindlusest nuppude aktiivsuse nimel ja vahetab sageli valgeväljalise oda ratsu vastu väljal f3, et avaldada survet väljale d4.
opening.family.chigorin.advanced.spoken = Must loobub tsentri kindlusest nuppude aktiivsuse nimel ja vahetab sageli valgeväljalise oda ratsu vastu väljal eff kolm, et avaldada survet väljale dee neli.
opening.family.albin = Albini vastugambiit
opening.family.albin.def = Albini vastugambiit
opening.family.albin.beginner = Must ohverdab vastuseks e-etturi, et tungida etturiga väljale d4 ja kitsendada valge mängu: terav ja lõkse täis.
opening.family.albin.beginner.spoken = Must ohverdab vastuseks ee-etturi, et tungida etturiga väljale dee neli ja kitsendada valge mängu: terav ja lõkse täis.
opening.family.albin.advanced = Must tugineb etturikiilule väljal d4 ja kiirele arengule; valge parim plaan on rahulik areng, oda viimine pikale diagonaalile ja vajadusel materjali tagasiandmine.
opening.family.albin.advanced.spoken = Must tugineb etturikiilule väljal dee neli ja kiirele arengule; valge parim plaan on rahulik areng, oda viimine pikale diagonaalile ja vajadusel materjali tagasiandmine.
opening.family.latvian = Läti gambiit
opening.family.latvian.def = Läti gambiit
opening.family.latvian.beginner = Must mängib teisel käigul f5: väga riskantne gambiit, mis nõrgestab musta enda kuningat.
opening.family.latvian.beginner.spoken = Must mängib teisel käigul eff viis: väga riskantne gambiit, mis nõrgestab musta enda kuningat.
opening.family.latvian.advanced = Objektiivselt kahtlane: valge saab tugeva initsiatiivi, kui lööb väljal e5 või viib oda väljale c4.
opening.family.latvian.advanced.spoken = Objektiivselt kahtlane: valge saab tugeva initsiatiivi, kui lööb väljal ee viis või viib oda väljale tsee neli.
opening.family.elephant = Elevandigambiit
opening.family.elephant.def = elevandigambiit
opening.family.elephant.beginner = Must lööb kohe vastu käiguga d5 ja pakub etturit, et liine avada: riskantne, kuid salakaval.
opening.family.elephant.beginner.spoken = Must lööb kohe vastu käiguga dee viis ja pakub etturit, et liine avada: riskantne, kuid salakaval.
opening.family.elephant.advanced = Objektiivselt ebakorrektne: pärast vahetust väljal d5 jääb valgel hoolika arenguga hea mäng.
opening.family.elephant.advanced.spoken = Objektiivselt ebakorrektne: pärast vahetust väljal dee viis jääb valgel hoolika arenguga hea mäng.
opening.family.nimzo_larsen = Nimzowitsch-Larseni rünnak
opening.family.nimzo_larsen.spoken = Nimzowitsch-Larseni rünnak
opening.family.nimzo_larsen.def = Nimzowitsch-Larseni rünnak
opening.family.nimzo_larsen.def.spoken = Nimzowitsch-Larseni rünnak
opening.family.nimzo_larsen.beginner = Pärast käiku b3 viib valge mustväljalise oda pikale diagonaalile, et kontrollida kaugelt välja e5 ja tsentrit.
opening.family.nimzo_larsen.beginner.spoken = Pärast käiku bee kolm viib valge mustväljalise oda pikale diagonaalile, et kontrollida kaugelt välja ee viis ja tsentrit.
opening.family.nimzo_larsen.advanced = Hüpermodernne tiivaülesehitus: must hõivab tsentri käiguga e5 või d5 ning valge avaldab sellele survet odaga ning käikudega e3 ja f4 või c4.
opening.family.nimzo_larsen.advanced.spoken = Hüpermodernne tiivaülesehitus: must hõivab tsentri käiguga ee viis või dee viis ning valge avaldab sellele survet odaga ning käikudega ee kolm ja eff neli või tsee neli.
opening.family.polish = Poola avang
opening.family.polish.def = Poola avang
opening.family.polish.beginner = Valge alustab käiguga b4, ebatavalise tiivakäiguga, mis võidab ruumi liputiival.
opening.family.polish.beginner.spoken = Valge alustab käiguga bee neli, ebatavalise tiivakäiguga, mis võidab ruumi liputiival.
opening.family.polish.advanced = Oda läheb etturi taha väljale b2; ettur b4 võib muutuda märklauaks, kuid avang on mängitav ja üllatav.
opening.family.polish.advanced.spoken = Oda läheb etturi taha väljale bee kaks; ettur bee neli võib muutuda märklauaks, kuid avang on mängitav ja üllatav.
opening.family.grob = Grobi avang
opening.family.grob.def = Grobi avang
opening.family.grob.beginner = Valge lükkab esimesel käigul g-etturi kahe välja võrra edasi: provokatiivne avang, mis nõrgestab valge enda kuningat.
opening.family.grob.beginner.spoken = Valge lükkab esimesel käigul gee-etturi kahe välja võrra edasi: provokatiivne avang, mis nõrgestab valge enda kuningat.
opening.family.grob.advanced = Valge sihib pikka diagonaali ja välja b7; must vastab käikudega d5 ja e5 ning peaks valget nõrgestatud kuningatiiva eest karistama.
opening.family.grob.advanced.spoken = Valge sihib pikka diagonaali ja välja bee seitse; must vastab käikudega dee viis ja ee viis ning peaks valget nõrgestatud kuningatiiva eest karistama.
opening.family.hungarian = Ungari avang
opening.family.hungarian.def = Ungari avang
opening.family.hungarian.beginner = Valge valmistab käiguga g3 ette oda viimise väljale g2: paindlik algus, millest saab sageli kuningaindia rünnak või Inglise avang.
opening.family.hungarian.beginner.spoken = Valge valmistab käiguga gee kolm ette oda viimise väljale gee kaks: paindlik algus, millest saab sageli kuningaindia rünnak või Inglise avang.
opening.family.hungarian.advanced = Sellest saab väga sageli mõni teine avang: Réti avangu, Inglise avangu või kuningaindia rünnaku ülesehitus või vahetatud värvidega moodne kaitse.
opening.family.hungarian.advanced.spoken = Sellest saab väga sageli mõni teine avang: Réti avangu, Inglise avangu või kuningaindia rünnaku ülesehitus või vahetatud värvidega moodne kaitse.
opening.family.mieses = Miesesi avang
opening.family.mieses.def = Miesesi avang
opening.family.mieses.beginner = Valge alustab väga tagasihoidlikult käiguga d3, mis avab mustväljalisele odale tee, kuid ei haara tsentrit.
opening.family.mieses.beginner.spoken = Valge alustab väga tagasihoidlikult käiguga dee kolm, mis avab mustväljalisele odale tee, kuid ei haara tsentrit.
opening.family.mieses.advanced = See viib sageli vahetatud värvidega Pirci kaitse või kuningaindia rünnaku ülesehitusteni; must võib vabalt tsentri hõivata.
opening.family.mieses.advanced.spoken = See viib sageli vahetatud värvidega Pirci kaitse või kuningaindia rünnaku ülesehitusteni; must võib vabalt tsentri hõivata.
opening.family.saragossa = Zaragoza avang
opening.family.saragossa.def = Zaragoza avang
opening.family.saragossa.beginner = Valge alustab käiguga c3, mis on väga haruldane ja rahulik esimene käik.
opening.family.saragossa.beginner.spoken = Valge alustab käiguga tsee kolm, mis on väga haruldane ja rahulik esimene käik.
opening.family.saragossa.advanced = Käik c3 valmistab ette toetatud käigu d4 ja võib viia vahetatud värvidega Caro-Kanni või Slaavi kaitse struktuurideni.
opening.family.saragossa.advanced.spoken = Käik tsee kolm valmistab ette toetatud käigu dee neli ja võib viia vahetatud värvidega Caro-Kanni või Slaavi kaitse struktuurideni.
opening.family.van_geet = Van Geeti avang
opening.family.van_geet.def = Van Geeti avang
opening.family.van_geet.beginner = Valge arendab esimesena lipuratsu: ebatavaline käik, mis hoiab käigu e4 või d4 tagavaraks.
opening.family.van_geet.beginner.spoken = Valge arendab esimesena lipuratsu: ebatavaline käik, mis hoiab käigu ee neli või dee neli tagavaraks.
opening.family.van_geet.advanced = Sellest saab sageli Viini partii, vahetatud värvidega Sitsiilia kaitse või Pirci kaitse tüüpi seis.
opening.family.van_geet.advanced.spoken = Sellest saab sageli Viini partii, vahetatud värvidega Sitsiilia kaitse või Pirci kaitse tüüpi seis.
opening.family.jobava_london = Jobava Londoni süsteem
opening.family.jobava_london.spoken = Jobava Londoni süsteem
opening.family.jobava_london.def = Jobava Londoni süsteem
opening.family.jobava_london.def.spoken = Jobava Londoni süsteem
opening.family.jobava_london.beginner = Valge ühendab ratsu väljal c3 odaga väljal f4: agressiivne süsteem, kus ratsu hüppab väljale b5 ja sihib välja c7.
opening.family.jobava_london.beginner.spoken = Valge ühendab ratsu väljal tsee kolm odaga väljal eff neli: agressiivne süsteem, kus ratsu hüppab väljale bee viis ja sihib välja tsee seitse.
opening.family.jobava_london.advanced = Valge teeb sageli pika vangerduse ja ründab käiguga h4 või g4; must peab valvama välja c7 ja käiku e4.
opening.family.jobava_london.advanced.spoken = Valge teeb sageli pika vangerduse ja ründab käiguga haa neli või gee neli; must peab valvama välja tsee seitse ja käiku ee neli.
opening.family.stonewall_attack = Stonewalli rünnak
opening.family.stonewall_attack.def = Stonewalli rünnak
opening.family.stonewall_attack.beginner = Valge paigutab etturid väljadele d4, e3 ja f4 ning oda väljale d3, taotledes kuningatiivarünnakut ratsuga väljal e5.
opening.family.stonewall_attack.beginner.spoken = Valge paigutab etturid väljadele dee neli, ee kolm ja eff neli ning oda väljale dee kolm, taotledes kuningatiivarünnakut ratsuga väljal ee viis.
opening.family.stonewall_attack.advanced = Väli e5 on kindlalt kontrolli all, kuid väljad e4 ja c4 nõrgenevad; musta parim plaan on kiire käik c5 või valge valgeväljalise oda vahetamine.
opening.family.stonewall_attack.advanced.spoken = Väli ee viis on kindlalt kontrolli all, kuid väljad ee neli ja tsee neli nõrgenevad; musta parim plaan on kiire käik tsee viis või valge valgeväljalise oda vahetamine.
opening.family.richter_veresov = Richter-Veressovi rünnak
opening.family.richter_veresov.spoken = Richter-Veressovi rünnak
opening.family.richter_veresov.def = Richter-Veressovi rünnak
opening.family.richter_veresov.def.spoken = Richter-Veressovi rünnak
opening.family.richter_veresov.beginner = Valge arendab varakult lipuratsu väljale c3 ja oda väljale g5, taotledes käiku e4.
opening.family.richter_veresov.beginner.spoken = Valge arendab varakult lipuratsu väljale tsee kolm ja oda väljale gee viis, taotledes käiku ee neli.
opening.family.richter_veresov.advanced = Ratsu blokeerib c-etturi, kuid toetab käike f3 ja e4; mustal läheb hästi käiguga c5 või oda viimisega väljale f5.
opening.family.richter_veresov.advanced.spoken = Ratsu blokeerib tsee-etturi, kuid toetab käike eff kolm ja ee neli; mustal läheb hästi käiguga tsee viis või oda viimisega väljale eff viis.
opening.family.st_george = Püha Jüri kaitse
opening.family.st_george.def = Püha Jüri kaitse
opening.family.st_george.beginner = Must alustab käikudega a6 ja b5: haruldane tiivaülesehitus, mille tegi kuulsaks Milesi võit Karpovi üle.
opening.family.st_george.beginner.spoken = Must alustab käikudega aa kuus ja bee viis: haruldane tiivaülesehitus, mille tegi kuulsaks Milesi võit Karpovi üle.
opening.family.st_george.advanced = Must taotleb oda viimist väljale b7 ja laienemist liputiival ning loovutab tsentri; valge säilitab lihtsa tsentraalse arenguga eelise.
opening.family.st_george.advanced.spoken = Must taotleb oda viimist väljale bee seitse ja laienemist liputiival ning loovutab tsentri; valge säilitab lihtsa tsentraalse arenguga eelise.
opening.family.borg = Borgi kaitse
opening.family.borg.def = Borgi kaitse
opening.family.borg.beginner = Must lükkab g-etturi kahe välja võrra edasi: provokatiivne avang, mis nõrgestab musta enda kuningat.
opening.family.borg.beginner.spoken = Must lükkab gee-etturi kahe välja võrra edasi: provokatiivne avang, mis nõrgestab musta enda kuningat.
opening.family.borg.advanced = Grobi avang vahetatud värvidega; valge võidab ruumi ja aega käiguga d4 ning survega etturile g5.
opening.family.borg.advanced.spoken = Grobi avang vahetatud värvidega; valge võidab ruumi ja aega käiguga dee neli ning survega etturile gee viis.
opening.family.hippopotamus = Jõehobu kaitse
opening.family.hippopotamus.def = jõehobu kaitse
opening.family.hippopotamus.beginner = Must paigutab etturid kuuendale horisontaalile ja viib mõlemad odad pikkadele diagonaalidele, oodates, et valge end üle venitaks.
opening.family.hippopotamus.advanced = Paindlik ootav ülesehitus: kindel aeglase mängu vastu, kitsas laia tsentri vastu.
opening.family.english_defense = Inglise kaitse
opening.family.english_defense.def = Inglise kaitse
opening.family.english_defense.beginner = Must vastab käiguga b6, viib oda väljale b7 ja võitleb nuppudega välja e4 eest.
opening.family.english_defense.beginner.spoken = Must vastab käiguga bee kuus, viib oda väljale bee seitse ja võitleb nuppudega välja ee neli eest.
opening.family.english_defense.advanced = Must kutsub valget ehitama suurt tsentrit ja ründab seda siis odaga, mis annab väljalt b4 tuld, käiguga f5 ning survega etturile e4.
opening.family.english_defense.advanced.spoken = Must kutsub valget ehitama suurt tsentrit ja ründab seda siis odaga, mis annab väljalt bee neli tuld, käiguga eff viis ning survega etturile ee neli.
opening.family.pterodactyl = Pterodaktüli kaitse
opening.family.pterodactyl.def = pterodaktüli kaitse
opening.family.pterodactyl.beginner = Must viib mustväljalise oda väljale g7, mängib siis c5 ja toob lipu varakult väljale a5: ebatavaline agressiivne süsteem.
opening.family.pterodactyl.beginner.spoken = Must viib mustväljalise oda väljale gee seitse, mängib siis tsee viis ja toob lipu varakult väljale aa viis: ebatavaline agressiivne süsteem.
opening.family.pterodactyl.advanced = Moodsa kaitse ja Sitsiilia kaitse ideede segu: lipp väljal a5 ründab diagonaali kaudu ratsut väljal c3.
opening.family.pterodactyl.advanced.spoken = Moodsa kaitse ja Sitsiilia kaitse ideede segu: lipp väljal aa viis ründab diagonaali kaudu ratsut väljal tsee kolm.
opening.family.bongcloud = Bongcloudi rünnak
opening.family.bongcloud.def = Bongcloudi rünnak
opening.family.bongcloud.beginner = Valge käib teisel käigul kuningaga: naljaavang, mis rikub põhireegleid, sest kuningas peab olema kaitstud ja tuleb vangerdada.
opening.family.bongcloud.advanced = Kuningas sulgeb tee odale ja lipule ning valge loobub vangerdusest; seda mängitakse naljaga ja seda ei tasu järele teha.

# ---- Notable variations
opening.variation.open_sicilian = Avatud variant
opening.variation.open_sicilian.def = avatud variant
opening.variation.open_sicilian.advanced = Valge avab käiguga d4 tsentri ja lööb tagasi ratsuga: Sitsiilia kaitse peamine lahinguväli, terav ja teooriarohke.
opening.variation.open_sicilian.advanced.spoken = Valge avab käiguga dee neli tsentri ja lööb tagasi ratsuga: Sitsiilia kaitse peamine lahinguväli, terav ja teooriarohke.
opening.variation.closed_sicilian = Suletud variant
opening.variation.closed_sicilian.def = suletud variant
opening.variation.closed_sicilian.advanced = Valge väldib käiku d4, viib oda väljale g2 ja mängib sageli f4, taotledes aeglast rünnakut kuningatiival.
opening.variation.closed_sicilian.advanced.spoken = Valge väldib käiku dee neli, viib oda väljale gee kaks ja mängib sageli eff neli, taotledes aeglast rünnakut kuningatiival.
opening.variation.alapin = Alapini variant
opening.variation.alapin.def = Alapini variant
opening.variation.alapin.advanced = Käik c3 valmistab ette käigu d4, et ehitada täielik etturitsenter ja vältida Sitsiilia kaitse peateooriat; must vastab käiguga d5 või ratsuga väljale f6.
opening.variation.alapin.advanced.spoken = Käik tsee kolm valmistab ette käigu dee neli, et ehitada täielik etturitsenter ja vältida Sitsiilia kaitse peateooriat; must vastab käiguga dee viis või ratsuga väljale eff kuus.
opening.variation.smith_morra = Smith-Morra gambiit
opening.variation.smith_morra.def = Smith-Morra gambiit
opening.variation.smith_morra.beginner = Valge annab etturi, et kiiresti areneda ja avada liinid musta kuninga vastu: must peab hoolikalt arenema.
opening.variation.smith_morra.advanced = Ettur kiire arengu ning avatud c-vertikaali ja d-vertikaali eest; must areneb korralikult ja annab etturi sageli õigel hetkel tagasi.
opening.variation.smith_morra.advanced.spoken = Ettur kiire arengu ning avatud tsee-vertikaali ja dee-vertikaali eest; must areneb korralikult ja annab etturi sageli õigel hetkel tagasi.
opening.variation.grand_prix = Grand Prix' rünnak
opening.variation.grand_prix.def = Grand Prix' rünnak
opening.variation.grand_prix.advanced = Valge viib ratsu väljale c3 ja mängib f4, et kiiresti rünnata kuningatiival käiguga f5, vältides Sitsiilia kaitse avatud varianti.
opening.variation.grand_prix.advanced.spoken = Valge viib ratsu väljale tsee kolm ja mängib eff neli, et kiiresti rünnata kuningatiival käiguga eff viis, vältides Sitsiilia kaitse avatud varianti.
opening.variation.rossolimo = Rossolimo variant
opening.variation.rossolimo.def = Rossolimo variant
opening.variation.rossolimo.advanced = Oda väljal b5 seob ratsu väljal c6 või vahetab selle, et tekitada mustale kahekordsed etturid ja hoida mäng positsiooniline.
opening.variation.rossolimo.advanced.spoken = Oda väljal bee viis seob ratsu väljal tsee kuus või vahetab selle, et tekitada mustale kahekordsed etturid ja hoida mäng positsiooniline.
opening.variation.najdorf = Najdorfi variant
opening.variation.najdorf.spoken = Najdorfi variant
opening.variation.najdorf.def = Najdorfi variant
opening.variation.najdorf.def.spoken = Najdorfi variant
opening.variation.najdorf.advanced = Käik a6 loob Sitsiilia kaitse kõige kuulsama variandi: paindlik ja sügav, struktuuridega e5 või e6 valge teravate rünnakute vastu.
opening.variation.najdorf.advanced.spoken = Käik aa kuus loob Sitsiilia kaitse kõige kuulsama variandi: paindlik ja sügav, struktuuridega ee viis või ee kuus valge teravate rünnakute vastu.
opening.variation.dragon = Draakonivariant
opening.variation.dragon.def = draakonivariant
opening.variation.dragon.advanced = Must viib oda väljale g7; Jugoslaavia rünnak viib kuulsate võidujooksudeni, kus pooled ründavad eri tiibadel.
opening.variation.dragon.advanced.spoken = Must viib oda väljale gee seitse; Jugoslaavia rünnak viib kuulsate võidujooksudeni, kus pooled ründavad eri tiibadel.
opening.variation.accelerated_dragon = Kiirendatud draakonivariant
opening.variation.accelerated_dragon.def = kiirendatud draakonivariant
opening.variation.accelerated_dragon.advanced = Must viib oda väljale g7 enne käiku d6, et mängida d5 ühe käiguga; Maróczy haare käiguga c4 on valge positsiooniline vastumürk.
opening.variation.accelerated_dragon.advanced.spoken = Must viib oda väljale gee seitse enne käiku dee kuus, et mängida dee viis ühe käiguga; Maróczy haare käiguga tsee neli on valge positsiooniline vastumürk.
opening.variation.scheveningen = Scheveningeni variant
opening.variation.scheveningen.spoken = Scheveningeni variant
opening.variation.scheveningen.def = Scheveningeni variant
opening.variation.scheveningen.def.spoken = Scheveningeni variant
opening.variation.scheveningen.advanced = Must ehitab käikudega e6 ja d6 väikese tsentri, paindliku kaitsekesta; valge ründab sageli käiguga g4.
opening.variation.scheveningen.advanced.spoken = Must ehitab käikudega ee kuus ja dee kuus väikese tsentri, paindliku kaitsekesta; valge ründab sageli käiguga gee neli.
opening.variation.sveshnikov = Svešnikovi variant
opening.variation.sveshnikov.def = Svešnikovi variant
opening.variation.sveshnikov.advanced = Must mängib e5, nõustudes aktiivsuse ja odapaari nimel nõrga väljaga d5 ja mahajäänud d-etturiga: väga dünaamiline.
opening.variation.sveshnikov.advanced.spoken = Must mängib ee viis, nõustudes aktiivsuse ja odapaari nimel nõrga väljaga dee viis ja mahajäänud dee-etturiga: väga dünaamiline.
opening.variation.taimanov = Taimanovi variant
opening.variation.taimanov.def = Taimanovi variant
opening.variation.taimanov.advanced = Must ühendab käigu e6 ja ratsu väljal c6 paindliku käigu a6 ja lipuga väljal c7, hoides käigu d6 tagavaraks.
opening.variation.taimanov.advanced.spoken = Must ühendab käigu ee kuus ja ratsu väljal tsee kuus paindliku käigu aa kuus ja lipuga väljal tsee seitse, hoides käigu dee kuus tagavaraks.
opening.variation.kan = Kani variant
opening.variation.kan.def = Kani variant
opening.variation.kan.advanced = Must mängib e6 ja a6, jätab ratsud koju ja taotleb sageli siili ülesehitust.
opening.variation.kan.advanced.spoken = Must mängib ee kuus ja aa kuus, jätab ratsud koju ja taotleb sageli siili ülesehitust.
opening.variation.classical_sicilian = Klassikaline variant
opening.variation.classical_sicilian.def = klassikaline variant
opening.variation.classical_sicilian.advanced = Must arendab mõlemad ratsud ja mängib d6; valge peamised vastused on Richter-Rauzeri rünnak ja Sozini rünnak.
opening.variation.classical_sicilian.advanced.spoken = Must arendab mõlemad ratsud ja mängib dee kuus; valge peamised vastused on Richter-Rauzeri rünnak ja Sozini rünnak.
opening.variation.french_advance = Edasitungivariant
opening.variation.french_advance.def = edasitungivariant
opening.variation.french_advance.advanced = Valge sulgeb käiguga e5 tsentri ja võidab ruumi; must ründab ahela alust, etturit d4, käiguga c5 ja nuppudega.
opening.variation.french_advance.advanced.spoken = Valge sulgeb käiguga ee viis tsentri ja võidab ruumi; must ründab ahela alust, etturit dee neli, käiguga tsee viis ja nuppudega.
opening.variation.french_exchange = Vahetusvariant
opening.variation.french_exchange.def = vahetusvariant
opening.variation.french_exchange.advanced = Etturivahetusega väljal d5 kaob pinge: sümmeetriline ja rahulik struktuur, kus musta valgeväljaline oda pääseb vabaks.
opening.variation.french_exchange.advanced.spoken = Etturivahetusega väljal dee viis kaob pinge: sümmeetriline ja rahulik struktuur, kus musta valgeväljaline oda pääseb vabaks.
opening.variation.french_tarrasch = Tarraschi variant
opening.variation.french_tarrasch.def = Tarraschi variant
opening.variation.french_tarrasch.advanced = Ratsu läheb väljale d2, et vältida Winaweri variandi sidumist; must nõustub pärast käiku c5 sageli isoleeritud d-etturiga või sulgeb tsentri.
opening.variation.french_tarrasch.advanced.spoken = Ratsu läheb väljale dee kaks, et vältida Winaweri variandi sidumist; must nõustub pärast käiku tsee viis sageli isoleeritud dee-etturiga või sulgeb tsentri.
opening.variation.winawer = Winaweri variant
opening.variation.winawer.spoken = Winaweri variant
opening.variation.winawer.def = Winaweri variant
opening.variation.winawer.def.spoken = Winaweri variant
opening.variation.winawer.advanced = Oda väljal b4 seob ratsu; must annab tavaliselt oda ratsu vastu, mille järel on valgel kahekordsed etturid, kuid ka odapaar.
opening.variation.winawer.advanced.spoken = Oda väljal bee neli seob ratsu; must annab tavaliselt oda ratsu vastu, mille järel on valgel kahekordsed etturid, kuid ka odapaar.
opening.variation.french_classical = Klassikaline variant
opening.variation.french_classical.def = klassikaline variant
opening.variation.french_classical.advanced = Must arendab ratsu väljale f6; mäng keerleb etturiahela ümber, mille eesotsas on ettur e5, ning sidumise ümber, mille teeb oda väljal g5.
opening.variation.french_classical.advanced.spoken = Must arendab ratsu väljale eff kuus; mäng keerleb etturiahela ümber, mille eesotsas on ettur ee viis, ning sidumise ümber, mille teeb oda väljal gee viis.
opening.variation.french_rubinstein = Rubinsteini variant
opening.variation.french_rubinstein.def = Rubinsteini variant
opening.variation.french_rubinstein.advanced = Must lööb väljal e4 ja loovutab tsentri kindla ja kompaktse seisu nimel, taotledes hiljem käiku c5.
opening.variation.french_rubinstein.advanced.spoken = Must lööb väljal ee neli ja loovutab tsentri kindla ja kompaktse seisu nimel, taotledes hiljem käiku tsee viis.
opening.variation.ck_advance = Edasitungivariant
opening.variation.ck_advance.def = edasitungivariant
