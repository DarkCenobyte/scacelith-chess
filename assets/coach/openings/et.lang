opening.variation.ck_advance.advanced.spoken = Valge võidab käiguga ee viis ruumi; must arendab oda väljale eff viis enne käiku ee kuus ja lööb vastu käiguga tsee viis.
opening.variation.ck_exchange = Vahetusvariant
opening.variation.ck_exchange.def = vahetusvariant
opening.variation.ck_exchange.advanced = Vahetatud värvidega Karlsbadi struktuur: valge paigutub kuningatiivale, must taotleb vähemusrünnakut liputiival.
opening.variation.ck_panov = Panovi rünnak
opening.variation.ck_panov.def = Panovi rünnak
opening.variation.ck_panov.advanced = Valge mängib c4 ja nõustub isoleeritud d-etturiga, saades vastu aktiivsed nupud ja ründevõimalused.
opening.variation.ck_panov.advanced.spoken = Valge mängib tsee neli ja nõustub isoleeritud dee-etturiga, saades vastu aktiivsed nupud ja ründevõimalused.
opening.variation.ck_classical = Klassikaline variant
opening.variation.ck_classical.def = klassikaline variant
opening.variation.ck_classical.advanced = Oda tuleb väljale f5 ja ründab tempovõiduga ratsut; valge võidab käikudega h4 ja h5 ruumi ning vangerdused eri tiibadele on tavalised.
opening.variation.ck_classical.advanced.spoken = Oda tuleb väljale eff viis ja ründab tempovõiduga ratsut; valge võidab käikudega haa neli ja haa viis ruumi ning vangerdused eri tiibadele on tavalised.
opening.variation.ck_two_knights = Kahe ratsu rünnak
opening.variation.ck_two_knights.def = kahe ratsu rünnak
