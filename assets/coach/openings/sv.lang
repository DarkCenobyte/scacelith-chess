opening.family.center_game.advanced.spoken = Svart utvecklar med tempo mot damen; vit ställer oftast damen på é tre, utvecklar damflygeln och gör lång rockad för att anfalla.
opening.family.englund = Englundgambiten
opening.family.englund.def = Englundgambiten
