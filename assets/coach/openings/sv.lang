opening.family.old_indian.def = gammalindiskt försvar
opening.family.old_indian.beginner = Svart spelar d6 och e5 utan fianchetto: ett solitt men något passivt försvar.
opening.family.old_indian.beginner.spoken = Svart spelar dé sex och é fem utan fianchetto: ett solitt men något passivt försvar.
opening.family.old_indian.advanced = Som kungsindiskt, men med löparen på e7: solitt men trångt, med spel i centrum som bygger på e5.
opening.family.old_indian.advanced.spoken = Som kungsindiskt, men med löparen på é sju: solitt men trångt, med spel i centrum som bygger på é fem.
opening.family.chigorin = Tjigorins försvar
opening.family.chigorin.def = Tjigorins försvar
opening.family.chigorin.beginner = Svart utvecklar damspringaren till c6 mot damgambiten och spelar för aktiva pjäser.
opening.family.chigorin.beginner.spoken = Svart utvecklar damspringaren till se sex mot damgambiten och spelar för aktiva pjäser.
opening.family.chigorin.advanced = Svart ger upp stabiliteten i centrum för pjäsaktivitet och byter ofta den vitfältiga löparen mot springaren på f3 för att trycka på d4.
opening.family.chigorin.advanced.spoken = Svart ger upp stabiliteten i centrum för pjäsaktivitet och byter ofta den vitfältiga löparen mot springaren på eff tre för att trycka på dé fyra.
opening.family.albin = Albins motgambit
opening.family.albin.def = Albins motgambit
opening.family.albin.beginner = Svart offrar i sin tur e-bonden för att gå fram till d4 och tränga ihop vit: skarpt och fullt av fällor.
opening.family.albin.beginner.spoken = Svart offrar i sin tur é-bonden för att gå fram till dé fyra och tränga ihop vit: skarpt och fullt av fällor.
opening.family.albin.advanced = Svart bygger på bondekilen på d4 och snabb utveckling; vits bästa är en lugn utveckling med fianchetto och att ge tillbaka material vid behov.
opening.family.albin.advanced.spoken = Svart bygger på bondekilen på dé fyra och snabb utveckling; vits bästa är en lugn utveckling med fianchetto och att ge tillbaka material vid behov.
opening.family.latvian = Lettisk gambit
opening.family.latvian.def = lettisk gambit
opening.family.latvian.beginner = Svart spelar f5 i andra draget: en mycket riskabel gambit som försvagar svarts egen kung.
opening.family.latvian.beginner.spoken = Svart spelar eff fem i andra draget: en mycket riskabel gambit som försvagar svarts egen kung.
opening.family.latvian.advanced = Objektivt tveksam: vit får ett starkt initiativ genom att slå på e5 eller med löparen på c4.
opening.family.latvian.advanced.spoken = Objektivt tveksam: vit får ett starkt initiativ genom att slå på é fem eller med löparen på se fyra.
opening.family.elephant = Elefantgambiten
opening.family.elephant.def = elefantgambiten
opening.family.elephant.beginner = Svart går direkt till motangrepp med d5 och erbjuder en bonde för att öppna linjer: riskabelt men lurigt.
opening.family.elephant.beginner.spoken = Svart går direkt till motangrepp med dé fem och erbjuder en bonde för att öppna linjer: riskabelt men lurigt.
opening.family.elephant.advanced = Objektivt inkorrekt: efter bytet på d5 behåller vit ett bra spel med noggrann utveckling.
opening.family.elephant.advanced.spoken = Objektivt inkorrekt: efter bytet på dé fem behåller vit ett bra spel med noggrann utveckling.
opening.family.nimzo_larsen = Nimzo-Larsen-angreppet
opening.family.nimzo_larsen.spoken = Nimzo-Larsen-angreppet
opening.family.nimzo_larsen.def = Nimzo-Larsen-angreppet
opening.family.nimzo_larsen.def.spoken = Nimzo-Larsen-angreppet
opening.family.nimzo_larsen.beginner = Vit ställer damlöparen på den långa diagonalen efter b3 för att kontrollera e5 och centrum på avstånd.
opening.family.nimzo_larsen.beginner.spoken = Vit ställer damlöparen på den långa diagonalen efter be tre för att kontrollera é fem och centrum på avstånd.
opening.family.nimzo_larsen.advanced = En hypermodern flankuppställning: svart besätter centrum med e5 eller d5, och vit trycker på det med löparen, e3 och f4 eller c4.
opening.family.nimzo_larsen.advanced.spoken = En hypermodern flankuppställning: svart besätter centrum med é fem eller dé fem, och vit trycker på det med löparen, é tre och eff fyra eller se fyra.
opening.family.polish = Polsk öppning
opening.family.polish.def = polsk öppning
opening.family.polish.beginner = Vit börjar med b4, ett ovanligt flygeldrag som vinner utrymme på damflygeln.
opening.family.polish.beginner.spoken = Vit börjar med be fyra, ett ovanligt flygeldrag som vinner utrymme på damflygeln.
opening.family.polish.advanced = Löparen går till b2 bakom bonden; bonden på b4 kan bli en måltavla, men öppningen är spelbar och överraskande.
opening.family.polish.advanced.spoken = Löparen går till be två bakom bonden; bonden på be fyra kan bli en måltavla, men öppningen är spelbar och överraskande.
opening.family.grob = Grobs öppning
opening.family.grob.def = Grobs öppning
opening.family.grob.beginner = Vit flyttar g-bonden två rutor i första draget: en provocerande öppning som försvagar vits egen kung.
opening.family.grob.beginner.spoken = Vit flyttar ghé-bonden två rutor i första draget: en provocerande öppning som försvagar vits egen kung.
opening.family.grob.advanced = Vit siktar på den långa diagonalen och b7; svart svarar med d5 och e5 och bör straffa den försvagade kungsflygeln.
opening.family.grob.advanced.spoken = Vit siktar på den långa diagonalen och be sju; svart svarar med dé fem och é fem och bör straffa den försvagade kungsflygeln.
opening.family.hungarian = Ungersk öppning
opening.family.hungarian.def = ungersk öppning
opening.family.hungarian.beginner = Vit förbereder en fianchetto med g3: en flexibel start som ofta blir kungsindiskt angrepp eller engelskt.
opening.family.hungarian.beginner.spoken = Vit förbereder en fianchetto med ghé tre: en flexibel start som ofta blir kungsindiskt angrepp eller engelskt.
opening.family.hungarian.advanced = Rikt på dragomkastningar: uppställningar från Réti, engelskt och kungsindiskt angrepp, eller ett modernt försvar med ombytta färger.
opening.family.hungarian.advanced.spoken = Rikt på dragomkastningar: uppställningar från Réti, engelskt och kungsindiskt angrepp, eller ett modernt försvar med ombytta färger.
opening.family.mieses = Miesesöppningen
opening.family.mieses.def = Miesesöppningen
opening.family.mieses.beginner = Vit börjar mycket blygsamt med d3 och öppnar för den svartfältiga löparen utan att ta centrum.
opening.family.mieses.beginner.spoken = Vit börjar mycket blygsamt med dé tre och öppnar för den svartfältiga löparen utan att ta centrum.
opening.family.mieses.advanced = Det leder ofta till Pirc med ombytta färger eller uppställningar som i kungsindiskt angrepp; svart kan ta centrum fritt.
opening.family.mieses.advanced.spoken = Det leder ofta till Pirc med ombytta färger eller uppställningar som i kungsindiskt angrepp; svart kan ta centrum fritt.
opening.family.saragossa = Saragossaöppningen
opening.family.saragossa.def = Saragossaöppningen
opening.family.saragossa.beginner = Vit börjar med c3, ett mycket ovanligt och lugnt första drag.
opening.family.saragossa.beginner.spoken = Vit börjar med se tre, ett mycket ovanligt och lugnt första drag.
opening.family.saragossa.advanced = c3 förbereder ett understött d4 och kan gå över i strukturer från Caro-Kann eller slaviskt med ombytta färger.
opening.family.saragossa.advanced.spoken = se tre förbereder ett understött dé fyra och kan gå över i strukturer från Caro-Kann eller slaviskt med ombytta färger.
opening.family.van_geet = Van Geet-öppningen
opening.family.van_geet.def = Van Geet-öppningen
opening.family.van_geet.beginner = Vit utvecklar damspringaren först, ett ovanligt drag som håller e4 eller d4 i reserv.
opening.family.van_geet.beginner.spoken = Vit utvecklar damspringaren först, ett ovanligt drag som håller é fyra eller dé fyra i reserv.
opening.family.van_geet.advanced = Det går ofta över i ställningar som påminner om wienerparti, omvänt sicilianskt eller Pirc.
opening.family.van_geet.advanced.spoken = Det går ofta över i ställningar som påminner om wienerparti, omvänt sicilianskt eller Pirc.
opening.family.jobava_london = Jobava London-systemet
opening.family.jobava_london.spoken = Jobava London-systemet
opening.family.jobava_london.def = Jobava London-systemet
opening.family.jobava_london.def.spoken = Jobava London-systemet
opening.family.jobava_london.beginner = Vit kombinerar springaren på c3 med löparen på f4: ett aggressivt system som siktar på c7 med ett springarhopp till b5.
opening.family.jobava_london.beginner.spoken = Vit kombinerar springaren på se tre med löparen på eff fyra: ett aggressivt system som siktar på se sju med ett springarhopp till be fem.
opening.family.jobava_london.advanced = Vit gör ofta lång rockad och anfaller med h4 eller g4; svart måste hålla ett öga på c7 och framstöten e4.
opening.family.jobava_london.advanced.spoken = Vit gör ofta lång rockad och anfaller med hå fyra eller ghé fyra; svart måste hålla ett öga på se sju och framstöten é fyra.
opening.family.stonewall_attack = Stonewallangreppet
opening.family.stonewall_attack.def = Stonewallangreppet
opening.family.stonewall_attack.beginner = Vit ställer bönder på d4, e3 och f4 och löparen på d3 och siktar på ett anfall på kungsflygeln med en springare på e5.
opening.family.stonewall_attack.beginner.spoken = Vit ställer bönder på dé fyra, é tre och eff fyra och löparen på dé tre och siktar på ett anfall på kungsflygeln med en springare på é fem.
opening.family.stonewall_attack.advanced = e5 är fast kontrollerad, men e4 och c4 blir svaga; svarts bästa är ett snabbt c5 eller att byta bort vits vitfältiga löpare.
opening.family.stonewall_attack.advanced.spoken = é fem är fast kontrollerad, men é fyra och se fyra blir svaga; svarts bästa är ett snabbt se fem eller att byta bort vits vitfältiga löpare.
opening.family.richter_veresov = Richter-Veresov-angreppet
opening.family.richter_veresov.spoken = Richter-Veresov-angreppet
opening.family.richter_veresov.def = Richter-Veresov-angreppet
opening.family.richter_veresov.def.spoken = Richter-Veresov-angreppet
opening.family.richter_veresov.beginner = Vit utvecklar tidigt damspringaren till c3 och löparen till g5 och siktar på e4.
opening.family.richter_veresov.beginner.spoken = Vit utvecklar tidigt damspringaren till se tre och löparen till ghé fem och siktar på é fyra.
opening.family.richter_veresov.advanced = Springaren blockerar c-bonden men stöder f3 och e4; svart klarar sig bra med c5 eller med löparen till f5.
opening.family.richter_veresov.advanced.spoken = Springaren blockerar se-bonden men stöder eff tre och é fyra; svart klarar sig bra med se fem eller med löparen till eff fem.
opening.family.st_george = Sankt Göran-försvaret
opening.family.st_george.def = Sankt Göran-försvaret
opening.family.st_george.beginner = Svart börjar med a6 och b5, en ovanlig flygeluppställning som blev berömd genom Miles seger över Karpov.
opening.family.st_george.beginner.spoken = Svart börjar med a sex och be fem, en ovanlig flygeluppställning som blev berömd genom Miles seger över Karpov.
opening.family.st_george.advanced = Svart vill få löparen till b7 och expandera på damflygeln och ger upp centrum; vit behåller en liten fördel med enkel utveckling i centrum.
opening.family.st_george.advanced.spoken = Svart vill få löparen till be sju och expandera på damflygeln och ger upp centrum; vit behåller en liten fördel med enkel utveckling i centrum.
opening.family.borg = Borgförsvaret
opening.family.borg.def = Borgförsvaret
opening.family.borg.beginner = Svart flyttar g-bonden två rutor: en provocerande öppning som försvagar svarts egen kung.
opening.family.borg.beginner.spoken = Svart flyttar ghé-bonden två rutor: en provocerande öppning som försvagar svarts egen kung.
opening.family.borg.advanced = Grobs öppning med ombytta färger; vit vinner utrymme och tid med d4 och tryck mot g5.
opening.family.borg.advanced.spoken = Grobs öppning med ombytta färger; vit vinner utrymme och tid med dé fyra och tryck mot ghé fem.
opening.family.hippopotamus = Flodhästförsvaret
opening.family.hippopotamus.def = flodhästförsvaret
opening.family.hippopotamus.beginner = Svart ställer bönderna på sjätte raden och fianchetterar båda löparna, i väntan på att vit ska gå för långt fram.
opening.family.hippopotamus.advanced = En flexibel vänteuppställning: sund mot långsamt spel, trång mot ett brett centrum.
opening.family.english_defense = Engelskt försvar
opening.family.english_defense.def = engelskt försvar
opening.family.english_defense.beginner = Svart svarar med b6 och löparen på b7 för att kämpa om e4 med pjäserna.
opening.family.english_defense.beginner.spoken = Svart svarar med be sex och löparen på be sju för att kämpa om é fyra med pjäserna.
opening.family.english_defense.advanced = Svart bjuder in till ett stort centrum och angriper det sedan med en löparschack på b4, med f5 och med tryck mot e4.
opening.family.english_defense.advanced.spoken = Svart bjuder in till ett stort centrum och angriper det sedan med en löparschack på be fyra, med eff fem och med tryck mot é fyra.
opening.family.pterodactyl = Pterodaktylförsvaret
opening.family.pterodactyl.def = pterodaktylförsvaret
opening.family.pterodactyl.beginner = Svart fianchetterar kungslöparen, spelar sedan c5 och tar tidigt ut damen till a5: ett udda, aggressivt system.
opening.family.pterodactyl.beginner.spoken = Svart fianchetterar kungslöparen, spelar sedan se fem och tar tidigt ut damen till a fem: ett udda, aggressivt system.
opening.family.pterodactyl.advanced = En blandning av idéer från modernt försvar och sicilianskt: damen på a5 angriper springaren på c3 längs diagonalen.
opening.family.pterodactyl.advanced.spoken = En blandning av idéer från modernt försvar och sicilianskt: damen på a fem angriper springaren på se tre längs diagonalen.
opening.family.bongcloud = Bongcloudangreppet
opening.family.bongcloud.def = Bongcloudangreppet
opening.family.bongcloud.beginner = Vit flyttar kungen i andra draget: en skämtöppning som bryter mot grundreglerna, eftersom kungen ska stå säkert och rockera.
opening.family.bongcloud.advanced = Kungen står i vägen för löparen och damen och förlorar rätten att rockera; öppningen spelas som ett skämt och bör inte efterliknas.

# ---- Notable variations
opening.variation.open_sicilian = Öppet sicilianskt
opening.variation.open_sicilian.def = öppet sicilianskt
opening.variation.open_sicilian.advanced = Vit öppnar centrum med d4 och slår tillbaka med springaren: huvudarenan i sicilianskt, skarp och full av teori.
opening.variation.open_sicilian.advanced.spoken = Vit öppnar centrum med dé fyra och slår tillbaka med springaren: huvudarenan i sicilianskt, skarp och full av teori.
opening.variation.closed_sicilian = Stängt sicilianskt
opening.variation.closed_sicilian.def = stängt sicilianskt
opening.variation.closed_sicilian.advanced = Vit undviker d4, fianchetterar på g2 och spelar ofta f4, med sikte på ett långsamt anfall på kungsflygeln.
opening.variation.closed_sicilian.advanced.spoken = Vit undviker dé fyra, fianchetterar på ghé två och spelar ofta eff fyra, med sikte på ett långsamt anfall på kungsflygeln.
opening.variation.alapin = Alapinvarianten
opening.variation.alapin.def = Alapinvarianten
opening.variation.alapin.advanced = c3 förbereder d4 för att bygga ett fullständigt bondecentrum och kringgå den sicilianska huvudteorin; svart svarar med d5 eller springaren till f6.
opening.variation.alapin.advanced.spoken = se tre förbereder dé fyra för att bygga ett fullständigt bondecentrum och kringgå den sicilianska huvudteorin; svart svarar med dé fem eller springaren till eff sex.
opening.variation.smith_morra = Smith-Morra-gambiten
opening.variation.smith_morra.def = Smith-Morra-gambiten
opening.variation.smith_morra.beginner = Vit ger en bonde för att utveckla sig snabbt och öppna linjer mot svarts kung: svart måste utveckla sig försiktigt.
opening.variation.smith_morra.advanced = En bonde för snabb utveckling och den öppna c-linjen och d-linjen; svart utvecklar sig sunt och ger ofta tillbaka bonden i rätt ögonblick.
opening.variation.smith_morra.advanced.spoken = En bonde för snabb utveckling och den öppna se-linjen och dé-linjen; svart utvecklar sig sunt och ger ofta tillbaka bonden i rätt ögonblick.
opening.variation.grand_prix = Grand Prix-angreppet
opening.variation.grand_prix.def = Grand Prix-angreppet
opening.variation.grand_prix.advanced = Vit spelar springaren till c3 och f4 för ett snabbt anfall på kungsflygeln med f5 och undviker öppet sicilianskt.
opening.variation.grand_prix.advanced.spoken = Vit spelar springaren till se tre och eff fyra för ett snabbt anfall på kungsflygeln med eff fem och undviker öppet sicilianskt.
opening.variation.rossolimo = Rossolimovarianten
opening.variation.rossolimo.def = Rossolimovarianten
opening.variation.rossolimo.advanced = Löparen på b5 binder eller byter bort springaren på c6 för att ge svart dubbelbönder och hålla spelet positionellt.
opening.variation.rossolimo.advanced.spoken = Löparen på be fem binder eller byter bort springaren på se sex för att ge svart dubbelbönder och hålla spelet positionellt.
opening.variation.najdorf = Najdorfvarianten
opening.variation.najdorf.spoken = Najdorfvarianten
opening.variation.najdorf.def = Najdorfvarianten
opening.variation.najdorf.def.spoken = Najdorfvarianten
opening.variation.najdorf.advanced = a6 ger den mest berömda sicilianska varianten: flexibel och djup, med strukturer med e5 eller e6 mot vits skarpa anfall.
opening.variation.najdorf.advanced.spoken = a sex ger den mest berömda sicilianska varianten: flexibel och djup, med strukturer med é fem eller é sex mot vits skarpa anfall.
opening.variation.dragon = Drakvarianten
opening.variation.dragon.def = drakvarianten
opening.variation.dragon.advanced = Svart fianchetterar på g7; det jugoslaviska angreppet leder till berömda kapplöpningar mellan anfall på var sin flygel.
opening.variation.dragon.advanced.spoken = Svart fianchetterar på ghé sju; det jugoslaviska angreppet leder till berömda kapplöpningar mellan anfall på var sin flygel.
opening.variation.accelerated_dragon = Accelererade draken
opening.variation.accelerated_dragon.def = den accelererade draken
opening.variation.accelerated_dragon.advanced = Svart fianchetterar före d6 för att kunna spela d5 i ett enda drag; Maróczyuppställningen med c4 är vits positionella motmedel.
opening.variation.accelerated_dragon.advanced.spoken = Svart fianchetterar före dé sex för att kunna spela dé fem i ett enda drag; Maróczyuppställningen med se fyra är vits positionella motmedel.
opening.variation.scheveningen = Scheveningenvarianten
opening.variation.scheveningen.spoken = Scheveningenvarianten
opening.variation.scheveningen.def = Scheveningenvarianten
opening.variation.scheveningen.def.spoken = Scheveningenvarianten
opening.variation.scheveningen.advanced = Svart bygger det lilla centrumet med e6 och d6, ett flexibelt försvarsskal; vit anfaller ofta med g4.
opening.variation.scheveningen.advanced.spoken = Svart bygger det lilla centrumet med é sex och dé sex, ett flexibelt försvarsskal; vit anfaller ofta med ghé fyra.
opening.variation.sveshnikov = Svesjnikovvarianten
opening.variation.sveshnikov.def = Svesjnikovvarianten
opening.variation.sveshnikov.advanced = Svart spelar e5 och accepterar ett hål på d5 och en efterbliven d-bonde för aktivitet och löparparet: mycket dynamiskt.
opening.variation.sveshnikov.advanced.spoken = Svart spelar é fem och accepterar ett hål på dé fem och en efterbliven dé-bonde för aktivitet och löparparet: mycket dynamiskt.
opening.variation.taimanov = Tajmanovvarianten
opening.variation.taimanov.def = Tajmanovvarianten
opening.variation.taimanov.advanced = Svart kombinerar e6 och springaren på c6 med ett flexibelt a6 och damen på c7 och håller d6 i reserv.
opening.variation.taimanov.advanced.spoken = Svart kombinerar é sex och springaren på se sex med ett flexibelt a sex och damen på se sju och håller dé sex i reserv.
opening.variation.kan = Kan-varianten
opening.variation.kan.def = Kan-varianten
opening.variation.kan.advanced = Svart spelar e6 och a6, låter springarna stå kvar hemma och siktar ofta på en igelkottsuppställning.
opening.variation.kan.advanced.spoken = Svart spelar é sex och a sex, låter springarna stå kvar hemma och siktar ofta på en igelkottsuppställning.
opening.variation.classical_sicilian = Klassiska varianten
opening.variation.classical_sicilian.def = den klassiska varianten
opening.variation.classical_sicilian.advanced = Svart utvecklar båda springarna och spelar d6; vits viktigaste svar är Richter-Rauzer och Sozin.
opening.variation.classical_sicilian.advanced.spoken = Svart utvecklar båda springarna och spelar dé sex; vits viktigaste svar är Richter-Rauzer och Sozin.
opening.variation.french_advance = Avancemangsvarianten
opening.variation.french_advance.def = avancemangsvarianten
opening.variation.french_advance.advanced = Vit låser centrum med e5 och vinner utrymme; svart angriper d4, kedjans bas, med c5 och pjäserna.
opening.variation.french_advance.advanced.spoken = Vit låser centrum med é fem och vinner utrymme; svart angriper dé fyra, kedjans bas, med se fem och pjäserna.
opening.variation.french_exchange = Avbytesvarianten
opening.variation.french_exchange.def = avbytesvarianten
opening.variation.french_exchange.advanced = Bondebytet på d5 löser upp spänningen: en symmetrisk, lugn struktur där svarts vitfältiga löpare blir fri.
opening.variation.french_exchange.advanced.spoken = Bondebytet på dé fem löser upp spänningen: en symmetrisk, lugn struktur där svarts vitfältiga löpare blir fri.
opening.variation.french_tarrasch = Tarraschvarianten
opening.variation.french_tarrasch.def = Tarraschvarianten
opening.variation.french_tarrasch.advanced = Springaren går till d2 för att undvika bindningen i Winawervarianten; svart accepterar ofta en isolerad d-bonde efter c5, eller låser centrum.
opening.variation.french_tarrasch.advanced.spoken = Springaren går till dé två för att undvika bindningen i Winawervarianten; svart accepterar ofta en isolerad dé-bonde efter se fem, eller låser centrum.
opening.variation.winawer = Winawervarianten
opening.variation.winawer.spoken = Winawervarianten
opening.variation.winawer.def = Winawervarianten
opening.variation.winawer.def.spoken = Winawervarianten
opening.variation.winawer.advanced = Löparen på b4 binder springaren; svart ger oftast löpare mot springare, vilket ger vit dubbelbönder men löparparet.
opening.variation.winawer.advanced.spoken = Löparen på be fyra binder springaren; svart ger oftast löpare mot springare, vilket ger vit dubbelbönder men löparparet.
opening.variation.french_classical = Klassiska varianten
opening.variation.french_classical.def = den klassiska varianten
opening.variation.french_classical.advanced = Svart utvecklar springaren till f6; spelet kretsar kring bondekedjan med e5 och bindningen från en löpare på g5.
opening.variation.french_classical.advanced.spoken = Svart utvecklar springaren till eff sex; spelet kretsar kring bondekedjan med é fem och bindningen från en löpare på ghé fem.
opening.variation.french_rubinstein = Rubinsteinvarianten
opening.variation.french_rubinstein.def = Rubinsteinvarianten
opening.variation.french_rubinstein.advanced = Svart slår på e4 och ger upp centrum för en solid, kompakt ställning, med sikte på c5 längre fram.
opening.variation.french_rubinstein.advanced.spoken = Svart slår på é fyra och ger upp centrum för en solid, kompakt ställning, med sikte på se fem längre fram.
opening.variation.ck_advance = Avancemangsvarianten
opening.variation.ck_advance.def = avancemangsvarianten
opening.variation.ck_advance.advanced = Vit vinner utrymme med e5; svart utvecklar löparen till f5 före e6 och går till motangrepp med c5.
opening.variation.ck_advance.advanced.spoken = Vit vinner utrymme med é fem; svart utvecklar löparen till eff fem före é sex och går till motangrepp med se fem.
opening.variation.ck_exchange = Avbytesvarianten
opening.variation.ck_exchange.def = avbytesvarianten
opening.variation.ck_exchange.advanced = En Karlsbadstruktur med ombytta färger: vit ställer upp sig på kungsflygeln, svart spelar för ett minoritetsangrepp på damflygeln.
opening.variation.ck_panov = Panovangreppet
opening.variation.ck_panov.def = Panovangreppet
opening.variation.ck_panov.advanced = Vit spelar c4 och accepterar en isolerad d-bonde i utbyte mot aktiva pjäser och anfallschanser.
opening.variation.ck_panov.advanced.spoken = Vit spelar se fyra och accepterar en isolerad dé-bonde i utbyte mot aktiva pjäser och anfallschanser.
opening.variation.ck_classical = Klassiska varianten
opening.variation.ck_classical.def = den klassiska varianten
opening.variation.ck_classical.advanced = Löparen kommer till f5 med tempo mot springaren; vit vinner utrymme med h4 och h5, och motsatta rockader är vanliga.
opening.variation.ck_classical.advanced.spoken = Löparen kommer till eff fem med tempo mot springaren; vit vinner utrymme med hå fyra och hå fem, och motsatta rockader är vanliga.
opening.variation.ck_two_knights = Tvåspringarangreppet
opening.variation.ck_two_knights.def = tvåspringarangreppet
opening.variation.ck_two_knights.advanced = Vit utvecklar båda springarna före d4, håller spelet flexibelt och undviker huvudvarianterna.
opening.variation.ck_two_knights.advanced.spoken = Vit utvecklar båda springarna före dé fyra, håller spelet flexibelt och undviker huvudvarianterna.
opening.variation.two_knights = Tvåspringarspel
opening.variation.two_knights.def = tvåspringarspel
opening.variation.two_knights.beginner = Svart går till motangrepp mot e4 med springaren i stället för att härma vit; se upp för springarhoppet till g5, som angriper f7.
opening.variation.two_knights.beginner.spoken = Svart går till motangrepp mot é fyra med springaren i stället för att härma vit; se upp för springarhoppet till ghé fem, som angriper eff sju.
opening.variation.two_knights.advanced = Svarts mest aktiva svar på italienskt parti: det bjuder in till det skarpa springarhoppet till g5 eller det lugna d3.
opening.variation.two_knights.advanced.spoken = Svarts mest aktiva svar på italienskt parti: det bjuder in till det skarpa springarhoppet till ghé fem eller det lugna dé tre.
opening.variation.giuoco_piano = Giuoco piano
opening.variation.giuoco_piano.spoken = Giuoco piano
opening.variation.giuoco_piano.def = Giuoco piano
opening.variation.giuoco_piano.def.spoken = Giuoco piano
opening.variation.giuoco_piano.beginner = ”Det lugna spelet” på italienska: båda löparna siktar mot motståndarens f-bonde, och partiet utvecklas lugnt.
opening.variation.giuoco_piano.beginner.spoken = ”Det lugna spelet” på italienska: båda löparna siktar mot motståndarens eff-bonde, och partiet utvecklas lugnt.
opening.variation.giuoco_piano.advanced = Svarts löpare speglar vits; vit väljer mellan centrumspel med c3 och d4, det långsamma d3 eller Evansgambiten.
opening.variation.giuoco_piano.advanced.spoken = Svarts löpare speglar vits; vit väljer mellan centrumspel med se tre och dé fyra, det långsamma dé tre eller Evansgambiten.
opening.variation.giuoco_pianissimo = Giuoco pianissimo
opening.variation.giuoco_pianissimo.spoken = Giuoco pianissimo
opening.variation.giuoco_pianissimo.def = Giuoco pianissimo
opening.variation.giuoco_pianissimo.def.spoken = Giuoco pianissimo
opening.variation.giuoco_pianissimo.advanced = Det moderna, långsamma italienska partiet med d3, c3 och rockad: långa manövrer och en fördröjd brytning med d4.
opening.variation.giuoco_pianissimo.advanced.spoken = Det moderna, långsamma italienska partiet med dé tre, se tre och rockad: långa manövrer och en fördröjd brytning med dé fyra.
opening.variation.evans = Evansgambiten
opening.variation.evans.def = Evansgambiten
opening.variation.evans.advanced = b4 ger en bonde för att avleda löparen och snabbt bygga ett centrum med c3 och d4: mycket skarpt, en favorit under den romantiska eran.
opening.variation.evans.advanced.spoken = be fyra ger en bonde för att avleda löparen och snabbt bygga ett centrum med se tre och dé fyra: mycket skarpt, en favorit under den romantiska eran.
opening.variation.fried_liver = Fegatelloangreppet
opening.variation.fried_liver.def = Fegatelloangreppet
opening.variation.fried_liver.beginner = Vit offrar springaren på f7 för att dra ut svarts kung i det fria: mycket farligt om svart har slagit på d5 med springaren.
opening.variation.fried_liver.beginner.spoken = Vit offrar springaren på eff sju för att dra ut svarts kung i det fria: mycket farligt om svart har slagit på dé fem med springaren.
opening.variation.fried_liver.advanced = Efter springaroffret på f7 får vit ett våldsamt anfall; huvudvarianten undviker det genom att angripa löparen med springaren på a5.
opening.variation.fried_liver.advanced.spoken = Efter springaroffret på eff sju får vit ett våldsamt anfall; huvudvarianten undviker det genom att angripa löparen med springaren på a fem.
opening.variation.traxler = Traxlers motangrepp
opening.variation.traxler.def = Traxlers motangrepp
opening.variation.traxler.advanced = Svart struntar i hotet mot f7 och angriper f2 i stället: vild taktik där exakt kunskap avgör.
opening.variation.traxler.advanced.spoken = Svart struntar i hotet mot eff sju och angriper eff två i stället: vild taktik där exakt kunskap avgör.
opening.variation.berlin = Berlinförsvaret
opening.variation.berlin.def = Berlinförsvaret
opening.variation.berlin.advanced = Springaren går till motangrepp mot e4; det berömda Berlinslutspelet, med damerna tidigt avbytta och svarts kung i centrum, är extremt solitt.
opening.variation.berlin.advanced.spoken = Springaren går till motangrepp mot é fyra; det berömda Berlinslutspelet, med damerna tidigt avbytta och svarts kung i centrum, är extremt solitt.
opening.variation.morphy = Morphyförsvaret
opening.variation.morphy.def = Morphyförsvaret
opening.variation.morphy.advanced = a6 ställer genast löparen inför valet: porten till huvudvarianterna, stängt spanskt, öppet spanskt och Marshallangreppet.
opening.variation.morphy.advanced.spoken = a sex ställer genast löparen inför valet: porten till huvudvarianterna, stängt spanskt, öppet spanskt och Marshallangreppet.
opening.variation.closed_ruy = Stängt spanskt
opening.variation.closed_ruy.def = stängt spanskt
opening.variation.closed_ruy.advanced = Den klassiska huvudvarianten: långsamma manövrer från vit mot svarts planer på damflygeln, som Breyer-, Zajtsev- eller Tjigorinvarianten.
opening.variation.marshall = Marshallangreppet
opening.variation.marshall.def = Marshallangreppet
opening.variation.marshall.advanced = Svart offrar en bonde med d5 för ett långvarigt anfall på kungsflygeln; det är djupt analyserat och ett respekterat remivapen på toppnivå.
opening.variation.marshall.advanced.spoken = Svart offrar en bonde med dé fem för ett långvarigt anfall på kungsflygeln; det är djupt analyserat och ett respekterat remivapen på toppnivå.
opening.variation.ruy_exchange = Avbytesvarianten
opening.variation.ruy_exchange.def = avbytesvarianten
opening.variation.ruy_exchange.advanced = Slaget på c6 ger svart löparparet men dubbelbönder; vit siktar på ett slutspel med en sund majoritet på kungsflygeln.
opening.variation.ruy_exchange.advanced.spoken = Slaget på se sex ger svart löparparet men dubbelbönder; vit siktar på ett slutspel med en sund majoritet på kungsflygeln.
opening.variation.ruy_open = Öppet spanskt
opening.variation.ruy_open.def = öppet spanskt
opening.variation.ruy_open.advanced = Svart slår bonden på e4 för aktivt pjässpel; pjäserna är livliga, men e-linjen och bonden på d5 kräver omsorg.
opening.variation.ruy_open.advanced.spoken = Svart slår bonden på é fyra för aktivt pjässpel; pjäserna är livliga, men é-linjen och bonden på dé fem kräver omsorg.
opening.variation.schliemann = Schliemannförsvaret
opening.variation.schliemann.def = Schliemannförsvaret
opening.variation.schliemann.advanced = f5 är en kungsgambit med ombytta färger: skarpt och riskabelt för båda sidor.
opening.variation.schliemann.advanced.spoken = eff fem är en kungsgambit med ombytta färger: skarpt och riskabelt för båda sidor.
opening.variation.scotch_gambit = Skotsk gambit
opening.variation.scotch_gambit.def = skotsk gambit
opening.variation.scotch_gambit.advanced = Vit utvecklar löparen till c4 i stället för att slå tillbaka på d4 och erbjuder en bonde för snabb utveckling; det går ofta över i tvåspringarspel.
opening.variation.scotch_gambit.advanced.spoken = Vit utvecklar löparen till se fyra i stället för att slå tillbaka på dé fyra och erbjuder en bonde för snabb utveckling; det går ofta över i tvåspringarspel.
opening.variation.vienna_gambit = Wienergambiten
opening.variation.vienna_gambit.def = wienergambiten
opening.variation.vienna_gambit.advanced = f4 i wienerpartiet, en kungsgambit med springaren redan på c3; svarts bästa svar är motstöten d5 i centrum.
opening.variation.vienna_gambit.advanced.spoken = eff fyra i wienerpartiet, en kungsgambit med springaren redan på se tre; svarts bästa svar är motstöten dé fem i centrum.
opening.variation.stafford = Staffordgambiten
opening.variation.stafford.def = Staffordgambiten
opening.variation.stafford.beginner = En gambit full av fällor som är populär på nätet: svart ger en bonde och hoppas att vit går på knepen mot f2 och e4.
opening.variation.stafford.beginner.spoken = En gambit full av fällor som är populär på nätet: svart ger en bonde och hoppas att vit går på knepen mot eff två och é fyra.
opening.variation.stafford.advanced = Svart får snabb utveckling och fällor mot f2; med lugna drag har vit helt enkelt en ren merbonde.
opening.variation.stafford.advanced.spoken = Svart får snabb utveckling och fällor mot eff två; med lugna drag har vit helt enkelt en ren merbonde.
opening.variation.wayward_queen = Parhamangreppet
opening.variation.wayward_queen.def = Parhamangreppet
opening.variation.wayward_queen.beginner = En tidig damutflykt mot f7, idén bakom skomakarmatt: svart försvarar sig med springaren och g6 och jagar sedan damen med pjäserna.
opening.variation.wayward_queen.beginner.spoken = En tidig damutflykt mot eff sju, idén bakom skomakarmatt: svart försvarar sig med springaren och ghé sex och jagar sedan damen med pjäserna.
opening.variation.wayward_queen.advanced = Det tidiga damdraget bryter mot utvecklingsreglerna; svart vinner tid genom att ansätta damen och bör få det bättre.
opening.variation.halloween = Halloweengambiten
opening.variation.halloween.def = Halloweengambiten
opening.variation.halloween.advanced = Vit ger en springare för två bönder och ett stort centrum: objektivt inkorrekt, men farligt i snabba partier.
opening.variation.qgd_orthodox = Ortodoxa försvaret
opening.variation.qgd_orthodox.def = det ortodoxa försvaret
opening.variation.qgd_orthodox.advanced = Den klassiska uppställningen med löparen på e7, rockad och springaren på d7: solid men passiv, och befrias med c5 eller e5.
opening.variation.qgd_orthodox.advanced.spoken = Den klassiska uppställningen med löparen på é sju, rockad och springaren på dé sju: solid men passiv, och befrias med se fem eller é fem.
opening.variation.qgd_exchange = Avbytesvarianten
opening.variation.qgd_exchange.def = avbytesvarianten
opening.variation.qgd_exchange.advanced = Bytet på d5 skapar Karlsbadstrukturen; vits klassiska plan är minoritetsangreppet med b4 och b5.
opening.variation.qgd_exchange.advanced.spoken = Bytet på dé fem skapar Karlsbadstrukturen; vits klassiska plan är minoritetsangreppet med be fyra och be fem.
opening.variation.semi_tarrasch = Semi-Tarrasch
opening.variation.semi_tarrasch.def = Semi-Tarrasch
opening.variation.semi_tarrasch.advanced = Svart spelar c5 och slår tillbaka på d5 med en pjäs och undviker därmed den isolerade bonden i Tarraschförsvaret; vit får ett rörligt centrum.
opening.variation.semi_tarrasch.advanced.spoken = Svart spelar se fem och slår tillbaka på dé fem med en pjäs och undviker därmed den isolerade bonden i Tarraschförsvaret; vit får ett rörligt centrum.
opening.variation.meran = Meranvarianten
opening.variation.meran.def = Meranvarianten
opening.variation.meran.advanced = Svart slår på c4 och vinner utrymme på damflygeln med b5 och tempo; spelet kretsar kring brytningen c5 och vits framstöt till e5.
opening.variation.meran.advanced.spoken = Svart slår på se fyra och vinner utrymme på damflygeln med be fem och tempo; spelet kretsar kring brytningen se fem och vits framstöt till é fem.
opening.variation.kid_classical = Klassiska varianten
opening.variation.kid_classical.def = den klassiska varianten
opening.variation.kid_classical.advanced = Vit utvecklar lugnt och rockerar; efter e5 och d5 börjar den berömda kapplöpningen, vit på damflygeln, svart på kungsflygeln.
opening.variation.kid_classical.advanced.spoken = Vit utvecklar lugnt och rockerar; efter é fem och dé fem börjar den berömda kapplöpningen, vit på damflygeln, svart på kungsflygeln.
opening.variation.kid_samisch = Sämischvarianten
opening.variation.kid_samisch.spoken = Sämischvarianten
opening.variation.kid_samisch.def = Sämischvarianten
opening.variation.kid_samisch.def.spoken = Sämischvarianten
opening.variation.kid_samisch.advanced = f3 stöder e4 och förbereder en bondestorm på kungsflygeln; svart svarar med c5, e5 eller en plan på damflygeln med b5.
opening.variation.kid_samisch.advanced.spoken = eff tre stöder é fyra och förbereder en bondestorm på kungsflygeln; svart svarar med se fem, é fem eller en plan på damflygeln med be fem.
opening.variation.kid_four_pawns = Fyrbondeangreppet
opening.variation.kid_four_pawns.def = fyrbondeangreppet
opening.variation.kid_four_pawns.advanced = Vit bygger en mur av bönder på c4, d4, e4 och f4; svart underminerar den genast med c5 och e6.
opening.variation.kid_four_pawns.advanced.spoken = Vit bygger en mur av bönder på se fyra, dé fyra, é fyra och eff fyra; svart underminerar den genast med se fem och é sex.
opening.variation.kid_fianchetto = Fianchettovarianten
opening.variation.kid_fianchetto.def = fianchettovarianten
opening.variation.kid_fianchetto.advanced = Fianchetton på g2 trubbar av svarts löpare på g7, och spelet blir mer positionellt.
opening.variation.kid_fianchetto.advanced.spoken = Fianchetton på ghé två trubbar av svarts löpare på ghé sju, och spelet blir mer positionellt.
opening.variation.nimzo_rubinstein = Rubinsteinvarianten
opening.variation.nimzo_rubinstein.def = Rubinsteinvarianten
opening.variation.nimzo_rubinstein.advanced = e3 utvecklar lugnt och håller flera uppställningar i reserv: det populäraste sättet att möta nimzoindiskt.
opening.variation.nimzo_rubinstein.advanced.spoken = é tre utvecklar lugnt och håller flera uppställningar i reserv: det populäraste sättet att möta nimzoindiskt.
opening.variation.nimzo_classical = Klassiska varianten
opening.variation.nimzo_classical.def = den klassiska varianten
opening.variation.nimzo_classical.advanced = Damen går till c2 för att kunna slå tillbaka på c3 utan dubbelbönder; vit får löparparet, svart snabb utveckling.
opening.variation.nimzo_classical.advanced.spoken = Damen går till se två för att kunna slå tillbaka på se tre utan dubbelbönder; vit får löparparet, svart snabb utveckling.
opening.variation.nimzo_samisch = Sämischvarianten
opening.variation.nimzo_samisch.spoken = Sämischvarianten
opening.variation.nimzo_samisch.def = Sämischvarianten
opening.variation.nimzo_samisch.def.spoken = Sämischvarianten
opening.variation.nimzo_samisch.advanced = a3 tvingar fram bytet på c3 direkt: vit accepterar dubbelbönder för löparparet och ett stort centrum.
opening.variation.nimzo_samisch.advanced.spoken = a tre tvingar fram bytet på se tre direkt: vit accepterar dubbelbönder för löparparet och ett stort centrum.
opening.variation.grunfeld_exchange = Avbytesvarianten
opening.variation.grunfeld_exchange.def = avbytesvarianten
opening.variation.grunfeld_exchange.advanced = Vit bygger ett stort centrum med e4; svart angriper d4 med c5 och pjäserna, och slutspelen gynnar ofta svarts majoritet på damflygeln.
opening.variation.grunfeld_exchange.advanced.spoken = Vit bygger ett stort centrum med é fyra; svart angriper dé fyra med se fem och pjäserna, och slutspelen gynnar ofta svarts majoritet på damflygeln.
opening.variation.leningrad = Leningradvarianten
opening.variation.leningrad.def = Leningradvarianten
opening.variation.leningrad.advanced = Svart fianchetterar på g7: ett holländskt försvar i kungsindisk stil, där svart siktar på e5 och spel på kungsflygeln.
opening.variation.leningrad.advanced.spoken = Svart fianchetterar på ghé sju: ett holländskt försvar i kungsindisk stil, där svart siktar på é fem och spel på kungsflygeln.
opening.variation.stonewall_dutch = Stonewallvarianten
opening.variation.stonewall_dutch.def = Stonewallvarianten
opening.variation.stonewall_dutch.advanced = Bönder på c6, d5, e6 och f5 ger svart ett bergfast grepp om e4, till priset av ett hål på e5 och en passiv vitfältig löpare.
opening.variation.stonewall_dutch.advanced.spoken = Bönder på se sex, dé fem, é sex och eff fem ger svart ett bergfast grepp om é fyra, till priset av ett hål på é fem och en passiv vitfältig löpare.
opening.variation.modern_benoni = Modern Benoni
opening.variation.modern_benoni.def = modern Benoni
opening.variation.modern_benoni.advanced = Svart får en majoritet på damflygeln mot vits majoritet i centrum; taktik kring e5 och löparen på g7 dominerar.
opening.variation.modern_benoni.advanced.spoken = Svart får en majoritet på damflygeln mot vits majoritet i centrum; taktik kring é fem och löparen på ghé sju dominerar.
opening.variation.catalan_open = Öppet katalanskt
opening.variation.catalan_open.def = öppet katalanskt
opening.variation.catalan_open.advanced = Svart slår bonden på c4; vit vinner tillbaka den och behåller trycket längs den långa diagonalen, medan svart siktar på c5 eller b5.
opening.variation.catalan_open.advanced.spoken = Svart slår bonden på se fyra; vit vinner tillbaka den och behåller trycket längs den långa diagonalen, medan svart siktar på se fem eller be fem.
opening.variation.catalan_closed = Stängt katalanskt
opening.variation.catalan_closed.def = stängt katalanskt
opening.variation.catalan_closed.advanced = Svart behåller bonden på d5 med en kompakt uppställning: en långsam positionell kamp kring de befriande brytningarna e5 eller c5.
opening.variation.catalan_closed.advanced.spoken = Svart behåller bonden på dé fem med en kompakt uppställning: en långsam positionell kamp kring de befriande brytningarna é fem eller se fem.
opening.variation.english_symmetrical = Symmetriska varianten
opening.variation.english_symmetrical.def = den symmetriska varianten
opening.variation.english_symmetrical.advanced = Svart härmar vit med c5: långsamt manövrerande med fianchetterade löpare och tryck mot d4 och d5.
opening.variation.english_symmetrical.advanced.spoken = Svart härmar vit med se fem: långsamt manövrerande med fianchetterade löpare och tryck mot dé fyra och dé fem.
opening.variation.kings_english = Omvänt sicilianskt
opening.variation.kings_english.def = omvänt sicilianskt
opening.variation.kings_english.advanced = e5 gör engelskt parti till sicilianskt med ett extra tempo för vit; typiska planer är en fianchetto och en framstöt på damflygeln.
opening.variation.kings_english.advanced.spoken = é fem gör engelskt parti till sicilianskt med ett extra tempo för vit; typiska planer är en fianchetto och en framstöt på damflygeln.
opening.variation.alekhine_four_pawns = Fyrbondeangreppet
opening.variation.alekhine_four_pawns.def = fyrbondeangreppet
opening.variation.alekhine_four_pawns.advanced = Vit jagar springaren med bönder och bygger ett väldigt men alltför framskjutet centrum; svart svarar med c5 och pjäserna.
opening.variation.alekhine_four_pawns.advanced.spoken = Vit jagar springaren med bönder och bygger ett väldigt men alltför framskjutet centrum; svart svarar med se fem och pjäserna.
opening.variation.alekhine_modern = Moderna varianten
opening.variation.alekhine_modern.def = den moderna varianten
opening.variation.alekhine_modern.advanced = Vit behåller en stabil rumsfördel utan att gå för långt fram; svart binder springaren eller fianchetterar.
opening.variation.pirc_austrian = Österrikiska angreppet
opening.variation.pirc_austrian.def = det österrikiska angreppet
opening.variation.pirc_austrian.advanced = f4 bygger ett stort centrum för e5 eller ett anfall på kungsflygeln; svart går till motangrepp med c5 eller e5.
opening.variation.pirc_austrian.advanced.spoken = eff fyra bygger ett stort centrum för é fem eller ett anfall på kungsflygeln; svart går till motangrepp med se fem eller é fem.
opening.variation.falkbeer = Falkbeers motgambit
opening.variation.falkbeer.def = Falkbeers motgambit
opening.variation.falkbeer.advanced = d5 slår till i centrum i stället för att slå på f4; i modern praxis föredrar man att först slå på d5.
opening.variation.falkbeer.advanced.spoken = dé fem slår till i centrum i stället för att slå på eff fyra; i modern praxis föredrar man att först slå på dé fem.

