opening.family.blackmar_diemer.spoken = Blackmar-Diemer-gambiten
opening.family.blackmar_diemer.def = Blackmar-Diemer-gambiten
opening.family.blackmar_diemer.def.spoken = Blackmar-Diemer-gambiten
