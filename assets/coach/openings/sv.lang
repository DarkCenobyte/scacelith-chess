opening.family.kga.beginner.spoken = Svart slår eff-bonden: spelet blir mycket skarpt, och båda kungarna står lite utsatta.
opening.family.kga.advanced = Svart försöker antingen behålla bonden med g5 eller ger tillbaka den för snabb utveckling; vit bygger på f-linjen och ett utvecklingsförsprång.
opening.family.kga.advanced.spoken = Svart försöker antingen behålla bonden med ghé fem eller ger tillbaka den för snabb utveckling; vit bygger på eff-linjen och ett utvecklingsförsprång.
opening.family.kgd = Avböjd kungsgambit
opening.family.kgd.def = avböjd kungsgambit
