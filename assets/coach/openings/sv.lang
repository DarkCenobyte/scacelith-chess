opening.family.alekhine.def.spoken = Aljechins försvar
opening.family.alekhine.beginner = Svart angriper e4 med springaren för att locka fram vits bönder: de vinner utrymme, men de kan bli måltavlor.
opening.family.alekhine.beginner.spoken = Svart angriper é fyra med springaren för att locka fram vits bönder: de vinner utrymme, men de kan bli måltavlor.
opening.family.alekhine.advanced = Svart lockar fram bönderna och underminerar sedan det alltför framskjutna centrumet med d6 och c5; den lugna moderna varianten är vits huvudvariant.
opening.family.alekhine.advanced.spoken = Svart lockar fram bönderna och underminerar sedan det alltför framskjutna centrumet med dé sex och se fem; den lugna moderna varianten är vits huvudvariant.
opening.family.kings_gambit = Kungsgambit
opening.family.kings_gambit.def = kungsgambit
