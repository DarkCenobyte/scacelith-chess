opening.variation.open_sicilian = Siciliana deschisă
opening.variation.open_sicilian.def = Siciliana deschisă
opening.variation.open_sicilian.advanced = Albul deschide centrul cu d4 și recapturează cu calul: principalul câmp de luptă al Sicilianei, ascuțit și plin de teorie.
opening.variation.open_sicilian.advanced.spoken = Albul deschide centrul cu de patru și recapturează cu calul: principalul câmp de luptă al Sicilianei, ascuțit și plin de teorie.
opening.variation.closed_sicilian = Siciliana închisă
opening.variation.closed_sicilian.def = Siciliana închisă
opening.variation.closed_sicilian.advanced = Albul evită d4, face fianchetto pe g2 și joacă adesea f4, urmărind un atac lent pe flancul regelui.
opening.variation.closed_sicilian.advanced.spoken = Albul evită de patru, face fianchetto pe ge doi și joacă adesea ef patru, urmărind un atac lent pe flancul regelui.
opening.variation.alapin = Varianta Alapin
opening.variation.alapin.def = varianta Alapin
opening.variation.alapin.advanced = Mutarea c3 pregătește d4 pentru un centru complet de pioni și ocolește teoria principală a Sicilianei; Negrul răspunde cu d5 sau cu calul pe f6.
opening.variation.alapin.advanced.spoken = Mutarea ce trei pregătește de patru pentru un centru complet de pioni și ocolește teoria principală a Sicilianei; Negrul răspunde cu de cinci sau cu calul pe ef șase.
opening.variation.smith_morra = Gambitul Smith-Morra
opening.variation.smith_morra.def = gambitul Smith-Morra
opening.variation.smith_morra.beginner = Albul dă un pion ca să se dezvolte repede și să deschidă coloane împotriva regelui negru: Negrul trebuie să se dezvolte cu grijă.
opening.variation.smith_morra.advanced = Un pion pentru o dezvoltare rapidă și pentru coloana c și coloana d deschise; Negrul se dezvoltă corect și adesea înapoiază pionul la momentul potrivit.
opening.variation.smith_morra.advanced.spoken = Un pion pentru o dezvoltare rapidă și pentru coloana ce și coloana de deschise; Negrul se dezvoltă corect și adesea înapoiază pionul la momentul potrivit.
opening.variation.grand_prix = Atacul Grand Prix
opening.variation.grand_prix.def = atacul Grand Prix
opening.variation.grand_prix.advanced = Albul joacă calul pe c3 și f4 pentru un atac rapid pe flancul regelui cu f5, evitând Siciliana deschisă.
opening.variation.grand_prix.advanced.spoken = Albul joacă calul pe ce trei și ef patru pentru un atac rapid pe flancul regelui cu ef cinci, evitând Siciliana deschisă.
opening.variation.rossolimo = Varianta Rossolimo
opening.variation.rossolimo.def = varianta Rossolimo
opening.variation.rossolimo.advanced = Nebunul de pe b5 leagă sau schimbă calul de pe c6 ca să-i lase Negrului pioni dublați și să păstreze jocul pozițional.
opening.variation.rossolimo.advanced.spoken = Nebunul de pe be cinci leagă sau schimbă calul de pe ce șase ca să-i lase Negrului pioni dublați și să păstreze jocul pozițional.
opening.variation.najdorf = Varianta Najdorf
opening.variation.najdorf.spoken = Varianta Najdorf
opening.variation.najdorf.def = varianta Najdorf
opening.variation.najdorf.def.spoken = varianta Najdorf
opening.variation.najdorf.advanced = Mutarea a6 dă naștere celei mai celebre Siciliene: flexibilă și profundă, cu structuri cu e5 sau e6 împotriva atacurilor ascuțite ale Albului.
opening.variation.najdorf.advanced.spoken = Mutarea a șase dă naștere celei mai celebre Siciliene: flexibilă și profundă, cu structuri cu e cinci sau e șase împotriva atacurilor ascuțite ale Albului.
opening.variation.dragon = Varianta Dragon
opening.variation.dragon.def = varianta Dragon
opening.variation.dragon.advanced = Negrul face fianchetto pe g7; atacul iugoslav duce la celebre curse între atacuri pe flancuri opuse.
opening.variation.dragon.advanced.spoken = Negrul face fianchetto pe ge șapte; atacul iugoslav duce la celebre curse între atacuri pe flancuri opuse.
opening.variation.accelerated_dragon = Dragonul accelerat
opening.variation.accelerated_dragon.def = Dragonul accelerat
opening.variation.accelerated_dragon.advanced = Negrul face fianchetto înainte de d6, ca să poată juca d5 dintr-odată; structura Maróczy, cu c4, este antidotul pozițional al Albului.
opening.variation.accelerated_dragon.advanced.spoken = Negrul face fianchetto înainte de de șase, ca să poată juca de cinci dintr-odată; structura Maróczy, cu ce patru, este antidotul pozițional al Albului.
opening.variation.scheveningen = Varianta Scheveningen
opening.variation.scheveningen.spoken = Varianta Scheveningen
opening.variation.scheveningen.def = varianta Scheveningen
opening.variation.scheveningen.def.spoken = varianta Scheveningen
opening.variation.scheveningen.advanced = Negrul își construiește micul centru cu e6 și d6, o carapace defensivă flexibilă; Albul atacă adesea cu g4.
opening.variation.scheveningen.advanced.spoken = Negrul își construiește micul centru cu e șase și de șase, o carapace defensivă flexibilă; Albul atacă adesea cu ge patru.
opening.variation.sveshnikov = Varianta Sveșnikov
opening.variation.sveshnikov.def = varianta Sveșnikov
opening.variation.sveshnikov.advanced = Negrul joacă e5 și acceptă o gaură pe d5 și un pion rămas în urmă pe d6 în schimbul activității și al perechii de nebuni: foarte dinamic.
opening.variation.sveshnikov.advanced.spoken = Negrul joacă e cinci și acceptă o gaură pe de cinci și un pion rămas în urmă pe de șase în schimbul activității și al perechii de nebuni: foarte dinamic.
opening.variation.taimanov = Varianta Taimanov
opening.variation.taimanov.def = varianta Taimanov
opening.variation.taimanov.advanced = Negrul combină e6 și calul de pe c6 cu un a6 flexibil și cu dama pe c7, ținând d6 în rezervă.
opening.variation.taimanov.advanced.spoken = Negrul combină e șase și calul de pe ce șase cu un a șase flexibil și cu dama pe ce șapte, ținând de șase în rezervă.
opening.variation.kan = Varianta Kan
opening.variation.kan.def = varianta Kan
opening.variation.kan.advanced = Negrul joacă e6 și a6, își ține caii acasă și urmărește adesea o așezare de tip Arici.
opening.variation.kan.advanced.spoken = Negrul joacă e șase și a șase, își ține caii acasă și urmărește adesea o așezare de tip Arici.
opening.variation.classical_sicilian = Varianta clasică
opening.variation.classical_sicilian.def = varianta clasică
opening.variation.classical_sicilian.advanced = Negrul își dezvoltă ambii cai și joacă d6; principalele răspunsuri ale Albului sunt atacul Richter-Rauzer și atacul Sozin.
opening.variation.classical_sicilian.advanced.spoken = Negrul își dezvoltă ambii cai și joacă de șase; principalele răspunsuri ale Albului sunt atacul Richter-Rauzer și atacul Sozin.
opening.variation.french_advance = Varianta de avans
opening.variation.french_advance.def = varianta de avans
opening.variation.french_advance.advanced = Albul blochează centrul cu e5 și câștigă spațiu; Negrul atacă d4, baza lanțului, cu c5 și cu piesele.
opening.variation.french_advance.advanced.spoken = Albul blochează centrul cu e cinci și câștigă spațiu; Negrul atacă de patru, baza lanțului, cu ce cinci și cu piesele.
opening.variation.french_exchange = Varianta de schimb
opening.variation.french_exchange.def = varianta de schimb
opening.variation.french_exchange.advanced = Schimbul de pioni pe d5 eliberează tensiunea: o structură simetrică și liniștită, în care nebunul de câmpuri albe al Negrului devine liber.
opening.variation.french_exchange.advanced.spoken = Schimbul de pioni pe de cinci eliberează tensiunea: o structură simetrică și liniștită, în care nebunul de câmpuri albe al Negrului devine liber.
opening.variation.french_tarrasch = Varianta Tarrasch
opening.variation.french_tarrasch.def = varianta Tarrasch
opening.variation.french_tarrasch.advanced = Calul merge pe d2 ca să evite legarea din varianta Winawer; Negrul acceptă adesea, după c5, un pion izolat pe d5 sau blochează centrul.
opening.variation.french_tarrasch.advanced.spoken = Calul merge pe de doi ca să evite legarea din varianta Winawer; Negrul acceptă adesea, după ce cinci, un pion izolat pe de cinci sau blochează centrul.
opening.variation.winawer = Varianta Winawer
opening.variation.winawer.spoken = Varianta Winawer
opening.variation.winawer.def = varianta Winawer
opening.variation.winawer.def.spoken = varianta Winawer
opening.variation.winawer.advanced = Nebunul de pe b4 leagă calul; de obicei Negrul dă nebunul pentru cal, lăsându-i Albului pioni dublați, dar și perechea de nebuni.
opening.variation.winawer.advanced.spoken = Nebunul de pe be patru leagă calul; de obicei Negrul dă nebunul pentru cal, lăsându-i Albului pioni dublați, dar și perechea de nebuni.
opening.variation.french_classical = Varianta clasică
opening.variation.french_classical.def = varianta clasică
opening.variation.french_classical.advanced = Negrul dezvoltă calul pe f6; jocul se învârte în jurul lanțului de pioni cu vârful pe e5 și al legării cu un nebun pe g5.
opening.variation.french_classical.advanced.spoken = Negrul dezvoltă calul pe ef șase; jocul se învârte în jurul lanțului de pioni cu vârful pe e cinci și al legării cu un nebun pe ge cinci.
opening.variation.french_rubinstein = Varianta Rubinstein
opening.variation.french_rubinstein.def = varianta Rubinstein
opening.variation.french_rubinstein.advanced = Negrul ia pe e4 și cedează centrul pentru o poziție solidă și compactă, urmărind c5 mai târziu.
opening.variation.french_rubinstein.advanced.spoken = Negrul ia pe e patru și cedează centrul pentru o poziție solidă și compactă, urmărind ce cinci mai târziu.
opening.variation.ck_advance = Varianta de avans
opening.variation.ck_advance.def = varianta de avans
opening.variation.ck_advance.advanced = Albul câștigă spațiu cu e5; Negrul dezvoltă nebunul pe f5 înainte de e6 și ripostează cu c5.
opening.variation.ck_advance.advanced.spoken = Albul câștigă spațiu cu e cinci; Negrul dezvoltă nebunul pe ef cinci înainte de e șase și ripostează cu ce cinci.
opening.variation.ck_exchange = Varianta de schimb
opening.variation.ck_exchange.def = varianta de schimb
opening.variation.ck_exchange.advanced = O structură Carlsbad cu culorile inversate: Albul se așază pe flancul regelui, Negrul joacă pentru atacul minorității pe flancul damei.
opening.variation.ck_panov = Atacul Panov
opening.variation.ck_panov.def = atacul Panov
opening.variation.ck_panov.advanced = Albul joacă c4 și acceptă un pion izolat pe d4 în schimbul pieselor active și al șanselor de atac.
opening.variation.ck_panov.advanced.spoken = Albul joacă ce patru și acceptă un pion izolat pe de patru în schimbul pieselor active și al șanselor de atac.
opening.variation.ck_classical = Varianta clasică
opening.variation.ck_classical.def = varianta clasică
opening.variation.ck_classical.advanced = Nebunul iese pe f5 cu câștig de timp, atacând calul; Albul câștigă spațiu cu h4 și h5, iar rocadele opuse sunt frecvente.
opening.variation.ck_classical.advanced.spoken = Nebunul iese pe ef cinci cu câștig de timp, atacând calul; Albul câștigă spațiu cu haș patru și haș cinci, iar rocadele opuse sunt frecvente.
opening.variation.ck_two_knights = Atacul celor doi cai
opening.variation.ck_two_knights.def = atacul celor doi cai
opening.variation.ck_two_knights.advanced = Albul își dezvoltă ambii cai înainte de d4, păstrându-și flexibilitatea și evitând variantele principale.
opening.variation.ck_two_knights.advanced.spoken = Albul își dezvoltă ambii cai înainte de de patru, păstrându-și flexibilitatea și evitând variantele principale.
opening.variation.two_knights = Apărarea celor doi cai
opening.variation.two_knights.def = apărarea celor doi cai
opening.variation.two_knights.beginner = Negrul contraatacă e4 cu calul în loc să-l copieze pe Alb; atenție la saltul calului pe g5, care atacă f7.
opening.variation.two_knights.beginner.spoken = Negrul contraatacă e patru cu calul în loc să-l copieze pe Alb; atenție la saltul calului pe ge cinci, care atacă ef șapte.
opening.variation.two_knights.advanced = Cel mai activ răspuns al Negrului împotriva Italianei: invită saltul ascuțit al calului pe g5 sau liniștitul d3.
opening.variation.two_knights.advanced.spoken = Cel mai activ răspuns al Negrului împotriva Italianei: invită saltul ascuțit al calului pe ge cinci sau liniștitul de trei.
opening.variation.giuoco_piano = Giuoco Piano
opening.variation.giuoco_piano.spoken = Giuoco Piano
opening.variation.giuoco_piano.def = Giuoco Piano
opening.variation.giuoco_piano.def.spoken = Giuoco Piano
opening.variation.giuoco_piano.beginner = „Jocul liniștit” în italiană: ambii nebuni țintesc pionul f al adversarului, iar partida se dezvoltă calm.
opening.variation.giuoco_piano.beginner.spoken = „Jocul liniștit” în italiană: ambii nebuni țintesc pionul ef al adversarului, iar partida se dezvoltă calm.
opening.variation.giuoco_piano.advanced = Nebunul negru îl oglindește pe cel alb; Albul alege între jocul central cu c3 și d4, lentul d3 sau gambitul Evans.
opening.variation.giuoco_piano.advanced.spoken = Nebunul negru îl oglindește pe cel alb; Albul alege între jocul central cu ce trei și de patru, lentul de trei sau gambitul Evans.
opening.variation.giuoco_pianissimo = Giuoco Pianissimo
opening.variation.giuoco_pianissimo.spoken = Giuoco Pianissimo
opening.variation.giuoco_pianissimo.def = Giuoco Pianissimo
opening.variation.giuoco_pianissimo.def.spoken = Giuoco Pianissimo
opening.variation.giuoco_pianissimo.advanced = Italiana modernă și lentă, cu d3, c3 și rocadă: manevre lungi și un avans d4 amânat.
opening.variation.giuoco_pianissimo.advanced.spoken = Italiana modernă și lentă, cu de trei, ce trei și rocadă: manevre lungi și un avans de patru amânat.
opening.variation.evans = Gambitul Evans
opening.variation.evans.def = gambitul Evans
opening.variation.evans.advanced = Mutarea b4 dă un pion ca să abată nebunul și să construiască rapid un centru cu c3 și d4: un gambit foarte ascuțit, preferatul epocii romantice.
opening.variation.evans.advanced.spoken = Mutarea be patru dă un pion ca să abată nebunul și să construiască rapid un centru cu ce trei și de patru: un gambit foarte ascuțit, preferatul epocii romantice.
opening.variation.fried_liver = Atacul Fegatello
opening.variation.fried_liver.def = atacul Fegatello
opening.variation.fried_liver.beginner = Albul sacrifică calul pe f7 ca să scoată regele negru în câmp deschis: foarte periculos dacă Negrul a luat pe d5 cu calul.
opening.variation.fried_liver.beginner.spoken = Albul sacrifică calul pe ef șapte ca să scoată regele negru în câmp deschis: foarte periculos dacă Negrul a luat pe de cinci cu calul.
opening.variation.fried_liver.advanced = După sacrificiul calului pe f7, Albul obține un atac violent; varianta principală îl evită atacând nebunul cu calul pe a5.
opening.variation.fried_liver.advanced.spoken = După sacrificiul calului pe ef șapte, Albul obține un atac violent; varianta principală îl evită atacând nebunul cu calul pe a cinci.
opening.variation.traxler = Contraatacul Traxler
opening.variation.traxler.def = contraatacul Traxler
opening.variation.traxler.advanced = Negrul ignoră amenințarea pe f7 și lovește în schimb f2: tactică sălbatică, în care decid cunoștințele exacte.
opening.variation.traxler.advanced.spoken = Negrul ignoră amenințarea pe ef șapte și lovește în schimb ef doi: tactică sălbatică, în care decid cunoștințele exacte.
opening.variation.berlin = Apărarea berlineză
opening.variation.berlin.def = apărarea berlineză
opening.variation.berlin.advanced = Calul contraatacă e4; celebrul final berlinez, cu damele schimbate devreme și regele negru în centru, este extrem de solid.
opening.variation.berlin.advanced.spoken = Calul contraatacă e patru; celebrul final berlinez, cu damele schimbate devreme și regele negru în centru, este extrem de solid.
opening.variation.morphy = Apărarea Morphy
opening.variation.morphy.def = apărarea Morphy
opening.variation.morphy.advanced = Mutarea a6 îl provoacă imediat pe nebun: poarta spre variantele principale, Spaniola închisă, Spaniola deschisă și atacul Marshall.
opening.variation.morphy.advanced.spoken = Mutarea a șase îl provoacă imediat pe nebun: poarta spre variantele principale, Spaniola închisă, Spaniola deschisă și atacul Marshall.
opening.variation.closed_ruy = Spaniola închisă
opening.variation.closed_ruy.def = Spaniola închisă
opening.variation.closed_ruy.advanced = Varianta principală clasică: manevre lente ale Albului împotriva planurilor Negrului pe flancul damei, precum variantele Breyer, Zaițev sau Cigorin.
opening.variation.marshall = Atacul Marshall
opening.variation.marshall.def = atacul Marshall
opening.variation.marshall.advanced = Negrul sacrifică un pion cu d5 pentru un atac de durată pe flancul regelui; analizat în profunzime, atacul este o armă de remiză respectată la cel mai înalt nivel.
opening.variation.marshall.advanced.spoken = Negrul sacrifică un pion cu de cinci pentru un atac de durată pe flancul regelui; analizat în profunzime, atacul este o armă de remiză respectată la cel mai înalt nivel.
opening.variation.ruy_exchange = Varianta de schimb
opening.variation.ruy_exchange.def = varianta de schimb
opening.variation.ruy_exchange.advanced = Captura pe c6 îi dă Negrului perechea de nebuni, dar și pioni dublați; Albul urmărește un final cu o majoritate sănătoasă pe flancul regelui.
opening.variation.ruy_exchange.advanced.spoken = Captura pe ce șase îi dă Negrului perechea de nebuni, dar și pioni dublați; Albul urmărește un final cu o majoritate sănătoasă pe flancul regelui.
opening.variation.ruy_open = Spaniola deschisă
opening.variation.ruy_open.def = Spaniola deschisă
opening.variation.ruy_open.advanced = Negrul ia pionul e4 pentru un joc activ al pieselor; piesele sunt vii, dar coloana e și pionul d5 cer grijă.
opening.variation.ruy_open.advanced.spoken = Negrul ia pionul e patru pentru un joc activ al pieselor; piesele sunt vii, dar coloana e și pionul de cinci cer grijă.
opening.variation.schliemann = Apărarea Schliemann
opening.variation.schliemann.def = apărarea Schliemann
opening.variation.schliemann.advanced = Mutarea f5 face din această apărare un gambit al regelui cu culorile inversate: ascuțit și riscant pentru ambele tabere.
opening.variation.schliemann.advanced.spoken = Mutarea ef cinci face din această apărare un gambit al regelui cu culorile inversate: ascuțit și riscant pentru ambele tabere.
opening.variation.scotch_gambit = Gambitul scoțian
opening.variation.scotch_gambit.def = gambitul scoțian
opening.variation.scotch_gambit.advanced = Albul dezvoltă nebunul pe c4 în loc să recaptureze pe d4 și oferă un pion pentru o dezvoltare rapidă; adesea se ajunge, prin inversiune, la apărarea celor doi cai.
opening.variation.scotch_gambit.advanced.spoken = Albul dezvoltă nebunul pe ce patru în loc să recaptureze pe de patru și oferă un pion pentru o dezvoltare rapidă; adesea se ajunge, prin inversiune, la apărarea celor doi cai.
opening.variation.vienna_gambit = Gambitul vienez
opening.variation.vienna_gambit.def = gambitul vienez
opening.variation.vienna_gambit.advanced = Mutarea f4 în partida vieneză: un gambit al regelui cu calul deja pe c3; cel mai bun răspuns al Negrului este lovitura centrală d5.
opening.variation.vienna_gambit.advanced.spoken = Mutarea ef patru în partida vieneză: un gambit al regelui cu calul deja pe ce trei; cel mai bun răspuns al Negrului este lovitura centrală de cinci.
opening.variation.stafford = Gambitul Stafford
opening.variation.stafford.def = gambitul Stafford
opening.variation.stafford.beginner = Un gambit plin de capcane, popular pe internet: Negrul dă un pion și speră că Albul va cădea în cursele pe f2 și e4.
opening.variation.stafford.beginner.spoken = Un gambit plin de capcane, popular pe internet: Negrul dă un pion și speră că Albul va cădea în cursele pe ef doi și e patru.
opening.variation.stafford.advanced = Negrul obține o dezvoltare rapidă și capcane pe f2; cu mutări calme, Albul rămâne pur și simplu cu un pion curat în plus.
opening.variation.stafford.advanced.spoken = Negrul obține o dezvoltare rapidă și capcane pe ef doi; cu mutări calme, Albul rămâne pur și simplu cu un pion curat în plus.
opening.variation.wayward_queen = Atacul Parham
opening.variation.wayward_queen.def = atacul Parham
opening.variation.wayward_queen.beginner = O ieșire timpurie a damei spre f7, ideea matului școlarului: Negrul se apără cu calul și cu g6, apoi alungă dama cu piesele.
opening.variation.wayward_queen.beginner.spoken = O ieșire timpurie a damei spre ef șapte, ideea matului școlarului: Negrul se apără cu calul și cu ge șase, apoi alungă dama cu piesele.
opening.variation.wayward_queen.advanced = Ieșirea timpurie a damei încalcă regulile dezvoltării; Negrul câștigă timp hărțuind-o și ar trebui să obțină o poziție mai bună.
opening.variation.halloween = Gambitul Halloween
opening.variation.halloween.def = gambitul Halloween
opening.variation.halloween.advanced = Albul dă un cal pentru doi pioni și un centru mare: obiectiv incorect, dar periculos în partidele rapide.
opening.variation.qgd_orthodox = Apărarea ortodoxă
opening.variation.qgd_orthodox.def = apărarea ortodoxă
opening.variation.qgd_orthodox.advanced = Așezarea clasică, cu nebunul pe e7, rocada și calul pe d7: solidă, dar pasivă, eliberată prin c5 sau e5.
opening.variation.qgd_orthodox.advanced.spoken = Așezarea clasică, cu nebunul pe e șapte, rocada și calul pe de șapte: solidă, dar pasivă, eliberată prin ce cinci sau e cinci.
opening.variation.qgd_exchange = Varianta de schimb
opening.variation.qgd_exchange.def = varianta de schimb
opening.variation.qgd_exchange.advanced = Schimbul pe d5 creează structura Carlsbad; planul clasic al Albului este atacul minorității cu b4 și b5.
opening.variation.qgd_exchange.advanced.spoken = Schimbul pe de cinci creează structura Carlsbad; planul clasic al Albului este atacul minorității cu be patru și be cinci.
opening.variation.semi_tarrasch = Apărarea semi-Tarrasch
opening.variation.semi_tarrasch.def = apărarea semi-Tarrasch
opening.variation.semi_tarrasch.advanced = Negrul joacă c5 și recapturează pe d5 cu o piesă, evitând pionul izolat din apărarea Tarrasch; Albul obține un centru mobil.
opening.variation.semi_tarrasch.advanced.spoken = Negrul joacă ce cinci și recapturează pe de cinci cu o piesă, evitând pionul izolat din apărarea Tarrasch; Albul obține un centru mobil.
opening.variation.meran = Varianta Meran
opening.variation.meran.def = varianta Meran
opening.variation.meran.advanced = Negrul ia pe c4 și câștigă spațiu pe flancul damei cu b5, cu câștig de timp; jocul se învârte în jurul avansului c5 și al avansului Albului pe e5.
opening.variation.meran.advanced.spoken = Negrul ia pe ce patru și câștigă spațiu pe flancul damei cu be cinci, cu câștig de timp; jocul se învârte în jurul avansului ce cinci și al avansului Albului pe e cinci.
opening.variation.kid_classical = Varianta clasică
opening.variation.kid_classical.def = varianta clasică
opening.variation.kid_classical.advanced = Albul se dezvoltă calm și face rocada; după e5 și d5 începe celebra cursă, Albul pe flancul damei, Negrul pe flancul regelui.
opening.variation.kid_classical.advanced.spoken = Albul se dezvoltă calm și face rocada; după e cinci și de cinci începe celebra cursă, Albul pe flancul damei, Negrul pe flancul regelui.
opening.variation.kid_samisch = Varianta Sämisch
opening.variation.kid_samisch.spoken = Varianta Sämisch
opening.variation.kid_samisch.def = varianta Sämisch
opening.variation.kid_samisch.def.spoken = varianta Sämisch
opening.variation.kid_samisch.advanced = Mutarea f3 susține e4 și pregătește un asalt al pionilor pe flancul regelui; Negrul răspunde cu c5, cu e5 sau cu un plan pe flancul damei cu b5.
opening.variation.kid_samisch.advanced.spoken = Mutarea ef trei susține e patru și pregătește un asalt al pionilor pe flancul regelui; Negrul răspunde cu ce cinci, cu e cinci sau cu un plan pe flancul damei cu be cinci.
opening.variation.kid_four_pawns = Atacul celor patru pioni
opening.variation.kid_four_pawns.def = atacul celor patru pioni
opening.variation.kid_four_pawns.advanced = Albul construiește un zid de pioni pe c4, d4, e4 și f4; Negrul îl subminează imediat cu c5 și e6.
opening.variation.kid_four_pawns.advanced.spoken = Albul construiește un zid de pioni pe ce patru, de patru, e patru și ef patru; Negrul îl subminează imediat cu ce cinci și e șase.
opening.variation.kid_fianchetto = Varianta cu fianchetto
opening.variation.kid_fianchetto.def = varianta cu fianchetto
opening.variation.kid_fianchetto.advanced = Fianchetto-ul pe g2 neutralizează nebunul negru de pe g7, iar partida devine mai pozițională.
opening.variation.kid_fianchetto.advanced.spoken = Fianchetto-ul pe ge doi neutralizează nebunul negru de pe ge șapte, iar partida devine mai pozițională.
opening.variation.nimzo_rubinstein = Varianta Rubinstein
opening.variation.nimzo_rubinstein.def = varianta Rubinstein
opening.variation.nimzo_rubinstein.advanced = Mutarea e3 permite o dezvoltare calmă și ține în rezervă mai multe așezări: cel mai popular mod de a întâmpina apărarea nimzo-indiană.
opening.variation.nimzo_rubinstein.advanced.spoken = Mutarea e trei permite o dezvoltare calmă și ține în rezervă mai multe așezări: cel mai popular mod de a întâmpina apărarea nimzo-indiană.
opening.variation.nimzo_classical = Varianta clasică
opening.variation.nimzo_classical.def = varianta clasică
opening.variation.nimzo_classical.advanced = Dama merge pe c2 ca să recaptureze pe c3 fără pioni dublați; Albul obține perechea de nebuni, Negrul o dezvoltare rapidă.
opening.variation.nimzo_classical.advanced.spoken = Dama merge pe ce doi ca să recaptureze pe ce trei fără pioni dublați; Albul obține perechea de nebuni, Negrul o dezvoltare rapidă.
opening.variation.nimzo_samisch = Varianta Sämisch
opening.variation.nimzo_samisch.spoken = Varianta Sämisch
opening.variation.nimzo_samisch.def = varianta Sämisch
opening.variation.nimzo_samisch.def.spoken = varianta Sämisch
opening.variation.nimzo_samisch.advanced = Mutarea a3 forțează imediat schimbul pe c3: Albul acceptă pioni dublați în schimbul perechii de nebuni și al unui centru mare.
opening.variation.nimzo_samisch.advanced.spoken = Mutarea a trei forțează imediat schimbul pe ce trei: Albul acceptă pioni dublați în schimbul perechii de nebuni și al unui centru mare.
opening.variation.grunfeld_exchange = Varianta de schimb
opening.variation.grunfeld_exchange.def = varianta de schimb
opening.variation.grunfeld_exchange.advanced = Albul își construiește un centru mare cu e4; Negrul atacă d4 cu c5 și cu piesele, iar finalurile favorizează adesea majoritatea Negrului pe flancul damei.
opening.variation.grunfeld_exchange.advanced.spoken = Albul își construiește un centru mare cu e patru; Negrul atacă de patru cu ce cinci și cu piesele, iar finalurile favorizează adesea majoritatea Negrului pe flancul damei.
opening.variation.leningrad = Varianta Leningrad
opening.variation.leningrad.def = varianta Leningrad
opening.variation.leningrad.advanced = Negrul face fianchetto pe g7: o apărare olandeză în stil est-indian, în care Negrul joacă pentru e5 și pentru joc pe flancul regelui.
opening.variation.leningrad.advanced.spoken = Negrul face fianchetto pe ge șapte: o apărare olandeză în stil est-indian, în care Negrul joacă pentru e cinci și pentru joc pe flancul regelui.
opening.variation.stonewall_dutch = Varianta Stonewall
opening.variation.stonewall_dutch.def = varianta Stonewall
opening.variation.stonewall_dutch.advanced = Pionii de pe c6, d5, e6 și f5 îi dau Negrului un control solid ca stânca asupra câmpului e4, cu prețul unei găuri pe e5 și al unui nebun de câmpuri albe pasiv.
opening.variation.stonewall_dutch.advanced.spoken = Pionii de pe ce șase, de cinci, e șase și ef cinci îi dau Negrului un control solid ca stânca asupra câmpului e patru, cu prețul unei găuri pe e cinci și al unui nebun de câmpuri albe pasiv.
opening.variation.modern_benoni = Apărarea Benoni modernă
opening.variation.modern_benoni.def = apărarea Benoni modernă
opening.variation.modern_benoni.advanced = Negrul obține o majoritate pe flancul damei împotriva majorității centrale a Albului; domină tactica legată de câmpul e5 și de nebunul de pe g7.
opening.variation.modern_benoni.advanced.spoken = Negrul obține o majoritate pe flancul damei împotriva majorității centrale a Albului; domină tactica legată de câmpul e cinci și de nebunul de pe ge șapte.
opening.variation.catalan_open = Catalana deschisă
opening.variation.catalan_open.def = Catalana deschisă
opening.variation.catalan_open.advanced = Negrul ia pionul c4; Albul îl recâștigă și păstrează presiunea pe diagonala mare, iar Negrul urmărește c5 sau b5.
opening.variation.catalan_open.advanced.spoken = Negrul ia pionul ce patru; Albul îl recâștigă și păstrează presiunea pe diagonala mare, iar Negrul urmărește ce cinci sau be cinci.
opening.variation.catalan_closed = Catalana închisă
opening.variation.catalan_closed.def = Catalana închisă
opening.variation.catalan_closed.advanced = Negrul își păstrează pionul pe d5 cu o așezare compactă: o luptă pozițională lentă în jurul avansurilor eliberatoare e5 sau c5.
opening.variation.catalan_closed.advanced.spoken = Negrul își păstrează pionul pe de cinci cu o așezare compactă: o luptă pozițională lentă în jurul avansurilor eliberatoare e cinci sau ce cinci.
opening.variation.english_symmetrical = Varianta simetrică
opening.variation.english_symmetrical.def = varianta simetrică
opening.variation.english_symmetrical.advanced = Negrul îl copiază pe Alb cu c5: manevre lente, cu fianchetto-uri și presiune pe d4 și d5.
opening.variation.english_symmetrical.advanced.spoken = Negrul îl copiază pe Alb cu ce cinci: manevre lente, cu fianchetto-uri și presiune pe de patru și de cinci.
opening.variation.kings_english = Siciliana cu culorile inversate
opening.variation.kings_english.def = Siciliana cu culorile inversate
opening.variation.kings_english.advanced = Mutarea e5 transformă deschiderea engleză într-o Siciliană cu un timp în plus pentru Alb; planurile tipice sunt un fianchetto și un avans pe flancul damei.
opening.variation.kings_english.advanced.spoken = Mutarea e cinci transformă deschiderea engleză într-o Siciliană cu un timp în plus pentru Alb; planurile tipice sunt un fianchetto și un avans pe flancul damei.
opening.variation.alekhine_four_pawns = Atacul celor patru pioni
opening.variation.alekhine_four_pawns.def = atacul celor patru pioni
opening.variation.alekhine_four_pawns.advanced = Albul alungă calul cu pionii și își construiește un centru uriaș, dar prea întins; Negrul ripostează cu c5 și cu piesele.
opening.variation.alekhine_four_pawns.advanced.spoken = Albul alungă calul cu pionii și își construiește un centru uriaș, dar prea întins; Negrul ripostează cu ce cinci și cu piesele.
opening.variation.alekhine_modern = Varianta modernă
opening.variation.alekhine_modern.def = varianta modernă
opening.variation.alekhine_modern.advanced = Albul păstrează un avantaj de spațiu solid fără să se întindă prea mult; Negrul leagă calul sau face fianchetto.
opening.variation.pirc_austrian = Atacul austriac
opening.variation.pirc_austrian.def = atacul austriac
opening.variation.pirc_austrian.advanced = Mutarea f4 construiește un centru mare pentru e5 sau pentru un atac pe flancul regelui; Negrul ripostează cu c5 sau e5.
opening.variation.pirc_austrian.advanced.spoken = Mutarea ef patru construiește un centru mare pentru e cinci sau pentru un atac pe flancul regelui; Negrul ripostează cu ce cinci sau e cinci.
opening.variation.falkbeer = Contragambitul Falkbeer
opening.variation.falkbeer.def = contragambitul Falkbeer
opening.variation.falkbeer.advanced = Mutarea d5 ripostează în centru în loc de captura pe f4; practica modernă preferă mai întâi captura pe d5.
opening.variation.falkbeer.advanced.spoken = Mutarea de cinci ripostează în centru în loc de captura pe ef patru; practica modernă preferă mai întâi captura pe de cinci.

