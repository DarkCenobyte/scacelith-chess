opening.variation.morphy.advanced.spoken = a altı fili hemen sorguya çeker: ana varyantlara, yani Kapalı İspanyol'a, Açık İspanyol'a ve Marshall Atağına açılan kapı.
opening.variation.closed_ruy = Kapalı İspanyol
opening.variation.closed_ruy.def = Kapalı İspanyol
opening.variation.closed_ruy.advanced = Klasik ana varyant: Beyazın yavaş manevralarına karşı Siyahın Breyer, Zaytsev ya da Çigorin gibi vezir kanadı planları.
opening.variation.marshall = Marshall Atağı
opening.variation.marshall.def = Marshall Atağı
opening.variation.marshall.advanced = Siyah, kalıcı bir şah kanadı saldırısı için d5 ile bir piyon feda eder; derinlemesine analiz edilmiş bu varyant, üst düzeyde saygın bir beraberlik silahıdır.
opening.variation.marshall.advanced.spoken = Siyah, kalıcı bir şah kanadı saldırısı için de beş ile bir piyon feda eder; derinlemesine analiz edilmiş bu varyant, üst düzeyde saygın bir beraberlik silahıdır.
opening.variation.ruy_exchange = Değişim Varyantı
opening.variation.ruy_exchange.def = Değişim Varyantı
opening.variation.ruy_exchange.advanced = Beyazın c6'da alması Siyaha fil çiftini ama katmerli piyonları verir; Beyaz, şah kanadında sağlıklı bir çoğunlukla oyun sonunu hedefler.
opening.variation.ruy_exchange.advanced.spoken = Beyazın ce altıda alması Siyaha fil çiftini ama katmerli piyonları verir; Beyaz, şah kanadında sağlıklı bir çoğunlukla oyun sonunu hedefler.
opening.variation.ruy_open = Açık İspanyol
opening.variation.ruy_open.def = Açık İspanyol
opening.variation.ruy_open.advanced = Siyah, aktif taş oyunu için e4 piyonunu alır; taşlar canlıdır, ama d5 piyonuna ve e dikeyine dikkat etmek gerekir.
opening.variation.ruy_open.advanced.spoken = Siyah, aktif taş oyunu için e dört piyonunu alır; taşlar canlıdır, ama de beş piyonuna ve e dikeyine dikkat etmek gerekir.
opening.variation.schliemann = Schliemann Savunması
opening.variation.schliemann.def = Schliemann Savunması
opening.variation.schliemann.advanced = f5, renkleri ters çevrilmiş bir Şah Gambitidir: iki taraf için de keskin ve riskli.
opening.variation.schliemann.advanced.spoken = fe beş, renkleri ters çevrilmiş bir Şah Gambitidir: iki taraf için de keskin ve riskli.
opening.variation.scotch_gambit = İskoç Gambiti
opening.variation.scotch_gambit.def = İskoç Gambiti
opening.variation.scotch_gambit.advanced = Beyaz d4'te geri almak yerine filini c4'e geliştirir ve hızlı gelişim için bir piyon teklif eder; sık sık İki At Savunmasına dönüşür.
opening.variation.scotch_gambit.advanced.spoken = Beyaz de dörtte geri almak yerine filini ce dörde geliştirir ve hızlı gelişim için bir piyon teklif eder; sık sık İki At Savunmasına dönüşür.
opening.variation.vienna_gambit = Viyana Gambiti
opening.variation.vienna_gambit.def = Viyana Gambiti
opening.variation.vienna_gambit.advanced = Viyana Oyununda f4: atın zaten c3'te olduğu bir Şah Gambiti; Siyahın en iyi cevabı merkezde d5 vuruşudur.
opening.variation.vienna_gambit.advanced.spoken = Viyana Oyununda fe dört: atın zaten ce üçte olduğu bir Şah Gambiti; Siyahın en iyi cevabı merkezde de beş vuruşudur.
opening.variation.stafford = Stafford Gambiti
opening.variation.stafford.def = Stafford Gambiti
opening.variation.stafford.beginner = İnternette popüler, tuzaklarla dolu bir gambit: Siyah bir piyon verir ve Beyazın f2 ile e4'e karşı kurulan tuzaklardan birine düşmesini umar.
opening.variation.stafford.beginner.spoken = İnternette popüler, tuzaklarla dolu bir gambit: Siyah bir piyon verir ve Beyazın fe iki ile e dörde karşı kurulan tuzaklardan birine düşmesini umar.
opening.variation.stafford.advanced = Siyah hızlı gelişim ve f2'ye karşı tuzaklar elde eder; Beyaz sakin hamlelerle temiz bir piyon fazlasını korur.
opening.variation.stafford.advanced.spoken = Siyah hızlı gelişim ve fe ikiye karşı tuzaklar elde eder; Beyaz sakin hamlelerle temiz bir piyon fazlasını korur.
opening.variation.wayward_queen = Parham Atağı
opening.variation.wayward_queen.def = Parham Atağı
opening.variation.wayward_queen.beginner = Çoban Matı fikriyle f7'yi hedef alan erken bir vezir akını: Siyah at ve g6 ile savunur, sonra veziri taşlarıyla kovalar.
opening.variation.wayward_queen.beginner.spoken = Çoban Matı fikriyle fe yediyi hedef alan erken bir vezir akını: Siyah at ve ge altı ile savunur, sonra veziri taşlarıyla kovalar.
opening.variation.wayward_queen.advanced = Vezirin erken çıkışı gelişim kurallarını çiğner; Siyah veziri taciz ederek zaman kazanır ve daha iyi bir pozisyona ulaşmalıdır.
opening.variation.halloween = Halloween Gambiti
opening.variation.halloween.def = Halloween Gambiti
opening.variation.halloween.advanced = Beyaz iki piyon ve büyük bir merkez için bir at verir: objektif olarak sağlıksız, ama hızlı oyunlarda tehlikeli.
opening.variation.qgd_orthodox = Ortodoks Savunma
opening.variation.qgd_orthodox.def = Ortodoks Savunma
opening.variation.qgd_orthodox.advanced = Klasik kuruluş: fil e7'de, at d7'de ve rok atılmış. Sağlam ama pasif; c5 ya da e5 ile rahatlar.
opening.variation.qgd_orthodox.advanced.spoken = Klasik kuruluş: fil e yedide, at de yedide ve rok atılmış. Sağlam ama pasif; ce beş ya da e beş ile rahatlar.
opening.variation.qgd_exchange = Değişim Varyantı
opening.variation.qgd_exchange.def = Değişim Varyantı
opening.variation.qgd_exchange.advanced = d5'teki değişim Carlsbad yapısını oluşturur; Beyazın klasik planı b4 ve b5 ile azınlık saldırısıdır.
opening.variation.qgd_exchange.advanced.spoken = de beşteki değişim Carlsbad yapısını oluşturur; Beyazın klasik planı be dört ve be beş ile azınlık saldırısıdır.
opening.variation.semi_tarrasch = Yarı Tarrasch Savunması
opening.variation.semi_tarrasch.def = Yarı Tarrasch Savunması
opening.variation.semi_tarrasch.advanced = Siyah c5 oynar ve d5'te bir taşla geri alarak Tarrasch Savunmasındaki izole piyondan kaçınır; Beyaz hareketli bir merkez elde eder.
opening.variation.semi_tarrasch.advanced.spoken = Siyah ce beş oynar ve de beşte bir taşla geri alarak Tarrasch Savunmasındaki izole piyondan kaçınır; Beyaz hareketli bir merkez elde eder.
opening.variation.meran = Meran Varyantı
opening.variation.meran.def = Meran Varyantı
opening.variation.meran.advanced = Siyah c4'te alır ve b5 ile tempo kazanıp vezir kanadında genişler; oyun, c5 atılımı ve Beyazın e5 ilerleyişi etrafında döner.
opening.variation.meran.advanced.spoken = Siyah ce dörtte alır ve be beş ile tempo kazanıp vezir kanadında genişler; oyun, ce beş atılımı ve Beyazın e beş ilerleyişi etrafında döner.
opening.variation.kid_classical = Klasik Varyant
opening.variation.kid_classical.def = Klasik Varyant
opening.variation.kid_classical.advanced = Beyaz sakin gelişir ve rok atar; e5 ve d5'ten sonra ünlü yarış başlar: Beyaz vezir kanadında, Siyah şah kanadında.
opening.variation.kid_classical.advanced.spoken = Beyaz sakin gelişir ve rok atar; e beş ve de beşten sonra ünlü yarış başlar: Beyaz vezir kanadında, Siyah şah kanadında.
opening.variation.kid_samisch = Sämisch Varyantı
opening.variation.kid_samisch.spoken = Sämisch Varyantı
opening.variation.kid_samisch.def = Sämisch Varyantı
opening.variation.kid_samisch.def.spoken = Sämisch Varyantı
opening.variation.kid_samisch.advanced = f3, e4'ü destekler ve şah kanadında bir piyon fırtınası hazırlar; Siyah c5, e5 ya da b5 ile bir vezir kanadı planıyla karşılık verir.
opening.variation.kid_samisch.advanced.spoken = fe üç, e dördü destekler ve şah kanadında bir piyon fırtınası hazırlar; Siyah ce beş, e beş ya da be beş ile bir vezir kanadı planıyla karşılık verir.
opening.variation.kid_four_pawns = Dört Piyon Atağı
opening.variation.kid_four_pawns.def = Dört Piyon Atağı
opening.variation.kid_four_pawns.advanced = Beyaz c4, d4, e4 ve f4'te bir piyon duvarı kurar; Siyah bu duvarı hemen c5 ve e6 ile oyar.
opening.variation.kid_four_pawns.advanced.spoken = Beyaz ce dört, de dört, e dört ve fe dörtte bir piyon duvarı kurar; Siyah bu duvarı hemen ce beş ve e altı ile oyar.
opening.variation.kid_fianchetto = Fiyanketto Varyantı
opening.variation.kid_fianchetto.def = Fiyanketto Varyantı
opening.variation.kid_fianchetto.advanced = Beyazın g2'deki fiyankettosu Siyahın g7'deki filinin etkisini azaltır ve oyun daha pozisyonel bir hâl alır.
opening.variation.kid_fianchetto.advanced.spoken = Beyazın ge ikideki fiyankettosu Siyahın ge yedideki filinin etkisini azaltır ve oyun daha pozisyonel bir hâl alır.
opening.variation.nimzo_rubinstein = Rubinstein Varyantı
opening.variation.nimzo_rubinstein.def = Rubinstein Varyantı
opening.variation.nimzo_rubinstein.advanced = e3 sakin bir gelişim sağlar ve birkaç kuruluşu yedekte tutar: Nimzo-Hint Savunmasına karşı en popüler yol.
opening.variation.nimzo_rubinstein.advanced.spoken = e üç sakin bir gelişim sağlar ve birkaç kuruluşu yedekte tutar: Nimzo-Hint Savunmasına karşı en popüler yol.
opening.variation.nimzo_classical = Klasik Varyant
opening.variation.nimzo_classical.def = Klasik Varyant
opening.variation.nimzo_classical.advanced = Vezir, c3'te katmerli piyon olmadan geri alabilmek için c2'ye gider; Beyaz fil çiftini, Siyah hızlı gelişimi elde eder.
opening.variation.nimzo_classical.advanced.spoken = Vezir, ce üçte katmerli piyon olmadan geri alabilmek için ce ikiye gider; Beyaz fil çiftini, Siyah hızlı gelişimi elde eder.
opening.variation.nimzo_samisch = Sämisch Varyantı
opening.variation.nimzo_samisch.spoken = Sämisch Varyantı
opening.variation.nimzo_samisch.def = Sämisch Varyantı
opening.variation.nimzo_samisch.def.spoken = Sämisch Varyantı
opening.variation.nimzo_samisch.advanced = a3, c3'teki değişimi hemen zorlar: Beyaz, fil çifti ve büyük bir merkez için katmerli piyonları kabul eder.
opening.variation.nimzo_samisch.advanced.spoken = a üç, ce üçteki değişimi hemen zorlar: Beyaz, fil çifti ve büyük bir merkez için katmerli piyonları kabul eder.
opening.variation.grunfeld_exchange = Değişim Varyantı
opening.variation.grunfeld_exchange.def = Değişim Varyantı
opening.variation.grunfeld_exchange.advanced = Beyaz e4 ile büyük bir merkez kurar; Siyah c5 ve taşlarıyla d4'e saldırır, oyun sonları da çoğu zaman Siyahın vezir kanadı çoğunluğundan yanadır.
opening.variation.grunfeld_exchange.advanced.spoken = Beyaz e dört ile büyük bir merkez kurar; Siyah ce beş ve taşlarıyla de dörde saldırır, oyun sonları da çoğu zaman Siyahın vezir kanadı çoğunluğundan yanadır.
opening.variation.leningrad = Leningrad Varyantı
opening.variation.leningrad.def = Leningrad Varyantı
opening.variation.leningrad.advanced = Siyah g7'de fiyanketto yapar: Siyahın e5 ve şah kanadı oyunu için oynadığı, Şah Hint tarzı bir Hollanda.
opening.variation.leningrad.advanced.spoken = Siyah ge yedide fiyanketto yapar: Siyahın e beş ve şah kanadı oyunu için oynadığı, Şah Hint tarzı bir Hollanda.
opening.variation.stonewall_dutch = Stonewall Varyantı
opening.variation.stonewall_dutch.def = Stonewall Varyantı
opening.variation.stonewall_dutch.advanced = Siyahın c6, d5, e6 ve f5'teki piyonları ona e4 üzerinde kaya gibi sağlam bir kontrol sağlar; bedeli e5'te bir delik ve pasif bir beyaz kareli fildir.
opening.variation.stonewall_dutch.advanced.spoken = Siyahın ce altı, de beş, e altı ve fe beşteki piyonları ona e dört üzerinde kaya gibi sağlam bir kontrol sağlar; bedeli e beşte bir delik ve pasif bir beyaz kareli fildir.
opening.variation.modern_benoni = Modern Benoni
opening.variation.modern_benoni.def = Modern Benoni
opening.variation.modern_benoni.advanced = Siyah, Beyazın merkezdeki çoğunluğuna karşı vezir kanadında çoğunluk elde eder; e5 karesi ve g7'deki fil etrafındaki taktikler belirleyicidir.
opening.variation.modern_benoni.advanced.spoken = Siyah, Beyazın merkezdeki çoğunluğuna karşı vezir kanadında çoğunluk elde eder; e beş karesi ve ge yedideki fil etrafındaki taktikler belirleyicidir.
opening.variation.catalan_open = Açık Katalan
opening.variation.catalan_open.def = Açık Katalan
opening.variation.catalan_open.advanced = Siyah c4 piyonunu alır; Beyaz onu geri kazanır ve uzun çaprazda baskıyı sürdürür, Siyah ise c5 ya da b5 hamlesini hedefler.
opening.variation.catalan_open.advanced.spoken = Siyah ce dört piyonunu alır; Beyaz onu geri kazanır ve uzun çaprazda baskıyı sürdürür, Siyah ise ce beş ya da be beş hamlesini hedefler.
opening.variation.catalan_closed = Kapalı Katalan
opening.variation.catalan_closed.def = Kapalı Katalan
opening.variation.catalan_closed.advanced = Siyah, derli toplu bir kuruluşla piyonunu d5'te tutar: e5 ya da c5 rahatlatıcı atılımları etrafında yavaş, pozisyonel bir mücadele.
opening.variation.catalan_closed.advanced.spoken = Siyah, derli toplu bir kuruluşla piyonunu de beşte tutar: e beş ya da ce beş rahatlatıcı atılımları etrafında yavaş, pozisyonel bir mücadele.
opening.variation.english_symmetrical = Simetrik Varyant
opening.variation.english_symmetrical.def = Simetrik Varyant
opening.variation.english_symmetrical.advanced = Siyah c5 ile Beyazı taklit eder: fiyankettolar ve d4 ile d5 üzerinde baskıyla yavaş manevralar.
opening.variation.english_symmetrical.advanced.spoken = Siyah ce beş ile Beyazı taklit eder: fiyankettolar ve de dört ile de beş üzerinde baskıyla yavaş manevralar.
opening.variation.kings_english = Ters Sicilya
opening.variation.kings_english.def = Ters Sicilya
opening.variation.kings_english.advanced = e5, İngiliz Açılışını Beyaz için bir tempo fazlasıyla oynanan bir Sicilya'ya çevirir; tipik planlar fiyanketto ve vezir kanadında piyon ilerleyişidir.
opening.variation.kings_english.advanced.spoken = e beş, İngiliz Açılışını Beyaz için bir tempo fazlasıyla oynanan bir Sicilya'ya çevirir; tipik planlar fiyanketto ve vezir kanadında piyon ilerleyişidir.
opening.variation.alekhine_four_pawns = Dört Piyon Atağı
opening.variation.alekhine_four_pawns.def = Dört Piyon Atağı
opening.variation.alekhine_four_pawns.advanced = Beyaz atı piyonlarla kovalar ve devasa ama fazla ilerlemiş bir merkez kurar; Siyah c5 ve taşlarıyla karşılık verir.
opening.variation.alekhine_four_pawns.advanced.spoken = Beyaz atı piyonlarla kovalar ve devasa ama fazla ilerlemiş bir merkez kurar; Siyah ce beş ve taşlarıyla karşılık verir.
opening.variation.alekhine_modern = Modern Varyant
opening.variation.alekhine_modern.def = Modern Varyant
opening.variation.alekhine_modern.advanced = Beyaz fazla ilerlemeden sağlam bir alan üstünlüğünü korur; Siyah atı açmaza alır ya da fiyanketto yapar.
opening.variation.pirc_austrian = Avusturya Atağı
opening.variation.pirc_austrian.def = Avusturya Atağı
opening.variation.pirc_austrian.advanced = f4, e5 hamlesi ya da şah kanadı saldırısı için büyük bir merkez kurar; Siyah c5 ya da e5 ile karşılık verir.
opening.variation.pirc_austrian.advanced.spoken = fe dört, e beş hamlesi ya da şah kanadı saldırısı için büyük bir merkez kurar; Siyah ce beş ya da e beş ile karşılık verir.
opening.variation.falkbeer = Falkbeer Karşı Gambiti
opening.variation.falkbeer.def = Falkbeer Karşı Gambiti
opening.variation.falkbeer.advanced = d5, f4'te almak yerine merkezde karşılık verir; modern uygulamada Beyazın önce d5'te alması tercih edilir.
opening.variation.falkbeer.advanced.spoken = de beş, fe dörtte almak yerine merkezde karşılık verir; modern uygulamada Beyazın önce de beşte alması tercih edilir.

