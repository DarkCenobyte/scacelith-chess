opening.family.nimzowitsch_def.advanced.spoken = Tato obrana vede ke strukturám s dé čtyři a dé pět nebo é pět, případně přechází do otevřených her; její cena spočívá v překvapení a v pružné hře figurami.
opening.family.owen = Owenova obrana
opening.family.owen.def = Owenova obrana
