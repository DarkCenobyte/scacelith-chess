opening.family.kgd.advanced.spoken = Střelec na cé pět spoutává královské křídlo bílého a Falkbeerův protigambit vrací úder v centru; obojí se vyhýbá dlouhým vynuceným variantám přijatého gambitu.
opening.family.nimzowitsch_def = Nimcovičova obrana
opening.family.nimzowitsch_def.spoken = Nimcovičova obrana
opening.family.nimzowitsch_def.def = Nimcovičova obrana
