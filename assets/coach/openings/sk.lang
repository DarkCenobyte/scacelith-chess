opening.family.richter_veresov.advanced.spoken = Jazdec blokuje pešiaka cé, ale podporuje ef tri a é štyri; čierny dobre pochodí s cé päť alebo so strelcom na ef päť.
opening.family.st_george = Obrana svätého Juraja
opening.family.st_george.def = obrana svätého Juraja
opening.family.st_george.beginner = Čierny začína ťahmi a6 a b5, zriedkavým krídelným postavením, ktoré preslávila Milesova výhra nad Karpovom.
opening.family.st_george.beginner.spoken = Čierny začína ťahmi á šesť a bé päť, zriedkavým krídelným postavením, ktoré preslávila Milesova výhra nad Karpovom.
opening.family.st_george.advanced = Čierny smeruje k strelcovi na b7 a k rozpínaniu na dámskom krídle a prenecháva stred; biely si jednoduchým vývinom v strede udrží prevahu.
opening.family.st_george.advanced.spoken = Čierny smeruje k strelcovi na bé sedem a k rozpínaniu na dámskom krídle a prenecháva stred; biely si jednoduchým vývinom v strede udrží prevahu.
opening.family.borg = Borgova obrana
opening.family.borg.def = Borgova obrana
opening.family.borg.beginner = Čierny posunie pešiaka g o dve polia: provokatívne otvorenie, ktoré oslabuje vlastného kráľa.
opening.family.borg.beginner.spoken = Čierny posunie pešiaka gé o dve polia: provokatívne otvorenie, ktoré oslabuje vlastného kráľa.
opening.family.borg.advanced = Grobovo otvorenie s obrátenými farbami; biely získava priestor a čas ťahom d4 a tlakom na g5.
opening.family.borg.advanced.spoken = Grobovo otvorenie s obrátenými farbami; biely získava priestor a čas ťahom dé štyri a tlakom na gé päť.
opening.family.hippopotamus = Obrana Hroch
opening.family.hippopotamus.def = obrana Hroch
opening.family.hippopotamus.beginner = Čierny postaví pešiakov na šiesty rad, oboch strelcov dá do fianchetta a čaká, kým biely zájde priďaleko.
opening.family.hippopotamus.advanced = Pružné vyčkávacie postavenie: zdravé proti pomalej hre, stiesnené proti širokému stredu.
opening.family.english_defense = Anglická obrana
opening.family.english_defense.def = anglická obrana
opening.family.english_defense.beginner = Čierny odpovedá ťahom b6 a strelcom na b7, aby bojoval o e4 figúrami.
opening.family.english_defense.beginner.spoken = Čierny odpovedá ťahom bé šesť a strelcom na bé sedem, aby bojoval o é štyri figúrami.
opening.family.english_defense.advanced = Čierny dovolí bielemu veľký stred a potom naň útočí šachom strelcom na b4, ťahom f5 a tlakom na e4.
opening.family.english_defense.advanced.spoken = Čierny dovolí bielemu veľký stred a potom naň útočí šachom strelcom na bé štyri, ťahom ef päť a tlakom na é štyri.
opening.family.pterodactyl = Obrana Pterodaktyl
opening.family.pterodactyl.def = obrana Pterodaktyl
opening.family.pterodactyl.beginner = Čierny dá kráľovského strelca do fianchetta, potom hrá c5 a zavčasu vyvedie dámu na a5: neobvyklý, agresívny systém.
opening.family.pterodactyl.beginner.spoken = Čierny dá kráľovského strelca do fianchetta, potom hrá cé päť a zavčasu vyvedie dámu na á päť: neobvyklý, agresívny systém.
opening.family.pterodactyl.advanced = Zmes myšlienok modernej a sicílskej obrany: dáma na a5 napáda po diagonále jazdca na c3.
opening.family.pterodactyl.advanced.spoken = Zmes myšlienok modernej a sicílskej obrany: dáma na á päť napáda po diagonále jazdca na cé tri.
opening.family.bongcloud = Útok Bongcloud
opening.family.bongcloud.def = útok Bongcloud
opening.family.bongcloud.beginner = Biely v druhom ťahu pohne kráľom: žartovné otvorenie, ktoré porušuje základné pravidlá, lebo kráľ má zostať v bezpečí a urobiť rošádu.
opening.family.bongcloud.advanced = Kráľ zablokuje strelca aj dámu a vzdá sa rošády; hrá sa zo žartu a nemá sa napodobňovať.

# ---- Notable variations
opening.variation.open_sicilian = Otvorená sicílska obrana
opening.variation.open_sicilian.def = otvorená sicílska obrana
opening.variation.open_sicilian.advanced = Biely otvorí stred ťahom d4 a berie späť jazdcom: hlavné bojisko sicílskej obrany, ostré a plné teórie.
opening.variation.open_sicilian.advanced.spoken = Biely otvorí stred ťahom dé štyri a berie späť jazdcom: hlavné bojisko sicílskej obrany, ostré a plné teórie.
opening.variation.closed_sicilian = Zatvorená sicílska obrana
opening.variation.closed_sicilian.def = zatvorená sicílska obrana
opening.variation.closed_sicilian.advanced = Biely sa vyhne d4, urobí fianchetto na g2 a často hrá f4 s cieľom pomalého útoku na kráľovskom krídle.
opening.variation.closed_sicilian.advanced.spoken = Biely sa vyhne dé štyri, urobí fianchetto na gé dva a často hrá ef štyri s cieľom pomalého útoku na kráľovskom krídle.
opening.variation.alapin = Alapinov variant
opening.variation.alapin.def = Alapinov variant
opening.variation.alapin.advanced = Ťah c3 pripravuje d4, aby biely postavil úplný pešiakový stred a obišiel hlavnú teóriu sicílskej obrany; čierny odpovedá ťahom d5 alebo jazdcom na f6.
opening.variation.alapin.advanced.spoken = Ťah cé tri pripravuje dé štyri, aby biely postavil úplný pešiakový stred a obišiel hlavnú teóriu sicílskej obrany; čierny odpovedá ťahom dé päť alebo jazdcom na ef šesť.
opening.variation.smith_morra = Smithov-Morrov gambit
opening.variation.smith_morra.def = Smithov-Morrov gambit
opening.variation.smith_morra.beginner = Biely dá pešiaka, aby sa rýchlo vyvinul a otvoril línie proti čiernemu kráľovi: čierny sa musí vyvíjať opatrne.
opening.variation.smith_morra.advanced = Pešiak za rýchly vývin a otvorený stĺpec c aj stĺpec d; čierny sa zdravo vyvíja a v pravej chvíli pešiaka často vráti.
opening.variation.smith_morra.advanced.spoken = Pešiak za rýchly vývin a otvorený stĺpec cé aj stĺpec dé; čierny sa zdravo vyvíja a v pravej chvíli pešiaka často vráti.
opening.variation.grand_prix = Útok Grand Prix
opening.variation.grand_prix.def = útok Grand Prix
opening.variation.grand_prix.advanced = Biely vyvinie jazdca na c3, zahrá f4 a smeruje k rýchlemu útoku na kráľovskom krídle ťahom f5; vyhne sa tak otvorenej sicílskej obrane.
opening.variation.grand_prix.advanced.spoken = Biely vyvinie jazdca na cé tri, zahrá ef štyri a smeruje k rýchlemu útoku na kráľovskom krídle ťahom ef päť; vyhne sa tak otvorenej sicílskej obrane.
opening.variation.rossolimo = Rossolimov variant
opening.variation.rossolimo.def = Rossolimov variant
opening.variation.rossolimo.advanced = Strelec na b5 viaže alebo vymení jazdca na c6, aby čierny dostal zdvojených pešiakov a hra zostala pozičná.
opening.variation.rossolimo.advanced.spoken = Strelec na bé päť viaže alebo vymení jazdca na cé šesť, aby čierny dostal zdvojených pešiakov a hra zostala pozičná.
opening.variation.najdorf = Najdorfov variant
opening.variation.najdorf.spoken = Najdorfov variant
opening.variation.najdorf.def = Najdorfov variant
opening.variation.najdorf.def.spoken = Najdorfov variant
opening.variation.najdorf.advanced = Ťah a6 vytvára najslávnejší variant sicílskej obrany: pružný a hlboký, so štruktúrami s e5 alebo e6 proti ostrým útokom bieleho.
opening.variation.najdorf.advanced.spoken = Ťah á šesť vytvára najslávnejší variant sicílskej obrany: pružný a hlboký, so štruktúrami s é päť alebo é šesť proti ostrým útokom bieleho.
opening.variation.dragon = Dračí variant
opening.variation.dragon.def = dračí variant
opening.variation.dragon.advanced = Čierny urobí fianchetto na g7; juhoslovanský útok vedie k slávnym pretekom útokov na opačných krídlach.
opening.variation.dragon.advanced.spoken = Čierny urobí fianchetto na gé sedem; juhoslovanský útok vedie k slávnym pretekom útokov na opačných krídlach.
opening.variation.accelerated_dragon = Zrýchlený drak
opening.variation.accelerated_dragon.def = zrýchlený drak
opening.variation.accelerated_dragon.advanced = Čierny urobí fianchetto ešte pred d6, aby mohol hrať d5 jedným ťahom; pozičným protiliekom bieleho je Maróczyho zovretie s c4.
opening.variation.accelerated_dragon.advanced.spoken = Čierny urobí fianchetto ešte pred dé šesť, aby mohol hrať dé päť jedným ťahom; pozičným protiliekom bieleho je Maróczyho zovretie s cé štyri.
opening.variation.scheveningen = Scheveningenský variant
opening.variation.scheveningen.spoken = Scheveningenský variant
opening.variation.scheveningen.def = scheveningenský variant
opening.variation.scheveningen.def.spoken = scheveningenský variant
opening.variation.scheveningen.advanced = Čierny si ťahmi e6 a d6 postaví malý stred, pružnú obrannú škrupinu; biely často útočí ťahom g4.
opening.variation.scheveningen.advanced.spoken = Čierny si ťahmi é šesť a dé šesť postaví malý stred, pružnú obrannú škrupinu; biely často útočí ťahom gé štyri.
opening.variation.sveshnikov = Svešnikovov variant
opening.variation.sveshnikov.def = Svešnikovov variant
opening.variation.sveshnikov.advanced = Čierny hrá e5 a za aktivitu a dvojicu strelcov prijme slabé pole d5 a zaostalého pešiaka d: veľmi dynamické.
opening.variation.sveshnikov.advanced.spoken = Čierny hrá é päť a za aktivitu a dvojicu strelcov prijme slabé pole dé päť a zaostalého pešiaka dé: veľmi dynamické.
opening.variation.taimanov = Tajmanovov variant
opening.variation.taimanov.def = Tajmanovov variant
opening.variation.taimanov.advanced = Čierny spája e6 a jazdca na c6 s pružným a6 a dámou na c7, pričom d6 si necháva v zálohe.
opening.variation.taimanov.advanced.spoken = Čierny spája é šesť a jazdca na cé šesť s pružným á šesť a dámou na cé sedem, pričom dé šesť si necháva v zálohe.
opening.variation.kan = Kanov variant
opening.variation.kan.def = Kanov variant
opening.variation.kan.advanced = Čierny hrá e6 a a6, jazdcov necháva doma a často smeruje k postaveniu typu ježko.
opening.variation.kan.advanced.spoken = Čierny hrá é šesť a á šesť, jazdcov necháva doma a často smeruje k postaveniu typu ježko.
opening.variation.classical_sicilian = Klasický variant
opening.variation.classical_sicilian.def = klasický variant
opening.variation.classical_sicilian.advanced = Čierny vyvinie oboch jazdcov a hrá d6; hlavné odpovede bieleho sú Richterov-Rauzerov útok a Sozinov útok.
opening.variation.classical_sicilian.advanced.spoken = Čierny vyvinie oboch jazdcov a hrá dé šesť; hlavné odpovede bieleho sú Richterov-Rauzerov útok a Sozinov útok.
opening.variation.french_advance = Postupový variant
opening.variation.french_advance.def = postupový variant
opening.variation.french_advance.advanced = Biely uzavrie stred ťahom e5 a získa priestor; čierny útočí na d4, základňu reťaze, ťahom c5 a figúrami.
opening.variation.french_advance.advanced.spoken = Biely uzavrie stred ťahom é päť a získa priestor; čierny útočí na dé štyri, základňu reťaze, ťahom cé päť a figúrami.
opening.variation.french_exchange = Výmenný variant
opening.variation.french_exchange.def = výmenný variant
opening.variation.french_exchange.advanced = Výmena pešiakov na d5 uvoľní napätie: symetrická, pokojná štruktúra, v ktorej sa bielopoľný strelec čierneho dostane do hry.
opening.variation.french_exchange.advanced.spoken = Výmena pešiakov na dé päť uvoľní napätie: symetrická, pokojná štruktúra, v ktorej sa bielopoľný strelec čierneho dostane do hry.
opening.variation.french_tarrasch = Tarraschov variant
opening.variation.french_tarrasch.def = Tarraschov variant
opening.variation.french_tarrasch.advanced = Jazdec ide na d2, aby sa vyhol väzbe Winawerovho variantu; čierny po c5 často prijme izolovaného pešiaka d alebo uzavrie stred.
opening.variation.french_tarrasch.advanced.spoken = Jazdec ide na dé dva, aby sa vyhol väzbe Winawerovho variantu; čierny po cé päť často prijme izolovaného pešiaka dé alebo uzavrie stred.
opening.variation.winawer = Winawerov variant
opening.variation.winawer.spoken = Winawerov variant
opening.variation.winawer.def = Winawerov variant
opening.variation.winawer.def.spoken = Winawerov variant
opening.variation.winawer.advanced = Strelec na b4 viaže jazdca; čierny zvyčajne dá strelca za jazdca, takže biely má zdvojených pešiakov, ale aj dvojicu strelcov.
opening.variation.winawer.advanced.spoken = Strelec na bé štyri viaže jazdca; čierny zvyčajne dá strelca za jazdca, takže biely má zdvojených pešiakov, ale aj dvojicu strelcov.
opening.variation.french_classical = Klasický variant
opening.variation.french_classical.def = klasický variant
opening.variation.french_classical.advanced = Čierny vyvinie jazdca na f6; hra sa točí okolo pešiakovej reťaze s e5 a väzby strelcom na g5.
opening.variation.french_classical.advanced.spoken = Čierny vyvinie jazdca na ef šesť; hra sa točí okolo pešiakovej reťaze s é päť a väzby strelcom na gé päť.
opening.variation.french_rubinstein = Rubinsteinov variant
opening.variation.french_rubinstein.def = Rubinsteinov variant
opening.variation.french_rubinstein.advanced = Čierny berie na e4 a prenecháva stred za solídnu, kompaktnú pozíciu, s výhľadom na neskoršie c5.
opening.variation.french_rubinstein.advanced.spoken = Čierny berie na é štyri a prenecháva stred za solídnu, kompaktnú pozíciu, s výhľadom na neskoršie cé päť.
opening.variation.ck_advance = Postupový variant
opening.variation.ck_advance.def = postupový variant
opening.variation.ck_advance.advanced = Biely získa priestor ťahom e5; čierny vyvinie strelca na f5 ešte pred e6 a vracia úder ťahom c5.
opening.variation.ck_advance.advanced.spoken = Biely získa priestor ťahom é päť; čierny vyvinie strelca na ef päť ešte pred é šesť a vracia úder ťahom cé päť.
opening.variation.ck_exchange = Výmenný variant
opening.variation.ck_exchange.def = výmenný variant
opening.variation.ck_exchange.advanced = Karlovarská štruktúra s obrátenými farbami: biely sa rozostaví na kráľovskom krídle, čierny hrá na menšinový útok na dámskom krídle.
opening.variation.ck_panov = Panovov útok
opening.variation.ck_panov.def = Panovov útok
opening.variation.ck_panov.advanced = Biely hrá c4 a prijme izolovaného pešiaka d výmenou za aktívne figúry a útočné šance.
opening.variation.ck_panov.advanced.spoken = Biely hrá cé štyri a prijme izolovaného pešiaka dé výmenou za aktívne figúry a útočné šance.
opening.variation.ck_classical = Klasický variant
opening.variation.ck_classical.def = klasický variant
opening.variation.ck_classical.advanced = Strelec prichádza na f5 so ziskom tempa na jazdca; biely získava priestor ťahmi h4 a h5 a časté sú rôznostranné rošády.
opening.variation.ck_classical.advanced.spoken = Strelec prichádza na ef päť so ziskom tempa na jazdca; biely získava priestor ťahmi há štyri a há päť a časté sú rôznostranné rošády.
opening.variation.ck_two_knights = Útok dvoch jazdcov
opening.variation.ck_two_knights.def = útok dvoch jazdcov
opening.variation.ck_two_knights.advanced = Biely vyvinie oboch jazdcov ešte pred d4, zostáva pružný a vyhýba sa hlavným variantom.
opening.variation.ck_two_knights.advanced.spoken = Biely vyvinie oboch jazdcov ešte pred dé štyri, zostáva pružný a vyhýba sa hlavným variantom.
opening.variation.two_knights = Obrana dvoch jazdcov
opening.variation.two_knights.def = obrana dvoch jazdcov
opening.variation.two_knights.beginner = Čierny namiesto kopírovania bieleho napadne jazdcom e4; pozor na skok jazdca na g5, ktorý útočí na f7.
opening.variation.two_knights.beginner.spoken = Čierny namiesto kopírovania bieleho napadne jazdcom é štyri; pozor na skok jazdca na gé päť, ktorý útočí na ef sedem.
opening.variation.two_knights.advanced = Najaktívnejšia odpoveď čierneho na taliansku hru: pozýva na ostrý skok jazdca na g5 alebo na pokojné d3.
opening.variation.two_knights.advanced.spoken = Najaktívnejšia odpoveď čierneho na taliansku hru: pozýva na ostrý skok jazdca na gé päť alebo na pokojné dé tri.
opening.variation.giuoco_piano = Giuoco piano
opening.variation.giuoco_piano.spoken = Giuoco piano
opening.variation.giuoco_piano.def = giuoco piano
opening.variation.giuoco_piano.def.spoken = giuoco piano
opening.variation.giuoco_piano.beginner = Po taliansky „tichá hra“: obaja strelci mieria na súperovho pešiaka f a partia sa vyvíja pokojne.
opening.variation.giuoco_piano.beginner.spoken = Po taliansky „tichá hra“: obaja strelci mieria na súperovho pešiaka ef a partia sa vyvíja pokojne.
opening.variation.giuoco_piano.advanced = Strelec čierneho stojí zrkadlovo k strelcovi bieleho; biely volí medzi hrou v strede s c3 a d4, pomalým d3 alebo Evansovým gambitom.
opening.variation.giuoco_piano.advanced.spoken = Strelec čierneho stojí zrkadlovo k strelcovi bieleho; biely volí medzi hrou v strede s cé tri a dé štyri, pomalým dé tri alebo Evansovým gambitom.
opening.variation.giuoco_pianissimo = Giuoco pianissimo
opening.variation.giuoco_pianissimo.spoken = Giuoco pianissimo
opening.variation.giuoco_pianissimo.def = giuoco pianissimo
opening.variation.giuoco_pianissimo.def.spoken = giuoco pianissimo
opening.variation.giuoco_pianissimo.advanced = Moderná pomalá talianska hra s d3, c3 a rošádou: dlhé manévre a oneskorený prielom d4.
opening.variation.giuoco_pianissimo.advanced.spoken = Moderná pomalá talianska hra s dé tri, cé tri a rošádou: dlhé manévre a oneskorený prielom dé štyri.
opening.variation.evans = Evansov gambit
opening.variation.evans.def = Evansov gambit
opening.variation.evans.advanced = Biely ťahom b4 dáva pešiaka, aby odlákal strelca a rýchlo si postavil stred ťahmi c3 a d4: veľmi ostré, obľúbené v ére romantizmu.
opening.variation.evans.advanced.spoken = Biely ťahom bé štyri dáva pešiaka, aby odlákal strelca a rýchlo si postavil stred ťahmi cé tri a dé štyri: veľmi ostré, obľúbené v ére romantizmu.
opening.variation.fried_liver = Útok Fegatello
opening.variation.fried_liver.def = útok Fegatello
opening.variation.fried_liver.beginner = Biely obetuje jazdca na f7, aby vytiahol čierneho kráľa do otvorenej pozície: veľmi nebezpečné, ak čierny vzal na d5 jazdcom.
opening.variation.fried_liver.beginner.spoken = Biely obetuje jazdca na ef sedem, aby vytiahol čierneho kráľa do otvorenej pozície: veľmi nebezpečné, ak čierny vzal na dé päť jazdcom.
opening.variation.fried_liver.advanced = Po obeti jazdca na f7 má biely prudký útok; hlavný variant sa mu vyhne tým, že čierny napadne strelca jazdcom na a5.
opening.variation.fried_liver.advanced.spoken = Po obeti jazdca na ef sedem má biely prudký útok; hlavný variant sa mu vyhne tým, že čierny napadne strelca jazdcom na á päť.
opening.variation.traxler = Traxlerov protiútok
opening.variation.traxler.def = Traxlerov protiútok
opening.variation.traxler.advanced = Čierny ignoruje hrozbu na f7 a namiesto toho udrie na f2: divoká taktika, v ktorej rozhodujú presné znalosti.
opening.variation.traxler.advanced.spoken = Čierny ignoruje hrozbu na ef sedem a namiesto toho udrie na ef dva: divoká taktika, v ktorej rozhodujú presné znalosti.
opening.variation.berlin = Berlínska obrana
opening.variation.berlin.def = berlínska obrana
opening.variation.berlin.advanced = Jazdec napadne e4; slávna berlínska koncovka, s dámami vymenenými zavčasu a čiernym kráľom v strede, je mimoriadne solídna.
opening.variation.berlin.advanced.spoken = Jazdec napadne é štyri; slávna berlínska koncovka, s dámami vymenenými zavčasu a čiernym kráľom v strede, je mimoriadne solídna.
opening.variation.morphy = Morphyho obrana
opening.variation.morphy.def = Morphyho obrana
opening.variation.morphy.advanced = Ťah a6 hneď kladie strelcovi otázku: brána k hlavným variantom, teda k zatvorenej a otvorenej španielskej hre a k Marshallovmu útoku.
opening.variation.morphy.advanced.spoken = Ťah á šesť hneď kladie strelcovi otázku: brána k hlavným variantom, teda k zatvorenej a otvorenej španielskej hre a k Marshallovmu útoku.
opening.variation.closed_ruy = Zatvorená španielska hra
opening.variation.closed_ruy.def = zatvorená španielska hra
opening.variation.closed_ruy.advanced = Klasický hlavný variant: pomalé manévre bieleho proti plánom čierneho na dámskom krídle, ako sú Breyerov, Zajcevov alebo Čigorinov variant.
opening.variation.marshall = Marshallov útok
opening.variation.marshall.def = Marshallov útok
opening.variation.marshall.advanced = Čierny obetuje ťahom d5 pešiaka za trvalý útok na kráľovskom krídle; je hlboko analyzovaný a na najvyššej úrovni je to uznávaná zbraň na remízu.
opening.variation.marshall.advanced.spoken = Čierny obetuje ťahom dé päť pešiaka za trvalý útok na kráľovskom krídle; je hlboko analyzovaný a na najvyššej úrovni je to uznávaná zbraň na remízu.
opening.variation.ruy_exchange = Výmenný variant
opening.variation.ruy_exchange.def = výmenný variant
opening.variation.ruy_exchange.advanced = Braním na c6 dá biely čiernemu dvojicu strelcov, ale aj zdvojených pešiakov; biely smeruje do koncovky so zdravou prevahou na kráľovskom krídle.
opening.variation.ruy_exchange.advanced.spoken = Braním na cé šesť dá biely čiernemu dvojicu strelcov, ale aj zdvojených pešiakov; biely smeruje do koncovky so zdravou prevahou na kráľovskom krídle.
opening.variation.ruy_open = Otvorená španielska hra
opening.variation.ruy_open.def = otvorená španielska hra
opening.variation.ruy_open.advanced = Čierny vezme pešiaka e4 kvôli aktívnej hre figúr; figúry sú živé, ale stĺpec e a pešiak d5 si vyžadujú pozornosť.
opening.variation.ruy_open.advanced.spoken = Čierny vezme pešiaka é štyri kvôli aktívnej hre figúr; figúry sú živé, ale stĺpec é a pešiak dé päť si vyžadujú pozornosť.
opening.variation.schliemann = Schliemannova obrana
opening.variation.schliemann.def = Schliemannova obrana
opening.variation.schliemann.advanced = Ťah f5 je kráľovský gambit s obrátenými farbami: ostré a riskantné pre obe strany.
opening.variation.schliemann.advanced.spoken = Ťah ef päť je kráľovský gambit s obrátenými farbami: ostré a riskantné pre obe strany.
opening.variation.scotch_gambit = Škótsky gambit
opening.variation.scotch_gambit.def = škótsky gambit
opening.variation.scotch_gambit.advanced = Biely namiesto brania späť na d4 vyvinie strelca na c4 a ponúka pešiaka za rýchly vývin; často prechádza do obrany dvoch jazdcov.
opening.variation.scotch_gambit.advanced.spoken = Biely namiesto brania späť na dé štyri vyvinie strelca na cé štyri a ponúka pešiaka za rýchly vývin; často prechádza do obrany dvoch jazdcov.
opening.variation.vienna_gambit = Viedenský gambit
opening.variation.vienna_gambit.def = viedenský gambit
opening.variation.vienna_gambit.advanced = Ťah f4 vo viedenskej hre, kráľovský gambit s jazdcom už na c3; najlepšia odpoveď čierneho je úder v strede ťahom d5.
opening.variation.vienna_gambit.advanced.spoken = Ťah ef štyri vo viedenskej hre, kráľovský gambit s jazdcom už na cé tri; najlepšia odpoveď čierneho je úder v strede ťahom dé päť.
opening.variation.stafford = Staffordov gambit
opening.variation.stafford.def = Staffordov gambit
opening.variation.stafford.beginner = Gambit plný pascí, obľúbený na internete: čierny dá pešiaka a dúfa, že biely naletí na triky proti f2 a e4.
opening.variation.stafford.beginner.spoken = Gambit plný pascí, obľúbený na internete: čierny dá pešiaka a dúfa, že biely naletí na triky proti ef dva a é štyri.
opening.variation.stafford.advanced = Čierny získa rýchly vývin a pasce proti f2; pokojnými ťahmi si biely jednoducho udrží čistého pešiaka navyše.
opening.variation.stafford.advanced.spoken = Čierny získa rýchly vývin a pasce proti ef dva; pokojnými ťahmi si biely jednoducho udrží čistého pešiaka navyše.
opening.variation.wayward_queen = Útok zablúdenej dámy
opening.variation.wayward_queen.def = útok zablúdenej dámy
opening.variation.wayward_queen.beginner = Skorý výpad dámy, ktorý mieri na f7, myšlienka školského matu: čierny sa bráni jazdcom a ťahom g6, potom naháňa dámu figúrami.
opening.variation.wayward_queen.beginner.spoken = Skorý výpad dámy, ktorý mieri na ef sedem, myšlienka školského matu: čierny sa bráni jazdcom a ťahom gé šesť, potom naháňa dámu figúrami.
opening.variation.wayward_queen.advanced = Skorý ťah dámou porušuje pravidlá vývinu; čierny získava čas tým, že ju naháňa, a mal by z toho vyjsť lepšie.
opening.variation.halloween = Halloweenský gambit
opening.variation.halloween.def = halloweenský gambit
opening.variation.halloween.advanced = Biely dá jazdca za dvoch pešiakov a veľký stred: objektívne nekorektné, ale v rýchlych partiách nebezpečné.
opening.variation.qgd_orthodox = Ortodoxná obrana
opening.variation.qgd_orthodox.def = ortodoxná obrana
opening.variation.qgd_orthodox.advanced = Klasické postavenie so strelcom na e7, rošádou a jazdcom na d7: solídne, ale pasívne; čierny si hru uvoľňuje ťahom c5 alebo e5.
opening.variation.qgd_orthodox.advanced.spoken = Klasické postavenie so strelcom na é sedem, rošádou a jazdcom na dé sedem: solídne, ale pasívne; čierny si hru uvoľňuje ťahom cé päť alebo é päť.
opening.variation.qgd_exchange = Výmenný variant
opening.variation.qgd_exchange.def = výmenný variant
opening.variation.qgd_exchange.advanced = Výmena na d5 vytvorí karlovarskú štruktúru; klasický plán bieleho je menšinový útok ťahmi b4 a b5.
opening.variation.qgd_exchange.advanced.spoken = Výmena na dé päť vytvorí karlovarskú štruktúru; klasický plán bieleho je menšinový útok ťahmi bé štyri a bé päť.
opening.variation.semi_tarrasch = Polotarraschova obrana
opening.variation.semi_tarrasch.def = polotarraschova obrana
opening.variation.semi_tarrasch.advanced = Čierny hrá c5 a na d5 berie späť figúrou, čím sa vyhne izolovanému pešiakovi Tarraschovej obrany; biely získa pohyblivý stred.
opening.variation.semi_tarrasch.advanced.spoken = Čierny hrá cé päť a na dé päť berie späť figúrou, čím sa vyhne izolovanému pešiakovi Tarraschovej obrany; biely získa pohyblivý stred.
opening.variation.meran = Meránsky variant
opening.variation.meran.def = meránsky variant
opening.variation.meran.advanced = Čierny berie na c4 a ťahom b5 so ziskom tempa získa priestor na dámskom krídle; hra sa točí okolo prielomu c5 a postupu bieleho na e5.
opening.variation.meran.advanced.spoken = Čierny berie na cé štyri a ťahom bé päť so ziskom tempa získa priestor na dámskom krídle; hra sa točí okolo prielomu cé päť a postupu bieleho na é päť.
opening.variation.kid_classical = Klasický variant
opening.variation.kid_classical.def = klasický variant
opening.variation.kid_classical.advanced = Biely sa pokojne vyvinie a urobí rošádu; po e5 a d5 sa začnú slávne preteky, biely na dámskom krídle, čierny na kráľovskom.
opening.variation.kid_classical.advanced.spoken = Biely sa pokojne vyvinie a urobí rošádu; po é päť a dé päť sa začnú slávne preteky, biely na dámskom krídle, čierny na kráľovskom.
opening.variation.kid_samisch = Sämischov variant
opening.variation.kid_samisch.spoken = Sämischov variant
opening.variation.kid_samisch.def = Sämischov variant
opening.variation.kid_samisch.def.spoken = Sämischov variant
opening.variation.kid_samisch.advanced = Ťah f3 podopiera e4 a pripravuje pešiakový útok na kráľovskom krídle; čierny odpovedá ťahom c5, e5 alebo plánom na dámskom krídle s b5.
opening.variation.kid_samisch.advanced.spoken = Ťah ef tri podopiera é štyri a pripravuje pešiakový útok na kráľovskom krídle; čierny odpovedá ťahom cé päť, é päť alebo plánom na dámskom krídle s bé päť.
opening.variation.kid_four_pawns = Útok štyroch pešiakov
opening.variation.kid_four_pawns.def = útok štyroch pešiakov
opening.variation.kid_four_pawns.advanced = Biely postaví pešiakový múr na c4, d4, e4 a f4; čierny ho hneď podkopáva ťahmi c5 a e6.
opening.variation.kid_four_pawns.advanced.spoken = Biely postaví pešiakový múr na cé štyri, dé štyri, é štyri a ef štyri; čierny ho hneď podkopáva ťahmi cé päť a é šesť.
opening.variation.kid_fianchetto = Variant s fianchettom
opening.variation.kid_fianchetto.def = variant s fianchettom
opening.variation.kid_fianchetto.advanced = Fianchetto na g2 otupí čierneho strelca na g7 a hra je pozičnejšia.
opening.variation.kid_fianchetto.advanced.spoken = Fianchetto na gé dva otupí čierneho strelca na gé sedem a hra je pozičnejšia.
opening.variation.nimzo_rubinstein = Rubinsteinov variant
opening.variation.nimzo_rubinstein.def = Rubinsteinov variant
opening.variation.nimzo_rubinstein.advanced = Ťah e3 pokojne pokračuje vo vývine a necháva v zálohe viacero postavení: najobľúbenejšia odpoveď na Nimcovičovu indickú obranu.
opening.variation.nimzo_rubinstein.advanced.spoken = Ťah é tri pokojne pokračuje vo vývine a necháva v zálohe viacero postavení: najobľúbenejšia odpoveď na Nimcovičovu indickú obranu.
opening.variation.nimzo_classical = Klasický variant
opening.variation.nimzo_classical.def = klasický variant
opening.variation.nimzo_classical.advanced = Dáma ide na c2, aby brala späť na c3 bez zdvojených pešiakov; biely získa dvojicu strelcov, čierny rýchly vývin.
opening.variation.nimzo_classical.advanced.spoken = Dáma ide na cé dva, aby brala späť na cé tri bez zdvojených pešiakov; biely získa dvojicu strelcov, čierny rýchly vývin.
opening.variation.nimzo_samisch = Sämischov variant
opening.variation.nimzo_samisch.spoken = Sämischov variant
opening.variation.nimzo_samisch.def = Sämischov variant
opening.variation.nimzo_samisch.def.spoken = Sämischov variant
opening.variation.nimzo_samisch.advanced = Ťah a3 hneď vynúti výmenu na c3: biely prijme zdvojených pešiakov za dvojicu strelcov a veľký stred.
opening.variation.nimzo_samisch.advanced.spoken = Ťah á tri hneď vynúti výmenu na cé tri: biely prijme zdvojených pešiakov za dvojicu strelcov a veľký stred.
opening.variation.grunfeld_exchange = Výmenný variant
opening.variation.grunfeld_exchange.def = výmenný variant
opening.variation.grunfeld_exchange.advanced = Biely ťahom e4 postaví veľký stred; čierny útočí na d4 ťahom c5 a figúrami a v koncovkách často zaváži jeho prevaha na dámskom krídle.
opening.variation.grunfeld_exchange.advanced.spoken = Biely ťahom é štyri postaví veľký stred; čierny útočí na dé štyri ťahom cé päť a figúrami a v koncovkách často zaváži jeho prevaha na dámskom krídle.
opening.variation.leningrad = Leningradský variant
opening.variation.leningrad.def = leningradský variant
opening.variation.leningrad.advanced = Čierny urobí fianchetto na g7: holandská obrana v duchu kráľovskej indickej, v ktorej čierny smeruje k e5 a k hre na kráľovskom krídle.
opening.variation.leningrad.advanced.spoken = Čierny urobí fianchetto na gé sedem: holandská obrana v duchu kráľovskej indickej, v ktorej čierny smeruje k é päť a k hre na kráľovskom krídle.
opening.variation.stonewall_dutch = Variant Stonewall
opening.variation.stonewall_dutch.def = variant Stonewall
opening.variation.stonewall_dutch.advanced = Pešiaci na c6, d5, e6 a f5 dávajú čiernemu skalopevnú kontrolu nad e4, za cenu slabého poľa e5 a pasívneho bielopoľného strelca.
opening.variation.stonewall_dutch.advanced.spoken = Pešiaci na cé šesť, dé päť, é šesť a ef päť dávajú čiernemu skalopevnú kontrolu nad é štyri, za cenu slabého poľa é päť a pasívneho bielopoľného strelca.
opening.variation.modern_benoni = Moderný Benoni
opening.variation.modern_benoni.def = moderný Benoni
opening.variation.modern_benoni.advanced = Čierny má prevahu na dámskom krídle proti prevahe bieleho v strede; dominuje taktika okolo e5 a strelca na g7.
opening.variation.modern_benoni.advanced.spoken = Čierny má prevahu na dámskom krídle proti prevahe bieleho v strede; dominuje taktika okolo é päť a strelca na gé sedem.
opening.variation.catalan_open = Otvorený variant katalánskeho otvorenia
opening.variation.catalan_open.def = otvorený variant katalánskeho otvorenia
opening.variation.catalan_open.advanced = Čierny vezme pešiaka c4; biely ho získa späť a udržiava tlak na dlhej diagonále, kým čierny smeruje k c5 alebo b5.
opening.variation.catalan_open.advanced.spoken = Čierny vezme pešiaka cé štyri; biely ho získa späť a udržiava tlak na dlhej diagonále, kým čierny smeruje k cé päť alebo bé päť.
opening.variation.catalan_closed = Zatvorený variant katalánskeho otvorenia
opening.variation.catalan_closed.def = zatvorený variant katalánskeho otvorenia
opening.variation.catalan_closed.advanced = Čierny drží pešiaka na d5 v kompaktnom postavení: pomalý pozičný boj okolo uvoľňujúcich prielomov e5 alebo c5.
opening.variation.catalan_closed.advanced.spoken = Čierny drží pešiaka na dé päť v kompaktnom postavení: pomalý pozičný boj okolo uvoľňujúcich prielomov é päť alebo cé päť.
opening.variation.english_symmetrical = Symetrický variant
opening.variation.english_symmetrical.def = symetrický variant
opening.variation.english_symmetrical.advanced = Čierny kopíruje bieleho ťahom c5: pomalé manévrovanie s fianchettami a tlakom na d4 a d5.
opening.variation.english_symmetrical.advanced.spoken = Čierny kopíruje bieleho ťahom cé päť: pomalé manévrovanie s fianchettami a tlakom na dé štyri a dé päť.
opening.variation.kings_english = Obrátená sicílska obrana
opening.variation.kings_english.def = obrátená sicílska obrana
opening.variation.kings_english.advanced = Ťahom e5 sa anglické otvorenie mení na sicílsku obranu s tempom navyše pre bieleho; typickými plánmi sú fianchetto a postup na dámskom krídle.
opening.variation.kings_english.advanced.spoken = Ťahom é päť sa anglické otvorenie mení na sicílsku obranu s tempom navyše pre bieleho; typickými plánmi sú fianchetto a postup na dámskom krídle.
opening.variation.alekhine_four_pawns = Útok štyroch pešiakov
opening.variation.alekhine_four_pawns.def = útok štyroch pešiakov
opening.variation.alekhine_four_pawns.advanced = Biely naháňa jazdca pešiakmi a postaví obrovský, ale príliš vysunutý stred; čierny odpovedá protiúderom c5 a figúrami.
opening.variation.alekhine_four_pawns.advanced.spoken = Biely naháňa jazdca pešiakmi a postaví obrovský, ale príliš vysunutý stred; čierny odpovedá protiúderom cé päť a figúrami.
opening.variation.alekhine_modern = Moderný variant
opening.variation.alekhine_modern.def = moderný variant
opening.variation.alekhine_modern.advanced = Biely si udrží solídnu priestorovú prevahu bez prehnaného vysúvania; čierny viaže jazdca alebo robí fianchetto.
opening.variation.pirc_austrian = Rakúsky útok
opening.variation.pirc_austrian.def = rakúsky útok
opening.variation.pirc_austrian.advanced = Ťah f4 buduje veľký stred pre e5 alebo útok na kráľovskom krídle; čierny vracia úder ťahom c5 alebo e5.
opening.variation.pirc_austrian.advanced.spoken = Ťah ef štyri buduje veľký stred pre é päť alebo útok na kráľovskom krídle; čierny vracia úder ťahom cé päť alebo é päť.
opening.variation.falkbeer = Falkbeerov protigambit
opening.variation.falkbeer.def = Falkbeerov protigambit
opening.variation.falkbeer.advanced = Ťah d5 vracia úder v strede namiesto brania na f4; moderná prax uprednostňuje najprv brať na d5.
opening.variation.falkbeer.advanced.spoken = Ťah dé päť vracia úder v strede namiesto brania na ef štyri; moderná prax uprednostňuje najprv brať na dé päť.

