ex.better.b3.2 = {best} var det bättre draget.
ex.better.b3.3 = {best} hade varit bra i stället.
ex.better.b4 = {best} var starkare.
ex.better.b4.2 = {best} var rätt drag.
ex.better.b4.3 = Bättre var {best}.
ex.better.b5 = {best}, med idén {line}.
ex.better.b5.2 = Rätt drag var {best}: {line}.
ex.better.b5.3 = Bättre var {best}, följt av {line}.
ex.better.b6 = {best}: {eval}.
ex.better.b6.2 = {best} i stället, {eval}.
ex.better.b6.3 = {best} var {eval}.

