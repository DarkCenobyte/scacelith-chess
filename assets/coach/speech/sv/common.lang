# ---- Squares, files and ranks (spoken) -----------------------------------------------------------
# File letters are their Swedish letter names, as when spelling: a, be, se, dé, é, eff, ghé, hå
# ("é fyra", "eff tre", "dé fem", "hå sju", "ghé ett"). Respelled where the plain spelling would be
# misread: c is "se" (the letter's sound); d "dé", since a plain "de" is read as the pronoun ("dom");
# e "é", the long stressed letter name, as in "idé" (a lone "e" risks a short or reduced vowel); g
# "ghé" with a hard g, as in "spaghetti": "ge" is the verb ("je") and g before e is soft in Swedish
# spelling. These spellings are not Swedish words, so the pronunciation pass can respell them without
# touching any other word. Ranks are number words; rank 1 is "ett" ("a ett").
square.spoken = {file} {rank}
file.a.spoken = a
file.b.spoken = be
file.c.spoken = se
file.d.spoken = dé
file.e.spoken = é
file.f.spoken = eff
file.g.spoken = ghé
file.h.spoken = hå
rank.1.spoken = ett
rank.2.spoken = två
rank.3.spoken = tre
rank.4.spoken = fyra
rank.5.spoken = fem
rank.6.spoken = sex
rank.7.spoken = sju
rank.8.spoken = åtta

# ---- Moves ---------------------------------------------------------------------------------------
# Swedish scoresheet letters: K(ung) D(am) T(orn) L(öpare) S(pringare): "Sf3", "Txd1", "Lxc4".
move.letters = K D T L S
# Spoken as Swedish players read notation: "springare eff tre", "springare slår på é fem", "springare
# be dé sju", "é slår på dé fem", "bonde slår tillbaka", "kort rockad", "lång rockad", "é åtta och
# blir dam", "dam ghé fyra, schack", "dam hå sju, schackmatt". {piece} is the bare noun
# (piece.<type>.nom); "blir dam" needs no article.
move.piece.spoken = {piece} {to}
move.piece_capture.spoken = {piece} slår på {to}
move.piece_from.spoken = {piece} {from} {to}
move.piece_from_capture.spoken = {piece} {from} slår på {to}
move.pawn.spoken = {to}
move.pawn_capture.spoken = {file} slår på {to}
move.recapture.spoken = {piece} slår tillbaka
move.castle_short.spoken = kort rockad
move.castle_long.spoken = lång rockad
move.promotion.spoken = {move} och blir {piece}
move.check.spoken = {move}, schack
move.mate.spoken = {move}, schackmatt
moves.join.spoken = {a}, {b}

# ---- Respellings (spoken) ------------------------------------------------------------------------
# Words the voice misreads, respelled in every spoken line, opening texts included (src/coach/catalog.h;
# docs/PRONUNCIATION.md has the evidence). Never respell "en" (the English file does, for "en
# passant"): in Swedish it is the article and the number one.
# "passant" is said with its t ("en patient", "en procent"): "passang" gives the French ending.
respell.passant = passang
# English names read the Swedish way: "Birds" with the i of "bil", "Miles" in two syllables.
respell.birds = Börds
respell.miles = Majls
# "Stonewall" in three Swedish syllables ("sto-ne-vall"); one entry per compound (whole words only).
respell.stonewall = Stounwåll
respell.stonewallangreppet = Stounwållangreppet
respell.stonewallvarianten = Stounwållvarianten
# "Grand Prix": the x is said ("Grand Priks").
respell.prix = Pri

# ---- Numbers -------------------------------------------------------------------------------------
# Swedish writes the numbers under a thousand as one word: 21-99 compose as "{tens}{units}"
# ("tjugotre", "fyrtiofem", "nittionio"), the hundreds as "{n}hundra" ("tvåhundra"; one hundred is
# "hundra", not "etthundra"). The voice gets a space between the hundreds and the rest ("tvåhundra
# femtiotre"): the subtitles show digits, and shorter words are safer for the voice.
# Forms of 1: the plain number is "ett", the form in which Swedish counts, reads digits and counts a
# neuter noun ("drag ett", "matt i ett", "ett drag", "ett misstag", "ett parti"); the form "en"
# ("{n:en}", count.en) says "en" before a common-gender noun ("en bonde", "en pjäs", "en gång"); it
# carries into 21, 31 ... ("tjugoen bönder", "tjugoett drag"), both forms being correct Swedish.
number.0.spoken = noll
number.1.spoken = ett
number.1.en.spoken = en
number.2.spoken = två
number.3.spoken = tre
number.4.spoken = fyra
number.5.spoken = fem
number.6.spoken = sex
number.7.spoken = sju
number.8.spoken = åtta
number.9.spoken = nio
number.10.spoken = tio
number.11.spoken = elva
number.12.spoken = tolv
number.13.spoken = tretton
number.14.spoken = fjorton
number.15.spoken = femton
number.16.spoken = sexton
number.17.spoken = sjutton
number.18.spoken = arton
number.19.spoken = nitton
number.20.spoken = tjugo
number.30.spoken = trettio
number.40.spoken = fyrtio
number.50.spoken = femtio
number.60.spoken = sextio
number.70.spoken = sjuttio
number.80.spoken = åttio
number.90.spoken = nittio
# 27 ... 97 with a space: joined, the voice splits the "sj" of "sju" ("fyrtios ju", probe) and the
# seven is lost ("trettiosju" heard "trettioås u", "sextiosju" heard 60-80).
number.27.spoken = tjugo sju
number.37.spoken = trettio sju
number.47.spoken = fyrtio sju
number.57.spoken = femtio sju
number.67.spoken = sextio sju
number.77.spoken = sjuttio sju
number.87.spoken = åttio sju
number.97.spoken = nittio sju
number.100.spoken = hundra
number.tens.spoken = {tens}{units}
number.hundreds.spoken = {n}hundra
number.hundreds_rest.spoken = {hundreds} {rest}
number.minus.spoken = minus {n}
# A decimal number: Swedish writes a decimal comma ("1,3") and says "ett komma tre".
number.decimal = {int},{frac}
number.decimal.spoken = {int} komma {frac}

# ---- Counted nouns ---------------------------------------------------------------------------------
# Swedish plural rule (assets/i18n): one (exactly 1) | other (0, 2, 3 ... 21 ...). Written with digits
# ("1 bonde", "3 drag"), except "en gång" (written out, as Swedish writes it). Neuter nouns (drag,
# misstag, parti, slag) say their number plainly ("ett drag", "tjugoett drag"), common-gender nouns
# with the form "en" in both forms ("en bonde", "tjugoen bönder"). drag, misstag, poäng, slag,
# angripare and försvarare are the same in the plural. The program never capitalises a number: do not
# start a sentence with a counted noun ("{n:time} hittade du ..." would show "en gång hittade du ...").
count.move = {n} drag|{n} drag
count.point = {n:en} poäng|{n:en} poäng
count.pawn = {n:en} bonde|{n:en} bönder
count.piece = {n:en} pjäs|{n:en} pjäser
count.mistake = {n} misstag|{n} misstag
count.blunder = {n:en} blunder|{n:en} blundrar
count.inaccuracy = {n:en} onoggrannhet|{n:en} onoggrannheter
count.game = {n} parti|{n} partier
count.time = en gång|{n:en} gånger
count.square = {n:en} ruta|{n:en} rutor
count.position = {n:en} ställning|{n:en} ställningar
# "{n:en}" in a line says a bare number in the common gender ("en"); it is a count key so that the
# same form also works outside the counted nouns (and the form check knows it). A bare "{n}" is the
# neuter "ett" ("i drag {n}", "matt i {m}").
count.en = {n:en}|{n:en}
# More counted nouns for the review and appraisal lines: "{n:capture}" = "2 slag" (captures, pawns
# included), "{n:attacker}" / "{n:defender}" = "3 angripare", "1 försvarare" ("{n:attacker} mot
# {n2:defender}"), "{acc:percent}" = "85 %" written (no-break space), "åttiofem procent" spoken.
# Checks are counted as times ("du gav schack {m:time}"), a streak of best moves too ("bästa draget
# {n:time} i rad").
count.capture = {n} slag|{n} slag
count.attacker = {n:en} angripare|{n:en} angripare
count.defender = {n:en} försvarare|{n:en} försvarare
count.percent = {n} %|{n} %
count.percent.spoken = {n:en} procent|{n:en} procent

# ---- Evaluations (the strongest levels) ------------------------------------------------------------
# From the listener's point of view. {x} = pawns with one decimal (number.decimal), {n} = moves.
# A level position is "jämnt" ("Det var jämnt", "ungefär jämnt"). The subtitles keep the short "matt
# i 3"; the voice adds "drag", the same word in the singular and plural ("matt i tre drag", "matt i ett
# drag"), as Swedish players say it. ({n:move} would not work here: inside these patterns a form is a
# number form, number.<n>.<form>, not a counted noun.)
eval.up = +{x}
eval.up.spoken = plus {x}
eval.down = −{x}
eval.down.spoken = minus {x}
eval.even = 0,0
eval.even.spoken = jämnt
eval.mate_win = matt i {n}
eval.mate_win.spoken = matt i {n} drag
eval.mate_loss = matt i {n} mot dig
eval.mate_loss.spoken = matt i {n} drag mot dig
