# The Analysis mode names a piece by its side, nobody being "du" or "jag" there: the side's genitive,
# lowercase as in Swedish chess books ("vits springare", "svarts torn"; capitalised by the program at
# the start of a sentence). The players themselves are "vit" and "svart".
owner.white.nom = vits {piece}
owner.black.nom = svarts {piece}
owner.white.gen = vits {piece}
owner.black.gen = svarts {piece}
owner.white.poss = vits
