piece.rook.sin = torn
piece.queen.sin = dam
piece.king.sin = kung
piece.pawn.den = den
piece.knight.den = den
piece.bishop.den = den
piece.rook.den = det
piece.queen.den = den
piece.king.den = den
piece.pawn.art = en
piece.knight.art = en
piece.bishop.art = en
piece.rook.art = ett
piece.queen.art = en
