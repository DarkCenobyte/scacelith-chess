# Coach speech (Swedish): the building blocks every line uses (src/coach/catalog.cpp renders them).
# Same keys as assets/coach/speech/en/common.lang, plus the grammatical forms Swedish needs.
# Register: the coach says "du" (dig, din / ditt / dina) to the player and "jag" (mig, min / mitt /
# mina) of himself; the game menus say "du" too, as Swedish software does. Nothing in Swedish agrees
# with a person's gender (the old masculine ending "-e", "den unge", is never used), so neither the
# coach's nor the player's gender ever shows. Chess words as in assets/i18n/sv.lang: bonde, springare,
# löpare, torn, dam, kung; schack, schackmatt, patt, remi, rockad, förvandling, drag, ruta, linje, rad,
# blunder, misstag, onoggrannhet.

# ---- Pieces --------------------------------------------------------------------------------------
# Nouns and genders (c = common gender, an "en" word; n = neuter, an "ett" word): en bonde, en
# springare, en löpare, ett torn, en dam, en kung. Swedish nouns have no cases: one form is the
# subject, the object and the noun after a preposition. A possessive agrees with the piece (din /
# ditt, min / mitt) and the noun after it stays indefinite ("din springare", never "din springaren").
# What else agrees with the piece: the pronoun that stands for it (den / det), an article (en / ett)
# and an adjective or participle (säker / säkert, skyddad / skyddat, bunden / bundet).
# Forms (every one defined for all six pieces and the four owners your, my, white, black; {your2},
# {my2}, {t1}, {t2} and the analysis {piece} take the same forms):
#   nom      din springare / ditt torn, min dam / mitt torn; Analysis mode: vits springare / svarts
#            torn (the default form, subject and object alike)
#                                         "{my} angriper {your}." (= Min löpare angriper ditt torn.)
#   gen      din springares / ditt torns, vits kungs (the genitive, before the noun it owns)
#                                         "{your:gen} flyktrutor är spärrade." (= Din kungs flyktrutor ...)
#   def      springaren / tornet (definite, no owner: when the owner is already clear)
#                                         "{my} angriper {your}, och {your:def} kan inte fly."
#   def_gen  springarens / tornets        "{your:def_gen} väg tillbaka är stängd."
#   indef    en springare / ett torn (indefinite, no owner)
#                                         "Nu har du vunnit {my:indef}." (= ... vunnit ett torn.)
#   bare     springare / torn (the noun alone), after poss, sin_poss, art or den and an adjective
#                                         "{your:poss} bundna {your:bare}" (= din bundna springare)
#   poss     din / ditt, min / mitt, vits / svarts: the possessive alone, before an adjective (which
#            then takes its -a form) and bare; alone it also means "yours" / "mine"
#                                         "{your:poss} bundna {your:bare} kan inte skydda {sq}."
#                                         (= Din bundna löpare ... / Ditt bundna torn ...)
#                                         "Din dam är hotad, inte {my:poss}." (my queen: "min")
#   sin      sin springare / sitt torn (every owner): the reflexive possessive, only when the subject
#            of the same clause is a third person who owns the piece (a side, "man", the unspoken
#            subject of an infinitive that refers to them)
#                                         "Vit offrar {piece:sin}." (= Vit offrar sitt torn.)
#            With "du" or "jag" as the subject Swedish keeps din / min: use nom
#                                         ("Du flyttade {your} två gånger.")
#   sin_poss sin / sitt alone, before an adjective and bare
#                                         "Svart flyttar {piece:sin_poss} bundna {piece:bare}."
#   den      den / det: the pronoun standing for the piece (subject, object, after a preposition)
#                                         "Det här är {your}. {your:den} går längs linjer och rader."
#                                         "{my} hänger. Slå {my:den}!", "{t2} står bakom {t1:den}."
#            Also the article before an adjective and def, and with "här" the demonstrative:
#                                         "{my:den} oskyddade {my:def}" (= det oskyddade tornet)
#                                         "{your:den} här {your:def}" (= den här springaren)
#            "Its" needs no form: "dess" for every piece ("{my:den} och dess försvarare"), and when
#            the piece is the subject, sin / sitt / sina agreeing with the thing owned
#            ("{your} står bakom sina bönder"). The relative pronoun is always "som".
#   art      en / ett: the indefinite article alone, before an adjective and bare
#                                         "{my:art} oskydda{my:d_t} {my:bare}" (= ett oskyddat torn)
# Endings glued to an adjective or participle that agrees with the piece (written right after the
# word, with no space; the placeholder is the piece the word agrees with):
#   t        "" / "t": adjectives that simply add -t for an ett-word (säker, ensam, stark, svag, aktiv,
#            passiv, lös, dålig, farlig, försvarslös)
#                                         "{your} är inte säker{your:t} där." (= Ditt torn är inte
#                                         säkert där. / Din kung är inte säker där.)
#   d_t      "d" / "t": participles in -ad and -d, and "värd" (hotad / hotat, skyddad / skyddat,
#            oskyddad, obevakad, försvarad, förlorad, fångad, instängd / instängt, värd / värt)
#                                         "{my} var oskydda{my:d_t}." (= Min löpare var oskyddad. /
#                                         Mitt torn var oskyddat.)  "{your} är vär{your:d_t} {n:point}."
#   en_et    "en" / "et": participles and adjectives in -en (angripen / angripet, bunden / bundet,
#            slagen, fången, öppen)
#                                         "{your} är bund{your:en_et}." (= Din springare är bunden. /
#                                         Ditt torn är bundet.)  "{my} är angrip{my:en_et}."
#            Words already ending in -t never change (utsatt, låst, täckt, fast, inlåst), nor -e / -a
#            (hängande, ensamma), "bra", "kvar", "gratis": write them plain. Irregular ones (fri /
#            fritt, ny / nytt, död / dött, klädd / klätt): rephrase. Two pieces take the plural:
#            "{t1} och {t2} är angripna / hotade / bundna" (no form needed).
# Never put a possessive or an article (din, min, en, ett, den, det) before {your}, {my}, {t1}, {t2},
# {piece}: the owner is in them (only bare and def follow words you write). Never glue an "s" to a
# placeholder: use gen or def_gen. Spoken moves use piece.<type>.nom, the bare noun ("springare eff tre").
piece.pawn.gender = c
piece.knight.gender = c
piece.bishop.gender = c
piece.rook.gender = n
piece.queen.gender = c
piece.king.gender = c
piece.pawn.nom = bonde
piece.knight.nom = springare
piece.bishop.nom = löpare
piece.rook.nom = torn
piece.queen.nom = dam
piece.king.nom = kung
piece.pawn.gen = bondes
piece.knight.gen = springares
piece.bishop.gen = löpares
piece.rook.gen = torns
piece.queen.gen = dams
piece.king.gen = kungs
piece.pawn.def = bonden
piece.knight.def = springaren
piece.bishop.def = löparen
piece.rook.def = tornet
piece.queen.def = damen
piece.king.def = kungen
piece.pawn.def_gen = bondens
piece.knight.def_gen = springarens
piece.bishop.def_gen = löparens
piece.rook.def_gen = tornets
piece.queen.def_gen = damens
piece.king.def_gen = kungens
piece.pawn.indef = en bonde
piece.knight.indef = en springare
piece.bishop.indef = en löpare
piece.rook.indef = ett torn
piece.queen.indef = en dam
piece.king.indef = en kung
piece.pawn.bare = bonde
piece.knight.bare = springare
piece.bishop.bare = löpare
