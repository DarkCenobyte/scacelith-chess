piece.pawn.t =
piece.knight.t =
piece.bishop.t =
piece.rook.t = t
piece.queen.t =
piece.king.t =
piece.pawn.d_t = d
piece.knight.d_t = d
piece.bishop.d_t = d
piece.rook.d_t = t
piece.queen.d_t = d
piece.king.d_t = d
piece.pawn.en_et = en
piece.knight.en_et = en
piece.bishop.en_et = en
piece.rook.en_et = et
piece.queen.en_et = en
piece.king.en_et = en
# The owner patterns: owner.<owner>.<form> serves the common-gender pieces, owner.<owner>.<form>.n
# the neuter one (torn). {your} = "din springare" / "ditt torn", {my} = "min springare" / "mitt torn".
owner.your.nom = din {piece}
owner.your.nom.n = ditt {piece}
owner.my.nom = min {piece}
owner.my.nom.n = mitt {piece}
owner.your.gen = din {piece}
owner.your.gen.n = ditt {piece}
owner.my.gen = min {piece}
owner.my.gen.n = mitt {piece}
owner.your.poss = din
owner.your.poss.n = ditt
owner.my.poss = min
owner.my.poss.n = mitt
owner.your.sin = sin {piece}
owner.your.sin.n = sitt {piece}
owner.my.sin = sin {piece}
owner.my.sin.n = sitt {piece}
owner.your.sin_poss = sin
owner.your.sin_poss.n = sitt
owner.my.sin_poss = sin
owner.my.sin_poss.n = sitt
# Forms without an owner word: the noun, the pronoun, the article or the ending alone, the same for
# every owner.
owner.your.def = {piece}
owner.my.def = {piece}
owner.your.def_gen = {piece}
owner.my.def_gen = {piece}
owner.your.indef = {piece}
owner.my.indef = {piece}
owner.your.bare = {piece}
