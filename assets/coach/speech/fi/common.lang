# the side before the noun, "valkean ratsu", "mustan kuningatar" ("White's knight"); only the noun
# takes the case. The analysis lines use the forms nom ... tra and bare_<form> (no _emph):
# "{reply} lyö {piece:acc}" = "valkean ratsun", "{reply} uhkaa {t1:part} ja {t2:part}" = "mustan
# kuningatarta ja mustan tornia", "{piece:abl} puuttuu suoja" = "valkean lähetiltä".
