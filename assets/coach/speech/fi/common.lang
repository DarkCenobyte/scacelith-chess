file.a.spoken = aa
file.b.spoken = bee
file.c.spoken = see
file.d.spoken = dee
file.e.spoken = ee
file.f.spoken = äf
file.g.spoken = gee
file.h.spoken = hoo
rank.1.spoken = yksi
rank.2.spoken = kaksi
rank.3.spoken = kolme
rank.4.spoken = neljä
rank.5.spoken = viisi
rank.6.spoken = kuusi
rank.7.spoken = seitsemän
rank.8.spoken = kahdeksan

# ---- Moves ---------------------------------------------------------------------------------------
# Finnish scoresheet letters: K(uningas), D(aami, the queen), T(orni), L(ähetti), R(atsu): "Rf3",
# "Dxd5", "Lb5+".
move.letters = K D T L R
# Spoken as Finnish players read notation: "ratsu äf kolme", "ratsu lyö ee viisi", "ratsu bee dee
# seitsemän", "ee lyö dee viisi", "sotilas lyö takaisin" (a recapture), "lyhyt linnoitus", "pitkä
# linnoitus", "ee kahdeksan, korotus: kuningatar", "kuningatar hoo viisi, shakki", "..., matti".
# {piece} is always the nominative here, so the promotion names the new piece after a colon ("korotus
# kuningattareksi" would need the translative).
