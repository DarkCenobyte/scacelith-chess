# A decimal number: Dutch writes a decimal comma ("1,3") and says "één komma drie".
number.decimal = {int},{frac}
number.decimal.spoken = {int} komma {frac}

# ---- Counted nouns ---------------------------------------------------------------------------------
# Dutch plural rule (assets/i18n): one (1) | other (0, 2, 3 ...): "1 zet", "0 zetten", "3 zetten";
# spoken "één zet" (the stressed number, right for a count). "keer" has no plural after a number.
# "stuk" excludes the pawns, as in Dutch chess books ("een stuk voor twee pionnen"): for a number of
# captures that includes pawns, say how many times the player captured: "Je hebt {n:time} geslagen".
# Move numbers are cardinals in Dutch ("bij zet {n}", "zet 21"): no ordinals are needed.
count.move = {n} zet|{n} zetten
count.point = {n} punt|{n} punten
count.pawn = {n} pion|{n} pionnen
count.piece = {n} stuk|{n} stukken
count.mistake = {n} fout|{n} fouten
count.blunder = {n} blunder|{n} blunders
count.inaccuracy = {n} onnauwkeurigheid|{n} onnauwkeurigheden
count.game = {n} partij|{n} partijen
count.time = {n} keer|{n} keer
count.square = {n} veld|{n} velden
count.position = {n} stelling|{n} stellingen
# More counted nouns for the review and the appraisal: attackers and defenders of a square
# ("{n:attacker} tegen {n2:defender}" = "drie aanvallers tegen twee verdedigers"), a streak of best
# moves ("{n:best_move} op rij"), and a percentage ("{acc:percent}" = "85%" written, "vijfentachtig
# procent" spoken; "{acc} procent" written out in full is fine too).
count.attacker = {n} aanvaller|{n} aanvallers
count.defender = {n} verdediger|{n} verdedigers
count.best_move = {n} beste zet|{n} beste zetten
count.percent = {n}%|{n}%
count.percent.spoken = {n} procent|{n} procent

# ---- Evaluations (the strongest levels) ------------------------------------------------------------
# From the listener's point of view. {x} = pawns with one decimal (number.decimal), {n} = moves.
# "mat in 3" needs no noun ("mat in drie"); a mate against the listener says "tegen jou".
eval.up = +{x}
eval.up.spoken = plus {x}
eval.down = −{x}
eval.down.spoken = min {x}
eval.even = 0,0
eval.even.spoken = gelijk
eval.mate_win = mat in {n}
eval.mate_loss = mat in {n} tegen jou
