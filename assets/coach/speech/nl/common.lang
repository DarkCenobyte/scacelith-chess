# ---- Squares, files and ranks (spoken) -----------------------------------------------------------
# File letters are said by their Dutch names: aa, bee, cee, dee, ee, ef, gee, ha ("ee vier", "ef drie",
# "gee zeven"). "a" and "e" are written "aa" and "ee" so that the voice says the long vowel of the
# letter name, not a short vowel or a schwa. Ranks are number words; one is "één" (with its accents:
# "een" is the article).
square.spoken = {file} {rank}
file.a.spoken = aa
file.b.spoken = bee
file.c.spoken = cee
file.d.spoken = dee
file.e.spoken = ee
file.f.spoken = ef
file.g.spoken = gee
file.h.spoken = ha
rank.1.spoken = één
rank.2.spoken = twee
rank.3.spoken = drie
rank.4.spoken = vier
rank.5.spoken = vijf
rank.6.spoken = zes
rank.7.spoken = zeven
rank.8.spoken = acht

# ---- Moves ---------------------------------------------------------------------------------------
# Dutch scoresheet letters: K(oning) D(ame) T(oren) L(oper) P(aard): "Pf3", "Lxc4", "Kxe2".
move.letters = K D T L P
# Spoken as Dutch players read notation: "paard ef drie", "paard slaat op ee vijf", "paard bee dee
# zeven", "ee slaat op dee vijf", "pion slaat terug", "korte rokade", "ee acht, promotie tot dame",
# "dame gee vier, schaak", "dame ha zeven, schaakmat". {piece} is the bare noun (piece.<type>.nom).
move.piece.spoken = {piece} {to}
move.piece_capture.spoken = {piece} slaat op {to}
move.piece_from.spoken = {piece} {from} {to}
move.piece_from_capture.spoken = {piece} {from} slaat op {to}
move.pawn.spoken = {to}
move.pawn_capture.spoken = {file} slaat op {to}
move.recapture.spoken = {piece} slaat terug
move.castle_short.spoken = korte rokade
move.castle_long.spoken = lange rokade
move.promotion.spoken = {move}, promotie tot {piece}
move.check.spoken = {move}, schaak
move.mate.spoken = {move}, schaakmat
moves.join.spoken = {a}, {b}

# ---- Respellings (spoken) ------------------------------------------------------------------------
# Words the voice misreads, respelled in every spoken line, opening texts included (src/coach/catalog.h;
# the findings are in docs/PRONUNCIATION.md). Whole words only: a compound is a word of its own. Never
# respell "en" (the English file does, for "en passant"): in Dutch it is the word "and".
# "coach" is said without its t ("koosj"; heard "kosh", "koorts", "koos"): spelled as Dutch says it.
respell.coach = kootsj
# "fianchetteert": the ch is said s or sj ("fiansetteert"); Italian ch is a k. "fianchetto" itself is a
# close call and was heard no better as "fianketto" (heard "fianket"): left as written.
respell.fianchetteert = fianketteert
# "Grand Prix": the d and the x are said ("grant priks"); French, as Dutch players say it.
respell.grand = gran
respell.prix = prie
# "Winawer": the aw is said like au ("wienauer"); the Polish w is a v.
respell.winawer = winaver
# "Fajarowicz": heard "firewix"; Polish w = v, cz = tsj.
respell.fajarowicz = fajarovitsj

# ---- Numbers -------------------------------------------------------------------------------------
# Dutch says the units before the tens, joined by "en": 21-99 compose as "{units}en{tens}"
# ("vierentwintig", "achtenveertig"). Listed instead: the numbers ending in 1 ("eenentwintig": one
# alone is "één", with the accents that tell the voice it is the number, not the article "een"), in
# 2 and 3 (a diaeresis after the vowel: "tweeëntwintig", "drieëndertig").
# 100-999: "{n}honderd" ("tweehonderd"; one hundred is "honderd", never "eenhonderd"), then the rest
# after a space ("driehonderd vijfenveertig", "honderd één"). Written Dutch joins them in one word;
# the space only helps the voice (subtitles show digits) and keeps "één" in 101, 201... stressed.
number.0.spoken = nul
number.1.spoken = één
number.2.spoken = twee
number.3.spoken = drie
number.4.spoken = vier
number.5.spoken = vijf
number.6.spoken = zes
number.7.spoken = zeven
number.8.spoken = acht
number.9.spoken = negen
number.10.spoken = tien
number.11.spoken = elf
number.12.spoken = twaalf
number.13.spoken = dertien
number.14.spoken = veertien
number.15.spoken = vijftien
number.16.spoken = zestien
number.17.spoken = zeventien
number.18.spoken = achttien
number.19.spoken = negentien
number.20.spoken = twintig
# 21 only: "eenentwintig" loses its first syllable ("enentwintig", heard "in twintig"); with the
# accents it is heard 21. 31 and 71 were heard no better with them, so the others stay unaccented.
number.21.spoken = éénentwintig
number.22.spoken = tweeëntwintig
number.23.spoken = drieëntwintig
number.30.spoken = dertig
