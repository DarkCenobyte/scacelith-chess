ex.hint.gain.b6 = {your:short} có nước giành lợi thế lực lượng.
ex.hint.gain.b6.2 = Xem lại {your}: đã có quân để ăn.
# Levels 1-2: the better move as the piece and its square, said when the offer is declined (or
# when none can be made); levels 3-6 say ex.better.
ex.reveal.b1 = Nước hay hơn là đi {your} đến ô {sq}.
ex.reveal.b1.2 = {your} có thể đi đến ô {sq}. Như thế hay hơn.
ex.reveal.b2 = Đi {your} đến ô {sq} là nước hay hơn.
ex.reveal.b2.2 = Nước hay hơn là đi {your} đến ô {sq}.

