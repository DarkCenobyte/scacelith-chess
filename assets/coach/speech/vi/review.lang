ex.verdict.blunder.b1.2 = Cẩn thận! Nước này có thể khiến bạn thiệt.
ex.verdict.blunder.b1.3 = Ồ, khoan đã. Nước này có vấn đề.
ex.verdict.blunder.b2 = Hừm, nước này có vấn đề.
ex.verdict.blunder.b2.2 = Đó là một sai lầm lớn.
ex.verdict.blunder.b2.3 = Cẩn thận, nước này làm bạn thiệt đấy.
ex.verdict.blunder.b3 = Đó là một sai lầm nghiêm trọng.
ex.verdict.blunder.b3.2 = Nước {move} là một sai lầm thật sự.
ex.verdict.blunder.b3.3 = Ôi, nước {move} là một sai lầm lớn.
ex.verdict.blunder.b4 = Nước {move} là một sai lầm nghiêm trọng.
ex.verdict.blunder.b4.2 = Nước {move} là một sai lầm nặng.
ex.verdict.blunder.b4.3 = Rất tiếc, đó là một sai lầm nghiêm trọng.
ex.verdict.blunder.b5 = Nước {move} là một sai lầm nặng.
ex.verdict.blunder.b5.2 = {move} là sai lầm nghiêm trọng.
ex.verdict.blunder.b5.3 = {move} là một sai lầm đắt giá.
ex.verdict.blunder.b6 = {move}: sai lầm nặng.
ex.verdict.blunder.b6.2 = {move} là sai lầm nghiêm trọng.
ex.verdict.blunder.b6.3 = {move}? Sai lầm nghiêm trọng.
# A blunder that leaves the coach's threat standing (levels 1-2: the threat the engine found after the
# coach's last move is what the reply carries out).
ex.verdict.ignored.b1 = Ối! Bạn chưa đối phó với mối đe dọa của tôi.
ex.verdict.ignored.b1.2 = Cẩn thận! Mối đe dọa của tôi vẫn còn đó.
ex.verdict.ignored.b1.3 = Ồ, khoan đã. Bạn quên mối đe dọa của tôi rồi.
ex.verdict.ignored.b2 = Hừm, mối đe dọa của tôi vẫn còn đó.
ex.verdict.ignored.b2.2 = Bạn đã bỏ qua mối đe dọa của tôi.
ex.verdict.ignored.b2.3 = Cẩn thận, bạn chưa đối phó với mối đe dọa của tôi.
ex.verdict.mistake.b3 = Đó không phải là nước đi hay.
ex.verdict.mistake.b3.2 = Hừm, nước {move} có vấn đề.
ex.verdict.mistake.b3.3 = Đó là một sai lầm.
ex.verdict.mistake.b4 = Nước {move} là một sai lầm.
ex.verdict.mistake.b4.2 = Nước {move} không ổn.
ex.verdict.mistake.b4.3 = Đó là một sai lầm.
ex.verdict.mistake.b5 = Nước {move} rõ ràng là một sai lầm.
ex.verdict.mistake.b5.2 = {move} là một sai lầm.
ex.verdict.mistake.b5.3 = {move} không ổn.
ex.verdict.mistake.b6 = {move}: sai lầm.
ex.verdict.mistake.b6.2 = {move}? Sai lầm.
ex.verdict.mistake.b6.3 = Không phải {move}.
# A dubious move (an inaccuracy; a costly move with nothing concrete to show while still better):
# only the better move is named ({best} is pointed at), never a scenario.
ex.verdict.inaccuracy.b3 = Không tệ, nhưng nước {best} hay hơn một chút.
ex.verdict.inaccuracy.b3.2 = Nước {best} chính xác hơn một chút.
ex.verdict.inaccuracy.b3.3 = Một sơ suất nhỏ: ở đây nước {best} hay hơn.
ex.verdict.inaccuracy.b4 = Thiếu chính xác: nước {best} chính xác hơn.
ex.verdict.inaccuracy.b4.2 = Hơi thiếu chính xác. Nước {best} hay hơn một chút.
ex.verdict.inaccuracy.b4.3 = Chưa phải nước tốt nhất: nước {best} chính xác hơn.
ex.verdict.inaccuracy.b5 = Nước {move} thiếu chính xác; {best} mạnh hơn.
ex.verdict.inaccuracy.b5.2 = Hơi thiếu chính xác. Là tôi thì tôi đã đi {best}.
ex.verdict.inaccuracy.b5.3 = Nước {best} chính xác hơn nước {move}.
ex.verdict.inaccuracy.b6 = {move} thiếu chính xác; {best}.
ex.verdict.inaccuracy.b6.2 = Thiếu chính xác. {best}.
ex.verdict.inaccuracy.b6.3 = {best} hay hơn.
# Level 6, an inaccuracy at the bottom of its class (deeper searches often clear it): a hedged word.
ex.verdict.inaccuracy.maybe = Có lẽ nước {best} chính xác hơn một chút.
ex.verdict.inaccuracy.maybe.2 = Có lẽ tôi sẽ đi {best}.
# A dubious move that loses material (levels 3-6): the remark alone, never "a bit better" (at level 6
# under 6 points, the hedged word above unless a piece is lost).
ex.verdict.dubious = Nước đi này trông đáng ngờ.
ex.verdict.dubious.2 = Nước đi này có vẻ đáng ngờ.
# Something good was missed (levels 1-2).
ex.verdict.missed.b1 = Ồ, khoan đã! Bạn đã bỏ lỡ một nước hay.
ex.verdict.missed.b1.2 = Hãy nhìn lại! Có nước hay hơn đấy.
