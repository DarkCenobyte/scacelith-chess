number.4.ord.spoken = tư

# ---- Counted nouns ---------------------------------------------------------------------------------
# Vietnamese has a single plural form: the noun after a number never changes ("1 nước", "3 nước"). A
# bare "{n}" followed by a noun written by hand works as well (the voice reads the number in words).
count.move = {n} nước
count.point = {n} điểm
count.pawn = {n} con Tốt
count.piece = {n} quân
count.mistake = {n} sai lầm
count.blunder = {n} sai lầm nghiêm trọng
count.inaccuracy = {n} nước thiếu chính xác
count.game = {n} ván
count.time = {n} lần
count.square = {n} ô
count.position = {n} thế cờ
# Vietnamese helpers for the other coach files:
#   attacker / defender  "{n:attacker}" = "2 quân tấn công", "{n2:defender}" = "1 quân bảo vệ"
#   best_move            "{n:best_move}" = "5 nước đi tốt nhất" (a streak: "{n:best_move} liên tiếp")
#   check / capture      "{m:check}" = "2 nước chiếu", "{n:capture}" = "3 lần bắt quân"
#   ord                  an ordinal, "lần {n:ord}" = "lần thứ 2" (spoken "lần thứ hai"; 1 = "thứ nhất")
#   moveno               a move number, "ở {n:moveno}" = "ở nước thứ 12", spoken "ở nước thứ mười hai"
#                        ("nước thứ nhất", "nước thứ tư", "nước thứ hai mươi mốt")
#   percent              an accuracy, "độ chính xác {acc:percent}" = "độ chính xác 85%", spoken
#                        "tám mươi lăm phần trăm"
count.attacker = {n} quân tấn công
count.defender = {n} quân bảo vệ
count.best_move = {n} nước đi tốt nhất
count.check = {n} nước chiếu
count.capture = {n} lần bắt quân
count.ord = thứ {n}
count.ord.spoken = thứ {n:ord}
count.moveno = nước thứ {n}
count.moveno.spoken = nước thứ {n:ord}
count.percent = {n}%
count.percent.spoken = {n} phần trăm

# ---- Evaluations (the strongest levels) ------------------------------------------------------------
# From the listener's point of view. {x} = pawns with one decimal (number.decimal), {n} = moves.
# Vietnamese reads an engine score "cộng một phẩy ba" / "trừ hai phẩy năm"; "chiếu hết sau 3 nước" is
# the usual wording of "mate in 3" (puzzles, engines).
eval.up = +{x}
eval.up.spoken = cộng {x}
eval.down = −{x}
eval.down.spoken = trừ {x}
eval.even = 0,0
eval.even.spoken = cân bằng
eval.mate_win = chiếu hết sau {n} nước
eval.mate_loss = bị chiếu hết sau {n} nước
