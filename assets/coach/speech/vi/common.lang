# ---- Squares, files and ranks (spoken) -----------------------------------------------------------
# The files are said by the names Vietnamese gives Latin letters when spelling (as in "DVD" = "đê vê
# đê"), the ranks as number words: e4 = "e bốn", f3 = "ép ba", c6 = "xê sáu", d5 = "đê năm",
# g7 = "giê bảy", h8 = "hát tám", b1 = "bê một".
square.spoken = {file} {rank}
file.a.spoken = a
file.b.spoken = bê
file.c.spoken = xê
file.d.spoken = đê
file.e.spoken = e
file.f.spoken = ép
file.g.spoken = giê
file.h.spoken = hát
rank.1.spoken = một
rank.2.spoken = hai
rank.3.spoken = ba
rank.4.spoken = bốn
rank.5.spoken = năm
rank.6.spoken = sáu
rank.7.spoken = bảy
rank.8.spoken = tám

# ---- Moves ---------------------------------------------------------------------------------------
# Vietnamese notation letters: V(ua) H(ậu) X(e) T(ượng) M(ã): "Mf3", "Xad1", "Vxe2".
move.letters = V H X T M
# Spoken as Vietnamese players read moves aloud: "Mã ép ba", "Mã bắt e năm", "Mã bê đê hai",
# "Tốt e bắt đê năm", "Tốt bắt lại" (a recapture in a line), "nhập thành ngắn", "e tám, phong Hậu",
# "Hậu giê bốn, chiếu", "... chiếu hết". {piece} is the bare noun (piece.<type>.nom).
move.piece.spoken = {piece} {to}
move.piece_capture.spoken = {piece} bắt {to}
move.piece_from.spoken = {piece} {from} {to}
move.piece_from_capture.spoken = {piece} {from} bắt {to}
move.pawn.spoken = {to}
move.pawn_capture.spoken = Tốt {file} bắt {to}
move.recapture.spoken = {piece} bắt lại
move.castle_short.spoken = nhập thành ngắn
move.castle_long.spoken = nhập thành dài
move.promotion.spoken = {move}, phong {piece}
move.check.spoken = {move}, chiếu
move.mate.spoken = {move}, chiếu hết
moves.join.spoken = {a}, {b}

