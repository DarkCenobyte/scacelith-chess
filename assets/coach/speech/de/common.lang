# German only (review.lang and appraisal.lang): attackers and defenders of a square ("drei Angreifer
# gegen einen Verteidiger"), percent ("ein Prozent", never "eins Prozent"; nominative = accusative),
# and the best moves of a streak ("fünf beste Züge in Folge", "eine Serie von fünf besten Zügen").
count.attacker = {n} Angreifer|{n} Angreifer
count.attacker.spoken = ein Angreifer|{n} Angreifer
count.attacker_acc = {n} Angreifer|{n} Angreifer
count.attacker_acc.spoken = einen Angreifer|{n} Angreifer
count.attacker_dat = {n} Angreifer|{n} Angreifern
count.attacker_dat.spoken = einem Angreifer|{n} Angreifern
