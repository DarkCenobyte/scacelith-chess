count.time = einmal|{n}-mal
count.time.spoken = einmal|{n} Mal
count.square = {n} Feld|{n} Felder
count.square.spoken = ein Feld|{n} Felder
count.square_acc = {n} Feld|{n} Felder
count.square_acc.spoken = ein Feld|{n} Felder
count.square_dat = {n} Feld|{n} Feldern
