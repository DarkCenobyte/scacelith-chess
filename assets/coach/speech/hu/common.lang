# ---- Moves ---------------------------------------------------------------------------------------
# Hungarian scoresheet letters: K(irály) V(ezér) B(ástya) F(utó) H(uszár): "Hf3", "Bad1", "Vxd5".
move.letters = K V B F H
# Spoken as Hungarian players read notation ("x" is "üt"): "huszár ef három", "huszár üt e öt",
# "huszár bé dé hét", "e üt dé öt", "gyalog visszaüt", "rövid sánc", "vezér gé négy, sakk".
# {piece} is the bare nominative here, so the promotion says "e nyolc, és vezér lesz belőle"
# ("átváltozik vezérré" would need the translative "vezérré").
