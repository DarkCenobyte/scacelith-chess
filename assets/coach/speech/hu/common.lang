# "{n:attr}" in a line says a bare number before a noun ("két", "huszonkét"); a count key, so that the
# form also works outside the counted nouns (and the form check knows it). Digits when written.
count.attr = {n:attr}|{n:attr}
# Move numbers: {n:ord} = "21." written, "huszonegyedik" spoken ("első" for 1). Never put "a"/"az" right
# before it ("az ötödik", "a hatodik"): "a játszma {n:ord} lépésében", "{n:ord} lépés: {move}". Put a
# noun right after it, never a piece placeholder (after the full stop the program would capitalise it).
count.ord = {n}.|{n}.
count.ord.spoken = első|{n:ord}

# ---- Evaluations (the strongest levels) ------------------------------------------------------------
# From the listener's point of view. {x} = pawns with one decimal (number.decimal), {n} = moves (a bare
# number: count keys do not apply to it; the form "attr" says "két lépésben").
eval.up = +{x}
eval.up.spoken = plusz {x}
eval.down = −{x}
eval.down.spoken = mínusz {x}
eval.even = 0,0
eval.even.spoken = egyenlő állás
eval.mate_win = matt {n:attr} lépésben
eval.mate_loss = matt ellened {n:attr} lépésben
