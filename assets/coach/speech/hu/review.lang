ex.better.b3 = Jobb lett volna: {best}.
ex.better.b3.2 = {best} lett volna a jobb lépés.
ex.better.b3.3 = Helyette {best} jó lett volna.
ex.better.b4 = {best} erősebb volt.
ex.better.b4.2 = {best} lett volna a helyes lépés.
ex.better.b4.3 = Jobb volt: {best}.
ex.better.b5 = {best}, a terv: {line}.
ex.better.b5.2 = {best} volt a lépés: {line}.
ex.better.b5.3 = Jobb lett volna {best}, majd {line}.
ex.better.b6 = {best}: {eval}.
ex.better.b6.2 = Inkább {best}, {eval}.
ex.better.b6.3 = {best} értékelése: {eval}.

