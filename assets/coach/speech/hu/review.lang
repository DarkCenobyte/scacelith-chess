# ---- 3. Stalemate ({my} = the coach's king, pointed at) ----------------------------------------
ex.stalemate.b1 = Jaj, ne! {my} nem tud lépni, és nincs sakkban. Ez patt: döntetlen.
ex.stalemate.b1.2 = Nézd: {my:dat} nincs biztonságos mezője, de nincs sakkban. Döntetlen!
ex.stalemate.b1.3 = Ez patt. {my} nem tud lépni, így a játszma döntetlen.
ex.stalemate.b2 = Patt! {my:dat} nincs szabályos lépése, és nincs sakkban. Döntetlen.
ex.stalemate.b2.2 = Jaj, ne, patt: {my} beszorult, de nincs sakkban.
ex.stalemate.b2.3 = Patt miatt döntetlen. {my} nem tud lépni.
ex.stalemate.b3 = Ez patt: {my:dat} nincs szabályos lépése. Pedig nyerő állásod volt!
ex.stalemate.b3.2 = Patt! {my} beszorult, és a megnyert játszmából döntetlen lesz.
ex.stalemate.b3.3 = {my:dat} nincs lépése, és nincs sakkban: patt.
ex.stalemate.b4 = Patt: {my:dat} nincs szabályos lépése. Ezzel elúszik a győzelem.
ex.stalemate.b4.2 = {move} patthelyzetbe hozza {my:acc}. Döntetlen nyerő állásból.
ex.stalemate.b4.3 = Ez patt; {my} be van szorítva.
ex.stalemate.b5 = {move} patthelyzetbe hozza {my:acc}. A győzelem odavan.
ex.stalemate.b5.2 = Patt: {my:dat} nincs mezője.
ex.stalemate.b5.3 = Ez patt, {my} beszorult.
ex.stalemate.b6 = Patt. {my:dat} nincs lépése.
ex.stalemate.b6.2 = {move}, patt: {my} be van szorítva.
ex.stalemate.b6.3 = Patt; {my} nem tud lépni.
ex.stalemate.tip.b1 = Ha nyerésre állsz, mindig hagyj egy szabad mezőt a királyomnak.
ex.stalemate.tip.b1.2 = Ne feledd: ha előnyben vagy, hagyj egy kis helyet a királyomnak.
# The coach can reach stalemate on purpose along the line.
ex.stalemate_trick.b1 = Vigyázz! Odaadhatom a bábuimat, és akkor {my} nem tud lépni: patt.
ex.stalemate_trick.b1.2 = Vigyázz: {my} majdnem beszorult. Döntetlenre menthetem a játszmát.
ex.stalemate_trick.b2 = Vigyázz: áldozhatok, és akkor {my} patthelyzetbe kerülne.
ex.stalemate_trick.b2.2 = {my:dat} alig van mezője. Ki tudom kényszeríteni a pattot!
ex.stalemate_trick.b3 = Ezzel pattal menekülhetek meg: {my:dat} elfogynak a lépései.
ex.stalemate_trick.b3.2 = Vigyázz: {line} után {my} patthelyzetbe kerül.
ex.stalemate_trick.b4 = {move} pattcselt enged: {line}, és {my} nem tud lépni.
ex.stalemate_trick.b4.2 = Most {my} patthelyzetbe menekülhet: {line}.
ex.stalemate_trick.b5 = {move} pattot enged: {line}; {my} be van szorítva.
ex.stalemate_trick.b5.2 = Pattcsel: {line}, és {my:dat} nincs lépése.
ex.stalemate_trick.b6 = {line}, patt: {my} be van szorítva.
ex.stalemate_trick.b6.2 = {line} után patt; {my} beszorult.
