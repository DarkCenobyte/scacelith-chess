# Coach speech (Hungarian): the rules lesson (level 0, src/coach/lesson.cpp).
# Same keys and variants as assets/coach/speech/en/lesson.lang.
#
# Placeholders: {your} / {my} = a piece of the player / of the coach WITH its article and possessive
# ("a bástyád", "a huszárom"), with the case forms of common.lang ({my:acc} "a huszáromat",
# {your:ins} "a bástyáddal", {my:dat}, {my:ter}, {your:noart_ins}...); never write "a"/"az" or a
# possessive next to them. {sq}, {sq2}, {to}, {esc} = squares: never a suffix or an article on them,
# the case goes on "mező" ("{sq} mezőre", "{sq} mezőn"). {move} = a move. {@}, {@2}, {@3} are
# invisible marks: the coach points at something while saying the word right after the mark.
# A ".spoken" key is what the voice says instead (here: letters said by their Hungarian names).
# Files = vonalak, ranks = sorok, back rank = alapsor (glossary).

# ---- Chapter titles (said inside "Folytassuk a leckét: {chapter}.") ------------------------------------
# Nominative with the article, lower case (they always follow a colon, see event.lesson.* in events.lang).
lesson.title.welcome = a sakktábla
lesson.title.pieces = hogyan lépnek a bábuk
lesson.title.safety = a biztonságos és a veszélyes ütések
lesson.title.check = a sakk
lesson.title.mate = a matt
lesson.title.castling = a sáncolás
lesson.title.en_passant = az en passant ütés
lesson.title.promotion = az átváltozás
lesson.title.draws = a patt és a döntetlen
lesson.title.etiquette = értékszám, sakkóra és illem a valódi játszmákban

# ---- Lines every exercise uses ------------------------------------------------------------------------
# After the coach demonstrated the solution.
lesson.now_you = Most próbáld te.
lesson.now_you.2 = Most te jössz.
lesson.now_you.3 = Most te.
# Another wrong move after the demonstration.
lesson.almost = Majdnem! Azt a lépést lépd meg, amit megmutattam.
lesson.almost.2 = Nem egészen. Próbáld meg a bemutatott lépést.
lesson.almost.3 = Közel jársz. Emlékezz, mit mutattam az előbb.
# A wrong move without a line of its own.
lesson.try_again = Nem ez az. Próbáld újra.
lesson.try_again.2 = Nem ez. Próbálkozz még egyszer.
lesson.try_again.3 = Próbáljuk meg még egyszer.
lesson.use_your = Lépj {your:ins}.
lesson.use_your.2 = Próbáld {your:ins}.
lesson.watch = Figyelj.
lesson.like_this = Így.
lesson.and_back = És vissza.
# A check that is not checkmate (the coach then shows the escape).
lesson.check_escape = Sakk, de a királyom elmenekül {esc} mezőre.
lesson.check_takes = Sakk, de a királyom egyszerűen leüti {your:acc}.
lesson.check_block = Sakk, de egy bábummal el tudom zárni az utat.
lesson.stalemate = Patt! A királyom nem tud lépni, és nincs sakkban. Döntetlen, pedig nyerésre álltál!

# ---- Why a move is not allowed (the coach points at the piece or square in question) ----------------
# {sq} = the square in question, {my} = the coach's piece that attacks, pins, blocks or gives
# check, {your} = the piece the player tried to move.
why.KingIntoCheck = Nem léphetsz {sq} mezőre: {my} támadja. A király sosem léphet támadott mezőre.
why.PathBlocked = Valami {@}útban van: a huszáron kívül egyik bábu sem ugorhat át másikat.
why.WrongGeometry = {your} nem így lép.
why.MustAnswerCheck = {@}Sakkban vagy: előbb azt kell elhárítanod.
why.CastlingThroughCheck = A királyod áthaladna {sq} mezőn, azt pedig {my} támadja.
why.CastlingNoRights = Az a király vagy bástya már lépett: nem lehet sáncolni.
why.CastlingBlocked = A sáncoláshoz üresnek kell lennie a király és a bástya közötti mezőknek.
why.CastlingOutOfCheck = Sakkban nem sáncolhatsz.
why.PawnForwardBlocked = A gyalog nem üthet egyenesen előre: az a mező {@}foglalt.
why.LeavesKingInCheck = {your} kötésben van: ha ellépne, {my} támadná a királyodat.
why.OwnPieceOnTarget = Nem léphetsz a saját bábudra.
why.PawnCaptureNeedsVictim = A gyalog csak ütéskor léphet átlósan.
why.EnPassantExpired = En passant ütni csak közvetlenül a gyalog kettős lépése után szabad.
why.NotYourTurn = Várj: én jövök.

