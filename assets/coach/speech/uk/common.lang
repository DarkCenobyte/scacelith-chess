# кома три"), not the bookish "одна ціла три десятих".
number.decimal = {int},{frac}
number.decimal.spoken = {int} кома {frac}

# ---- Counted nouns ---------------------------------------------------------------------------------
# Ukrainian plural rule (assets/i18n): one (1, 21, 31 ...) | few (2-4, 22-24 ...) | many (0, 5-20, 25 ...).
# Nominative (= accusative for the inanimate nouns): "мат у три ходи". A sentence needing another
# case ("після трьох ходів", "одну помилку") will need its own count key (count.<noun>_gen ...), with
# number words in that case. Feminine nouns say their number with the form "f", neuter ones with
# "neut". After 2-4 Ukrainian adjectives stay in the nominative plural: "дві грубі помилки".
count.move = {n} хід|{n} ходи|{n} ходів
count.position = {n:f} позиція|{n:f} позиції|{n:f} позицій
count.point = {n:neut} очко|{n:neut} очки|{n:neut} очок
count.pawn = {n} пішак|{n} пішаки|{n} пішаків
count.piece = {n:f} фігура|{n:f} фігури|{n:f} фігур
count.mistake = {n:f} помилка|{n:f} помилки|{n:f} помилок
count.blunder = {n:f} груба помилка|{n:f} грубі помилки|{n:f} грубих помилок
count.inaccuracy = {n:f} неточність|{n:f} неточності|{n:f} неточностей
count.game = {n:f} партія|{n:f} партії|{n:f} партій
count.time = {n} раз|{n} рази|{n} разів
count.square = {n:neut} поле|{n:neut} поля|{n:neut} полів
# "{n:f}" / "{n:neut}" in a line say a bare number in the feminine / neuter ("одна", "одне"); they are
# count keys so that the same forms also work outside the counted nouns (and the form check knows them).
count.f = {n:f}|{n:f}|{n:f}
count.neut = {n:neut}|{n:neut}|{n:neut}

# ---- Added for review.lang and appraisal.lang (pass 2) ---------------------------------------------
# Accusative of a counted feminine noun: only "one" differs from the nominative ("взято одну
# фігуру", "двадцять одну фігуру"; 2-4 and 5+ are the nominative forms "дві фігури", "п’ять фігур").
# "Взято {n:piece_acc}" says what was captured without a past tense that would show the player's
# gender ("ти взяв / взяла").
number.1.f_acc.spoken = одну
count.f_acc = {n:f_acc}|{n:f_acc}|{n:f_acc}
count.piece_acc = {n:f_acc} фігуру|{n:f} фігури|{n:f} фігур
# Attackers and defenders of a square ("на e4 у мене 3 нападники, а в тебе 2 захисники").
count.attacker = {n} нападник|{n} нападники|{n} нападників
count.defender = {n} захисник|{n} захисники|{n} захисників
# A run of best moves ("3 найкращі ходи поспіль").
count.top_move = {n} найкращий хід|{n} найкращі ходи|{n} найкращих ходів
# Accuracy in percent: written "87 %" (as assets/i18n/uk.lang number.percent), spoken with the noun
# in its plural form ("вісімдесят сім відсотків", "двадцять один відсоток").
count.pct = {n} %|{n} %|{n} %
count.pct.spoken = {n} відсоток|{n} відсотки|{n} відсотків
# "Mate in N" with the preposition the voice needs: "в" before the vowel of "один" ("мат в один
# хід"), "у" before a consonant ("мат у два ходи", "у двадцять один хід", "у вісім ходів").
# Written always "у" ("мат у 1 хід"). Use it after a word ending in a consonant: "мат {m:in_move}".
# Among the "one" numbers only 1 starts with a vowel (21, 31 ... are listed so that the composed
# number does not become "двадцять в один"); 11 keeps "у" ("у одинадцять ходів", allowed after a
# consonant). {n:prep_in} is the number with its preposition; count.prep_in only declares the form.
count.in_move = у {n} хід|у {n} ходи|у {n} ходів
count.in_move.spoken = {n:prep_in} хід|у {n} ходи|у {n} ходів
count.prep_in = {n:prep_in}|{n:prep_in}|{n:prep_in}
