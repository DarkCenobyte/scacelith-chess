# Coach speech (Ukrainian): the building blocks every line uses (src/coach/catalog.cpp renders them).
# Same keys as assets/coach/speech/en/common.lang, plus the grammatical forms Ukrainian needs.
# Register: the coach says "ти" to the player (the game menus stay formal, "ви"). The coach is male
# ("я радий", "я показав"); the player's gender is unknown: no second-person past tense, no short
# adjectives or participles agreeing with the player ("готовий", "здався"): present or future tense,
# impersonal forms in -но/-то ("партію здано") and noun phrases instead.
# Words as in assets/i18n/uk.lang: пішак, кінь, слон, тура, ферзь, король; рокіровка, перетворення,
# бланк запису партії, годинник, Ело. The apostrophe is ’ (U+2019), as in the UI and the opening texts.

# ---- Pieces --------------------------------------------------------------------------------------
# Nouns: пішак, кінь, слон, ферзь, король (m), тура (f). In chess Ukrainian the masculine pieces are
# animate: accusative = genitive ("візьми мого коня", "віддати ферзя", "посунь пішака").
# Forms (every one defined for all six pieces and both owners):
#   nom       твій кінь / твоя тура               "{your} так не ходить."
#   acc       твого коня / твою туру               "Візьми {my:acc} турою!"
#   gen       твого коня / твоєї тури              "аж до {my:gen}", "у {my:gen} захисту немає"
#   dat       твоєму коневі / твоїй турі           (not used yet)
#   ins       твоїм конем / твоєю турою            "поруч із {my:ins}"
#   loc       твоєму коневі / твоїй турі           (not used yet; "на твоєму коневі")
#   bare_ins  конем / турою (no possessive)        "Ходи {your:bare_ins}." When the player acts with
#             their own piece Ukrainian says "своєю турою" or nothing, never "твоєю турою": use bare_ins.
#   pron      він / вона (the piece as subject)    "Це {your}. {your:pron} ходить по діагоналі."
#   pron_acc  його / її (object, also "its")       "Візьми {my:pron_acc}!", "на {my:pron_acc} поле"
#             (never right after a preposition as an object, where Ukrainian says "нього / неї":
#             rephrase instead; as a possessive, "на його поле", it is right)
# Past tenses, short adjectives and participles agree with the piece's gender: the lines avoid
# them with a piece placeholder as subject ("{my} залишає дошку", "у {my:gen} захисту немає").
piece.pawn.gender = m
piece.knight.gender = m
piece.bishop.gender = m
piece.rook.gender = f
piece.queen.gender = m
piece.king.gender = m
piece.pawn.nom = пішак
piece.pawn.acc = пішака
piece.pawn.gen = пішака
piece.pawn.dat = пішакові
piece.pawn.ins = пішаком
piece.pawn.loc = пішакові
piece.pawn.bare_ins = пішаком
piece.pawn.pron = він
piece.pawn.pron_acc = його
piece.knight.nom = кінь
piece.knight.acc = коня
piece.knight.gen = коня
piece.knight.dat = коневі
piece.knight.ins = конем
piece.knight.loc = коневі
piece.knight.bare_ins = конем
piece.knight.pron = він
piece.knight.pron_acc = його
piece.bishop.nom = слон
piece.bishop.acc = слона
piece.bishop.gen = слона
piece.bishop.dat = слонові
piece.bishop.ins = слоном
piece.bishop.loc = слонові
piece.bishop.bare_ins = слоном
piece.bishop.pron = він
piece.bishop.pron_acc = його
piece.rook.nom = тура
piece.rook.acc = туру
piece.rook.gen = тури
piece.rook.dat = турі
piece.rook.ins = турою
piece.rook.loc = турі
piece.rook.bare_ins = турою
piece.rook.pron = вона
piece.rook.pron_acc = її
piece.queen.nom = ферзь
piece.queen.acc = ферзя
piece.queen.gen = ферзя
piece.queen.dat = ферзеві
piece.queen.ins = ферзем
piece.queen.loc = ферзеві
piece.queen.bare_ins = ферзем
piece.queen.pron = він
piece.queen.pron_acc = його
piece.king.nom = король
piece.king.acc = короля
piece.king.gen = короля
piece.king.dat = королеві
piece.king.ins = королем
piece.king.loc = королеві
piece.king.bare_ins = королем
piece.king.pron = він
piece.king.pron_acc = його
# Possessives: твій / твоя ... мій / моя ..., by case and gender.
owner.your.nom.m = твій {piece}
owner.your.nom.f = твоя {piece}
owner.your.acc.m = твого {piece}
owner.your.acc.f = твою {piece}
owner.your.gen.m = твого {piece}
owner.your.gen.f = твоєї {piece}
owner.your.dat.m = твоєму {piece}
owner.your.dat.f = твоїй {piece}
owner.your.ins.m = твоїм {piece}
owner.your.ins.f = твоєю {piece}
owner.your.loc.m = твоєму {piece}
owner.your.loc.f = твоїй {piece}
owner.my.nom.m = мій {piece}
owner.my.nom.f = моя {piece}
owner.my.acc.m = мого {piece}
owner.my.acc.f = мою {piece}
owner.my.gen.m = мого {piece}
owner.my.gen.f = моєї {piece}
owner.my.dat.m = моєму {piece}
owner.my.dat.f = моїй {piece}
owner.my.ins.m = моїм {piece}
owner.my.ins.f = моєю {piece}
owner.my.loc.m = моєму {piece}
owner.my.loc.f = моїй {piece}
# Forms without a possessive: the noun or the pronoun alone.
owner.your.bare_ins = {piece}
owner.my.bare_ins = {piece}
owner.your.pron = {piece}
owner.my.pron = {piece}
owner.your.pron_acc = {piece}
owner.my.pron_acc = {piece}
# The English keys (every language defines them); Ukrainian uses the gendered patterns above.
owner.your.nom = твій {piece}
owner.my.nom = мій {piece}

# ---- Squares, files and ranks (spoken) -----------------------------------------------------------
# The voice drops Latin letters: file letters are Cyrillic letter names, as in the opening texts
# (tools/gen_opening_lang.py): e4 = "е чотири", f5 = "еф п’ять", a8 = "а вісім", h7 = "аш сім".
square.spoken = {file} {rank}
file.a.spoken = а
file.b.spoken = бе
file.c.spoken = це
file.d.spoken = де
file.e.spoken = е
file.f.spoken = еф
file.g.spoken = же
file.h.spoken = аш
rank.1.spoken = один
rank.2.spoken = два
rank.3.spoken = три
rank.4.spoken = чотири
rank.5.spoken = п’ять
rank.6.spoken = шість
rank.7.spoken = сім
rank.8.spoken = вісім

# ---- Moves ---------------------------------------------------------------------------------------
# Ukrainian scoresheet letters (assets/i18n/uk.lang scoresheet.pieces): Кр(ороль) Ф(ерзь) Т(ура)
# С(лон) К(інь): "Кf3", "Тad1", "Кр:e2".
move.letters = Кр Ф Т С К
# Spoken as Ukrainian players read notation: "кінь еф три", "кінь б’є на е п’ять", "кінь бе де сім",
# "пішак де б’є на е п’ять" (the bare file letter "де" would sound like the word "where"), "пішак
# б’є у відповідь" (the opening texts' word for a recapture), "коротка рокіровка", "ферзь же чотири,
# шах". {piece} is always the nominative here, so the promotion names the new piece after a colon
# ("перетворення на" would need the accusative "на ферзя").
move.piece.spoken = {piece} {to}
move.piece_capture.spoken = {piece} б’є на {to}
move.piece_from.spoken = {piece} {from} {to}
move.piece_from_capture.spoken = {piece} {from} б’є на {to}
move.pawn.spoken = {to}
move.pawn_capture.spoken = пішак {file} б’є на {to}
move.recapture.spoken = {piece} б’є у відповідь
move.castle_short.spoken = коротка рокіровка
move.castle_long.spoken = довга рокіровка
move.promotion.spoken = {move}, перетворення: {piece}
move.check.spoken = {move}, шах
move.mate.spoken = {move}, мат
moves.join.spoken = {a}, {b}

# ---- Numbers -------------------------------------------------------------------------------------
# Spoken number words (nominative). 21-99 compose as "{tens} {units}" ("двадцять три"), 101-999 as
# "{hundreds} {rest}" ("сто двадцять"); every hundred is listed. Forms: "f" = feminine ("одна фігура",
# "дві помилки", "двадцять одна партія"), "neut" = neuter ("одне очко", "одне поле"); a number
# without its own form falls back to the plain word (neuter "два" = masculine "два").
number.0.spoken = нуль
number.1.spoken = один
number.1.f.spoken = одна
number.1.neut.spoken = одне
number.2.spoken = два
number.2.f.spoken = дві
number.3.spoken = три
number.4.spoken = чотири
number.5.spoken = п’ять
number.6.spoken = шість
number.7.spoken = сім
number.8.spoken = вісім
number.9.spoken = дев’ять
number.10.spoken = десять
number.11.spoken = одинадцять
number.12.spoken = дванадцять
number.13.spoken = тринадцять
number.14.spoken = чотирнадцять
number.15.spoken = п’ятнадцять
number.16.spoken = шістнадцять
number.17.spoken = сімнадцять
number.18.spoken = вісімнадцять
number.19.spoken = дев’ятнадцять
number.20.spoken = двадцять
number.30.spoken = тридцять
number.40.spoken = сорок
number.50.spoken = п’ятдесят
number.60.spoken = шістдесят
number.70.spoken = сімдесят
number.80.spoken = вісімдесят
number.90.spoken = дев’яносто
number.100.spoken = сто
number.200.spoken = двісті
number.300.spoken = триста
number.400.spoken = чотириста
number.500.spoken = п’ятсот
number.600.spoken = шістсот
number.700.spoken = сімсот
number.800.spoken = вісімсот
number.900.spoken = дев’ятсот
number.tens.spoken = {tens} {units}
# Unused (every hundred is listed above), kept because English defines it.
number.hundreds.spoken = {n} сотень
number.hundreds_rest.spoken = {hundreds} {rest}
number.minus.spoken = мінус {n}
# A decimal number: Ukrainian writes a decimal comma ("1,3") and says it with "кома" ("плюс один
# кома три"), not the bookish "одна ціла три десятих".
number.decimal = {int},{frac}
number.decimal.spoken = {int} кома {frac}

# ---- Counted nouns ---------------------------------------------------------------------------------
# Ukrainian plural rule (assets/i18n): one (1, 21, 31 ...) | few (2-4, 22-24 ...) | many (0, 5-20, 25 ...).
# Nominative (= accusative for the inanimate nouns): "мат у три ходи". A sentence needing another
# case ("після трьох ходів", "одну помилку") will need its own count key (count.<noun>_gen ...), with
# number words in that case. Feminine nouns say their number with the form "f", neuter ones with
# "neut". After 2-4 Ukrainian adjectives stay in the nominative plural: "дві грубі помилки".
count.move = {n} хід|{n} ходи|{n} ходів
count.point = {n:neut} очко|{n:neut} очки|{n:neut} очок
count.pawn = {n} пішак|{n} пішаки|{n} пішаків
count.piece = {n:f} фігура|{n:f} фігури|{n:f} фігур
count.mistake = {n:f} помилка|{n:f} помилки|{n:f} помилок
count.blunder = {n:f} груба помилка|{n:f} грубі помилки|{n:f} грубих помилок
count.inaccuracy = {n:f} неточність|{n:f} неточності|{n:f} неточностей
count.game = {n:f} партія|{n:f} партії|{n:f} партій
count.time = {n} раз|{n} рази|{n} разів
count.square = {n:neut} поле|{n:neut} поля|{n:neut} полів
# "{n:f}" / "{n:neut}" in a line say a bare number in the feminine / neuter ("одна", "одне"); they are
# count keys so that the same forms also work outside the counted nouns (and the form check knows them).
count.f = {n:f}|{n:f}|{n:f}
count.neut = {n:neut}|{n:neut}|{n:neut}

# ---- Evaluations (the strongest levels) ------------------------------------------------------------
# From the listener's point of view. {x} = pawns with one decimal (number.decimal), {n} = moves.
eval.up = +{x}
eval.up.spoken = плюс {x}
eval.down = −{x}
eval.down.spoken = мінус {x}
eval.even = 0,0
eval.even.spoken = рівність
eval.mate_win = мат у {n:move}
eval.mate_loss = тобі мат у {n:move}
