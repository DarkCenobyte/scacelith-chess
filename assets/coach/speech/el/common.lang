# ---- Squares, files and ranks (spoken) -----------------------------------------------------------
# Written squares stay "e4" (Latin letters, as on Greek boards and scoresheets). The voice names the
# Latin letter the way Greek players say it: a and e as the Greek vowels "α" and "ε", the others by
# their English names: e4 = "ε τέσσερα", d4 = "ντι τέσσερα", c4 = "σι τέσσερα", f3 = "εφ τρία",
# g3 = "τζι τρία", b5 = "μπι πέντε", h7 = "έιτς επτά". Ranks are the neuter numbers ("τέσσερα").
# A square is neuter (το τετράγωνο): "στο {sq}", "από το {sq}", "το {sq}" fit every square.
square.spoken = {file} {rank}
file.a.spoken = α
file.b.spoken = μπι
file.c.spoken = σι
file.d.spoken = ντι
file.e.spoken = ε
file.f.spoken = εφ
file.g.spoken = τζι
file.h.spoken = έιτς
rank.1.spoken = ένα
rank.2.spoken = δύο
rank.3.spoken = τρία
rank.4.spoken = τέσσερα
rank.5.spoken = πέντε
rank.6.spoken = έξι
rank.7.spoken = επτά
rank.8.spoken = οκτώ

# ---- Moves ---------------------------------------------------------------------------------------
# Greek notation letters: Ρ (ρήγας = βασιλιάς), Β (βασίλισσα), Π (πύργος), Α (αξιωματικός), Ι (ίππος):
# "Ιf3", "Αxc4", "Ρg1".
move.letters = Ρ Β Π Α Ι
# Spoken as Greek players read notation, without articles: "ίππος εφ τρία", "ίππος παίρνει στο ε
# πέντε", "ίππος μπι ντι επτά", "πιόνι ε παίρνει στο ντι πέντε", "πιόνι ξαναπαίρνει" (a recapture in a
# line), "μικρό ροκέ", "ε οκτώ και γίνεται βασίλισσα", "βασίλισσα τζι τέσσερα, σαχ". {piece} is the
# bare nominative (piece.<type>.nom): a promotion is "και γίνεται {piece}" (nominative after γίνεται).
move.piece.spoken = {piece} {to}
move.piece_capture.spoken = {piece} παίρνει στο {to}
move.piece_from.spoken = {piece} {from} {to}
move.piece_from_capture.spoken = {piece} {from} παίρνει στο {to}
move.pawn.spoken = {to}
move.pawn_capture.spoken = πιόνι {file} παίρνει στο {to}
move.recapture.spoken = {piece} ξαναπαίρνει
move.castle_short.spoken = μικρό ροκέ
move.castle_long.spoken = μεγάλο ροκέ
move.promotion.spoken = {move} και γίνεται {piece}
move.check.spoken = {move}, σαχ
move.mate.spoken = {move}, ματ
moves.join.spoken = {a}, {b}

