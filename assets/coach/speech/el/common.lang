# ---- Counted nouns ---------------------------------------------------------------------------------
# Greek plural rule (assets/i18n): one (1) | other (0, 2, 3...). A counted noun has no article, so its
# nominative and accusative are the same words ("έχασες τρεις μονάδες", "έμειναν τρεις μονάδες").
# Feminine nouns say their number with the form "f" ("μία κίνηση", "είκοσι μία κινήσεις"); neuter
# nouns use the plain number ("ένα λάθος", "τρία πιόνια"). No masculine noun is counted: the material
# is counted in "μονάδες" (f), not "πόντοι" / "βαθμοί".
count.move = {n:f} κίνηση|{n:f} κινήσεις
count.point = {n:f} μονάδα|{n:f} μονάδες
count.pawn = {n} πιόνι|{n} πιόνια
count.piece = {n} κομμάτι|{n} κομμάτια
count.mistake = {n} λάθος|{n} λάθη
count.blunder = {n} σοβαρό λάθος|{n} σοβαρά λάθη
count.inaccuracy = {n:f} ανακρίβεια|{n:f} ανακρίβειες
count.game = {n:f} παρτίδα|{n:f} παρτίδες
count.time = {n:f} φορά|{n:f} φορές
count.square = {n} τετράγωνο|{n} τετράγωνα
count.position = {n:f} θέση|{n:f} θέσεις
# "{n:f}", "{n:m}", "{n:m_acc}" in a line say a number in that gender before a noun written after the
# placeholder ("{n:f} συνεχόμενες καλύτερες κινήσεις"); they are count keys so that the same forms
# also work outside the counted nouns (and the form check knows them). Digits in the subtitles.
count.f = {n:f}|{n:f}
count.m = {n:m}|{n:m}
count.m_acc = {n:m_acc}|{n:m_acc}
# More counted nouns, for the lines that need them: "{acc:percent}" = "85%" in the subtitles and
# "ογδόντα πέντε τοις εκατό" spoken; "{m:check}" = "2 σαχ" (σαχ is invariable); "{n:best_move}" =
# "5 καλύτερες κινήσεις" (a streak).
count.percent = {n}%|{n}%
count.percent.spoken = {n} τοις εκατό|{n} τοις εκατό
count.check = {n} σαχ|{n} σαχ
count.best_move = {n:f} καλύτερη κίνηση|{n:f} καλύτερες κινήσεις

# ---- Evaluations (the strongest levels) ------------------------------------------------------------
# From the listener's point of view. {x} = pawns with one decimal (number.decimal), {n} = moves.
# "ματ σε 3" is said "ματ σε τρεις" (κινήσεις understood, feminine), as Greek players name problems.
eval.up = +{x}
eval.up.spoken = συν {x}
eval.down = −{x}
eval.down.spoken = μείον {x}
eval.even = 0,0
eval.even.spoken = ισορροπία
eval.mate_win = ματ σε {n}
eval.mate_win.spoken = ματ σε {n:f}
eval.mate_loss = ματ σε {n} εναντίον σου
eval.mate_loss.spoken = ματ σε {n:f} εναντίον σου

# ---- Forms of names used by other files ------------------------------------------------------------
# The phases of the game (appraisal.lang appraisal.phase.*: "το άνοιγμα", "το μέσο παιχνίδι", "το
# φινάλε", all neuter, with their article): "{text:se}" = "στο άνοιγμα" ("Έπαιξες πολύ καλά {text:se}."),
# "{text:gen}" = "του ανοίγματος" ("η ακρίβεια {text:gen}").
appraisal.phase.opening.se = στο άνοιγμα
appraisal.phase.opening.gen = του ανοίγματος
appraisal.phase.middlegame.se = στο μέσο παιχνίδι
appraisal.phase.middlegame.gen = του μέσου παιχνιδιού
appraisal.phase.endgame.se = στο φινάλε
appraisal.phase.endgame.gen = του φινάλε

