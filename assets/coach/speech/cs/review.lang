# Coach speech (Czech): the review of the player's moves (src/coach/review.cpp, review_explain.cpp).
# Same keys and variants as assets/coach/speech/en/review.lang (its header documents every placeholder).
#
# Register: the coach says "ty"; the coach is male ("nečekal jsem", "já bych zahrál"). The player's
# gender is unknown: no second-person past tense or conditional ("přehlédl jsi", "mohl bys"): the
# present or future ("ztrácíš", "nezachráníš"), impersonal phrasing ("šlo zahrát", "byl tu mat",
# "uniklo ti"), nouns, or a piece as subject ("{your} měl{your:past} lepší tah").
# Pieces carry their possessive; forms from common.lang: acc gen dat loc ins, bare_ins ("táhni
# jezdcem"), refl_acc refl_gen refl_ins ("svého jezdce": after an imperative or a verb whose subject
# is the player), pron_acc pron_dat pron_ins npron_* ("za ním / za ní"), alone ("sám / sama"),
# poss_ins, and the endings past ("visel{my:past}") and adj / adj_acc ("kter{my:adj}").
# A move as subject: "Tah {best} byl ..." or the impersonal neuter "Lepší bylo {best}", as Czech
# annotations write it. Mate in N: "mat {m:ord_ins} tahem" (spoken "mat třetím tahem") or "mat za
# {m:move}" (simpler, levels 1-3). Counted numbers: {pts:point}, {n:time} ("dvakrát"),
# {n:attacker_acc}, {n2:defender_acc}, {n:square}; a piece's value "je za {n:point}".
# Only prepositions that never change before {sq}, {move}, {best}, {reply}, {line} ("na", "po",
# "do", "od", "o", "za"), or a fixed noun in between ("z pole {sq}", "k poli {sq}", "tahem {move}").
# Levels 1-2: simple words, short sentences; levels 5-6: terse.

# ---- Announcements (either side's move) -------------------------------------------------------
# The player gives check (levels 1-2: say what it means).
ann.check.human.b1 = Šach! Můj král je pod útokem.
ann.check.human.b1.2 = Šach! Napadáš mého krále.
ann.check.human.b1.3 = To je šach! Můj král se musí ze šachu dostat.
ann.check.human = Šach.
ann.check.human.2 = Šach!
ann.check.human.3 = A to je šach.
# The coach gives check.
ann.check.coach = Šach!
ann.check.coach.2 = Šach.
ann.check.coach.3 = A šach!
# Once per game at levels 1-2, right after the coach's first check ({your} = the player's king).
ann.check.coach.first = To znamená, že {your} je pod útokem. Musíš {your:pron_acc} dostat ze šachu.
ann.check.coach.first.2 = Šach znamená, že {your} je pod útokem. Uhni {your:pron_ins}, zacloň, nebo vezmi moji figuru.
ann.double_check.coach = Dvojitý šach! Dvě moje figury napadají tvého krále najednou, takže musí ustoupit.
ann.double_check.coach.2 = To je dvojitý šach: teď pomůže jen tah králem.
ann.double_check.human = Dvojitý šach! Dvě tvoje figury napadají mého krále najednou, takže musí ustoupit.
ann.double_check.human.2 = Dvojitý šach! Teď mě zachrání jen tah králem.
# The player checkmates the coach.
ann.mate.human.b1 = Mat! Vítězství je tvoje! Můj král nemá kam utéct.
ann.mate.human.b1.2 = To je mat! Výborně, partie je tvoje!
ann.mate.human.b1.3 = Mat! Můj král je v pasti. Gratuluju!
ann.mate.human = Mat. Dobře zahráno.
ann.mate.human.2 = To je mat. Gratuluju.
ann.mate.human.3 = Mat! Pěkná práce.
# The coach checkmates the player.
ann.mate.coach.b1 = To je mat. Tvůj král nemá kam uniknout.
ann.mate.coach.b1.2 = Mat. Tvůj král je v šachu a nemůže utéct.
ann.mate.coach.b1.3 = Obávám se, že je to mat. Tvůj král nemůže uniknout.
ann.mate.coach = Mat.
ann.mate.coach.2 = A to je mat.
ann.mate.coach.3 = Obávám se, že je to mat.

