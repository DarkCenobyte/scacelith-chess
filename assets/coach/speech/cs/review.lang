ex.stalemate.b5 = {move} dává {my:dat} pat. Výhra je pryč.
ex.stalemate.b5.2 = Pat: {my} nemá žádné pole.
ex.stalemate.b5.3 = To je pat, {my} se nemůže hnout.
ex.stalemate.b6 = Pat. {my} nemá tah.
ex.stalemate.b6.2 = {move}, pat: {my} nemá kam.
ex.stalemate.b6.3 = Pat; {my} nemůže táhnout.
ex.stalemate.tip.b1 = Když vyhráváš, vždycky nech mému králi nějaké volné pole.
ex.stalemate.tip.b1.2 = Pamatuj: když vedeš, dej mému králi trochu místa.
# The coach can reach stalemate on purpose along the line.
ex.stalemate_trick.b1 = Pozor! Můžu rozdat své figury a {my} pak nebude mít tah: pat.
ex.stalemate_trick.b1.2 = Pozor: {my} skoro nemá kam jít. Můžu z toho udělat remízu.
ex.stalemate_trick.b2 = Pozor: můžu obětovat figuru a {my} skončí v patu.
ex.stalemate_trick.b2.2 = {my} nemá skoro žádné pole. Můžu si vynutit pat!
ex.stalemate_trick.b3 = Tohle mi dovolí zachránit se patem: {my} už nebude mít kam táhnout.
ex.stalemate_trick.b3.2 = Pozor: po {line} je {my} v patu.
