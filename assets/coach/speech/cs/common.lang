# ---- Moves ---------------------------------------------------------------------------------------
# Czech scoresheet letters: K(rál) D(áma) V(ěž) S(třelec) J(ezdec): "Jf3", "Vad1", "Kxe2".
move.letters = K D V S J
# Spoken as Czech players read notation: "jezdec ef tři", "jezdec bere é pět", "jezdec bé dé sedm",
# "é bere dé pět", "pěšec bere zpět" (a recapture), "malá rošáda" (O-O), "velká rošáda" (O-O-O),
# "dáma gé čtyři, šach". {piece} is always the nominative here, so the promotion says "é osm,
# z pěšce je dáma" ("proměna v" would need the accusative "v dámu").
