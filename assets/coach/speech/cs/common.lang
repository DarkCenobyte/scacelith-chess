# ---- Counted nouns ---------------------------------------------------------------------------------
# Czech plural rule (assets/i18n): one (1) | few (2-4) | other (0, 5 and up, 21 and 22 included).
# Nominative forms; for "tah", "bod", "šach", "pole", "braní" the accusative is the same ("za tři
# tahy", "ztratit pět bodů"). The feminine nouns and "pěšec" (animate) have their own accusative
# keys below (count.<noun>_acc). Never put a preposition that changes with the next sound (v/ve,
# s/se, z/ze, k/ke) right before a number: "v pěti tazích" but "ve dvou tazích".
count.move = {n:m} tah|{n} tahy|{n} tahů
count.point = {n:m} bod|{n} body|{n} bodů
count.pawn = {n:m} pěšec|{n} pěšci|{n} pěšců
count.piece = {n:f} figura|{n:f} figury|{n} figur
count.mistake = {n:f} chyba|{n:f} chyby|{n} chyb
count.blunder = {n:f} hrubá chyba|{n:f} hrubé chyby|{n} hrubých chyb
count.inaccuracy = {n:f} nepřesnost|{n:f} nepřesnosti|{n} nepřesností
count.game = {n:f} partie|{n:f} partie|{n} partií
# "Jednou", "dvakrát", "pětkrát": written "2krát", spoken as one word ("dva" + "krát").
count.time = jednou|{n}krát|{n}krát
count.square = {n:neut} pole|{n:neut} pole|{n} polí
count.position = {n:f} pozice|{n:f} pozice|{n} pozic
# "{n:m}", "{n:f}", "{n:neut}", "{n:ma}", "{n:fa}" in a line say a bare number in that form; they
# are count keys so that the same forms also work outside the counted nouns (and the form check
# knows them).
count.m = {n:m}|{n}|{n}
count.f = {n:f}|{n:f}|{n}
count.neut = {n:neut}|{n:neut}|{n}
count.ma = {n:ma}|{n}|{n}
count.fa = {n:fa}|{n:f}|{n}
# Accusatives that differ from the nominative ("sebral jsem ti {n:pawn_acc}" = "jednoho pěšce").
count.pawn_acc = {n:ma} pěšce|{n} pěšce|{n} pěšců
count.piece_acc = {n:fa} figuru|{n:f} figury|{n} figur
count.mistake_acc = {n:fa} chybu|{n:f} chyby|{n} chyb
count.blunder_acc = {n:fa} hrubou chybu|{n:f} hrubé chyby|{n} hrubých chyb
count.inaccuracy_acc = {n:fa} nepřesnost|{n:f} nepřesnosti|{n} nepřesností
count.game_acc = {n:fa} partii|{n:f} partie|{n} partií
count.position_acc = {n:fa} pozici|{n:f} pozice|{n} pozic
# More counted nouns for the review and the appraisal: attackers and defenders of a square ("mám tam
# {n:attacker_acc}, ty {n2:defender_acc}"), checks, captures (pawns included, unlike "figura"),
# best moves in a row, moves taken back.
count.attacker = {n:m} útočník|{n} útočníci|{n} útočníků
count.attacker_acc = {n:ma} útočníka|{n} útočníky|{n} útočníků
count.defender = {n:m} obránce|{n} obránci|{n} obránců
count.defender_acc = {n:ma} obránce|{n} obránce|{n} obránců
count.check = {n:m} šach|{n} šachy|{n} šachů
count.capture = {n:neut} braní|{n:neut} braní|{n} braní
count.best_move = {n:m} nejlepší tah|{n} nejlepší tahy|{n} nejlepších tahů
count.takeback = {n:m} vrácený tah|{n} vrácené tahy|{n} vrácených tahů
# Percentages (accuracy): "{acc:percent}" = "85 %" in the subtitles (Czech puts a space before %),
# "pětaosmdesát procent" spoken ("jedno procento", "dvě procenta", "pět procent").
count.percent = {n} %|{n} %|{n} %
count.percent.spoken = {n:neut} procento|{n:neut} procenta|{n} procent
# Ordinal instrumental: "{m:ord_ins} tahem" = "3. tahem" in the subtitles, "třetím tahem" spoken
# ("mat {m:ord_ins} tahem" = "mate in {m}").
count.ord_ins = {n}.|{n}.|{n}.
count.ord_ins.spoken = {n:ord_ins}|{n:ord_ins}|{n:ord_ins}
# Declares the form "in" of the phase names below ("{text:in}" = "ve střední hře"); for a number it
# would say the bare number.
count.in = {n}|{n}|{n}

# ---- Evaluations (the strongest levels) ------------------------------------------------------------
# From the listener's point of view. {x} = pawns with one decimal (number.decimal), {n} = moves.
# "Mate in 4" is "mat 4. tahem" (spoken "mat čtvrtým tahem"); being mated, "dostaneš mat 4. tahem"
# (a clause: use {eval} after a colon or a comma). The written lines keep the dot of the ordinal,
# the spoken ones drop it (.spoken), or the voice would stop there.
eval.up = +{x}
eval.up.spoken = plus {x}
eval.down = −{x}
eval.down.spoken = minus {x}
eval.even = 0,0
eval.even.spoken = vyrovnáno
eval.mate_win = mat {n:ord_ins}. tahem
eval.mate_win.spoken = mat {n:ord_ins} tahem
eval.mate_loss = dostaneš mat {n:ord_ins}. tahem
eval.mate_loss.spoken = dostaneš mat {n:ord_ins} tahem

# ---- Forms of names from other files -------------------------------------------------------------
# The game phases (appraisal.lang appraisal.phase.*: "zahájení" n, "střední hra" f, "koncovka" f)
# in the other cases, for "{text:<form>}": gen dat acc loc ins; "in" with its preposition ("v
# zahájení", "ve střední hře", "v koncovce": the preposition changes with the word); "past" and
# "adj" as for the pieces ("{text} se ti povedl{text:past}" = "povedlo" / "povedla").
appraisal.phase.opening.gen = zahájení
appraisal.phase.opening.dat = zahájení
appraisal.phase.opening.acc = zahájení
appraisal.phase.opening.loc = zahájení
appraisal.phase.opening.ins = zahájením
appraisal.phase.opening.in = v zahájení
appraisal.phase.opening.past = o
appraisal.phase.opening.adj = é
appraisal.phase.middlegame.gen = střední hry
appraisal.phase.middlegame.dat = střední hře
appraisal.phase.middlegame.acc = střední hru
appraisal.phase.middlegame.loc = střední hře
appraisal.phase.middlegame.ins = střední hrou
appraisal.phase.middlegame.in = ve střední hře
appraisal.phase.middlegame.past = a
appraisal.phase.middlegame.adj = á
appraisal.phase.endgame.gen = koncovky
appraisal.phase.endgame.dat = koncovce
appraisal.phase.endgame.acc = koncovku
appraisal.phase.endgame.loc = koncovce
appraisal.phase.endgame.ins = koncovkou
appraisal.phase.endgame.in = v koncovce
appraisal.phase.endgame.past = a
appraisal.phase.endgame.adj = á
