# ---- Counted nouns ---------------------------------------------------------------------------------
# Hindi plural rule (assets/i18n): one (0 and 1) | other. Direct case: "3 चालें", "1 ग़लती", "5 बार".
count.move = {n} चाल|{n} चालें
count.point = {n} अंक|{n} अंक
count.pawn = {n} प्यादा|{n} प्यादे
count.piece = {n} मोहरा|{n} मोहरे
count.mistake = {n} ग़लती|{n} ग़लतियाँ
count.blunder = {n} ब्लंडर|{n} ब्लंडर
count.inaccuracy = {n} चूक|{n} चूकें
count.game = {n} बाज़ी|{n} बाज़ियाँ
count.time = {n} बार|{n} बार
count.square = {n} खाना|{n} खाने
count.position = {n} स्थिति|{n} स्थितियाँ
# The oblique count "<noun>_obl", for a count followed by a postposition: "{m:move_obl} में मात" = "3 चालों में
# मात" / "1 चाल में मात", "{n:piece_obl} का फ़ायदा", "{n:time_obl} तक" ("बार" does not change).
# A verb agreeing with a counted noun changes with the number ("1 ग़लती हुई", "3 ग़लतियाँ हुईं"): the lines avoid
# it, e.g. with ने and को the verb stays masculine singular ("तुमने {n:move_obl} को वापस लिया").
count.move_obl = {n} चाल|{n} चालों
count.point_obl = {n} अंक|{n} अंकों
count.pawn_obl = {n} प्यादे|{n} प्यादों
count.piece_obl = {n} मोहरे|{n} मोहरों
count.mistake_obl = {n} ग़लती|{n} ग़लतियों
count.blunder_obl = {n} ब्लंडर|{n} ब्लंडरों
count.inaccuracy_obl = {n} चूक|{n} चूकों
count.game_obl = {n} बाज़ी|{n} बाज़ियों
count.time_obl = {n} बार|{n} बार
count.square_obl = {n} खाने|{n} खानों
count.position_obl = {n} स्थिति|{n} स्थितियों
# More counted nouns for the review and the appraisal: "{n:best_move}" = "5 सबसे अच्छी चालें" (a streak),
# "{n:attacker}" / "{n2:defender}" = "3 हमलावर" / "2 रक्षक" (the pieces aimed at a square), each with its oblique.
count.best_move = {n} सबसे अच्छी चाल|{n} सबसे अच्छी चालें
count.best_move_obl = {n} सबसे अच्छी चाल|{n} सबसे अच्छी चालों
count.attacker = {n} हमलावर|{n} हमलावर
count.attacker_obl = {n} हमलावर|{n} हमलावरों
count.defender = {n} रक्षक|{n} रक्षक
count.defender_obl = {n} रक्षक|{n} रक्षकों
# Accuracy in percent: "{acc:percent}" = "85%" in the subtitles, "पचासी प्रतिशत" spoken.
count.percent = {n}%|{n}%
count.percent.spoken = {n} प्रतिशत|{n} प्रतिशत
# A move NUMBER ("at move 21"): "{n:moveno}" = "चाल 21" in the subtitles and the ordinal "इक्कीसवीं चाल" spoken
# ("{n:moveno} पर" = "at move 21", "{crit_no:moveno} तक" = "until move 21"). A written ordinal ending depends on
# the number ("21वीं" but "पहली", "दूसरी", "छठी"), which a count key cannot choose: hence "चाल 21" in writing.
count.moveno = चाल {n}|चाल {n}
count.moveno.spoken = {n:ordf} चाल|{n:ordf} चाल
# "ordf" and "mv" are number forms (number.<n>.ordf.spoken, number.<n>.mv.spoken above); these count keys
# declare them. In the lines use {n:moveno} and {n:move_obl}: "{n:ordf}" shows a bare number in the subtitles,
# and count.mv only repeats count.move_obl.
count.ordf = {n}|{n}
count.ordf.spoken = {n:ordf}|{n:ordf}
count.mv = {n} चाल|{n} चालों
count.mv.spoken = {n:mv}|{n:mv}

# ---- Evaluations (the strongest levels) ------------------------------------------------------------
# From the listener's point of view. {x} = pawns with one decimal (number.decimal), {n} = moves: a bare number,
# said with "चाल" by the form "mv" ("तीन चालों में मात"); the subtitles keep "3 चाल में मात".
eval.up = +{x}
eval.up.spoken = प्लस {x}
eval.down = −{x}
eval.down.spoken = माइनस {x}
eval.even = 0.0
eval.even.spoken = बराबर
eval.mate_win = {n} चाल में मात
eval.mate_win.spoken = {n:mv} में मात
eval.mate_loss = {n} चाल में तुम्हारी मात
eval.mate_loss.spoken = {n:mv} में तुम्हारी मात
