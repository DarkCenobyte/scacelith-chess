# ---- Squares, files and ranks (spoken) -----------------------------------------------------------
# The voice drops Latin letters: the file letters are spelled the way Indian players say the English letters,
# the ranks are Hindi number words: e4 = "ई चार", f3 = "एफ़ तीन", a8 = "ए आठ", h7 = "एच सात".
square.spoken = {file} {rank}
file.a.spoken = ए
file.b.spoken = बी
file.c.spoken = सी
file.d.spoken = डी
file.e.spoken = ई
file.f.spoken = एफ़
file.g.spoken = जी
file.h.spoken = एच
rank.1.spoken = एक
rank.2.spoken = दो
rank.3.spoken = तीन
rank.4.spoken = चार
rank.5.spoken = पाँच
rank.6.spoken = छह
rank.7.spoken = सात
rank.8.spoken = आठ

# ---- Moves ---------------------------------------------------------------------------------------
# Indian scoresheets use the English piece letters (assets/i18n/hi.lang scoresheet.pieces).
move.letters = K Q R B N
# Spoken as Hindi players read notation: "घोड़ा एफ़ तीन", "घोड़ा ई पाँच पर काटता है", "घोड़ा बी से डी सात",
# "ई का प्यादा डी पाँच पर काटता है", "प्यादा वापस काटता है" (recapture), "छोटी कैसलिंग" / "लंबी कैसलिंग",
# "ई आठ, और प्यादा वज़ीर बनता है", "वज़ीर जी चार, शह", "..., शह और मात". {piece} is the direct case. A capture
# or a promotion is said with a verb: the lines treat a spoken move as a quoted name (after a colon, or before a
# comma), never followed by a postposition or a verb ("{move} के बाद" would read "... काटता है के बाद").
move.piece.spoken = {piece} {to}
move.piece_capture.spoken = {piece} {to} पर काटता है
move.piece_from.spoken = {piece} {from} से {to}
move.piece_from_capture.spoken = {piece} {from} से {to} पर काटता है
move.pawn.spoken = {to}
move.pawn_capture.spoken = {file} का प्यादा {to} पर काटता है
move.recapture.spoken = {piece} वापस काटता है
move.castle_short.spoken = छोटी कैसलिंग
