# ---- Squares, files and ranks (spoken) -----------------------------------------------------------
# Written squares stay "e4". Spoken: the Turkish names of the letters (as when spelling: a, be, ce, de,
# e, fe, ge, he), then the rank as a number, as Turkish players read coordinates: e4 = "e dört",
# f3 = "fe üç", c6 = "ce altı", h7 = "he yedi". A square ends in a varying sound: never put a suffix
# after {sq}; put it on the noun "kare" instead ("{sq} karesine", "{sq} karesinde", "{sq} karesindeki").
square.spoken = {file} {rank}
file.a.spoken = a
file.b.spoken = be
file.c.spoken = ce
file.d.spoken = de
file.e.spoken = e
file.f.spoken = fe
file.g.spoken = ge
file.h.spoken = he
rank.1.spoken = bir
rank.2.spoken = iki
rank.3.spoken = üç
rank.4.spoken = dört
rank.5.spoken = beş
rank.6.spoken = altı
rank.7.spoken = yedi
rank.8.spoken = sekiz

# ---- Moves ---------------------------------------------------------------------------------------
# Turkish scoresheet letters (TSF, MEB): Ş(ah) V(ezir) K(ale) F(il) A(t): "Af3", "Fxc4", "Şg1".
move.letters = Ş V K F A
# Spoken as Turkish players read notation: "at fe üç" (Nf3), "at e beş karesinde alır" (Nxe5: a suffix
# cannot follow the square, so it goes on "kare"), "at be de yedi" (Nbd7), "e piyonu de beş karesinde
# alır" (exd5), "piyon geri alır" (a recapture), "kısa rok", "uzun rok", "e sekiz, vezir olur" (e8=Q),
# "vezir ge dört, şah", "..., şah mat". {piece} is the bare noun here. A move ends in a varying sound too:
# never attach a suffix to {move} {best} {reply} {line}; write "{best} hamlesi", "{line} varyantında".
move.piece.spoken = {piece} {to}
move.piece_capture.spoken = {piece} {to} karesinde alır
move.piece_from.spoken = {piece} {from} {to}
move.piece_from_capture.spoken = {piece} {from} {to} karesinde alır
move.pawn.spoken = {to}
move.pawn_capture.spoken = {file} piyonu {to} karesinde alır
move.recapture.spoken = {piece} geri alır
move.castle_short.spoken = kısa rok
move.castle_long.spoken = uzun rok
move.promotion.spoken = {move}, {piece} olur
move.check.spoken = {move}, şah
move.mate.spoken = {move}, şah mat
moves.join.spoken = {a}, {b}

# ---- Respellings (spoken) ------------------------------------------------------------------------
