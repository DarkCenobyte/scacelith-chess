# ---- Counted nouns ---------------------------------------------------------------------------------
# Turkish plural rule (assets/i18n): one|other, but a noun after a number stays singular ("1 hamle",
# "3 hamle"), so both forms are the same words. For the same reason a bare {n} may be followed by any
# noun in a line ("{n} saldıran taş"). A counted value ends in its fixed noun, so a suffix may follow
# the placeholder in that noun's harmony: hamle, kare: -de -yi -ye -den -lik; puan: -da -ı -a -dan
# -lık; piyon, pozisyon: -da -u -a -dan; taş: -ta -ı -a -tan; hata, büyük hata: -da -yı -ya -dan;
# kusurlu hamle as hamle; oyun: -da -u -a -dan; kez: none ("{m:move}de mat", "{n:move}lik bir
# kombinasyon", "{n2:point}lık bir taş").
count.move = {n} hamle|{n} hamle
count.point = {n} puan|{n} puan
count.pawn = {n} piyon|{n} piyon
count.piece = {n} taş|{n} taş
count.mistake = {n} hata|{n} hata
count.blunder = {n} büyük hata|{n} büyük hata
count.inaccuracy = {n} kusurlu hamle|{n} kusurlu hamle
count.game = {n} oyun|{n} oyun
count.time = {n} kez|{n} kez
count.square = {n} kare|{n} kare
count.position = {n} pozisyon|{n} pozisyon
# Turkish additions, for the other coach files:
#   ord      a move NUMBER as an ordinal: "{n:ord} hamlede" = written "21. hamlede", spoken "yirmi
#            birinci hamlede"; "{crit_no:ord} hamleye kadar". Only a noun may follow it (never a suffix,
#            and never a piece placeholder: the dot would capitalise it).
#   percent  an accuracy: "{acc:percent}" = written "%85" (the sign comes first in Turkish), spoken
#            "yüzde seksen beş". No suffix after it; "yüzde {acc}" is also correct.
count.ord = {n}.|{n}.
count.ord.spoken = {n:ord}|{n:ord}
count.percent = %{n}|%{n}
count.percent.spoken = yüzde {n}|yüzde {n}

# ---- Evaluations (the strongest levels) ------------------------------------------------------------
# From the listener's point of view. {x} = pawns with one decimal (number.decimal), {n} = moves.
# "artı bir virgül üç", "eşit" (level); a mate as Turkish puzzle books write it: "3 hamlede mat" (the
# listener mates), "sana 3 hamlede mat" (the listener gets mated). Never attach a suffix to {eval}.
eval.up = +{x}
eval.up.spoken = artı {x}
eval.down = −{x}
eval.down.spoken = eksi {x}
eval.even = 0,0
eval.even.spoken = eşit
eval.mate_win = {n} hamlede mat
eval.mate_loss = sana {n} hamlede mat

