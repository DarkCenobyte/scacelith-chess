ex.verdict.blunder.b1.2 = Atenție! Mutarea asta te poate costa.
ex.verdict.blunder.b1.3 = Stai puțin. Mutarea asta are o problemă.
ex.verdict.blunder.b2 = Hm, mutarea asta are o problemă.
ex.verdict.blunder.b2.2 = E o greșeală mare.
ex.verdict.blunder.b2.3 = Atenție, mutarea asta te costă ceva.
ex.verdict.blunder.b3 = E o gafă.
ex.verdict.blunder.b3.2 = {move} e o greșeală adevărată.
ex.verdict.blunder.b3.3 = Of, {move} e o greșeală mare.
ex.verdict.blunder.b4 = {move} e o gafă.
ex.verdict.blunder.b4.2 = {move} e o greșeală gravă.
ex.verdict.blunder.b4.3 = Mă tem că e o gafă.
ex.verdict.blunder.b5 = {move} e o greșeală gravă.
ex.verdict.blunder.b5.2 = {move} e o gafă.
ex.verdict.blunder.b5.3 = {move} e o greșeală care costă scump.
ex.verdict.blunder.b6 = {move} e o eroare gravă.
ex.verdict.blunder.b6.2 = {move} e o gafă.
ex.verdict.blunder.b6.3 = {move}? O gafă.
# A blunder that leaves the coach's threat standing (levels 1-2: the threat the engine found after the
# coach's last move is what the reply carries out).
ex.verdict.ignored.b1 = Hopa! N-ai răspuns la amenințarea mea.
ex.verdict.ignored.b1.2 = Atenție! Amenințarea mea era încă acolo.
ex.verdict.ignored.b1.3 = Stai puțin. Ai uitat de amenințarea mea.
ex.verdict.ignored.b2 = Hm, amenințarea mea era încă acolo.
ex.verdict.ignored.b2.2 = Ai lăsat amenințarea mea fără răspuns.
ex.verdict.ignored.b2.3 = Atenție, n-ai răspuns la amenințarea mea.
ex.verdict.mistake.b3 = Nu e o mutare bună.
ex.verdict.mistake.b3.2 = Hm, {move} are o problemă.
ex.verdict.mistake.b3.3 = E o greșeală.
ex.verdict.mistake.b4 = {move} e o greșeală.
ex.verdict.mistake.b4.2 = {move} nu e bună.
ex.verdict.mistake.b4.3 = E o greșeală.
ex.verdict.mistake.b5 = {move} e o greșeală clară.
ex.verdict.mistake.b5.2 = {move} e o greșeală.
ex.verdict.mistake.b5.3 = {move} nu e bună.
ex.verdict.mistake.b6 = {move} e o greșeală.
ex.verdict.mistake.b6.2 = {move}? O greșeală.
ex.verdict.mistake.b6.3 = Nu {move}.
# A dubious move (an inaccuracy; a costly move with nothing concrete to show while still better):
# only the better move is named ({best} is pointed at), never a scenario.
ex.verdict.inaccuracy.b3 = Nu e rău, dar {best} era puțin mai bună.
ex.verdict.inaccuracy.b3.2 = {best} era puțin mai precisă.
ex.verdict.inaccuracy.b3.3 = O mică scăpare: aici, {best} era mai bună.
ex.verdict.inaccuracy.b4 = Inexactitate: {best} era mai precisă.
ex.verdict.inaccuracy.b4.2 = O mică inexactitate. {best} era puțin mai bună.
ex.verdict.inaccuracy.b4.3 = Nu chiar cea mai bună: {best} era mai exactă.
ex.verdict.inaccuracy.b5 = {move} e imprecisă; {best} era mai puternică.
ex.verdict.inaccuracy.b5.2 = O mică inexactitate. Aș fi jucat {best}.
ex.verdict.inaccuracy.b5.3 = {best} era mai precisă decât {move}.
ex.verdict.inaccuracy.b6 = {move} e imprecisă; {best}.
ex.verdict.inaccuracy.b6.2 = Inexactitate. {best}.
ex.verdict.inaccuracy.b6.3 = {best} era mai bună.
# Level 6, an inaccuracy at the bottom of its class (deeper searches often clear it): a hedged word.
ex.verdict.inaccuracy.maybe = Poate că {best} era puțin mai precisă.
ex.verdict.inaccuracy.maybe.2 = Poate aș fi jucat {best}.
# A dubious move that loses material (levels 3-6): the remark alone, never "a bit better" (at level 6
# under 6 points, the hedged word above unless a piece is lost).
ex.verdict.dubious = Mutarea asta pare dubioasă.
ex.verdict.dubious.2 = Mutarea asta mi se pare dubioasă.
# Something good was missed (levels 1-2).
ex.verdict.missed.b1 = Stai puțin! Ai ratat ceva bun.
ex.verdict.missed.b1.2 = Mai uită-te o dată! Era ceva mai bun.
ex.verdict.missed.b1.3 = Stai, aici aveai o șansă!
ex.verdict.missed.b2 = Aici ai ratat o șansă.
ex.verdict.missed.b2.2 = Hm, era ceva mai bun.
ex.verdict.missed.b2.3 = Stai, aici aveai o mutare excelentă.

