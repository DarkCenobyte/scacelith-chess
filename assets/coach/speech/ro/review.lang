demo.move.2 = {move}.
demo.move.3 = Apoi {move}.
# Levels 1-3, the coach's moves.
demo.my.move = {my} merge pe {sq}.
demo.my.move.2 = Mut {my} pe {sq}.
demo.my.move.3 = Apoi {my} merge pe {sq}.
demo.my.take = Iau {your}.
demo.my.take.2 = {my} ia {your}.
