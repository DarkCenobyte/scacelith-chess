ex.stalemate.b4.3 = E pat; {my} e închi{my:agr_s}.
ex.stalemate.b5 = {move} dă pat {my:gen}. Victoria s-a dus.
ex.stalemate.b5.2 = Pat: {my} nu are niciun câmp.
ex.stalemate.b5.3 = E pat, {my} e bloca{my:agr_t}.
ex.stalemate.b6 = Pat. {my} nu are mutări.
ex.stalemate.b6.2 = {move}, pat: {my} e închi{my:agr_s}.
ex.stalemate.b6.3 = Pat; {my} nu se poate mișca.
ex.stalemate.tip.b1 = Când ai o poziție câștigată, lasă-i mereu regelui meu un câmp liber.
ex.stalemate.tip.b1.2 = Ține minte: când ești în avantaj, lasă-i regelui meu puțin loc.
# The coach can reach stalemate on purpose along the line.
ex.stalemate_trick.b1 = Atenție! Pot să-mi dau piesele, iar apoi {my} nu mai are mutări: pat.
ex.stalemate_trick.b1.2 = Atenție: {my} aproape că nu se mai poate mișca. Pot face remiză.
ex.stalemate_trick.b2 = Atenție: pot sacrifica, iar {my} ar fi în pat.
ex.stalemate_trick.b2.2 = {my} aproape că nu mai are câmpuri. Pot forța patul!
ex.stalemate_trick.b3 = Asta îmi permite să scap prin pat: {my} rămâne fără mutări.
ex.stalemate_trick.b3.2 = Atenție: după {line}, {my} e în pat.
ex.stalemate_trick.b4 = {move} permite o capcană de pat: {line}, iar {my} nu se mai poate mișca.
ex.stalemate_trick.b4.2 = Acum {my} se poate salva prin pat: {line}.
ex.stalemate_trick.b5 = {move} permite patul: {line}; {my} e închi{my:agr_s}.
ex.stalemate_trick.b5.2 = Capcană de pat: {line}, iar {my} nu are mutări.
ex.stalemate_trick.b6 = {line}, pat: {my} e închi{my:agr_s}.
ex.stalemate_trick.b6.2 = Pat după {line}; {my} e bloca{my:agr_t}.

# ---- 4. Fork (b1 b2: {my} {t1} {t2} pointed at; b3-b5: {reply} {t1} {t2}; b6: {reply}) ----------
ex.fork.b1 = {my} poate merge pe {sq}, de unde atacă {t1} și {t2}.
ex.fork.b1.2 = {my} merge pe {sq} și atacă două piese: {t1} și {t2}.
ex.fork.b1.3 = Atenție la {my}: de pe {sq} atacă deodată {t1} și {t2}.
ex.fork.b2 = Furculiță! {my} de pe {sq} atacă deodată {t1} și {t2}.
ex.fork.b2.2 = După mutarea ta, {my} poate ataca dublu {t1} și {t2} de pe {sq}.
ex.fork.b2.3 = {my} merge pe {sq}: atac dublu, {t1} și {t2}.
ex.fork.b3 = {move} permite {reply}, care atacă dublu {t1} și {t2}.
ex.fork.b3.2 = După {reply}, atac în același timp {t1} și {t2}.
ex.fork.b3.3 = {reply} e o furculiță: și {t1}, și {t2} sunt sub atac.
ex.fork.b4 = {reply} atacă dublu {t1} și {t2}; după {line}, ai pierdut {pts:point}.
ex.fork.b4.2 = {reply} lovește deodată {t1} și {t2}.
ex.fork.b4.3 = {move} permite furculița {reply}, care atacă {t1} și {t2}.
ex.fork.b5 = {move} cade în furculița {reply}: {t1} și {t2}.
ex.fork.b5.2 = {reply} atacă dublu {t1} și {t2}.
ex.fork.b5.3 = După {reply}, și {t1}, și {t2} sunt sub atac.
ex.fork.b6 = {reply} atacă dublu.
ex.fork.b6.2 = {move} permite {reply}, o furculiță.
ex.fork.b6.3 = {reply}, cu furculiță.
# Once the fork stands (level 1; in the middle of the demonstration, or where it stops).
ex.fork.tail.b1 = Poți salva doar una dintre piese: {t1} sau {t2}.
ex.fork.tail.b1.2 = Acum atac două piese deodată: {t1} și {t2}. Asta e o furculiță!
ex.fork.tail.b1.3 = Vezi? Atac și {t1}, și {t2}. Una dintre piese va cădea.
# The fork gives check ({your} = the king, {t1} = the piece that falls; both pointed at).
ex.fork.tail_king = {your} trebuie să iasă din șah, așa că iau {t1}.
ex.fork.tail_king.2 = Șah! {your} trebuie să plece, iar {t1} cade.
ex.fork.more.b3 = Înainte să muți, uită-te la câmpul {sq}: de acolo, {my} poate da o furculiță.
ex.fork.more.b3.2 = Urmărește câmpul {sq}. De acolo, {my} atacă dublu.
ex.fork.tip.knight = Atenție la săriturile calului lângă regele tău și dama ta!
ex.fork.tip.knight.2 = Caii adoră să atace două piese deodată. Uită-te unde pot sări.

