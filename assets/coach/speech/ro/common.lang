# ---- Counted nouns ---------------------------------------------------------------------------------
# Romanian plural rule (assets/i18n): one (1) | few (0, 2-19, and 101-119, 201-219...) | other (20-99,
# 100, 120...: the noun takes "de"). Written: digits ("1 mutare", "3 mutări", "20 de mutări"). Spoken: the
# ".spoken" forms say "o mutare" / "un punct" for one, and the number in the noun's gender.
# A count renders in lower case: never start a sentence with one.
count.move = {n} mutare|{n} mutări|{n} de mutări
count.move.spoken = o mutare|{n:f} mutări|{n:f} de mutări
count.point = {n} punct|{n} puncte|{n} de puncte
count.point.spoken = un punct|{n:neut} puncte|{n:neut} de puncte
count.pawn = {n} pion|{n} pioni|{n} de pioni
count.pawn.spoken = un pion|{n} pioni|{n} de pioni
count.piece = {n} piesă|{n} piese|{n} de piese
count.piece.spoken = o piesă|{n:f} piese|{n:f} de piese
count.mistake = {n} greșeală|{n} greșeli|{n} de greșeli
count.mistake.spoken = o greșeală|{n:f} greșeli|{n:f} de greșeli
count.blunder = {n} gafă|{n} gafe|{n} de gafe
count.blunder.spoken = o gafă|{n:f} gafe|{n:f} de gafe
count.inaccuracy = {n} inexactitate|{n} inexactități|{n} de inexactități
count.inaccuracy.spoken = o inexactitate|{n:f} inexactități|{n:f} de inexactități
count.game = {n} partidă|{n} partide|{n} de partide
count.game.spoken = o partidă|{n:f} partide|{n:f} de partide
# "{n:time}" = "o dată", "de 3 ori", "de 20 de ori" (with its "de"): "Ai dat șah {m:time}."
count.time = o dată|de {n} ori|de {n} de ori
count.time.spoken = o dată|de {n:f} ori|de {n:f} de ori
count.square = {n} câmp|{n} câmpuri|{n} de câmpuri
count.square.spoken = un câmp|{n:neut} câmpuri|{n:neut} de câmpuri
count.position = {n} poziție|{n} poziții|{n} de poziții
count.position.spoken = o poziție|{n:f} poziții|{n:f} de poziții
# Romanian only, for the sentences of the other coach files:
# "mat {m:in_move}" = "mat într-o mutare" / "mat în 3 mutări" / "mat în 20 de mutări" (it carries its "în",
# which contracts with "o" to "într-o": never write "în {m:move}"); "{n:best_move}" = "5 mutări optime"
# (a streak of the engine's best moves); "{n:attacker}" / "{n:defender}" = "3 atacatori", "un apărător";
# "{m:check}" = "2 șahuri"; "{n:capture}" = "4 capturi"; "{acc:percent}" = "85 %", spoken "optzeci și cinci
# la sută" (the percent sign after a no-break space).
count.in_move = într-o mutare|în {n} mutări|în {n} de mutări
count.in_move.spoken = într-o mutare|în {n:f} mutări|în {n:f} de mutări
count.best_move = {n} mutare optimă|{n} mutări optime|{n} de mutări optime
count.best_move.spoken = o mutare optimă|{n:f} mutări optime|{n:f} de mutări optime
count.attacker = {n} atacator|{n} atacatori|{n} de atacatori
count.attacker.spoken = un atacator|{n} atacatori|{n} de atacatori
count.defender = {n} apărător|{n} apărători|{n} de apărători
count.defender.spoken = un apărător|{n} apărători|{n} de apărători
count.check = {n} șah|{n} șahuri|{n} de șahuri
count.check.spoken = un șah|{n:neut} șahuri|{n:neut} de șahuri
count.capture = {n} captură|{n} capturi|{n} de capturi
count.capture.spoken = o captură|{n:f} capturi|{n:f} de capturi
count.percent = {n} %|{n} %|{n} %
count.percent.spoken = {n} la sută|{n} la sută|{n} la sută
# "{n:f}" / "{n:neut}" in a line say a bare number in the feminine / neuter, for a noun the line writes
# itself or leaves out ("{m:f} dintre ele" = "una dintre ele", "două dintre ele"); digits in writing.
# They are count keys so that the same forms work outside the counted nouns (and the form check knows them).
count.f = {n:f}|{n:f}|{n:f}
count.neut = {n:neut}|{n:neut}|{n:neut}

# ---- Evaluations (the strongest levels) ------------------------------------------------------------
# From the listener's point of view. {x} = pawns with one decimal (number.decimal), {n} = moves.
# The spoken mate says its noun ("mat în trei mutări", "mat într-o mutare"); the subtitles keep "mat în 3".
eval.up = +{x}
eval.up.spoken = plus {x}
eval.down = −{x}
eval.down.spoken = minus {x}
eval.even = 0,0
eval.even.spoken = egalitate
eval.mate_win = mat în {n}
eval.mate_win.spoken = mat {n:in_move}
eval.mate_loss = mat în {n} împotriva ta
eval.mate_loss.spoken = mat {n:in_move} împotriva ta
