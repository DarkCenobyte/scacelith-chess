# ---- Squares, files and ranks (spoken) -----------------------------------------------------------
# Letter names as Romanian spells them, ranks as number words: e4 = "e patru", f3 = "ef trei",
# d5 = "de cinci", c6 = "ce șase", g7 = "ge șapte", h8 = "haș opt", a1 = "a unu".
square.spoken = {file} {rank}
file.a.spoken = a
file.b.spoken = be
file.c.spoken = ce
file.d.spoken = de
file.e.spoken = e
file.f.spoken = ef
file.g.spoken = ge
file.h.spoken = haș
rank.1.spoken = unu
rank.2.spoken = doi
rank.3.spoken = trei
rank.4.spoken = patru
rank.5.spoken = cinci
rank.6.spoken = șase
rank.7.spoken = șapte
rank.8.spoken = opt

# ---- Moves ---------------------------------------------------------------------------------------
# Romanian scoresheet letters: R(ege) D(amă) T(urn) N(ebun) C(al): "Cf3", "Txe1", "Nb5".
move.letters = R D T N C
# Spoken as Romanian players read notation, with the bare noun: "cal ef trei", "cal ia e cinci",
# "cal be de doi", "e ia de cinci", "pion recapturează" (a recapture in a line), "rocadă mică",
# "e opt, se transformă în damă", "damă ge patru, șah", "damă haș șapte, șah mat".
move.piece.spoken = {piece} {to}
move.piece_capture.spoken = {piece} ia {to}
move.piece_from.spoken = {piece} {from} {to}
move.piece_from_capture.spoken = {piece} {from} ia {to}
move.pawn.spoken = {to}
move.pawn_capture.spoken = {file} ia {to}
move.recapture.spoken = {piece} recapturează
move.castle_short.spoken = rocadă mică
move.castle_long.spoken = rocadă mare
move.promotion.spoken = {move}, se transformă în {piece}
move.check.spoken = {move}, șah
move.mate.spoken = {move}, șah mat
moves.join.spoken = {a}, {b}

# ---- Respellings (spoken) ------------------------------------------------------------------------
