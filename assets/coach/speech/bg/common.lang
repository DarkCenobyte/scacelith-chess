# Coach speech (Bulgarian): the building blocks every line uses (src/coach/catalog.cpp renders them).
# Same keys as assets/coach/speech/en/common.lang, plus the grammatical forms Bulgarian needs.
# Register: the coach says "ти" to the player (the game menus use the polite "вие"). The coach is
# male ("доволен съм", "бих взел"). The player's gender is unknown: never a form that agrees with the
# player: no "ти си готов/готова", no l-participle ("ти си направил", "би взел", "беше пропуснал"),
# no adjective or past passive participle about the player. Use the aorist ("ти взе", "пропусна"),
# the imperfect ("можеше да вземеш", "щеше да спечелиш"), present, future, nouns or impersonal phrasing.
# Terms: the standard Bulgarian chess words (шах, мат, пат, реми, рокада, ан пасан, произвеждане,
# дебют, мителшпил, ендшпил, вилица, свръзка, линеен удар, открита атака, груба грешка, неточност).

# ---- Pieces --------------------------------------------------------------------------------------
# Nouns: пешка (f), кон (m), офицер (m), топ (m), дама (f), цар (m). Bulgarian has no cases but a
# definite article, which has two forms on a masculine noun: the FULL article (конят, офицерът, топът,
# царят) for the subject and after "е" ("Това е конят ти"), the SHORT one (коня, офицера, топа, царя)
# everywhere else (direct object, after any preposition). Feminine nouns have one: пешката, дамата.
# The possessive is normally the clitic after the article ("конят ти", "дамата ми"); the full
# possessive ("твоят кон", "моята дама") stresses the owner (contrast, "Това е твоят кон").
# When the owner is the subject of the clause (an imperative to the player, "I" moving my own piece,
# "Белите" in Analysis), Bulgarian uses the reflexive "си", never "ти"/"ми": "Премести коня си",
# "Местя офицера си", "Белите изтеглят коня си".
# Forms (each defined for all six pieces and the owners your, my, white, black; the same for {your},
# {your2}, {my}, {my2}, {t1}, {t2} and the Analysis {piece}, which already hold their owner: never
# write твой, мой, ти, ми next to them):
#   nom        конят ти / пешката ти, конят ми; белият кон / бялата пешка, черният кон / черната
#              The subject, or the predicate after "е" ("Това е {your}." = "Това е конят ти.").
#              "{your} е под удар." = "Конят ти е под удар."
#   obj        коня ти / пешката ти, коня ми; белия кон / бялата пешка, черния кон / черната
#              Object and after every preposition. "Офицерът ми напада {your:obj}." = "... коня ти.",
#              "Вземи {my:obj} с {your:refl}!" = "Вземи офицера ми с коня си!"
#   full       твоят кон / твоята пешка, моят кон / моята пешка; white/black as nom
#              Subject with the stressed possessive. "Това е {your:full}." = "Това е твоят кон."
#   full_obj   твоя кон / твоята пешка, моя кон / моята пешка; white/black as obj
#              Object with the stressed possessive. "Вземам {your:full_obj}, не пешката." = "... твоя кон ..."
#   refl       коня си / пешката си (every owner)
#              The owner is the subject. "Погледни {your:refl}." = "Погледни коня си.",
#              "Изтеглям {my:refl}." = "Изтеглям офицера си." Never the subject itself.
#   refl_full  своя кон / своята пешка (every owner)
#              Stressed reflexive. "Пази {your:refl_full}!" = "Пази своя цар!" After "с" write "със":
#              "със {your:refl_full}" = "със своя кон".
#   def        конят / пешката (no owner; every owner, so never in Analysis lines: the side is lost)
#              Subject. "{your:def} се движи като буквата Г." = "Конят се движи като буквата Г."
#   def_obj    коня / пешката (no owner, as def)
#              Object. "Играй с {your:def_obj}." = "Играй с коня."
#   bare       кон / пешка (no article, no owner, as def)
#              "Това е {your:bare}, не офицер." = "Това е кон, не офицер."
#   pron       той / тя: the piece as a subject pronoun (Bulgarian usually drops it: the verb is enough)
#              "Това е {your}. {your:pron} се движи по диагонал." = "... Той се движи по диагонал."
#   pron_obj   го / я: object clitic. "Мога да {your:pron_obj} взема." = "Мога да го взема."
#   pron_dat   му / ѝ: dative clitic, also "its" after an articled noun. "{my} може да {your:pron_dat}
#              даде шах." = "... може да му даде шах.", "полето {your:pron_dat}" = "полето му" (its square)
#              The clitics go, as always in Bulgarian, right before the verb ("да го взема", "не я пази"),
#              or right after it when the verb starts the clause ("Вземи го!"), never first in a clause.
#   pron_full  него / нея: the stressed pronoun, after a preposition. "{t2} е точно зад {t1:pron_full}."
#              = "Топът ти е точно зад него."
#   rel        който / която: the relative pronoun. "{your2}, {your2:rel} пазеше {your:obj}, се
#              премести." = "Офицерът ти, който пазеше коня ти, се премести."
#   a          "" / "а": the ending of a past passive participle or adjective after the piece, whose
#              feminine adds "а": "{your} е свързан{your:a}." = "Конят ти е свързан." / "Пешката ти е
#              свързана." Only for words of that kind (свързан, нападнат, защитен, заклещен, хванат,
#              оставен, изгубен, открит, сам); rephrase the others ("беззащитен" -> "без защита").
# Verbs in the present, the aorist and the imperfect do not agree with gender: prefer them to
# participles ("Конят ти виси", "Пешката ти падна"). Never put an adjective before a piece
# placeholder ("the pinned {your}"): the article and the clitic would move to the adjective; rephrase.
# Spoken moves use piece.<type>.nom: the bare noun ("кон еф три"), hence the phrases for nom below.
