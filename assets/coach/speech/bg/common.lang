# ---- Counted nouns ---------------------------------------------------------------------------------
# Bulgarian plural rule (assets/i18n): one (1 only) | other (0, 2-999..., 21 included: "двадесет и една
# грешки"). Masculine nouns take their count form after a number ("два хода", "пет пъти") and say the
# number with the form "m"; feminine nouns with the form "f"; neuter nouns with the plain word.
# One time is "веднъж" (written and spoken).
count.move = {n:m} ход|{n:m} хода
count.point = {n:f} точка|{n:f} точки
count.pawn = {n:f} пешка|{n:f} пешки
count.piece = {n:f} фигура|{n:f} фигури
count.mistake = {n:f} грешка|{n:f} грешки
count.blunder = {n:f} груба грешка|{n:f} груби грешки
count.inaccuracy = {n:f} неточност|{n:f} неточности
count.game = {n:f} партия|{n:f} партии
count.time = веднъж|{n:m} пъти
count.square = {n} поле|{n} полета
count.position = {n:f} позиция|{n:f} позиции
# "{n:m}" / "{n:f}" in a line say a bare number in the masculine / feminine ("един", "една"), digits in
# writing; "{n:mv}" says the number with "ход" ("три хода"), digits alone in writing. They are count
# keys so that the form check knows them.
count.m = {n:m}|{n:m}
count.f = {n:f}|{n:f}
count.mv = {n:mv}|{n:mv}
# More counted nouns for the other files: "{acc:percent}" = "85%" written, "осемдесет и пет процента"
# spoken (a bare {acc} would say "двадесет и едно", not "двадесет и един процента"); "{m:check}" = "2
# шаха"; "{n:capture}" = "3 вземания" (pawns included, unlike "фигура"); "{n:best_move}" = "5 най-добри
# хода"; "{n:attacker}" / "{n:defender}" = "3 нападащи фигури" / "2 защитаващи фигури".
count.percent = {n}%|{n}%
count.percent.spoken = {n:m} процент|{n:m} процента
count.check = {n:m} шах|{n:m} шаха
count.capture = {n} вземане|{n} вземания
count.best_move = {n:m} най-добър ход|{n:m} най-добри хода
count.attacker = {n:f} нападаща фигура|{n:f} нападащи фигури
count.defender = {n:f} защитаваща фигура|{n:f} защитаващи фигури

# ---- Evaluations (the strongest levels) ------------------------------------------------------------
# From the listener's point of view. {x} = pawns with one decimal (number.decimal), {n} = moves.
eval.up = +{x}
eval.up.spoken = плюс {x}
eval.down = −{x}
eval.down.spoken = минус {x}
eval.even = 0,0
eval.even.spoken = равенство
# {n} here is a bare number (count keys do not apply to it): the form "mv" says the number with "ход"
# in the voice ("мат в три хода"); the subtitles keep the short "мат в 3". The listener being mated:
# "мат срещу теб в 3" (a noun phrase, so that it fits "около {eval}", "{best}: {eval}").
eval.mate_win = мат в {n:mv}
eval.mate_loss = мат срещу теб в {n:mv}
