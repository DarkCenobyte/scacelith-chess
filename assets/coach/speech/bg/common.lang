# ---- Squares, files and ranks (spoken) -----------------------------------------------------------
# Written squares are "e4" (Latin letters, as in Bulgarian notation). The voice says the letter names
# Bulgarian players use for the files, in Cyrillic so that the voice reads them as Bulgarian:
# "е четири", "еф три", "же седем", "аш осем". Ranks are the neutral counting numbers ("а едно").
square.spoken = {file} {rank}
file.a.spoken = а
file.b.spoken = бе
file.c.spoken = це
file.d.spoken = де
file.e.spoken = е
