# Coach speech (Bulgarian): the review of the player's moves (src/coach/review.cpp, review_explain.cpp).
# Same keys and variants as assets/coach/speech/en/review.lang (its header documents every placeholder).
#
# Register and forms: see the header of bg/common.lang and the glossary. The coach says "ти" and is
# male ("бих изиграл", "не очаквах", "сгреших"). The player's gender is unknown: no l-participle, no
# adjective or passive participle about the player. The lines use the present ("губиш", "изоставаш с"),
# the imperfect ("можеше да дадеш мат", "щеше да спечели") or an aorist that cannot be read as an
# imperative ("пропусна", "взе", "откри", "прибра"); never "загуби", "спечели", "остави", "направи",
# "намери" as a 2nd person aorist, which sound like orders.
# Piece forms (bg/common.lang): {your} = subject ("конят ти"), {your:obj} = object and after a
# preposition ("коня ти"), {your:refl} = when the player (or the coach, for {my}) is the subject
# ("Погледни коня си", "Премествам офицера си"), pron / pron_obj / pron_dat / pron_full / rel, and
# {x:a} = the feminine ending of a participle after the piece ("свързан{your:a}" = свързан / свързана).
# Other participles about a piece are avoided: "под удар", "в капан", "без защита", "виси", "пада".
# {m:mv} (level 6) = "3" written, "три хода" spoken; {n:point} = "3 точки"; {n:attacker} /
# {n:defender} = "3 нападащи фигури" / "2 защитаващи фигури"; {n:time} = "веднъж" / "3 пъти".
# Levels 1-2: simple words, short sentences; levels 5-6: terse.

# ---- Announcements (either side's move) -------------------------------------------------------
# The player gives check (levels 1-2: say what it means).
ann.check.human.b1 = Шах! Царят ми е под удар.
ann.check.human.b1.2 = Шах! Нападаш царя ми.
ann.check.human.b1.3 = Това е шах! Царят ми трябва да излезе от шах.
ann.check.human = Шах.
ann.check.human.2 = Шах!
ann.check.human.3 = А това е шах.
# The coach gives check.
ann.check.coach = Шах!
ann.check.coach.2 = Шах.
ann.check.coach.3 = И шах!
# Once per game at levels 1-2, right after the coach's first check ({your} = the player's king).
ann.check.coach.first = Това означава, че {your} е под удар. Трябва да {your:pron_obj} извадиш от шах.
ann.check.coach.first.2 = Шах означава, че {your} е под удар. Премести {your:pron_obj}, закрий се или вземи фигурата ми.
ann.double_check.coach = Двоен шах! Две мои фигури нападат царя ти едновременно, затова той трябва да се премести.
ann.double_check.coach.2 = Това е двоен шах: сега ще ти помогне само ход с царя.
ann.double_check.human = Двоен шах! Две твои фигури нападат царя ми едновременно, затова той трябва да се премести.
ann.double_check.human.2 = Двоен шах! Сега може да ме спаси само ход с царя.
# The player checkmates the coach.
ann.mate.human.b1 = Мат! Ти спечели! Царят ми не може да избяга.
ann.mate.human.b1.2 = Това е мат! Браво, партията е твоя!
ann.mate.human.b1.3 = Мат! Царят ми е в капан. Поздравления!
ann.mate.human = Мат. Добре изиграно.
ann.mate.human.2 = Това е мат. Поздравления.
ann.mate.human.3 = Мат! Отлично се справи.
# The coach checkmates the player.
ann.mate.coach.b1 = Това е мат. Царят ти няма изход.
ann.mate.coach.b1.2 = Мат. Царят ти е под удар и не може да избяга.
ann.mate.coach.b1.3 = Боя се, че това е мат. Царят ти не може да се измъкне.
ann.mate.coach = Мат.
ann.mate.coach.2 = А това е мат.
ann.mate.coach.3 = Мат, за съжаление.

# ---- Verdicts (the first sentence about a bad move) --------------------------------------------
ex.verdict.blunder.b1 = Опа! С този ход подаряваш нещо.
ex.verdict.blunder.b1.2 = Внимавай! Този ход може да ти навреди.
ex.verdict.blunder.b1.3 = О, чакай. Този ход има проблем.
ex.verdict.blunder.b2 = Хм, този ход има проблем.
ex.verdict.blunder.b2.2 = Това е голяма грешка.
ex.verdict.blunder.b2.3 = Внимавай, с този ход губиш нещо.
ex.verdict.blunder.b3 = Това е груба грешка.
ex.verdict.blunder.b3.2 = {move} е истинска грешка.
ex.verdict.blunder.b3.3 = Ох, {move} е голяма грешка.
ex.verdict.blunder.b4 = {move} е груба грешка.
ex.verdict.blunder.b4.2 = {move} е сериозна грешка.
ex.verdict.blunder.b4.3 = Боя се, че това е груба грешка.
ex.verdict.blunder.b5 = {move} е сериозна грешка.
ex.verdict.blunder.b5.2 = {move} е груба грешка.
ex.verdict.blunder.b5.3 = {move} е скъпо струваща грешка.
ex.verdict.blunder.b6 = {move} е тежка грешка.
ex.verdict.blunder.b6.2 = {move} е груба грешка.
ex.verdict.blunder.b6.3 = {move}? Груба грешка.
# A blunder that leaves the coach's threat standing (levels 1-2: the threat the engine found after the
# coach's last move is what the reply carries out).
ex.verdict.ignored.b1 = Опа! Ти не отговори на заплахата ми.
ex.verdict.ignored.b1.2 = Внимавай! Заплахата ми още беше в сила.
ex.verdict.ignored.b1.3 = О, чакай. Изпусна от поглед заплахата ми.
ex.verdict.ignored.b2 = Хм, заплахата ми още беше в сила.
ex.verdict.ignored.b2.2 = Заплахата ми остана без отговор.
ex.verdict.ignored.b2.3 = Внимавай, ти не отговори на заплахата ми.
ex.verdict.mistake.b3 = Това не е добър ход.
ex.verdict.mistake.b3.2 = Хм, ходът {move} има проблем.
ex.verdict.mistake.b3.3 = Това е грешка.
ex.verdict.mistake.b4 = {move} е грешка.
ex.verdict.mistake.b4.2 = {move} не е добър ход.
ex.verdict.mistake.b4.3 = Това е грешка.
ex.verdict.mistake.b5 = {move} е явна грешка.
ex.verdict.mistake.b5.2 = {move} е грешка.
ex.verdict.mistake.b5.3 = {move} не е хубав ход.
ex.verdict.mistake.b6 = {move} е грешка.
ex.verdict.mistake.b6.2 = {move}? Грешка.
ex.verdict.mistake.b6.3 = Не {move}.
# A dubious move (an inaccuracy; a costly move with nothing concrete to show while still better):
# only the better move is named ({best} is pointed at), never a scenario.
ex.verdict.inaccuracy.b3 = Не е зле, но малко по-добре беше {best}.
ex.verdict.inaccuracy.b3.2 = Малко по-точно беше {best}.
ex.verdict.inaccuracy.b3.3 = Малка неточност: тук по-добре беше {best}.
ex.verdict.inaccuracy.b4 = Неточно: по-точно беше {best}.
ex.verdict.inaccuracy.b4.2 = Малка неточност. Леко по-добре беше {best}.
ex.verdict.inaccuracy.b4.3 = Не е най-точният ход: по-прецизно беше {best}.
ex.verdict.inaccuracy.b5 = {move} е неточен ход; по-силно беше {best}.
ex.verdict.inaccuracy.b5.2 = Леко неточно. Аз бих изиграл {best}.
ex.verdict.inaccuracy.b5.3 = {best} беше по-точен ход от {move}.
ex.verdict.inaccuracy.b6 = {move} е неточно; {best}.
ex.verdict.inaccuracy.b6.2 = Неточно. {best}.
ex.verdict.inaccuracy.b6.3 = По-добре беше {best}.
# Level 6, an inaccuracy at the bottom of its class (deeper searches often clear it): a hedged word.
ex.verdict.inaccuracy.maybe = Може би малко по-точно беше {best}.
ex.verdict.inaccuracy.maybe.2 = Аз може би бих изиграл {best}.
# A dubious move that loses material (levels 3-6): the remark alone, never "a bit better" (at level 6
# under 6 points, the hedged word above unless a piece is lost).
ex.verdict.dubious = Този ход изглежда съмнителен.
ex.verdict.dubious.2 = Този ход ми се струва съмнителен.
# Something good was missed (levels 1-2).
ex.verdict.missed.b1 = О, чакай! Пропусна нещо хубаво.
ex.verdict.missed.b1.2 = Погледни пак! Имаше нещо по-добро.
ex.verdict.missed.b1.3 = Чакай малко, тук имаше шанс!
ex.verdict.missed.b2 = Тук пропусна шанс.
ex.verdict.missed.b2.2 = Хм, имаше нещо по-добро.
ex.verdict.missed.b2.3 = Чакай, тук имаше страхотен ход.

# ---- The better move (levels 3-6; {best} is pointed at) ----------------------------------------
# {line} (level 5) holds the moves that follow {best}, not {best} itself.
ex.better.b3 = По-добре беше {best}.
ex.better.b3.2 = {best} беше по-добрият ход.
ex.better.b3.3 = Вместо това добър ход беше {best}.
ex.better.b4 = По-силно беше {best}.
ex.better.b4.2 = Правилният ход беше {best}.
ex.better.b4.3 = По-добре беше {best}.
ex.better.b5 = {best}, с идеята {line}.
ex.better.b5.2 = Правилният ход беше {best}: {line}.
ex.better.b5.3 = По-добре беше {best}, а след това {line}.
ex.better.b6 = {best}: {eval}.
ex.better.b6.2 = Вместо това {best}, {eval}.
ex.better.b6.3 = {best} даваше {eval}.

# ---- A blunder without a reason the coach can give reliably --------------------------------------
# The piece that had the better move ({your}, pointed at), said before the takeback offer; the move
# itself is not named. ex.hint.move: the same without the piece.
ex.hint.b1 = Имаше по-добър ход с {your:obj}.
ex.hint.b1.2 = {your} имаше по-добър ход.
ex.hint.b2 = {your} имаше по-добър ход.
ex.hint.b2.2 = Имаше по-добър ход с {your:obj}.
ex.hint.b3 = {your} имаше по-добър ход.
ex.hint.b3.2 = С {your:obj} имаше нещо по-добро.
ex.hint.b4 = {your} имаше по-добър ход.
ex.hint.b4.2 = Погледни пак {your:refl}: с {your:pron_full} имаше нещо по-добро.
ex.hint.b5 = {your} имаше по-силен ход.
ex.hint.b5.2 = Имаше по-силен ход с {your:obj}.
ex.hint.b6 = {your} имаше по-добър ход.
ex.hint.b6.2 = Погледни пак {your:refl}.
ex.hint.move = Имаше по-добър ход.
ex.hint.move.2 = Тук имаше по-добър ход.
# The same when the better move plainly wins material for good (the move played wins and loses
# none); the move is still not named. "който" always follows "ход" directly, so that it cannot
# refer to a masculine piece.
ex.hint.gain.b1 = {your} имаше по-добър ход. Този ход печели материал.
ex.hint.gain.b1.2 = Имаше по-добър ход с {your:obj}. Този ход печели материал.
ex.hint.gain.b2 = {your} имаше по-добър ход. С него се печели материал.
ex.hint.gain.b2.2 = С {your:obj} имаше ход, който печели материал.
ex.hint.gain.b3 = {your} имаше по-добър ход, който печели материал.
ex.hint.gain.b3.2 = С {your:obj} имаше ход, който печели материал.
ex.hint.gain.b4 = {your} имаше ход, който печели материал.
ex.hint.gain.b4.2 = Погледни пак {your:refl}: с {your:pron_full} имаше ход, който печели материал.
ex.hint.gain.b5 = {your} имаше по-силен ход, който печели материал.
ex.hint.gain.b5.2 = С {your:obj} имаше ход с печалба на материал.
ex.hint.gain.b6 = {your} имаше ход с печалба на материал.
ex.hint.gain.b6.2 = Погледни пак {your:refl}: можеше да се спечели материал.
# Levels 1-2: the better move as the piece and its square, said when the offer is declined (or
# when none can be made); levels 3-6 say ex.better.
ex.reveal.b1 = По-добрият ход беше да преместиш {your:refl} на {sq}.
ex.reveal.b1.2 = {your} можеше да отиде на {sq}. Това беше по-добре.
ex.reveal.b2 = Ходът с {your:obj} на {sq} беше по-добър.
ex.reveal.b2.2 = По-добре беше да преместиш {your:refl} на {sq}.

# ---- Putting the demonstration back (levels 1-4; silent from level 5) --------------------------
