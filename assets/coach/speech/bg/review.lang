# A dubious move at levels 1-2, said with the takeback card; the better move is not named.
ex.dubious.b1 = Този ход е съмнителен. Може би можеш и по-добре?
ex.dubious.b1.2 = Този ход е съмнителен. Може би ще намериш по-добър?
ex.dubious.b2 = Съмнителен ход. Може би можеш и по-добре?
ex.dubious.b2.2 = Този ход е съмнителен. Може би има нещо по-добро?

# ---- Demonstration narration: one short line per move shown on the board ------------------------
# Levels 4-6: just the move.
demo.move = {move}.
demo.move.2 = {move}.
demo.move.3 = След това {move}.
# Levels 1-3, the coach's moves.
demo.my.move = {my} отива на {sq}.
demo.my.move.2 = Премествам {my:refl} на {sq}.
demo.my.move.3 = След това {my} отива на {sq}.
demo.my.take = Вземам {your:obj}.
demo.my.take.2 = {my} взема {your:obj}.
demo.my.take.3 = И аз вземам {your:obj}.
demo.my.check = {my} отива на {sq}. Шах.
demo.my.check.2 = Шах с {my:obj} на {sq}.
demo.my.check.3 = {my} на {sq}, шах!
demo.my.mate = {my} отива на {sq}. Мат.
demo.my.mate.2 = И {my} на {sq} дава мат.
demo.my.mate.3 = {my} на {sq}. Това е мат.
# Levels 1-3, the coach's in-between move: a capture, a check or a quiet move played first while a
# bigger piece of the player's ({t1}) is attacked; the next move of the coach's takes it.
demo.my.first.take = Първо {my} взема {your:obj}. {t1} може да почака.
demo.my.first.take.2 = {my} първо взема {your:obj}. {t1} ще си остане там.
demo.my.first.check = {my} взема {your:obj} и това е шах! {t1} може да почака.
demo.my.first.check.2 = Първо {my} взема {your:obj} с шах. {t1} ще си остане там.
demo.my.first.check_move = Първо шах с {my:obj} на {sq}. {t1} може да почака.
demo.my.first.check_move.2 = {my} отива на {sq}: първо шах! {t1} ще си остане там.
demo.my.first.move = Първо {my} отива на {sq}. {t1} може да почака.
demo.my.first.move.2 = Първо {my} на {sq}. {t1} ще си остане там.
# The piece that moves was attacked itself: it takes something before it can be taken.
demo.my.first.attacked = {my} е под удар, затова първо взема {your:obj}.
demo.my.first.attacked.2 = {my} е под удар: първо грабва {your:obj}.
# Levels 4-6, the same in-between move.
demo.first = Първо {move}: {t1} може да почака.
demo.first.2 = Първо {move}. {t1} ще си остане там.
# After the rewind when no takeback is offered: the coach's real move comes next.
demo.play_on = Сега играя своя ход.
demo.play_on.2 = Ето истинския ми ход.
demo.play_on.3 = А сега играя хода си наистина.
# Levels 1-3, the player's moves (what they would play; the present tense, as in a story).
demo.your.move = Ти местиш {your:refl} на {sq}.
demo.your.move.2 = Да кажем, че местиш {your:refl} на {sq}.
demo.your.move.3 = След това {your} отива на {sq}.
demo.your.take = Ти вземаш {my:obj}.
demo.your.take.2 = Вземаш {my:obj} с {your:refl}.
demo.your.take.3 = След това вземаш {my:obj}.
demo.your.back = Ти вземаш обратно.
demo.your.back.2 = Вземаш обратно на {sq}.
