# ---- Evaluations (the strongest levels) ------------------------------------------------------------
# From the listener's point of view. {x} = pawns with one decimal (number.decimal), {n} = moves.
eval.up = +{x}
eval.up.spoken = plus {x}
eval.down = −{x}
eval.down.spoken = mīnus {x}
eval.even = 0,0
eval.even.spoken = līdzsvars
# {n} here is a bare number (count keys do not apply to it), so the subtitles say "mats pēc 3" ("mate
# after 3", right for every number, where "mats 3 gājienos" would be wrong for 1, 21, 31 ...), and the
# voice adds the noun with the form "mv": the number as after "pēc" with "gājiens" in the right number,
# "mats pēc viena gājiena", "mats pēc trim gājieniem", "mats pēc desmit gājieniem", "mats pēc
# divdesmit viena gājiena". (The challenges say the proper term with a count: "Mats {n:move_loc}.")
eval.mate_win = mats pēc {n}
eval.mate_win.spoken = mats pēc {n:mv}
eval.mate_loss = tev mats pēc {n}
eval.mate_loss.spoken = tev mats pēc {n:mv}
count.mv = {n:mv}|{n:mv}|{n:mv}
