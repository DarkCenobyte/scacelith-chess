# ---- Moves ---------------------------------------------------------------------------------------
# Latvian scoresheet letters: K(aralis) D(āma) T(ornis) L(aidnis) Z(irgs): "Zf3", "Tad1", "Dxe2".
move.letters = K D T L Z
# Spoken as Latvian players read notation: "zirgs ef trīs", "zirgs ņem e pieci", "zirgs bē dē
# septiņi", "e ņem dē pieci", "bandinieks ņem atpakaļ" (a recapture), "īsā rokāde", "garā rokāde",
# "dāma gā četri, šahs". {piece} is always the nominative here, so the promotion names the new piece
# after a colon ("pārvēršas par" would need the accusative): "e astoņi, pārvēršana: dāma".
