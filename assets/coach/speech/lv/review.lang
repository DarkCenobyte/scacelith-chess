ex.result.b1 = Redzi? Tagad tev ir par {pts:point_pacc} mazāk.
ex.result.b1.2 = Tā tu zaudē {pts:point_acc}.
ex.result.b2 = Beigu beigās tu zaudēji {pts:point_acc}.
