ex.rewind.b2.2 = Atpakaļ, kur bijām.
ex.rewind.b2.3 = Es nolikšu figūras atpakaļ.
ex.rewind.b3 = Atpakaļ pie partijas.
ex.rewind.b3.2 = Atgriežamies.
ex.rewind.b3.3 = Atpakaļ pie pozīcijas.
ex.rewind.b4 = Atpakaļ pie partijas.
ex.rewind.b4.2 = Atpakaļ.
ex.rewind.b4.3 = Atgriezīsimies.

# ---- Takeback offer (the player answers yes or no) ---------------------------------------------
ex.offer.b1 = Vai gribi pamēģināt citu gājienu?
ex.offer.b1.2 = Vai gribi atsaukt šo gājienu un mēģināt vēlreiz?
