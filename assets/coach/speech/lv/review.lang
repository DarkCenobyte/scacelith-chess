# Coach speech (Latvian): the review of the player's moves (src/coach/review.cpp, review_explain.cpp).
# Same keys and variants as assets/coach/speech/en/review.lang (its header documents every placeholder).
#
# Register: the coach says "tu" (imperatives "paskaties", "uzmanies"); the coach is male ("es būtu
# spēlējis", "esmu ieguvis"). The player's gender is unknown: finite verbs only for the player ("tu
# palaidi garām", "tu varēji"), never "tu esi zaudējis"; "you're 3 points down" = "tev ir par 3
# punktiem mazāk" ({pts:point_pacc}); "you've lost 3 points" = "tu zaudē 3 punktus" ({pts:point_acc}).
# Pieces carry their possessive; forms from common.lang: acc gen dat, refl_* ("savs" when the player
# or the coach is the subject: "Paskaties uz {your:refl_acc}"), pron pron_gen pron_dat pron_acc
# ("tas / tā"), bare_nom, and the endings adj ("piesiet{your:adj}" = piesiets / piesieta), def, is
# ("iesprūd{your:is}" = iesprūdis / iesprūdusi). "Attacks X" = "uzbrūk {x:dat}"; "pinned to X" =
# "piesiet{your:adj} pie {t1:gen}"; "behind it" = "aiz {x:pron_gen}"; "in front of X" = "{t1:dat}
# priekšā". Squares: "uz {sq}" (to / on a square, as Latvian chess writes "zirgs uz f3"), "no {sq}",
# "lauciņš {sq}" in other cases; moves after a preposition get "gājiens" when the voice needs it
# ("ar gājienu {best}"). "Mate in N" = "mats {m:move_loc}" (divos gājienos). Terms: dakša (fork),
# iesms (skewer), piesaiste (pin), atklātais uzbrukums, pats (stalemate), caurejošais bandinieks,
# opozīcija, bandinieku galotne, laidņu pāris, pēdējā horizontāle, brīvs lauciņš (luft).

# ---- Announcements (either side's move) -------------------------------------------------------
# The player gives check (levels 1-2: say what it means).
ann.check.human.b1 = Šahs! Mans karalis ir apdraudēts.
ann.check.human.b1.2 = Šahs! Tu uzbrūc manam karalim.
ann.check.human.b1.3 = Tas ir šahs! Manam karalim jāglābjas.
ann.check.human = Šahs.
ann.check.human.2 = Šahs!
ann.check.human.3 = Un tas ir šahs.
# The coach gives check.
ann.check.coach = Šahs!
ann.check.coach.2 = Šahs.
ann.check.coach.3 = Un šahs!
# Once per game at levels 1-2, right after the coach's first check ({your} = the player's king).
ann.check.coach.first = Tas nozīmē, ka es uzbrūku {your:dat}. Tev jāaizsargājas no šaha.
ann.check.coach.first.2 = Šahs nozīmē, ka {your} ir apdraudēt{your:adj}. Pārvieto {your:pron_acc}, aizsedzies vai paņem manu figūru.
ann.double_check.coach = Dubultšahs! Divas manas figūras uzbrūk tavam karalim uzreiz, tāpēc tam jāiet prom.
ann.double_check.coach.2 = Tas ir dubultšahs: tagad palīdzēs tikai karaļa gājiens.
ann.double_check.human = Dubultšahs! Divas tavas figūras uzbrūk manam karalim uzreiz, tāpēc tam jāiet prom.
ann.double_check.human.2 = Dubultšahs! Tagad mani var glābt tikai karaļa gājiens.
# The player checkmates the coach.
ann.mate.human.b1 = Mats! Tu uzvarēji! Mans karalis nevar aizbēgt.
ann.mate.human.b1.2 = Tas ir mats! Lieliski, tu uzvarēji partijā!
ann.mate.human.b1.3 = Mats! Mans karalis ir ieslēgts. Apsveicu!
ann.mate.human = Mats. Labi nospēlēts.
ann.mate.human.2 = Tas ir mats. Apsveicu.
ann.mate.human.3 = Mats! Skaisti nospēlēts.
# The coach checkmates the player.
ann.mate.coach.b1 = Tas ir mats. Tavam karalim nav izejas.
ann.mate.coach.b1.2 = Mats. Es uzbrūku tavam karalim, un tas nevar aizbēgt.
ann.mate.coach.b1.3 = Baidos, ka tas ir mats. Tavs karalis nevar izbēgt.
ann.mate.coach = Mats.
ann.mate.coach.2 = Un tas ir mats.
ann.mate.coach.3 = Mats, diemžēl.

# ---- Verdicts (the first sentence about a bad move) --------------------------------------------
ex.verdict.blunder.b1 = Ups! Ar šo gājienu tu kaut ko atdod.
ex.verdict.blunder.b1.2 = Uzmanīgi! Šis gājiens tev var dārgi maksāt.
ex.verdict.blunder.b1.3 = Ak, pagaidi. Ar šo gājienu kaut kas nav kārtībā.
ex.verdict.blunder.b2 = Hmm, ar šo gājienu ir problēma.
ex.verdict.blunder.b2.2 = Tā ir liela kļūda.
ex.verdict.blunder.b2.3 = Uzmanīgi, šis gājiens tev kaut ko maksā.
ex.verdict.blunder.b3 = Tā ir rupja kļūda.
ex.verdict.blunder.b3.2 = {move} ir īsta kļūda.
ex.verdict.blunder.b3.3 = Ai, {move} ir liela kļūda.
ex.verdict.blunder.b4 = {move} ir rupja kļūda.
ex.verdict.blunder.b4.2 = {move} ir nopietna kļūda.
ex.verdict.blunder.b4.3 = Diemžēl tā ir rupja kļūda.
ex.verdict.blunder.b5 = {move} ir nopietna kļūda.
ex.verdict.blunder.b5.2 = {move} ir rupja kļūda.
ex.verdict.blunder.b5.3 = {move} ir dārga kļūda.
ex.verdict.blunder.b6 = {move} ir smaga kļūda.
ex.verdict.blunder.b6.2 = {move} ir rupja kļūda.
ex.verdict.blunder.b6.3 = {move}? Rupja kļūda.
# A blunder that leaves the coach's threat standing (levels 1-2: the threat the engine found after the
# coach's last move is what the reply carries out). "Draudi" (threat) is plural only.
ex.verdict.ignored.b1 = Ups! Tu neatbildēji uz maniem draudiem.
ex.verdict.ignored.b1.2 = Uzmanīgi! Mani draudi vēl bija spēkā.
ex.verdict.ignored.b1.3 = Ak, pagaidi. Tu aizmirsi par maniem draudiem.
ex.verdict.ignored.b2 = Hmm, mani draudi vēl bija spēkā.
ex.verdict.ignored.b2.2 = Tu atstāji manus draudus bez atbildes.
ex.verdict.ignored.b2.3 = Uzmanīgi, tu neatbildēji uz maniem draudiem.
ex.verdict.mistake.b3 = Tas nav labs gājiens.
ex.verdict.mistake.b3.2 = Hmm, ar gājienu {move} kaut kas nav kārtībā.
ex.verdict.mistake.b3.3 = Tā ir kļūda.
ex.verdict.mistake.b4 = {move} ir kļūda.
ex.verdict.mistake.b4.2 = {move} nav labs gājiens.
ex.verdict.mistake.b4.3 = Tā ir kļūda.
ex.verdict.mistake.b5 = {move} ir acīmredzama kļūda.
ex.verdict.mistake.b5.2 = {move} ir kļūda.
ex.verdict.mistake.b5.3 = {move} nav labs gājiens.
ex.verdict.mistake.b6 = {move} ir kļūda.
ex.verdict.mistake.b6.2 = {move}? Kļūda.
ex.verdict.mistake.b6.3 = Ne {move}.
# A dubious move (an inaccuracy; a costly move with nothing concrete to show while still better):
# only the better move is named ({best} is pointed at), never a scenario. A move is "gājiens"
# (masculine): "{best} bija labāks".
ex.verdict.inaccuracy.b3 = Nav slikti, bet {best} bija mazliet labāks.
ex.verdict.inaccuracy.b3.2 = {best} bija nedaudz precīzāks.
ex.verdict.inaccuracy.b3.3 = Neliels misēklis: šeit labāks bija {best}.
ex.verdict.inaccuracy.b4 = Neprecīzi: {best} bija precīzāks.
ex.verdict.inaccuracy.b4.2 = Neliela neprecizitāte. {best} bija mazliet labāks.
ex.verdict.inaccuracy.b4.3 = Ne gluži labākais: {best} bija precīzāks.
ex.verdict.inaccuracy.b5 = {move} ir neprecīzs; {best} bija spēcīgāks.
ex.verdict.inaccuracy.b5.2 = Nedaudz neprecīzi. Es būtu spēlējis {best}.
ex.verdict.inaccuracy.b5.3 = {best} bija precīzāks par {move}.
ex.verdict.inaccuracy.b6 = {move} ir neprecīzs; {best}.
ex.verdict.inaccuracy.b6.2 = Neprecīzi. {best}.
ex.verdict.inaccuracy.b6.3 = {best} bija labāks.
# Level 6, an inaccuracy at the bottom of its class (deeper searches often clear it): a hedged word.
ex.verdict.inaccuracy.maybe = Iespējams, {best} bija mazliet precīzāks.
ex.verdict.inaccuracy.maybe.2 = Es varbūt būtu spēlējis {best}.
# A dubious move that loses material (levels 3-6): the remark alone, never "a bit better" (at level 6
# under 6 points, the hedged word above unless a piece is lost).
ex.verdict.dubious = Šis gājiens izskatās apšaubāms.
ex.verdict.dubious.2 = Šis gājiens šķiet apšaubāms.
# Something good was missed (levels 1-2).
ex.verdict.missed.b1 = Ak, pagaidi! Tu palaidi garām kaut ko labu.
ex.verdict.missed.b1.2 = Paskaties vēlreiz! Bija kaut kas labāks.
ex.verdict.missed.b1.3 = Pagaidi, tev tur bija iespēja!
ex.verdict.missed.b2 = Tu tur palaidi garām iespēju.
ex.verdict.missed.b2.2 = Hmm, bija kaut kas labāks.
ex.verdict.missed.b2.3 = Pagaidi, tev tur bija lielisks gājiens.

# ---- The better move (levels 3-6; {best} is pointed at) ----------------------------------------
# {line} (level 5) holds the moves that follow {best}, not {best} itself.
ex.better.b3 = Labāk bija {best}.
ex.better.b3.2 = Labāks gājiens bija {best}.
ex.better.b3.3 = Tā vietā labs gājiens bija {best}.
ex.better.b4 = {best} bija spēcīgāks.
ex.better.b4.2 = Pareizais gājiens bija {best}.
ex.better.b4.3 = Labāk bija {best}.
ex.better.b5 = {best} ar ideju {line}.
ex.better.b5.2 = Vajadzēja spēlēt {best}: {line}.
ex.better.b5.3 = Labāk bija {best}, un tālāk {line}.
ex.better.b6 = {best}: {eval}.
ex.better.b6.2 = Tā vietā {best}, {eval}.
ex.better.b6.3 = Pēc {best} būtu {eval}.

# ---- A blunder without a reason the coach can give reliably --------------------------------------
# The piece that had the better move ({your}, pointed at), said before the takeback offer; the move
# itself is not named. ex.hint.move: the same without the piece.
ex.hint.b1 = Ar {your:acc} bija labāks gājiens.
ex.hint.b1.2 = {your:dat} bija labāks gājiens.
ex.hint.b2 = {your:dat} bija labāks gājiens.
ex.hint.b2.2 = Ar {your:acc} bija labāks gājiens.
ex.hint.b3 = {your:dat} bija labāks gājiens.
ex.hint.b3.2 = Ar {your:acc} bija kaut kas labāks.
ex.hint.b4 = {your:dat} bija labāks gājiens.
ex.hint.b4.2 = Paskaties vēlreiz uz {your:refl_acc}: {your:pron_dat} bija kaut kas labāks.
ex.hint.b5 = {your:dat} bija spēcīgāks gājiens.
ex.hint.b5.2 = Ar {your:acc} bija spēcīgāks gājiens.
ex.hint.b6 = {your:dat} bija kas labāks.
ex.hint.b6.2 = Paskaties vēlreiz uz {your:refl_acc}.
ex.hint.move = Bija labāks gājiens.
ex.hint.move.2 = Tev tur bija labāks gājiens.
# The same when the better move plainly wins material for good (the move played wins and loses
# none); the move is still not named.
ex.hint.gain.b1 = {your:dat} bija labāks gājiens. Tas iegūst materiālu.
ex.hint.gain.b1.2 = Ar {your:acc} bija labāks gājiens. Tas iegūst materiālu.
ex.hint.gain.b2 = {your:dat} bija labāks gājiens. Tas iegūst materiālu.
ex.hint.gain.b2.2 = Ar {your:acc} bija gājiens, kas iegūst materiālu.
ex.hint.gain.b3 = {your:dat} bija labāks gājiens, kas iegūst materiālu.
ex.hint.gain.b3.2 = Ar {your:acc} bija gājiens, kas iegūst materiālu.
ex.hint.gain.b4 = {your:dat} bija gājiens, kas iegūst materiālu.
ex.hint.gain.b4.2 = Paskaties vēlreiz uz {your:refl_acc}: {your:pron_dat} bija gājiens, kas iegūst materiālu.
ex.hint.gain.b5 = {your:dat} bija spēcīgāks gājiens, kas iegūst materiālu.
ex.hint.gain.b5.2 = Ar {your:acc} bija gājiens, kas iegūst materiālu.
ex.hint.gain.b6 = {your:dat} bija gājiens, kas iegūst materiālu.
ex.hint.gain.b6.2 = Paskaties vēlreiz uz {your:refl_acc}: varēja iegūt materiālu.
# Levels 1-2: the better move as the piece and its square, said when the offer is declined (or
# when none can be made); levels 3-6 say ex.better.
ex.reveal.b1 = Labāk bija iet ar {your:acc} uz {sq}.
ex.reveal.b1.2 = {your} varēja iet uz {sq}. Tā būtu labāk.
ex.reveal.b2 = Gājiens ar {your:acc} uz {sq} bija labāks.
ex.reveal.b2.2 = Labāk bija iet ar {your:acc} uz {sq}.

# ---- Putting the demonstration back (levels 1-4; silent from level 5) --------------------------
