ex.hanging.b4.2 = {reply} zgarnia {your:acc} za darmo.
ex.hanging.b4.3 = {your} nie ma obrony; {reply} {your:pron_acc} bije.
ex.hanging.b5 = {move} zostawia {your:acc} bez obrony; {reply} {your:pron_acc} wygrywa.
ex.hanging.b5.2 = {your} na {sq} pada po {reply}.
ex.hanging.b5.3 = {reply} wygrywa {your:acc}.
ex.hanging.b6 = {move}? {reply} i {your} pada.
ex.hanging.b6.2 = {reply} wygrywa {your:acc}.
ex.hanging.b6.3 = {your} wisi: {reply}.
# Removal of the guard ({your2} = the piece that moved away, {your} = the piece it protected).
ex.hanging_guard.b1 = {your2} bronił{your2:a} {your:gen}. Teraz {my} może {your:pron_acc} zbić.
ex.hanging_guard.b1.2 = {your2} odchodzi i {your} zostaje sam{your:a}. {my} {your:pron_acc} bije.
ex.hanging_guard.b2 = {your2} bronił{your2:a} {your:gen}. Teraz {your} jest sam{your:a} i {my} {your:pron_acc} bije.
ex.hanging_guard.b2.2 = Ruch {your2:ins} zostawił {your:acc} bez obrony przed {my:ins}.
ex.hanging_guard.b3 = {your2} pilnował{your2:a} {your:gen}. Gdy {your2:pron} odchodzi, {reply} wygrywa {your:acc}.
ex.hanging_guard.b3.2 = Bez {your2:gen} {your} nie ma obrony: {reply}.
ex.hanging_guard.b4 = {move} usuwa obrońcę: {your2} zostawia {your:acc}, a {reply} {your:pron_acc} zgarnia.
ex.hanging_guard.b4.2 = {your2} {your2:was} jedynym obrońcą {your:gen}; {reply} {your:pron_acc} wygrywa.
# The coach's threat was not seen (levels 1-3; {my} = the attacker, {your} = the target).
ex.hanging_threat.b1 = {my} już atakował{my:a} {your:acc}. Zawsze sprawdzaj, czym grozi mój ruch.
ex.hanging_threat.b1.2 = Moja groźba umknęła ci uwadze: {my} atakuje {your:acc}.
ex.hanging_threat.b2 = Moim ostatnim ruchem zaatakowałem {your:acc} {my:refl_ins}. Zawsze patrz na moje groźby.
ex.hanging_threat.b2.2 = {my} groził{my:a} {your:dat}, a teraz mogę {your:pron_acc} zbić.
ex.hanging_threat.b3 = Przeoczona groźba: {my} atakował{my:a} {your:acc}.
ex.hanging_threat.b3.2 = {my} przez cały czas miał{my:a} {your:acc} na celowniku.
ex.hanging.tip.b1 = Przed każdym ruchem zadaj sobie pytanie: „Czy wszystkie moje bierki są bezpieczne?”
ex.hanging.tip.b1.2 = Dobry nawyk: po każdym ruchu sprawdzaj, które z twoich bierek są bronione.

# ---- 11. Exchange going wrong -------------------------------------------------------------------
# A bad capture ({your} pointed at; b1 b2 also {my}; b3-b6 also {sq}); {n} = your piece's points,
# {n2} = what it captured.
ex.exchange_capture.b1 = {your} bije, ale {my} odbija. Na tej wymianie tracisz punkty.
ex.exchange_capture.b1.2 = {my} odbija. {your} jest wart{your:a} {n:point_acc}, a dostajesz tylko {n2:point_acc}.
ex.exchange_capture.b1.3 = Uwaga: {my} może odbić {your:acc}. To zła wymiana.
ex.exchange_capture.b2 = Uważaj na wymiany: {your} jest wart{your:a} {n:point_acc}. {my} odbija, a ty dostajesz tylko {n2:point_acc}.
ex.exchange_capture.b2.2 = {my} odbija {your:acc}. Tracisz {n:point_acc}, a zyskujesz tylko {n2:point_acc}.
ex.exchange_capture.b3 = Bicie na {sq} nie wychodzi: {your} przepada po {line}.
ex.exchange_capture.b3.2 = {your} bije na {sq}, ale po {line} tracisz {pts:point_acc}.
ex.exchange_capture.b4 = {move} to błąd w rachunku na {sq}: {line} i {your} przepada.
ex.exchange_capture.b4.2 = Bicie na {sq} kosztuje {your:acc}: {line}.
ex.exchange_capture.b5 = {move} traci {your:acc} w wymianach na {sq}: {line}.
ex.exchange_capture.b5.2 = Na {sq} przepada {your}: {line}.
ex.exchange_capture.b6 = {move} traci {your:acc} na {sq} po {line}.
ex.exchange_capture.b6.2 = {line} na {sq} i {your} przepada.
# Counting attackers and defenders ({sq} pointed at); {n} = my attackers, {n2} = your defenders.
ex.exchange_count.b1 = Policz: atakuję pole {sq} {n:time}, a ty bronisz go {n2:time}.
ex.exchange_count.b1.2 = Na {sq} mam {n:attacker_acc}, a ty masz {n2:defender_acc}. Ta wymiana jest moja.
ex.exchange_count.b2 = Pole {sq} jest atakowane {n:time}, a bronione {n2:time}. Tam stracisz materiał.
ex.exchange_count.b2.2 = Policz na {sq}: {n:attacker} przeciw {n2:defender_dat}.
ex.exchange_count.b3 = Policz bierki atakujące i broniące pole {sq}: moich jest więcej.
ex.exchange_count.b3.2 = Wymiana na {sq} nie wychodzi: po {line} tracisz {pts:point_acc}.
ex.exchange_count.b4 = {move} to błąd w rachunku na {sq}: {line} i tracisz {pts:point_acc}.
ex.exchange_count.b4.2 = Pole {sq} jest atakowane częściej niż bronione: {line}.
ex.exchange_count.b5 = Na {sq} {n:attacker} przeciw {n2:defender_dat}: {line}.
ex.exchange_count.b5.2 = {move} – błąd w rachunku na {sq}.
ex.exchange_count.b6 = {line} na {sq} i wygrałem {pts:point_acc}.
ex.exchange_count.b6.2 = {sq}: {n} przeciw {n2:dat}.
# A cheaper piece attacks ({your} pointed at; b1 b2 also {my}; b3-b6 also {sq}); {n} = your piece,
# {n2} = my attacker.
ex.exchange_cheap.b1 = {my} jest wart{my:a} mniej niż {your}. Jeśli zbiję, stracisz punkty.
ex.exchange_cheap.b1.2 = {my} atakuje {your:acc}. Taka wymiana jest dla ciebie zła.
ex.exchange_cheap.b2 = {your} jest wart{your:a} {n:point_acc}, a {my} tylko {n2:point_acc}. Ta wymiana jest dla ciebie niekorzystna.
ex.exchange_cheap.b2.2 = {my} jest tańsz{my:y} niż {your}, więc atak wygrywa materiał.
ex.exchange_cheap.b3 = Tańsza bierka atakuje {your:acc} na {sq}.
ex.exchange_cheap.b3.2 = Bierka warta {n2:point_acc} atakuje {your:acc} na {sq}: {line}.
ex.exchange_cheap.b4 = Tańsza bierka atakuje {your:acc} na {sq}; {reply} wygrywa materiał.
ex.exchange_cheap.b4.2 = {reply} uderza tańszą bierką w {your:acc} na {sq}.
ex.exchange_cheap.b5 = {your} na {sq} jest celem tańszej bierki: {line}.
ex.exchange_cheap.b5.2 = {reply} wygrywa materiał na {sq} kosztem {your:gen}.
ex.exchange_cheap.b6 = {reply} wygrywa {your:acc} na {sq}.
ex.exchange_cheap.b6.2 = {line}: {your} na {sq} przepada.

