ex.verdict.blunder.b1.2 = Uwaga! Na tym ruchu możesz stracić.
ex.verdict.blunder.b1.3 = Oj, chwileczkę. Z tym ruchem jest kłopot.
ex.verdict.blunder.b2 = Hmm, z tym ruchem jest problem.
ex.verdict.blunder.b2.2 = To duży błąd.
ex.verdict.blunder.b2.3 = Uwaga, na tym ruchu coś tracisz.
ex.verdict.blunder.b3 = To poważny błąd.
ex.verdict.blunder.b3.2 = {move} to prawdziwy błąd.
ex.verdict.blunder.b3.3 = Auć, {move} to duży błąd.
ex.verdict.blunder.b4 = {move} to poważny błąd.
ex.verdict.blunder.b4.2 = {move} to ciężki błąd.
ex.verdict.blunder.b4.3 = Niestety, to poważny błąd.
ex.verdict.blunder.b5 = {move} to ciężki błąd.
ex.verdict.blunder.b5.2 = {move} to poważny błąd.
ex.verdict.blunder.b5.3 = {move} to kosztowny błąd.
ex.verdict.blunder.b6 = {move} to ciężki błąd.
ex.verdict.blunder.b6.2 = {move} to poważny błąd.
ex.verdict.blunder.b6.3 = {move}? Poważny błąd.
# A blunder that leaves the coach's threat standing (levels 1-2: the threat the engine found after the
# coach's last move is what the reply carries out).
ex.verdict.ignored.b1 = Ojej! Moja groźba została bez odpowiedzi.
ex.verdict.ignored.b1.2 = Uwaga! Moja groźba wciąż była aktualna.
ex.verdict.ignored.b1.3 = Oj, chwileczkę. A co z moją groźbą?
ex.verdict.ignored.b2 = Hmm, moja groźba wciąż była aktualna.
ex.verdict.ignored.b2.2 = Moja groźba została bez odpowiedzi.
ex.verdict.ignored.b2.3 = Uwaga, na moją groźbę trzeba było odpowiedzieć.
ex.verdict.mistake.b3 = To nie jest dobry ruch.
ex.verdict.mistake.b3.2 = Hmm, z ruchem {move} jest problem.
ex.verdict.mistake.b3.3 = To błąd.
ex.verdict.mistake.b4 = {move} to błąd.
ex.verdict.mistake.b4.2 = Ruch {move} nie jest dobry.
ex.verdict.mistake.b4.3 = To błąd.
ex.verdict.mistake.b5 = {move} to wyraźny błąd.
ex.verdict.mistake.b5.2 = {move} to błąd.
ex.verdict.mistake.b5.3 = Ruch {move} nie jest dobry.
ex.verdict.mistake.b6 = {move} to błąd.
ex.verdict.mistake.b6.2 = {move}? Błąd.
ex.verdict.mistake.b6.3 = Nie {move}.
# A dubious move (an inaccuracy; a costly move with nothing concrete to show while still better):
# only the better move is named ({best} is pointed at), never a scenario.
ex.verdict.inaccuracy.b3 = Nieźle, ale ruch {best} był trochę lepszy.
ex.verdict.inaccuracy.b3.2 = Ruch {best} był odrobinę dokładniejszy.
ex.verdict.inaccuracy.b3.3 = Drobne potknięcie: tu lepszy był ruch {best}.
ex.verdict.inaccuracy.b4 = Niedokładnie: dokładniejszy był ruch {best}.
ex.verdict.inaccuracy.b4.2 = Mała niedokładność. Ruch {best} był trochę lepszy.
ex.verdict.inaccuracy.b4.3 = Nie do końca najlepszy ruch: {best} był dokładniejszy.
ex.verdict.inaccuracy.b5 = Ruch {move} jest niedokładny; silniejszy był {best}.
ex.verdict.inaccuracy.b5.2 = Trochę niedokładnie. Ja zagrałbym {best}.
ex.verdict.inaccuracy.b5.3 = Ruch {best} był dokładniejszy niż {move}.
ex.verdict.inaccuracy.b6 = {move} – niedokładnie; {best}.
ex.verdict.inaccuracy.b6.2 = Niedokładnie. {best}.
ex.verdict.inaccuracy.b6.3 = Lepszy był {best}.
# Level 6, an inaccuracy at the bottom of its class (deeper searches often clear it): a hedged word.
ex.verdict.inaccuracy.maybe = Możliwe, że ruch {best} był odrobinę dokładniejszy.
ex.verdict.inaccuracy.maybe.2 = Może zagrałbym {best}.
# A dubious move that loses material (levels 3-6): the remark alone, never "a bit better" (at level 6
# under 6 points, the hedged word above unless a piece is lost).
ex.verdict.dubious = Ten ruch wygląda wątpliwie.
ex.verdict.dubious.2 = Ten ruch wydaje się wątpliwy.
# Something good was missed (levels 1-2).
ex.verdict.missed.b1 = Oj, zaczekaj! Umknęło ci coś dobrego.
ex.verdict.missed.b1.2 = Spójrz jeszcze raz! Było coś lepszego.
ex.verdict.missed.b1.3 = Zaczekaj, tu była dla ciebie szansa!
ex.verdict.missed.b2 = Tu umknęła ci okazja.
ex.verdict.missed.b2.2 = Hmm, było coś lepszego.
ex.verdict.missed.b2.3 = Zaczekaj, tu był świetny ruch.

# ---- The better move (levels 3-6; {best} is pointed at) ----------------------------------------
