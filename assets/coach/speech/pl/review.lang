# ---- 3. Stalemate ({my} = the coach's king, pointed at) ----------------------------------------
ex.stalemate.b1 = O nie! {my} nie może się ruszyć i nie ma szacha. To pat, czyli remis.
ex.stalemate.b1.2 = Popatrz: {my} nie ma bezpiecznego pola, ale nie ma też szacha. Remis!
ex.stalemate.b1.3 = To pat. {my} nie może się ruszyć, więc partia kończy się remisem.
ex.stalemate.b2 = Pat! {my} nie ma żadnego dozwolonego ruchu, a szacha nie ma. Remis.
ex.stalemate.b2.2 = O nie, pat: {my} utkn{my:al}, ale nie ma szacha.
ex.stalemate.b2.3 = To remis przez pata. {my} nie może się ruszyć.
ex.stalemate.b3 = To pat: {my} nie ma dozwolonego ruchu. A pozycja była wygrana!
ex.stalemate.b3.2 = Pat! {my} utkn{my:al} i wygrana partia kończy się remisem.
ex.stalemate.b3.3 = {my} nie ma ruchu, a szacha nie ma: pat.
ex.stalemate.b4 = Pat: {my} nie ma dozwolonego ruchu. Wygrana przepada.
ex.stalemate.b4.2 = Po {move} {my} jest w pacie. Remis w wygranej pozycji.
ex.stalemate.b4.3 = To pat; {my} jest w potrzasku.
ex.stalemate.b5 = Po {move} {my} jest w pacie. Wygrana przepadła.
ex.stalemate.b5.2 = Pat: {my} nie ma pól.
ex.stalemate.b5.3 = To pat, {my} utkn{my:al}.
ex.stalemate.b6 = Pat. {my} nie ma ruchów.
ex.stalemate.b6.2 = {move}, pat: {my} w potrzasku.
ex.stalemate.b6.3 = Pat; {my} nie może się ruszyć.
ex.stalemate.tip.b1 = Kiedy wygrywasz, zawsze zostaw mojemu królowi wolne pole.
ex.stalemate.tip.b1.2 = Pamiętaj: kiedy masz przewagę, daj mojemu królowi trochę miejsca.
# The coach can reach stalemate on purpose along the line.
ex.stalemate_trick.b1 = Uwaga! Mogę oddać swoje bierki, a wtedy {my} zostaje bez ruchu: pat.
ex.stalemate_trick.b1.2 = Uważaj: {my} prawie nie może się ruszyć. Mogę doprowadzić do remisu.
ex.stalemate_trick.b2 = Uwaga: mogę coś poświęcić i {my} będzie w pacie.
ex.stalemate_trick.b2.2 = {my} nie ma prawie żadnych pól. Mogę wymusić pata!
ex.stalemate_trick.b3 = To pozwala mi uratować się patem: {my} nie ma już ruchów.
ex.stalemate_trick.b3.2 = Uwaga: {my} jest w pacie po {line}.
ex.stalemate_trick.b4 = {move} pozwala na pułapkę patową: {line} i {my} nie może się ruszyć.
ex.stalemate_trick.b4.2 = Teraz {my} może się schować w pacie: {line}.
ex.stalemate_trick.b5 = {move} dopuszcza pata: {line}; {my} jest w potrzasku.
ex.stalemate_trick.b5.2 = Pułapka patowa: {line} i {my} nie ma ruchów.
ex.stalemate_trick.b6 = {line}, pat: {my} w potrzasku.
ex.stalemate_trick.b6.2 = Pat po {line}; {my} bez ruchu.
