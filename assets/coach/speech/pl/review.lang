ex.better.b3 = Lepszy był ruch {best}.
ex.better.b3.2 = Ruch {best} był lepszy.
ex.better.b3.3 = Zamiast tego dobry był ruch {best}.
ex.better.b4 = Silniejszy był ruch {best}.
ex.better.b4.2 = Właściwy był ruch {best}.
ex.better.b4.3 = Lepszy był ruch {best}.
ex.better.b5 = {best}, z ideą {line}.
ex.better.b5.2 = Należało zagrać {best}: {line}.
ex.better.b5.3 = Lepszy był ruch {best}, a potem {line}.
ex.better.b6 = {best}: {eval}.
ex.better.b6.2 = Zamiast tego {best}, {eval}.
ex.better.b6.3 = Po {best}: {eval}.

