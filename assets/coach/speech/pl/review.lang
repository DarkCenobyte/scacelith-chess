demo.my.first.check_move.2 = {my} idzie na {sq}: najpierw szach! {t1} nigdzie nie ucieknie.
demo.my.first.move = Najpierw {my} idzie na {sq}. {t1} poczeka.
demo.my.first.move.2 = Najpierw {my} na {sq}. {t1} nigdzie nie ucieknie.
