demo.my.move = {my} idzie na {sq}.
demo.my.move.2 = Idę {my:bare_ins} na {sq}.
demo.my.move.3 = Potem {my} przechodzi na {sq}.
demo.my.take = Biję {your:acc}.
demo.my.take.2 = {my} bije {your:acc}.
demo.my.take.3 = I zbijam {your:acc}.
demo.my.check = {my} idzie na {sq}. Szach.
demo.my.check.2 = Szach: {my} na {sq}.
demo.my.check.3 = {my} na {sq}, szach!
demo.my.mate = {my} idzie na {sq}. Mat.
demo.my.mate.2 = I {my} na {sq} daje mata.
demo.my.mate.3 = {my} na {sq}. To mat.
# Levels 1-3, the coach's in-between move: a capture, a check or a quiet move played first while a
# bigger piece of the player's ({t1}) is attacked; the next move of the coach's takes it.
demo.my.first.take = Najpierw {my} bije {your:acc}. {t1} poczeka.
demo.my.first.take.2 = {my} najpierw bije {your:acc}. {t1} nigdzie nie ucieknie.
demo.my.first.check = {my} bije {your:acc} i jest szach! {t1} poczeka.
