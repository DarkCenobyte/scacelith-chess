# ---- Squares, files and ranks (spoken) -----------------------------------------------------------
# Written squares are always "e4". The voice says the Polish letter name, then the rank as a
# cardinal number, as Polish players read a square: "e cztery", "ef trzy", "gie pięć", "ha siedem".
square.spoken = {file} {rank}
# The letter a alone melts into the word before it ("na a sześć" heard "na sześć", "ruch a trzy" "rucha
# trzy"): a long `aa` was heard as the a-file 22 times in 30, the plain "a" 12 (docs/PRONUNCIATION.md).
file.a.spoken = aa
file.b.spoken = be
file.c.spoken = ce
file.d.spoken = de
file.e.spoken = e
file.f.spoken = ef
file.g.spoken = gie
file.h.spoken = ha
rank.1.spoken = jeden
rank.2.spoken = dwa
rank.3.spoken = trzy
rank.4.spoken = cztery
rank.5.spoken = pięć
rank.6.spoken = sześć
rank.7.spoken = siedem
rank.8.spoken = osiem

# ---- Moves ---------------------------------------------------------------------------------------
# Polish notation letters: K(ról) H(etman) W(ieża) G(oniec) S(koczek): "Sf3", "Wad1", "Kxe2".
move.letters = K H W G S
# Spoken as Polish players read notation: "skoczek ef trzy", "skoczek bije na e pięć", "skoczek be de
# siedem", "e bije na de pięć", "pionek odbija" (a recapture), "krótka roszada", "długa roszada",
# "hetman gie cztery, szach". {piece} is always the nominative here, so the promoted piece follows a
# colon ("e osiem, promocja: hetman"): "promocja na" would need the accusative ("na hetmana").
move.piece.spoken = {piece} {to}
move.piece_capture.spoken = {piece} bije na {to}
move.piece_from.spoken = {piece} {from} {to}
move.piece_from_capture.spoken = {piece} {from} bije na {to}
move.pawn.spoken = {to}
move.pawn_capture.spoken = {file} bije na {to}
move.recapture.spoken = {piece} odbija
move.castle_short.spoken = krótka roszada
move.castle_long.spoken = długa roszada
move.promotion.spoken = {move}, promocja: {piece}
move.check.spoken = {move}, szach
move.mate.spoken = {move}, mat
moves.join.spoken = {a}, {b}

# ---- Respellings (spoken) ------------------------------------------------------------------------
# Words the voice misreads (docs/PRONUNCIATION.md, Polish). Polish says "bicie w przelocie", not "en
# passant". The voice reads foreign names letter by letter as Polish: they are spelled as Polish
# players say them. Italian ch = k (it said "fiancetto"):
respell.fianchetto = fianketto
respell.fianchetta = fianketta
respell.fianchettem = fiankettem
