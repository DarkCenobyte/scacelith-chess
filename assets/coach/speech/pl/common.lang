# Accuracy in percent: written "85%" (assets/i18n/pl.lang number.percent), spoken "osiemdziesiąt
# pięć procent" ("procent" stays the same after every number: "jeden procent", "dwa procent").
count.percent = {n}%|{n}%|{n}%
count.percent.spoken = {n} procent|{n} procent|{n} procent
# A move number as an ordinal with "ruch": written "21. ruch", spoken "dwudziesty pierwszy ruch".
# "{n:nth_move}" nominative / accusative ("{n:nth_move} był kluczowy"), "{n:nth_move_gen}" ("do
# {n:nth_move_gen}" = "do 21. ruchu"), "{n:nth_move_loc}" ("w {n:nth_move_loc}" = "w 21. ruchu", "po
# 21. ruchu"), "{n:nth_move_ins}" ("przed 21. ruchem"). Never put a piece placeholder right after the
# written ordinal: the full stop would capitalise it.
count.nth_move = {n}. ruch|{n}. ruch|{n}. ruch
count.nth_move.spoken = {n:ord} ruch|{n:ord} ruch|{n:ord} ruch
count.nth_move_gen = {n}. ruchu|{n}. ruchu|{n}. ruchu
count.nth_move_gen.spoken = {n:ord_gen} ruchu|{n:ord_gen} ruchu|{n:ord_gen} ruchu
count.nth_move_loc = {n}. ruchu|{n}. ruchu|{n}. ruchu
count.nth_move_loc.spoken = {n:ord_loc} ruchu|{n:ord_loc} ruchu|{n:ord_loc} ruchu
count.nth_move_ins = {n}. ruchem|{n}. ruchem|{n}. ruchem
count.nth_move_ins.spoken = {n:ord_loc} ruchem|{n:ord_loc} ruchem|{n:ord_loc} ruchem
# Bare numbers in a case or gender ("{n:gen}", "{n:f}" ...): count keys, so that each plural slot
# takes the right word ("jedna", but "dwadzieścia jeden"). The ordinals alone: written "21.".
count.f = {n:f}|{n:f}|{n}
count.neut = {n:neut}|{n}|{n}
count.acc_f = {n:acc_f}|{n:f}|{n}
count.acc_anim = {n:acc_anim}|{n}|{n}
count.gen = {n:gen}|{n:gen}|{n:gen}
count.gen_f = {n:gen_f}|{n:gen}|{n:gen}
count.dat = {n:dat}|{n:dat}|{n:dat}
count.dat_f = {n:dat_f}|{n:dat}|{n:dat}
count.ins = {n:ins}|{n:ins}|{n:ins}
count.ins_f = {n:ins_f}|{n:ins_f}|{n:ins}
count.loc = {n:loc}|{n:loc}|{n:loc}
count.loc_f = {n:loc_f}|{n:loc}|{n:loc}
count.ord = {n}.|{n}.|{n}.
count.ord.spoken = {n:ord}|{n:ord}|{n:ord}
count.ord_gen = {n}.|{n}.|{n}.
count.ord_gen.spoken = {n:ord_gen}|{n:ord_gen}|{n:ord_gen}
count.ord_loc = {n}.|{n}.|{n}.
count.ord_loc.spoken = {n:ord_loc}|{n:ord_loc}|{n:ord_loc}

# ---- Evaluations (the strongest levels) ------------------------------------------------------------
# From the listener's point of view. {x} = pawns with one decimal (number.decimal), {n} = moves (a
# bare number here: count keys do not apply, so the number is said in the locative, "mat w trzech",
# "mat w jednym", the short form Polish players use; the subtitles say "mat w 3").
eval.up = +{x}
eval.up.spoken = plus {x}
eval.down = −{x}
eval.down.spoken = minus {x}
eval.even = 0,0
eval.even.spoken = równowaga
eval.mate_win = mat w {n:loc}
eval.mate_loss = dostajesz mata w {n:loc}

# ---- Phases of the game (appraisal.lang) ---------------------------------------------------------
# appraisal.phase.* (nominative, in appraisal.lang): debiut (m), gra środkowa (f), końcówka (f). Their
# cases, "{text:loc}" = "w debiucie / w grze środkowej / w końcówce", "{text:gen}", "{text:acc}" ...
# The genders differ: no verb or adjective should agree with {text} ("najlepsza faza: {text}").
appraisal.phase.opening.gen = debiutu
appraisal.phase.opening.dat = debiutowi
appraisal.phase.opening.acc = debiut
appraisal.phase.opening.ins = debiutem
appraisal.phase.opening.loc = debiucie
appraisal.phase.middlegame.gen = gry środkowej
appraisal.phase.middlegame.dat = grze środkowej
appraisal.phase.middlegame.acc = grę środkową
appraisal.phase.middlegame.ins = grą środkową
appraisal.phase.middlegame.loc = grze środkowej
appraisal.phase.endgame.gen = końcówki
appraisal.phase.endgame.dat = końcówce
appraisal.phase.endgame.acc = końcówkę
appraisal.phase.endgame.ins = końcówką
appraisal.phase.endgame.loc = końcówce
