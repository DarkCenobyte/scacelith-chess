owner.your.ins.f = твоей {piece}
owner.your.pre.m = твоём {piece}
owner.your.pre.f = твоей {piece}
owner.my.nom.m = мой {piece}
owner.my.nom.f = моя {piece}
owner.my.acc.m = моего {piece}
