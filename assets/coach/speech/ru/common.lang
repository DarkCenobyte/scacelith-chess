# A decimal number: Russian writes a decimal comma ("1,3") and reads an engine evaluation digit by digit,
# "плюс один три", "плюс ноль пять" (not "ноль и пять", nor the bookish "одна целая три десятых").
number.decimal = {int},{frac}
number.decimal.spoken = {int} {frac}

# ---- Counted nouns ---------------------------------------------------------------------------------
# Russian plural rule (assets/i18n): one (1, 21, 31 ...) | few (2-4, 22-24 ...) | many (0, 5-20, 25 ...).
# Nominative (= accusative for the inanimate masculine and neuter nouns): a sentence needing another
# case ("после трёх ходов", "одну ошибку") will need its own count key (count.<noun>_gen ...), with
# number words in that case. Feminine nouns say their number with the form "f", neuter ones with "neut".
count.move = {n} ход|{n} хода|{n} ходов
count.point = {n:neut} очко|{n:neut} очка|{n:neut} очков
count.pawn = {n:f} пешка|{n:f} пешки|{n:f} пешек
count.piece = {n:f} фигура|{n:f} фигуры|{n:f} фигур
count.mistake = {n:f} ошибка|{n:f} ошибки|{n:f} ошибок
count.blunder = {n} зевок|{n} зевка|{n} зевков
count.inaccuracy = {n:f} неточность|{n:f} неточности|{n:f} неточностей
count.game = {n:f} партия|{n:f} партии|{n:f} партий
count.time = {n} раз|{n} раза|{n} раз
count.square = {n:neut} поле|{n:neut} поля|{n:neut} полей
# "{n:f}" / "{n:neut}" in a line say a bare number in the feminine / neuter ("одна", "одно"); they are
# count keys so that the same forms also work outside the counted nouns (and the form check knows them).
count.f = {n:f}|{n:f}|{n:f}
count.neut = {n:neut}|{n:neut}|{n:neut}
# "{n:mv}" = a number followed by "ход" in speech (number.<n>.mv.spoken below), digits alone in writing.
count.mv = {n:mv}|{n:mv}|{n:mv}

# ---- Evaluations (the strongest levels) ------------------------------------------------------------
# From the listener's point of view. {x} = pawns with one decimal (number.decimal), {n} = moves.
eval.up = +{x}
eval.up.spoken = плюс {x}
eval.down = −{x}
eval.down.spoken = минус {x}
eval.even = 0,0
eval.even.spoken = равенство
# {n} here is a bare number (count keys do not apply to it): the form "mv" says the number with the
# word "ход" in the right plural ("мат в три хода"); the subtitles keep the short "мат в 3".
eval.mate_win = мат в {n:mv}
eval.mate_loss = тебе мат в {n:mv}

