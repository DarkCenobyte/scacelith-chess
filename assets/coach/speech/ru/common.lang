piece.king.ins = королём
piece.king.pre = короле
piece.king.bare_ins = королём
piece.king.pron = он
piece.king.pron_acc = его
# Possessives: твой / твоя ... мой / моя ..., by case and gender.
owner.your.nom.m = твой {piece}
owner.your.nom.f = твоя {piece}
owner.your.acc.m = твоего {piece}
owner.your.acc.f = твою {piece}
owner.your.gen.m = твоего {piece}
owner.your.gen.f = твоей {piece}
owner.your.dat.m = твоему {piece}
owner.your.dat.f = твоей {piece}
