# Coach speech (Russian): the building blocks every line uses (src/coach/catalog.cpp renders them).
# Same keys as assets/coach/speech/en/common.lang, plus the grammatical forms Russian needs.
# Register: the coach says "ты" to the player (the game menus stay formal, "вы"). The coach is male
# ("я рад", "я показал"); the player's gender is unknown: no second-person past tense, no short
# adjectives or participles agreeing with the player ("готов", "сдался"): present or future tense,
# impersonal and noun phrases instead.

# ---- Pieces --------------------------------------------------------------------------------------
# Nouns: пешка (f), конь, слон, ладья (f), ферзь, король. In chess Russian конь, слон, ферзь and
# король are animate: accusative = genitive ("возьми моего коня", "отдать ферзя").
# Forms (every one defined for all six pieces and both owners):
#   nom       твой конь / твоя ладья            "{your} так не ходит."
#   acc       твоего коня / твою ладью           "Возьми {my:acc} ладьёй!"
#   gen       твоего коня / твоей ладьи          "прямо до {my:gen}", "у {my:gen} защиты нет"
#   dat       твоему коню / твоей ладье          (not used yet)
#   ins       твоим конём / твоей ладьёй          "рядом с {my:ins}"
#   pre       твоём коне / твоей ладье           (not used yet)
#   bare_ins  конём / ладьёй (no possessive)     "Ходи {your:bare_ins}." When the player is the
#             subject Russian says "своей ладьёй" or nothing, never "твоей ладьёй": use bare_ins.
#   pron      он / она (the piece as subject)    "Это {your}. {your:pron} ходит по диагонали."
#   pron_acc  его / её (object, also "its")      "Возьми {my:pron_acc}!", "на {my:pron_acc} поле"
#             (never after a preposition that needs "него/неё": rephrase instead)
# Past tenses, short adjectives and participles agree with the piece's gender: the lines avoid
# them with a piece placeholder as subject ("{my} покидает доску", "у {my:gen} защиты нет").
piece.pawn.gender = f
piece.knight.gender = m
piece.bishop.gender = m
piece.rook.gender = f
piece.queen.gender = m
piece.king.gender = m
piece.pawn.nom = пешка
piece.pawn.acc = пешку
piece.pawn.gen = пешки
piece.pawn.dat = пешке
piece.pawn.ins = пешкой
piece.pawn.pre = пешке
piece.pawn.bare_ins = пешкой
piece.pawn.pron = она
piece.pawn.pron_acc = её
piece.knight.nom = конь
piece.knight.acc = коня
piece.knight.gen = коня
piece.knight.dat = коню
piece.knight.ins = конём
piece.knight.pre = коне
piece.knight.bare_ins = конём
piece.knight.pron = он
piece.knight.pron_acc = его
piece.bishop.nom = слон
piece.bishop.acc = слона
piece.bishop.gen = слона
piece.bishop.dat = слону
piece.bishop.ins = слоном
piece.bishop.pre = слоне
piece.bishop.bare_ins = слоном
piece.bishop.pron = он
piece.bishop.pron_acc = его
piece.rook.nom = ладья
piece.rook.acc = ладью
piece.rook.gen = ладьи
