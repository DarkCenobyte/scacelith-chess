# ---- Moves ---------------------------------------------------------------------------------------
# Russian scoresheet letters: Кр(ороль) Ф(ерзь) Л(адья) С(лон) К(онь): "Кf3", "Лad1", "Кр:e2".
move.letters = Кр Ф Л С К
# Spoken as Russian players read notation: "конь эф три", "конь бьёт на е пять", "конь бэ дэ семь",
# "е бьёт на дэ пять", "пешка бьёт в ответ" (the opening texts' word for a recapture), "короткая
# рокировка", "ферзь жэ четыре, шах". {piece} is always the nominative here, so the promotion names
# the new piece after a colon ("превращение в" would need the accusative "в ферзя").
move.piece.spoken = {piece} {to}
move.piece_capture.spoken = {piece} бьёт на {to}
move.piece_from.spoken = {piece} {from} {to}
move.piece_from_capture.spoken = {piece} {from} бьёт на {to}
move.pawn.spoken = {to}
move.pawn_capture.spoken = {file} бьёт на {to}
move.recapture.spoken = {piece} бьёт в ответ
move.castle_short.spoken = короткая рокировка
move.castle_long.spoken = длинная рокировка
move.promotion.spoken = {move}, превращение: {piece}
move.check.spoken = {move}, шах
move.mate.spoken = {move}, мат
moves.join.spoken = {a}, {b}

