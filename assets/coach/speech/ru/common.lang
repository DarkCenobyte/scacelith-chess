# ---- Squares, files and ranks (spoken) -----------------------------------------------------------
# The voice drops Latin letters: file letters are Cyrillic letter names, as in the opening texts
# (tools/gen_opening_lang.py): e4 = "е четыре", f5 = "эф пять", a8 = "а восемь", h7 = "аш семь".
square.spoken = {file} {rank}
file.a.spoken = а
file.b.spoken = бэ
file.c.spoken = цэ
file.d.spoken = дэ
file.e.spoken = е
file.f.spoken = эф
file.g.spoken = жэ
file.h.spoken = аш
