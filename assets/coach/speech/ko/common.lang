# ---- Squares, files and ranks (spoken) -----------------------------------------------------------
# Written squares stay "e4". Spoken: the Korean names of the Latin letters, then the rank as a
# Sino-Korean number, as Korean players read coordinates: e4 = "이 사", f3 = "에프 삼", a8 = "에이 팔",
# h7 = "에이치 칠", c6 = "씨 육". A square ends in a varying sound: never write a particle after {sq},
# put it on the noun 칸 instead ("{sq} 칸으로", "{sq} 칸에", "{sq} 칸의 제 나이트").
square.spoken = {file} {rank}
file.a.spoken = 에이
file.b.spoken = 비
file.c.spoken = 씨
file.d.spoken = 디
file.e.spoken = 이
file.f.spoken = 에프
file.g.spoken = 지
file.h.spoken = 에이치
rank.1.spoken = 일
rank.2.spoken = 이
rank.3.spoken = 삼
rank.4.spoken = 사
rank.5.spoken = 오
rank.6.spoken = 육
rank.7.spoken = 칠
rank.8.spoken = 팔

# ---- Moves ---------------------------------------------------------------------------------------
# Korean scoresheets use the English letters K Q R B N (assets/i18n/ko.lang scoresheet.pieces).
move.letters = K Q R B N
# Spoken as Korean players read notation, without particles ({piece} is the bare noun, whose last
# sound varies): "나이트 에프 삼" (Nf3), "나이트 이 오 잡기" (Nxe5), "비 나이트 디 이" (Nbd2: the b-file
# knight), "이 폰 디 오 잡기" (exd5: the e-pawn), "폰 되잡기" (a recapture), "킹사이드 캐슬링",
# "이 팔, 퀸 프로모션" (e8=Q), "퀸 지 사, 체크". A move ends in a varying sound too: never attach a
# particle to {move} {best} {reply} {line}; write "{best}, 이 수가 더 좋았어요", "{line} 수순 뒤에".
move.piece.spoken = {piece} {to}
move.piece_capture.spoken = {piece} {to} 잡기
move.piece_from.spoken = {from} {piece} {to}
move.piece_from_capture.spoken = {from} {piece} {to} 잡기
move.pawn.spoken = {to}
move.pawn_capture.spoken = {file} 폰 {to} 잡기
move.recapture.spoken = {piece} 되잡기
move.castle_short.spoken = 킹사이드 캐슬링
move.castle_long.spoken = 퀸사이드 캐슬링
move.promotion.spoken = {move}, {piece} 프로모션
move.check.spoken = {move}, 체크
move.mate.spoken = {move}, 체크메이트
moves.join.spoken = {a}, {b}

