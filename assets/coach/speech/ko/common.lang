# A decimal number: {int} and {frac} (one digit); Korean writes a point and says 점: "일 점 삼",
# "영 점 오".
number.decimal = {int}.{frac}
number.decimal.spoken = {int} 점 {frac}

# ---- Counted nouns ---------------------------------------------------------------------------------
# Korean has a single form. Native counters (수 개 번 칸 판) say the number with the form "nat" in
# speech; Sino-Korean ones (점, 퍼센트, 수째) the plain number. Written: digits joined to the counter
# ("3수", "폰 2개", "85%"). A counted value ends in a fixed syllable, so a particle may follow the
# placeholder: V = vowel-final (가 는 를 와 로 예요), C = consonant-final (이 은 을 과 으로 이에요).
#   move V ("{m:move} 만에", "{n:move}를 무르셨어요"), point C, pawn V, piece V, mistake C, blunder C,
#   inaccuracy C, game C, time C, square C, position V; moveno V, percent V (spoken 퍼센트).
# Mistakes are counted as times (실수 두 번); a line may also write "실수를 {n:time} 했어요".
count.move = {n}수
count.move.spoken = {n:nat} 수
count.point = {n}점
count.point.spoken = {n} 점
count.pawn = 폰 {n}개
count.pawn.spoken = 폰 {n:nat} 개
count.piece = 기물 {n}개
count.piece.spoken = 기물 {n:nat} 개
count.mistake = 실수 {n}번
count.mistake.spoken = 실수 {n:nat} 번
count.blunder = 블런더 {n}번
count.blunder.spoken = 블런더 {n:nat} 번
count.inaccuracy = 부정확한 수 {n}번
count.inaccuracy.spoken = 부정확한 수 {n:nat} 번
count.game = {n}판
count.game.spoken = {n:nat} 판
count.time = {n}번
count.time.spoken = {n:nat} 번
count.square = {n}칸
count.square.spoken = {n:nat} 칸
count.position = 포지션 {n}개
count.position.spoken = 포지션 {n:nat} 개
# Korean additions, for the other coach files:
#   moveno   a move NUMBER, Sino-Korean: "{n:moveno}에" = "23수째에" ("이십삼 수째에"); "{n:move}" is a
#            count of moves ("세 수"), never a move number.
#   percent  an accuracy: "{acc:percent}" = "85%" / "팔십오 퍼센트".
#   nat      the bare native number, to put before another native counter (see Numbers).
count.moveno = {n}수째
count.moveno.spoken = {n} 수째
count.percent = {n}%
count.percent.spoken = {n} 퍼센트
count.nat = {n:nat}

# ---- Evaluations (the strongest levels) ------------------------------------------------------------
# From the listener's point of view. {x} = pawns with one decimal (number.decimal), {n} = moves.
# "플러스 일 점 삼", "균형" (level); mates count moves as Korean puzzle books write them: "3수 메이트"
# (spoken "세 수 메이트"), and "3수 뒤 메이트당함" when the listener gets mated. Never attach a
# particle to {eval}.
eval.up = +{x}
eval.up.spoken = 플러스 {x}
eval.down = −{x}
eval.down.spoken = 마이너스 {x}
eval.even = 0.0
eval.even.spoken = 균형
eval.mate_win = {n:move} 메이트
eval.mate_loss = {n:move} 뒤 메이트당함
