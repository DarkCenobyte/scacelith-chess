respell.giuoco = džuoko
respell.milesi = mailsi
respell.birdi = bördi
respell.breyer = braier
respell.breyeri = braieri
respell.parhami = paarami
respell.sämisch = sämiš
respell.sämischi = sämiši
respell.nimzo = nimtso
respell.nimzowitsch = nimtsovitš
respell.nimzowitschi = nimtsovitši

