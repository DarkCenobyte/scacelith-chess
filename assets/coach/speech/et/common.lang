# ---- Squares, files and ranks (spoken) -----------------------------------------------------------
# The voice says the Estonian letter names, as players read squares aloud: e4 = "ee neli", c5 = "tsee
# viis", f3 = "eff kolm", h7 = "haa seitse". A square never takes a case ending: the lines put it next
# to a noun that carries the case ("väljale {sq}", "välja {sq} pärast").
square.spoken = {file} {rank}
file.a.spoken = aa
file.b.spoken = bee
file.c.spoken = tsee
file.d.spoken = dee
file.e.spoken = ee
file.f.spoken = eff
file.g.spoken = gee
file.h.spoken = haa
rank.1.spoken = üks
rank.2.spoken = kaks
rank.3.spoken = kolm
rank.4.spoken = neli
rank.5.spoken = viis
rank.6.spoken = kuus
rank.7.spoken = seitse
rank.8.spoken = kaheksa

# ---- Moves ---------------------------------------------------------------------------------------
# Estonian scoresheet letters: K(uningas) L(ipp) V(anker) O(da) R(atsu): "Rf3", "Vad1", "Kxe2".
move.letters = K L V O R
# Spoken as Estonian players read notation: "ratsu eff kolm", "ratsu lööb ee viis", "ratsu bee dee
# seitse", "ee-ettur lööb dee viis", "ettur lööb tagasi", "lühike vangerdus", "lipp gee neli, tuli".
# {piece} is always the nominative here, so the promotion names the new piece after a colon
# ("muundub lipuks" would need the translative): "ee kaheksa, muundumine: lipp".
move.piece.spoken = {piece} {to}
move.piece_capture.spoken = {piece} lööb {to}
move.piece_from.spoken = {piece} {from} {to}
move.piece_from_capture.spoken = {piece} {from} lööb {to}
move.pawn.spoken = {to}
move.pawn_capture.spoken = {file}-ettur lööb {to}
move.recapture.spoken = {piece} lööb tagasi
move.castle_short.spoken = lühike vangerdus
move.castle_long.spoken = pikk vangerdus
move.promotion.spoken = {move}, muundumine: {piece}
move.check.spoken = {move}, tuli
move.mate.spoken = {move}, matt
# A line that says the mate itself uses "{best:nomate}" (or {line:nomate}, {reply:nomate}): the voice
# then says the mating move without "matt".
moves.join.spoken = {a}, {b}

# ---- Respellings (spoken) ------------------------------------------------------------------------
# Estonian says "möödaminnes löömine" for en passant, so the French words need no respelling here.
# The voice reads foreign names letter by letter, the Estonian way: the names below are respelled as
# Estonian players say them (see docs/PRONUNCIATION.md, Estonian).
