appraisal.phase.opening.ill = avangusse
appraisal.phase.opening.ine = avangus
appraisal.phase.opening.ela = avangust
appraisal.phase.middlegame.gen = keskmängu
appraisal.phase.middlegame.part = keskmängu
appraisal.phase.middlegame.ill = keskmängu
appraisal.phase.middlegame.ine = keskmängus
appraisal.phase.middlegame.ela = keskmängust
appraisal.phase.endgame.gen = lõppmängu
appraisal.phase.endgame.part = lõppmängu
appraisal.phase.endgame.ill = lõppmängu
appraisal.phase.endgame.ine = lõppmängus
appraisal.phase.endgame.ela = lõppmängust
