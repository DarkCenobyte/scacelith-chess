# ---- Counted nouns ---------------------------------------------------------------------------------
# Estonian plural rule (assets/i18n): one (1) | other (0, 2-20, 21, ...). After any number but "üks"
# the noun is in the partitive singular ("kolm käiku", "kakskümmend üks viga"); in the other cases
# the number and the noun take the same case ("kolme käiguga"). Written: digits; spoken: words.
# Every noun has four forms:
#   {n:move}       nominative: subject, predicate, quantity, imperative object: "1 käik", "3 käiku"
#                  ("Kuus seisu.", "Pea vastu {n:move}.")
#   {n:move_obj}   the total object of a statement: "1 käigu" (= "ühe käigu"), "3 käiku":
#                  "Valge tegi {n:mistake_obj}." = "ühe vea" / "kaks viga"
#   {n:move_gen}   the genitive (both forms): "3 käigu" = "kolme käigu", before a postposition
#                  ("{n:move_gen} jooksul", "{n:move_gen} pärast") and as the first member of a list
#                  whose last member carries the ending ("{n:mistake_gen} ja {m:blunder_com}")
#   {n:move_com}   the comitative: "3 käiguga" = "kolme käiguga": "matt {m:move_com}"
# Other cases (inessive "kolmes partiis", elative "kümnest seisust"...) are not composed: say them
# with a genitive and a postposition ("{n:game_gen} jooksul", "{n:position_gen} hulgast").
count.move = {n} käik|{n} käiku
count.move_obj = {n:gen} käigu|{n} käiku
count.move_gen = {n:gen} käigu|{n:gen} käigu
count.move_com = {n:gen} käiguga|{n:gen} käiguga
count.point = {n} punkt|{n} punkti
count.point_obj = {n:gen} punkti|{n} punkti
count.point_gen = {n:gen} punkti|{n:gen} punkti
count.point_com = {n:gen} punktiga|{n:gen} punktiga
count.pawn = {n} ettur|{n} etturit
count.pawn_obj = {n:gen} etturi|{n} etturit
count.pawn_gen = {n:gen} etturi|{n:gen} etturi
count.pawn_com = {n:gen} etturiga|{n:gen} etturiga
count.piece = {n} malend|{n} malendit
count.piece_obj = {n:gen} malendi|{n} malendit
count.piece_gen = {n:gen} malendi|{n:gen} malendi
count.piece_com = {n:gen} malendiga|{n:gen} malendiga
count.mistake = {n} viga|{n} viga
count.mistake_obj = {n:gen} vea|{n} viga
count.mistake_gen = {n:gen} vea|{n:gen} vea
count.mistake_com = {n:gen} veaga|{n:gen} veaga
count.blunder = {n} jäme viga|{n} jämedat viga
count.blunder_obj = {n:gen} jämeda vea|{n} jämedat viga
count.blunder_gen = {n:gen} jämeda vea|{n:gen} jämeda vea
count.blunder_com = {n:gen} jämeda veaga|{n:gen} jämeda veaga
count.inaccuracy = {n} ebatäpsus|{n} ebatäpsust
count.inaccuracy_obj = {n:gen} ebatäpsuse|{n} ebatäpsust
count.inaccuracy_gen = {n:gen} ebatäpsuse|{n:gen} ebatäpsuse
count.inaccuracy_com = {n:gen} ebatäpsusega|{n:gen} ebatäpsusega
count.game = {n} partii|{n} partiid
count.game_obj = {n:gen} partii|{n} partiid
count.game_gen = {n:gen} partii|{n:gen} partii
count.game_com = {n:gen} partiiga|{n:gen} partiiga
# "kord" (a time, "üks kord", "kolm korda"); "ühe korra" also means "once". No comitative: "kolme
# korraga" means "three at a time".
count.time = {n} kord|{n} korda
count.time_obj = {n:gen} korra|{n} korda
count.time_gen = {n:gen} korra|{n:gen} korra
count.square = {n} väli|{n} välja
count.square_obj = {n:gen} välja|{n} välja
count.square_gen = {n:gen} välja|{n:gen} välja
count.square_com = {n:gen} väljaga|{n:gen} väljaga
count.position = {n} seis|{n} seisu
count.position_obj = {n:gen} seisu|{n} seisu
count.position_gen = {n:gen} seisu|{n:gen} seisu
count.position_com = {n:gen} seisuga|{n:gen} seisuga
# More counted nouns for review.lang and appraisal.lang: attackers and defenders of a square ("kolm
# ründajat kahe kaitsja vastu"), checks given ("kolm tuld"), captures, and the best moves of a streak
# ("viis parimat käiku järjest").
count.attacker = {n} ründaja|{n} ründajat
count.attacker_obj = {n:gen} ründaja|{n} ründajat
count.attacker_gen = {n:gen} ründaja|{n:gen} ründaja
count.attacker_com = {n:gen} ründajaga|{n:gen} ründajaga
count.defender = {n} kaitsja|{n} kaitsjat
count.defender_obj = {n:gen} kaitsja|{n} kaitsjat
count.defender_gen = {n:gen} kaitsja|{n:gen} kaitsja
count.defender_com = {n:gen} kaitsjaga|{n:gen} kaitsjaga
count.check = {n} tuli|{n} tuld
count.check_obj = {n:gen} tule|{n} tuld
count.check_gen = {n:gen} tule|{n:gen} tule
count.check_com = {n:gen} tulega|{n:gen} tulega
count.capture = {n} löömine|{n} löömist
count.capture_obj = {n:gen} löömise|{n} löömist
count.capture_gen = {n:gen} löömise|{n:gen} löömise
count.capture_com = {n:gen} löömisega|{n:gen} löömisega
count.best_move = {n} parim käik|{n} parimat käiku
count.best_move_obj = {n:gen} parima käigu|{n} parimat käiku
count.best_move_gen = {n:gen} parima käigu|{n:gen} parima käigu
count.best_move_com = {n:gen} parima käiguga|{n:gen} parima käiguga
# Percentages (accuracy): "{acc:percent}" = "85 %" in the subtitles, "kaheksakümmend viis protsenti"
# spoken; "{acc:percent_gen}" = "kaheksakümne viie protsendi" ("{acc:percent_gen} täpsusega").
count.percent = {n} %|{n} %
count.percent.spoken = {n} protsent|{n} protsenti
count.percent_gen = {n} %|{n} %
count.percent_gen.spoken = {n:gen} protsendi|{n:gen} protsendi
# A bare number in the genitive: "{m:gen}" = "3" / "kolme" (a number with a noun that is not counted
# here: "{m:gen} sammu kaugusel").
count.gen = {n:gen}|{n:gen}
# Move numbers as ordinals: "{n:ord}" = "21." / "kahekümne esimene" ("{n:ord} käik"), "{n:ord_gen}" =
# "kahekümne esimese" ("{n:ord_gen} käigu järel", "kuni {n:ord_gen} käiguni"), "{n:ord_part}" =
# "kahekümne esimest" ("pärast {n:ord_part} käiku"), "{n:ord_ade}" = "kahekümne esimesel" ("{n:ord_ade}
# käigul" = "at move 21"). The subtitles write the number with its period: "21. käigul".
count.ord = {n}.|{n}.
count.ord.spoken = {n:ord}|{n:ord}
count.ord_gen = {n}.|{n}.
count.ord_gen.spoken = {n:ord_gen}|{n:ord_gen}
count.ord_part = {n}.|{n}.
count.ord_part.spoken = {n:ord_part}|{n:ord_part}
count.ord_ade = {n}.|{n}.
count.ord_ade.spoken = {n:ord_ade}|{n:ord_ade}

# ---- Evaluations (the strongest levels) ------------------------------------------------------------
# From the listener's point of view. {x} = pawns with one decimal (number.decimal), {n} = moves: the
# genitive number with "käiguga" ("matt kolme käiguga"; the subtitles: "matt 3 käiguga").
eval.up = +{x}
eval.up.spoken = pluss {x}
eval.down = −{x}
eval.down.spoken = miinus {x}
eval.even = 0,0
eval.even.spoken = võrdne seis
eval.mate_win = matt {n:gen} käiguga
eval.mate_loss = sulle matt {n:gen} käiguga

