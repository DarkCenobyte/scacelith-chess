ex.offer.b1.2 = Kas soovid selle käigu tagasi võtta ja uuesti proovida?
ex.offer.b1.3 = Kas proovime mõnda teist käiku?
ex.offer.b2 = Kas soovid proovida teist käiku?
ex.offer.b2.2 = Kas tahad käigu tagasi võtta?
ex.offer.b2.3 = Proovid uuesti?
ex.offer.b3 = Kas soovid käigu tagasi võtta?
ex.offer.b3.2 = Kas tahad uuesti proovida?
ex.offer.b3.3 = Võtad tagasi?
ex.offer.b4 = Võtad tagasi?
ex.offer.b4.2 = Kas tahad käigu tagasi võtta?
ex.offer.b4.3 = Proovid teist käiku?
ex.offer.b5 = Võtad tagasi?
ex.offer.b5.2 = Tahad tagasi võtta?
ex.offer.b5.3 = Võtad käigu tagasi?
ex.offer.b6 = Võtad tagasi?
ex.offer.b6.2 = Käik tagasi?
ex.offer.b6.3 = Uuesti?
# A dubious move at levels 1-2, said with the takeback card; the better move is not named.
ex.dubious.b1 = See käik on kahtlane. Äkki saad paremini?
ex.dubious.b1.2 = See käik on kahtlane. Äkki leiad parema käigu?
ex.dubious.b2 = Kahtlane käik. Äkki saad paremini?
ex.dubious.b2.2 = See käik on kahtlane. Äkki leidub midagi paremat?
