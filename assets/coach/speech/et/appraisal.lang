# Coach speech (Estonian): the appraisal after the game (src/coach/appraisal.cpp).
# Same keys and variants as assets/coach/speech/en/appraisal.lang (its header documents every placeholder).
# Always positive, never blaming. The coach says "sina" (sa, sinu, singular imperatives); Estonian has
# no grammatical gender, so nothing agrees with the player or the coach.
#
# Names inserted by {text}, {theme}, {level} (written to fit every line that inserts them):
#   appraisal.phase.*   lower-case nominative nouns ("avang"); their cases are in common.lang:
#                       "{text:ine}" = "avangus", "{text:gen}" = "avangu" ("Avangu mängisid sa hästi.").
#   appraisal.reason.*  an adverbial phrase said right after "viik" ("Viik pati tõttu."), no comma.
#   theme.*             a verbal-noun phrase in -mine (nominative, lower case, no full stop), always said
#                       after a colon ("Üks nõuanne: kogu laua vaatamine enne käiku.").
#   appraisal.level.*   the level names of the coach page (coach.level.N.name), always quoted „…“ after
#                       the noun "tase", which carries the case ("proovi taset „Algaja“").
# Forms from common.lang: move numbers are ordinals: "{n:ord_ade} käigul" = "21. käigul" (spoken
# "kahekümne esimesel käigul"), "{n:ord} käik" = "21. käik", "kuni {crit_no:ord_gen} käiguni";
# accuracy "{acc:percent}" = "85 %" (spoken "kaheksakümmend viis protsenti"), "{acc:percent_gen}
# täpsusega"; total objects "{n:piece_obj}", "{n:move_obj}"; "{moves:move_com}" = "30 käiguga";
# a list "{n:mistake_gen} ja {m:blunder_com}" = "kahe vea ja ühe jämeda veaga".
# Material won is said as "{pts:point_gen} väärtuses materjali" ("kolme punkti väärtuses materjali").
# {opening:def} is the opening's name inside a sentence, always where the nominative fits ("Meil oli
# {opening:def}."); {opening} alone is a short sentence by itself.

# ---- Names used inside the lines ------------------------------------------------------------------
appraisal.phase.opening = avang
appraisal.phase.middlegame = keskmäng
appraisal.phase.endgame = lõppmäng
appraisal.reason.stalemate = pati tõttu
appraisal.reason.material = ebapiisava materjali tõttu
