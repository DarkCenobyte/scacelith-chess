# Coach speech (Slovak): the rules lesson (level 0, src/coach/lesson.cpp).
# Same keys and variants as assets/coach/speech/en/lesson.lang.
#
# Placeholders: {your} / {my} = a piece of the player / of the coach ("tvoja veža", "môj jazdec"), with
# the forms of common.lang ({my:acc}, {my:dat}, {my:gen}, {my:pron_acc}, {my:poss}, {your:refl_acc},
# {your:refl_ins} ...); {sq}, {sq2}, {to}, {esc} = squares ("na {sq}", "pole {sq}"); {move} = a move.
# {@}, {@2}, {@3} are invisible marks: the coach points at something while saying the word right after
# the mark. A ".spoken" key is what the voice says instead (here: the file letters spelled as Slovak
# letter names: á, é, há).
# Rules the lines follow: the player is never the subject of a past tense, conditional or adjective
# (their gender varies): "Takto sa pohne len veža", "Tvoja dáma ... padla za môjho jazdca". When the
# player acts with their own piece, "svoj" ({your:refl_acc} = "svoju vežu"). Files = stĺpce, ranks =
# rady, back rank = posledný rad, defended = krytá.

# ---- Chapter titles (said inside "Pokračujeme témou „{chapter}“.") --------------------------------
# Nominative, lower case (see event.lesson.* in events.lang).
lesson.title.welcome = šachovnica
lesson.title.pieces = ako sa pohybujú figúry
lesson.title.safety = bezpečné a nebezpečné branie
lesson.title.check = šach
lesson.title.mate = mat
lesson.title.castling = rošáda
lesson.title.en_passant = branie mimochodom
lesson.title.promotion = premena pešiaka
lesson.title.draws = pat a remíza
lesson.title.etiquette = rating, hodiny a etiketa v skutočných partiách

# ---- Lines every exercise uses ------------------------------------------------------------------------
# After the coach demonstrated the solution.
lesson.now_you = Teraz skús ty.
lesson.now_you.2 = Teraz je rad na tebe.
lesson.now_you.3 = Teraz ty.
# Another wrong move after the demonstration.
lesson.almost = Takmer! Zahraj ťah, ktorý som ti ukázal.
lesson.almost.2 = Nie celkom. Skús ťah z mojej ukážky.
lesson.almost.3 = Blízko. Spomeň si, čo som ti práve ukázal.
# A wrong move without a line of its own.
lesson.try_again = To nie je ono. Skús to znova.
lesson.try_again.2 = Tento ťah nie. Skús to ešte raz.
lesson.try_again.3 = Skúsme to ešte raz.
lesson.use_your = Použi {your:refl_acc}.
lesson.use_your.2 = Skús to so {your:refl_ins}.
lesson.watch = Sleduj.
lesson.like_this = Takto.
lesson.and_back = A späť.
# A check that is not checkmate (the coach then shows the escape).
lesson.check_escape = Šach, ale môj kráľ unikne na {esc}.
lesson.check_takes = Šach, ale môj kráľ jednoducho vezme {your:acc}.
lesson.check_block = Šach, ale môžem mu postaviť do cesty figúru.
lesson.stalemate = Pat! Môj kráľ sa nemôže pohnúť a nie je v šachu. Remíza, a pritom tvoja pozícia bola vyhratá!

# ---- Why a move is not allowed (the coach points at the piece or square in question) ----------------
# {sq} = the square in question, {my} = the coach's piece that attacks, pins, blocks or gives
# check, {your} = the piece the player tried to move.
why.KingIntoCheck = Nie na {sq}: {my} to pole napáda. Kráľ sa nikdy nesmie postaviť na napadnuté pole.
why.PathBlocked = Niečo stojí v {@}ceste: figúry nemôžu preskakovať, jedine jazdec.
why.WrongGeometry = {your} sa takto nepohybuje.
why.MustAnswerCheck = Si v {@}šachu: najprv naň musíš odpovedať.
why.CastlingThroughCheck = Tvoj kráľ by prešiel cez {sq} a to pole napáda {my}.
why.CastlingNoRights = S týmto kráľom alebo vežou sa už ťahalo: rošáda nie je možná.
why.CastlingBlocked = Na rošádu musia byť polia medzi kráľom a vežou voľné.
why.CastlingOutOfCheck = Keď si v šachu, rošádu urobiť nemôžeš.
why.PawnForwardBlocked = Pešiaci neberú priamo dopredu: to pole je {@}obsadené.
why.LeavesKingInCheck = {your} je viazan{your:adj}: ak {your:npron_ins} potiahneš, vystavíš svojho kráľa útoku {my:gen}.
why.OwnPieceOnTarget = Na pole s vlastnou figúrou sa postaviť nemôžeš.
why.PawnCaptureNeedsVictim = Pešiak ide šikmo len vtedy, keď berie.
why.EnPassantExpired = Mimochodom sa dá brať len hneď po tom, ako pešiak postúpil o dve polia.
why.NotYourTurn = Počkaj: teraz som na ťahu ja.

# ---- Chapter 0: welcome and the board -------------------------------------------------------------------
lesson.welcome.hello = Ahoj! Som tvoj tréner. Naučme sa spolu pravidlá šachu, pekne krok za krokom.
lesson.welcome.board = Toto je šachovnica: šesťdesiatštyri polí, svetlých a tmavých, osem radov po osem polí.
lesson.welcome.light = Rohové pole {@}vpravo od teba je vždy svetlé. Zapamätaj si: svetlé pole vpravo.
lesson.welcome.files = Zvislé línie sa volajú stĺpce. Označujú sa písmenami od {@}a po {@2}h.
lesson.welcome.files.spoken = Zvislé línie sa volajú stĺpce. Označujú sa písmenami od {@}á po {@2}há.
lesson.welcome.ranks = Vodorovné línie sa volajú rady. Majú čísla od {@}jednotky po {@2}osmičku, od tvojej strany.
lesson.welcome.square = Každé pole sa volá podľa svojho písmena a čísla. Toto pole je {sq}.
lesson.welcome.square2 = A toto je {sq}.
lesson.welcome.kings = Toto sú dvaja králi. Tvoj stojí na {sq}, môj na {sq2}.
lesson.welcome.ask = Teraz ty: posuň svojho kráľa o jedno pole dopredu, na {sq}.
lesson.welcome.wrong = To je {to}. Potrebujeme {sq}: písmeno e, číslo dva.
lesson.welcome.wrong.spoken = To je {to}. Potrebujeme {sq}: písmeno é, číslo dva.
lesson.welcome.ok = Perfektné. Tvoj kráľ stojí na {sq}.

# ---- Chapter 1: how the pieces move and capture -----------------------------------------------------------
# Rook
lesson.rook.intro = Toto je {your}. Pohybuje sa po priamkach, po stĺpcoch a radoch, ľubovoľne ďaleko.
lesson.rook.lines = Hore po stĺpci {@}alebo po rade.
lesson.rook.capture = Figúra berie tak, že sa postaví na pole {@}súperovej figúry, ktorá potom zmizne zo šachovnice.
lesson.rook.ask = Vezmi {my:acc} svojou vežou!
lesson.rook.short = Správny smer! Pokračuj hore po stĺpci, až k {my:dat}.
lesson.rook.rank = Toto je ťah po rade. {my} stojí vyššie, na stĺpci.
lesson.rook.king = To je tvoj kráľ. Použi {your:refl_acc} v rohu.
lesson.rook.ok = A je to! {my} opúšťa šachovnicu.
# Pieces don't jump
lesson.jump.blocked = Figúry nemôžu preskakovať iné figúry. Tvoj pešiak na {sq} blokuje veži cestu.
lesson.jump.knight = Preskakovať vie iba jazdec. Čoskoro sa s ním zoznámime.
# Bishop
lesson.bishop.intro = Toto je {your}. Pohybuje sa šikmo, po diagonálach, ľubovoľne ďaleko.
lesson.bishop.colour = Strelec zostáva vždy na poliach rovnakej farby.
lesson.bishop.ask = {my} stojí na diagonále tvojho strelca. Vezmi {my:pron_acc}!
lesson.bishop.short = Správna diagonála! Choď ďalej, až k {my:dat}.
lesson.bishop.other = To je tá druhá diagonála. Pozri sa smerom k {my:dat}.
lesson.bishop.ok = Výborne. Strelci milujú dlhé diagonály.
# Queen
lesson.queen.intro = Toto je {your}, najsilnejšia figúra. Pohybuje sa ako veža a strelec dohromady.
lesson.queen.ask = Nájdi {my:acc} a vezmi {my:pron_acc} svojou dámou.
lesson.queen.wrong = Tvoja dáma sa dostane k {my:dat} jedným ťahom, po diagonále.
lesson.queen.ok = Výborne! Chráň si dámu: má veľkú hodnotu.
# King
lesson.king.intro = Kráľ sa pohybuje len o jedno pole, ľubovoľným smerom.
lesson.king.important = Kráľ je najdôležitejšia figúra. Ak nemá kam uniknúť, partia je prehratá.
lesson.king.ask = Aj kráľ môže brať. Vezmi {my:acc}!
lesson.king.wrong = Tvoj kráľ stojí hneď vedľa {my:gen}. Vstúp na {my:poss} pole a vezmi {my:pron_acc}.
lesson.king.ok = Dobre! Kráľ je pomalý, ale zblízka silný.
# Knight
lesson.knight.intro = Toto je {your}. Pohybuje sa v tvare písmena L: dve polia rovno a potom jedno nabok.
lesson.knight.l = {@}Takto. Vždy skončí na poli opačnej farby.
lesson.knight.jump = Jazdec je jediná figúra, ktorá môže preskakovať iné.
lesson.knight.ask = Vezmi {my:acc} svojím jazdcom!
lesson.knight.wrong = To je správny ťah jazdcom, ale k {my:dat} sa ním nedostaneš. Skús iný skok v tvare L.
lesson.knight.ok = Skvelý skok!
# Pawn: moving
lesson.pawn.intro = Teraz {your}. Ide rovno dopredu, vždy o jedno pole, a nikdy necúva.
lesson.pawn.first = Pri svojom prvom ťahu môže pešiak ísť o jedno alebo o dve polia.
lesson.pawn.ask = Posuň svojho pešiaka o dve polia dopredu.
lesson.pawn.one = To je jedno pole: povolené, ale tentoraz choď o dve.
lesson.pawn.use = Použi pešiaka.
lesson.pawn.ok = Dobre.
# Pawn: capturing
lesson.pawncap.blocked = Môj pešiak blokuje tvojho. Pešiaci nemôžu brať priamo dopredu.
lesson.pawncap.diagonal = Pešiak však berie šikmo, o jedno pole dopredu.
lesson.pawncap.ask = Vezmi {my:acc} svojím pešiakom.
lesson.pawncap.use = Použi {your:refl_acc}: berie šikmo dopredu.
lesson.pawncap.ok = Áno! Rovno sa ťahá, šikmo sa berie.
# Values, set-up and the first moves
lesson.values.pawn = Každá figúra má hodnotu v bodoch. Pešiak má hodnotu jeden bod.
lesson.values.pieces = Jazdec alebo {@}strelec: tri. {@2}Veža: päť. {@3}Dáma: deväť.
lesson.values.king = Kráľ je na nezaplatenie: nikdy ho nemôžeš obetovať.
lesson.values.trade = Snaž sa nikdy nedávať figúru za menej, než je jej hodnota.
lesson.setup.corners = Každá partia začína takto: veže v {@}rohoch, vedľa nich {@2}jazdci, potom {@3}strelci.
lesson.setup.queen = Dáma stojí na poli svojej farby: tvoja dáma je na svetlom poli.
lesson.setup.king = Kráľ stojí vedľa nej. Biely ťahá vždy prvý.
lesson.first.ask = Začni partiu: posuň pešiaka pred svojím kráľom o dve polia, na {sq}.
lesson.first.wrong = Aj to je povolený ťah! Teraz však, prosím, potiahni kráľovským pešiakom na {sq}.
lesson.first.ok = Výborný prvý ťah: otvára cestu tvojej dáme aj strelcovi.
lesson.first.reply = Odpovedám rovnako. Teraz vyveď jazdca: skoč z poľa {sq} na {sq2}.
lesson.first.knight_wrong = Jazdci preskakujú pešiakov. Skús to z poľa {sq} na {sq2}.
lesson.first.knight_ok = Perfektné. Jazdcov a strelcov vyvíjame skoro.
