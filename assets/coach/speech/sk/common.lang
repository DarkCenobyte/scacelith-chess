# More counted nouns: checks given ("{m:check}" = "2 šachy"), best moves in a row ("{n:best_move}" =
# "3 najlepšie ťahy"), attackers and defenders of a square ("{n:attacker}" = "dvaja útočníci",
# "{n2:defender_acc}" = "jedného obrancu"), percent ("{acc:percent}" = "85 %" in the subtitles,
