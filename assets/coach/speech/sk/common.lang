count.inaccuracy = {n:f} nepresnosť|{n:f} nepresnosti|{n} nepresností
count.game = {n:f} partia|{n:f} partie|{n} partií
# Written "raz, 2-krát, 5-krát", spoken "raz, dvakrát, päťkrát".
count.time = raz|{n}-krát|{n}-krát
count.time.spoken = raz|{n}krát|{n}krát
count.square = {n:neut} pole|{n:neut} polia|{n} polí
count.position = {n:f} pozícia|{n:f} pozície|{n} pozícií
# Accusatives that differ from the nominative ("jednu chybu", "jedného pešiaka", "dvoch pešiakov").
count.pawn_acc = {n:ma} pešiaka|{n:ma} pešiakov|{n} pešiakov
count.piece_acc = {n:fa} figúru|{n:f} figúry|{n} figúr
