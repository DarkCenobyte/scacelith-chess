ex.verdict.inaccuracy.b3.2 = Ťah {best} bol o kúsok presnejší.
ex.verdict.inaccuracy.b3.3 = Malé zaváhanie: tu bol lepší ťah {best}.
ex.verdict.inaccuracy.b4 = Nepresné: presnejší bol ťah {best}.
