ex.hanging.b2.2 = {my} môže zadarmo vziať {your:acc}. Nič {your:pron_acc} nekryje.
ex.hanging.b2.3 = {your} zostal{your:past} na poli {sq} bez ochrany a {my} {your:pron_acc} vezme.
ex.hanging.b3 = {move} nechá {your:acc} nekryt{your:adj_acc}: {reply} a niet čím brať späť.
ex.hanging.b3.2 = {your} na poli {sq} visí: {reply}.
ex.hanging.b3.3 = Po {reply} prídeš o {your:refl_acc} zadarmo.
ex.hanging.b4 = {move} nechá visieť {your:acc}: {reply} získa {pts:point}.
ex.hanging.b4.2 = {reply} zadarmo získa {your:acc}.
ex.hanging.b4.3 = {your} je nekryt{your:adj} a padne po {reply}.
ex.hanging.b5 = {move} nechá {your:acc} nekryt{your:adj_acc}; po {reply} padne.
ex.hanging.b5.2 = {your} na poli {sq} padne po {reply}.
ex.hanging.b5.3 = {reply} získa {your:acc}.
ex.hanging.b6 = {move}? {reply} a {your} padne.
ex.hanging.b6.2 = {reply} získa {your:acc}.
ex.hanging.b6.3 = {your} visí: {reply}.
# Removal of the guard ({your2} = the piece that moved away, {your} = the piece it protected).
ex.hanging_guard.b1 = {your2} chránil{your2:past} {your:acc}. Teraz {your:pron_acc} {my} môže vziať.
ex.hanging_guard.b1.2 = {your2} odiš{your2:past_iel} a {your} zostal{your:past} bez ochrany. {my} {your:pron_acc} vezme.
ex.hanging_guard.b2 = {your2} predtým chránil{your2:past} {your:acc}. Teraz je bez ochrany a {my} {your:pron_acc} vezme.
ex.hanging_guard.b2.2 = Ťah {your2:bare_ins} nechal {your:acc} bez ochrany pred {my:ins}.
ex.hanging_guard.b3 = {your2} kryl{your2:past} {your:acc}. Keď odíde, {your} padne po {reply}.
ex.hanging_guard.b3.2 = Bez {your2:gen} je {your} nekryt{your:adj}: {reply}.
ex.hanging_guard.b4 = {move} odstráni obrancu: {your2} opustil{your2:past} {your:acc}, ktor{your:adj} padne po {reply}.
ex.hanging_guard.b4.2 = {your} mal{your:past} jediného obrancu, {your2:acc}; po {reply} padne.
# The coach's threat was not seen (levels 1-3; {my} = the attacker, {your} = the target).
ex.hanging_threat.b1 = {my} už napádal{my:past} {your:acc}. Vždy sa pozri, čím hrozí môj ťah.
ex.hanging_threat.b1.2 = Moja hrozba ti ušla: {my} napáda {your:acc}.
ex.hanging_threat.b2 = Posledným ťahom som {my:refl_ins} napadol {your:acc}. Vždy sleduj moje hrozby.
ex.hanging_threat.b2.2 = {my} hrozil{my:past} {your:dat} a teraz {your:pron_acc} môžem vziať.
ex.hanging_threat.b3 = Moja hrozba ti ušla: {my} napádal{my:past} {your:acc}.
ex.hanging_threat.b3.2 = {my} mal{my:past} {your:acc} celý čas na muške.
ex.hanging.tip.b1 = Pred každým ťahom sa spýtaj: sú všetky moje figúry v bezpečí?
ex.hanging.tip.b1.2 = Dobrý zvyk: po každom ťahu skontroluj, ktoré tvoje figúry sú kryté.

# ---- 11. Exchange going wrong -------------------------------------------------------------------
# A bad capture ({your} pointed at; b1 b2 also {my}; b3-b6 also {sq}); {n} = your piece's points,
# {n2} = what it captured.
ex.exchange_capture.b1 = {your} síce vzal{your:past} figúru, ale {my} berie späť. Táto výmena ťa stojí body.
ex.exchange_capture.b1.2 = {my} berie späť. {your} má hodnotu {n:point}, a ty získavaš len {n2:point}.
ex.exchange_capture.b1.3 = Pozor: {my} môže na oplátku vziať {your:acc}. To je zlá výmena.
ex.exchange_capture.b2 = Opatrne s výmenami: {your} má hodnotu {n:point}. {my} berie späť a ty máš len {n2:point}.
ex.exchange_capture.b2.2 = {my} na oplátku vezme {your:acc}. Strácaš {n:point} a získavaš len {n2:point}.
ex.exchange_capture.b3 = Branie na poli {sq} nevyjde: po {line} prídeš o {your:refl_acc}.
ex.exchange_capture.b3.2 = {your} berie na poli {sq}, ale po {line} máš o {pts:point} menej.
ex.exchange_capture.b4 = {move} je chyba v počítaní na poli {sq}: po {line} prídeš o {your:refl_acc}.
ex.exchange_capture.b4.2 = Branie na poli {sq} ťa stojí {your:acc}: {line}.
ex.exchange_capture.b5 = {move} stratí {your:acc} vo výmenách na poli {sq}: {line}.
ex.exchange_capture.b5.2 = Na poli {sq} prídeš o {your:refl_acc}: {line}.
ex.exchange_capture.b6 = {move} stratí {your:acc} na poli {sq} po {line}.
ex.exchange_capture.b6.2 = {line} na poli {sq} a {your} je preč.
# Counting attackers and defenders ({sq} pointed at); {n} = my attackers, {n2} = your defenders.
ex.exchange_count.b1 = Spočítaj to: pole {sq} napádam {n:time}, ty ho kryješ {n2:time}.
ex.exchange_count.b1.2 = Pole {sq}: ja mám {n:attacker_acc}, ty {n2:defender_acc}. Tam vyhrám.
ex.exchange_count.b2 = Pole {sq} je napadnuté {n:time} a kryté {n2:time}. Tam stratíš materiál.
ex.exchange_count.b2.2 = Spočítaj to na poli {sq}: {n:attacker} na jednej strane, {n2:defender} na druhej.
ex.exchange_count.b3 = Spočítaj útočníkov a obrancov na poli {sq}: ja mám viac.
ex.exchange_count.b3.2 = Výmena na poli {sq} nevyjde: po {line} máš o {pts:point} menej.
ex.exchange_count.b4 = {move} je chyba v počítaní na poli {sq}: {line} a máš o {pts:point} menej.
ex.exchange_count.b4.2 = Pole {sq} je napadnuté viackrát, ako je kryté: {line}.
ex.exchange_count.b5 = Na poli {sq} prevažujú útočníci, {n} na {n2}: {line}.
ex.exchange_count.b5.2 = {move}: na poli {sq} to nevychádza.
ex.exchange_count.b6 = {line} na poli {sq} a získal som {pts:point}.
ex.exchange_count.b6.2 = {sq}: {n} na {n2}.
# A cheaper piece attacks ({your} pointed at; b1 b2 also {my}; b3-b6 also {sq}); {n} = your piece,
# {n2} = my attacker.
ex.exchange_cheap.b1 = {my} má menšiu hodnotu ako {your}. Ak vezmem, prídeš o body.
ex.exchange_cheap.b1.2 = {my} napáda {your:acc}. Táto výmena je pre teba nevýhodná.
ex.exchange_cheap.b2 = {your} má hodnotu {n:point} a {my} len {n2:point}. Táto výmena je pre teba strata.
ex.exchange_cheap.b2.2 = {my} je lacnejš{my:adj_soft} ako {your}, takže útok získa materiál.
ex.exchange_cheap.b3 = {your} na poli {sq} je napadnut{your:adj} lacnejšou figúrou.
ex.exchange_cheap.b3.2 = Figúra za {n2:point} napáda {your:acc} na poli {sq}: {line}.
ex.exchange_cheap.b4 = {your} na poli {sq} je napadnut{your:adj} lacnejšou figúrou; {reply} získa materiál.
ex.exchange_cheap.b4.2 = {reply} napadne {your:acc} na poli {sq} lacnejšou figúrou.
ex.exchange_cheap.b5 = {your} na poli {sq} je vystaven{your:adj} útoku lacnejšej figúry: {line}.
ex.exchange_cheap.b5.2 = {reply} získa materiál na poli {sq} proti {your:dat}.
ex.exchange_cheap.b6 = {reply} získa {your:acc} na poli {sq}.
ex.exchange_cheap.b6.2 = {line}: {your} na poli {sq} padne.

