ex.hanging_threat.b1 = {my} je že napadal{my:ag} {your:acc}. Vedno preveri, s čim grozi moja poteza.
ex.hanging_threat.b1.2 = Moja grožnja ti je ušla: {my} napada {your:acc}.
ex.hanging_threat.b2 = Z zadnjo potezo sem {my:refl_with} napadel {your:acc}. Vedno poglej moje grožnje.
ex.hanging_threat.b2.2 = {my} je grozil{my:ag} {your:dat}, zdaj pa {your:cl_acc} lahko vzamem.
ex.hanging_threat.b3 = Moja grožnja ti je ušla: {my} je napadal{my:ag} {your:acc}.
ex.hanging_threat.b3.2 = {my} je ves čas meril{my:ag} na {your:acc}.
ex.hanging.tip.b1 = Pred vsako potezo se vprašaj: ali so vse moje figure varne?
ex.hanging.tip.b1.2 = Dobra navada: po vsaki potezi preveri, katere tvoje figure so zaščitene.

# ---- 11. Exchange going wrong -------------------------------------------------------------------
# A bad capture ({your} pointed at; b1 b2 also {my}; b3-b6 also {sq}); {n} = your piece's points,
# {n2} = what it captured. "vreden" takes the genitive: "vreden treh točk".
ex.exchange_capture.b1 = {your} je nekaj vzel{your:ag}, a {my} vzame nazaj. S to menjavo izgubiš točke.
ex.exchange_capture.b1.2 = {my} vzame nazaj. {your} je vred{your:ag_en} {n:point_gen}, ti pa dobiš le {n2:point_acc}.
ex.exchange_capture.b1.3 = Previdno: {my} lahko v odgovor vzame {your:acc}. To je slaba menjava.
ex.exchange_capture.b2 = Pazi pri menjavah: {your} je vred{your:ag_en} {n:point_gen}. {my} vzame nazaj, ti pa dobiš le {n2:point_acc}.
ex.exchange_capture.b2.2 = {my} v odgovor vzame {your:acc}. Izgubiš {n:point_acc}, dobiš pa le {n2:point_acc}.
ex.exchange_capture.b3 = Jemanje na {sq} ne gre: po {line} je {your} izgubljen{your:ag}.
ex.exchange_capture.b3.2 = {your} vzame na {sq}, a po {line} imaš {pts:point_acc} manj.
ex.exchange_capture.b4 = {move} temelji na napačnem računu na {sq}: po {line} je {your} izgubljen{your:ag}.
ex.exchange_capture.b4.2 = Jemanje na {sq} stane {your:acc}: {line}.
