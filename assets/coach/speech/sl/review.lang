ex.material.b5.2 = {line} mi prinese {pts:point_acc}.
ex.material.b6 = {line} in dobil sem {pts:point_acc}.
ex.material.b6.2 = {move} izgubi {pts:point_acc}: {line}.

# ---- 12. Missed capture ({my} pointed at; b1 also {your}; b2-b6 also {best}) --------------------
ex.missed_capture.b1 = Vidiš? {my} na {sq} je bil{my:ag} zastonj. {your} bi {my:cl_acc} lahko vzel{your:ag}.
ex.missed_capture.b1.2 = Poglej: {my} ni imel{my:ag} branilca. {your} bi {my:cl_acc} lahko vzel{your:ag}.
ex.missed_capture.b1.3 = {my} na {sq} ni bil{my:ag} zaščiten{my:ag}. {your} bi {my:cl_acc} lahko zgrabil{your:ag}!
ex.missed_capture.b2 = Ušlo ti je jemanje zastonj: {best} dobi {my:acc}.
ex.missed_capture.b2.2 = {my} je visel{my:ag} na {sq}. {best} {my:cl_acc} vzame. Naslednjič {my:cl_acc} zgrabi!
ex.missed_capture.b2.3 = Poteza {best} bi zastonj dobila {my:acc}.
ex.missed_capture.b3 = Poteza {best} bi dobila {my:acc} za nič.
ex.missed_capture.b3.2 = {my} na {sq} ni bil{my:ag} zaščiten{my:ag}: {best}. Pri vsaki potezi preveri, ali kaj visi.
ex.missed_capture.b3.3 = S potezo {best} je bilo mogoče vzeti {my:acc}.
ex.missed_capture.b4 = Zamujeno: {best} pobere {my:acc} na {sq}.
ex.missed_capture.b4.2 = {best} dobi {my:acc}, ki je bil{my:ag} nezaščiten{my:ag}.
ex.missed_capture.b4.3 = {my} je visel{my:ag}: {best}.
ex.missed_capture.b5 = {best} dobi {my:acc}; {move} pa {my:cl_dat} dovoli pobeg.
ex.missed_capture.b5.2 = {my} na {sq} je bil{my:ag} nezaščiten{my:ag}: {best}.
ex.missed_capture.b6 = {best}! {my} na {sq} je visel{my:ag}.
ex.missed_capture.b6.2 = {best} dobi {my:acc}.

