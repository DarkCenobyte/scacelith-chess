ex.exchange_capture.b5.2 = Na {sq} je {your} izgubljen{your:ag}: {line}.
ex.exchange_capture.b6 = {move} izgubi {your:acc} na {sq} po {line}.
ex.exchange_capture.b6.2 = {line} na {sq} in {your:gen} ni več.
# Counting attackers and defenders ({sq} pointed at); {n} = my attackers, {n2} = your defenders.
ex.exchange_count.b1 = Preštej: polje {sq} napadam {n:time}, ti pa ga braniš {n2:time}.
ex.exchange_count.b1.2 = Na polju {sq} imam {n:attacker_acc}, ti pa {n2:defender_acc}. Tu zmagam jaz.
ex.exchange_count.b2 = Polje {sq} je napadeno {n:time} in branjeno {n2:time}. Tam izgubiš material.
ex.exchange_count.b2.2 = Preštej na polju {sq}: {n:attacker} in {n2:defender}.
ex.exchange_count.b3 = Preštej napadalce in branilce na polju {sq}: jaz jih imam več.
ex.exchange_count.b3.2 = Menjava na polju {sq} ne gre: po {line} imaš {pts:point_acc} manj.
ex.exchange_count.b4 = {move} temelji na napačnem računu na polju {sq}: po {line} imaš {pts:point_acc} manj.
ex.exchange_count.b4.2 = Polje {sq} je večkrat napadeno kot branjeno: {line}.
ex.exchange_count.b5 = Na polju {sq} imam več napadalcev, {n} proti {n2}: {line}.
ex.exchange_count.b5.2 = Po {move} je račun na polju {sq} izgubljen.
ex.exchange_count.b6 = {line} na {sq} in dobil sem {pts:point_acc}.
ex.exchange_count.b6.2 = {sq}: {n} proti {n2}.
# A cheaper piece attacks ({your} pointed at; b1 b2 also {my}; b3-b6 also {sq}); {n} = your piece,
# {n2} = my attacker.
ex.exchange_cheap.b1 = {my} je vred{my:ag_en} manj kot {your}. Če vzamem, izgubiš točke.
ex.exchange_cheap.b1.2 = {my} napada {your:acc}. Menjava med njima je zate slaba.
ex.exchange_cheap.b2 = {your} je vred{your:ag_en} {n:point_gen}, {my} pa le {n2:point_gen}. Ta menjava te stane.
ex.exchange_cheap.b2.2 = {my} je cenejš{my:agi} od {your:gen}, zato napad dobi material.
ex.exchange_cheap.b3 = {your} na {sq} je pod napadom cenejše figure.
ex.exchange_cheap.b3.2 = Figura, vredna {n2:point_gen}, napada {your:acc} na {sq}: {line}.
ex.exchange_cheap.b4 = {your} na {sq} je pod napadom cenejše figure; {reply} dobi material.
ex.exchange_cheap.b4.2 = {reply} s cenejšo figuro napade {your:acc} na {sq}.
ex.exchange_cheap.b5 = {your} na {sq} je izpostavljen{your:ag} cenejšemu napadalcu: {line}.
ex.exchange_cheap.b5.2 = {reply} dobi material na {sq} proti {your:dat}.
ex.exchange_cheap.b6 = {reply} dobi {your:acc} na {sq}.
ex.exchange_cheap.b6.2 = {line}: {your} na {sq} je izgubljen{your:ag}.

