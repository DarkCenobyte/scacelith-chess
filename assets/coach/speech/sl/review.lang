ex.promotion_missed.b2 = Tvoj kmet bi lahko stekel do {sq}. Proste kmete potiskaj naprej!
ex.promotion_missed.b2.2 = Nič ni ustavljalo tvojega kmeta na poti do {sq}.
ex.promotion_missed.b3 = {best} dobi dirko do {sq}.
ex.promotion_missed.b3.2 = Tvoj kmet je bil hitrejši: {best} in na {sq} postane dama.
ex.promotion_missed.b4 = {best} dobi dirko kmetov do {sq}.
ex.promotion_missed.b4.2 = {best}! Kmet postane dama na {sq}.
ex.promotion_missed.b5 = Po {best} dobiš damo na {sq} pred mano.
ex.promotion_missed.b5.2 = {best} in polje {sq} je tvoje.
ex.promotion_missed.b6 = {best} dobi dirko do {sq}.
ex.promotion_missed.b6.2 = {best}; dama na {sq} prej.

