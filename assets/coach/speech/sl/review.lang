ex.promotion.b2 = {my} teče na {sq} in {your} {my:cl_gen} ne more ujeti.
ex.promotion.b2.2 = {my} potrebuje {n:move_acc} do polja {sq}, {your} pa {n2:move_acc}. Prepočasi.
ex.promotion.b2.3 = Previdno: {my} postane dama na {sq}, {your} pa je predaleč.
ex.promotion.b3 = {my} uide: {your} je zunaj kvadrata in {my:cl_gen} ne ujame pred poljem {sq}.
