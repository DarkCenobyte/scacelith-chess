# ---- Counted nouns ---------------------------------------------------------------------------------
# Portuguese plural rule (assets/i18n): one (exactly 1) | other (0 included: "zero lances").
# Feminine nouns say their number with the form "f" ("uma peça", "duas vezes", "vinte e uma casas").
count.move = {n} lance|{n} lances
count.point = {n} ponto|{n} pontos
count.pawn = {n} peão|{n} peões
count.piece = {n:f} peça|{n:f} peças
count.mistake = {n} erro|{n} erros
count.blunder = {n} erro grave|{n} erros graves
count.inaccuracy = {n:f} imprecisão|{n:f} imprecisões
count.game = {n:f} partida|{n:f} partidas
count.time = {n:f} vez|{n:f} vezes
count.square = {n:f} casa|{n:f} casas
count.position = {n:f} posição|{n:f} posições
# "{n:f}" in a line says a bare number in the feminine, before a feminine noun the line writes
# itself ("{n:f} casas"); it is a count key so that the form also works outside the counted nouns
# (and the form check knows it). A bare "{n}" is masculine.
count.f = {n:f}|{n:f}
# More counted nouns for the review and the appraisal: "{n:attacker}" = "3 atacantes",
# "{n2:defender}" = "1 defensor", "{m:check}" = "2 xeques", "{n:capture}" = "4 capturas",
# "{n:captured}" = "3 peças capturadas" (the participle agrees with the number, which a line
# cannot do around "{n:piece}"), "{n:best_move}" = "5 melhores lances" (a streak).
count.attacker = {n} atacante|{n} atacantes
count.defender = {n} defensor|{n} defensores
count.check = {n} xeque|{n} xeques
count.capture = {n:f} captura|{n:f} capturas
count.captured = {n:f} peça capturada|{n:f} peças capturadas
count.best_move = {n} melhor lance|{n} melhores lances
# Percentages (accuracy): "{acc:percent}" = "85%" in the subtitles, "oitenta e cinco por cento" spoken.
count.percent = {n}%|{n}%
count.percent.spoken = {n} por cento|{n} por cento

# ---- Evaluations (the strongest levels) ------------------------------------------------------------
# From the listener's point of view. {x} = pawns with one decimal (number.decimal), {n} = moves.
eval.up = +{x}
eval.up.spoken = mais {x}
eval.down = −{x}
eval.down.spoken = menos {x}
eval.even = 0,0
eval.even.spoken = igualdade
eval.mate_win = mate em {n}
eval.mate_loss = mate em {n} contra ti

# ---- Names used in the lines of other files ---------------------------------------------------------
# The phases of the game (appraisal.lang: appraisal.phase.* = "a abertura", "o meio-jogo",
# "o final", with their article) merged with "em" and "de": "{text:em}" = "na abertura"
# ("Jogaste muito bem {text:em}."), "{text:de}" = "da abertura".
appraisal.phase.opening.em = na abertura
appraisal.phase.opening.de = da abertura
appraisal.phase.middlegame.em = no meio-jogo
appraisal.phase.middlegame.de = do meio-jogo
appraisal.phase.endgame.em = no final
appraisal.phase.endgame.de = do final
