# Coach speech (European Portuguese): the building blocks every line uses (src/coach/catalog.cpp
# renders them). Same keys as assets/coach/speech/en/common.lang, plus the grammatical forms
# Portuguese needs. Portugal's usage and spelling (AO90): see the glossary of the translation.
# Register: the coach says "tu" to the player (the game menus stay formal: "o seu", "Selecione");
# the coach is male ("estou contente", "obrigado"). The player's gender is unknown: no adjective or
# participle agreeing with the player ("pronto", "atento", "bem-vindo"); verbs never agree with
# gender, so every tense is fine ("ganhaste", "jogaste"). Portuguese of Portugal: "estar a" +
# infinitive (never the gerund), enclitic pronouns ("Toma-o", "Mostro-te").

# ---- Pieces --------------------------------------------------------------------------------------
# Nouns and genders: o peão, o cavalo, o bispo, o rei (m); a torre, a dama (f).
# European Portuguese puts the definite article before a possessive ("o teu cavalo", "a minha
# torre"), so every piece placeholder carries its article, and the prepositions de, a, em and por
# merge with that article ("do teu cavalo", "à tua torre", "no meu bispo", "pela minha dama").
# Never write one of these four prepositions before a plain placeholder ("de {your}" would say
# "de o teu cavalo"): ask for the form that contains it. The renderer capitalises a placeholder
# that starts a sentence ("O teu cavalo...", "Este é...").
# Owners: your = "o teu cavalo / a tua torre", my = "o meu cavalo / a minha torre"; the Analysis
# mode: white = "o cavalo branco / a torre branca", black = "o cavalo preto / a torre preta".
# Every form below is defined for all six pieces and all four owners (examples with your / my):
#   nom   o teu cavalo / a tua torre       subject or object, and after the prepositions that do
#                                          not merge (com, para, contra, sem, sobre, entre, como):
#                                          "{your} não se move assim.", "Toma {my} com a tua torre!"
#                                          Also after "de" before an infinitive, which Portugal
#                                          keeps apart: "antes de {your} se mexer".
#   de    do teu cavalo / da tua torre     "{t2} está mesmo atrás {t1:de}.", "a segurança {your:de}"
#   a     ao teu cavalo / à tua torre      "Dás xeque {my:a}.", "até {my:a}", "um garfo {t1:a} e {t2:a}"
#   em    no teu cavalo / na tua torre     "Pensa {your:em}.", "Repara {my:em}."
#   por   pelo teu cavalo / pela tua torre "{your} está atacad{your:o} {my:por}."
#   bare  cavalo / torre                   the noun alone, without article or owner, after a word
#                                          of the line that agrees with it: "{your:um} {your:bare}"
#                                          (see "um" below)
# Forms that stand for the piece without naming it: pronouns, the article alone, endings. A line
# still names the piece in full ({your}, {my:de}...): the coach points at it where its placeholder
# first appears.
#   ele   ele / ela      after a preposition that does not merge: "com {my:ele}", "sem {your:ele}";
#                        as a subject only for emphasis (Portuguese drops it: "Move-se na diagonal.")
#   dele  dele / dela    "{my} ataca {t1}, e {t2} está mesmo atrás {t1:dele}." ("its" is more often
#                        "o seu / a sua", which agrees with the thing owned and needs no form:
#                        "a sua casa", "a sua diagonal")
#   nele  nele / nela    "Não toques {your:nele}."
#   o     o / a          the object pronoun: "Toma-{my:o}!", "para {my:o} capturar", "Não {your:o}
#                        percas."; the article alone: "{t1:o} primeir{t1:o}" = "o primeiro / a
#                        primeira"; the -o / -a ending of an adjective or participle written after
#                        the piece it agrees with: "{your} está cravad{your:o}." = "cravado /
#                        cravada" (also "sozinh{your:o}", "pres{your:o}", "protegid{your:o}")
#   lo    lo / la        after a verb form that drops its final -r, -s or -z: "Podes capturá-{my:lo}.",
#                        "para tomá-{my:lo}", "defendê-{your:lo}"
#   no    no / na        after a verb form ending in a nasal sound: "As minhas peças atacam-{your:no}.",
#                        "põe-{your:no}"
#   um    um / uma       with bare, for a statement about that kind of piece: "{your:um} {your:bare}
#                        pres{your:o} acaba perdid{your:o}." = "Um bispo preso..." / "Uma torre presa..."
#   este  este / esta    "{your:este} é {your}." = "Este é o teu cavalo." / "Esta é a tua torre."
#   esse  esse / essa    "Olha para {your}: {your:esse} é o problema."
# Two pieces together ("{t1} e {t2}") would need a plural agreeing with both (masculine unless both
# are feminine): no form can give it, so rephrase with "peça(s)" ("as duas peças", "uma das duas
# peças") or with a verb ("atacas {t1} e {t2} ao mesmo tempo").
