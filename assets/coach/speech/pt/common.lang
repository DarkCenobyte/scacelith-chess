# ---- Squares, files and ranks (spoken) -----------------------------------------------------------
# File letters are said by their Portuguese names: "á quatro", "bê cinco", "é quatro", "efe três",
# "agá sete". The "a" carries its accent so that the voice says the letter, not the unstressed
# article or preposition "a" ("a quatro"). A bare "é" melts into the word before it ("toma em é
# cinco" is said "toma em cinco", "para é quatro" adds 10 ms to "para quatro"): "éh" is the same
# letter, held a little longer, and is heard far more often (82 times in 111 against 55).
square.spoken = {file} {rank}
file.a.spoken = á
file.b.spoken = bê
file.c.spoken = cê
file.d.spoken = dê
file.e.spoken = éh
file.f.spoken = efe
file.g.spoken = gê
file.h.spoken = agá
rank.1.spoken = um
rank.2.spoken = dois
rank.3.spoken = três
rank.4.spoken = quatro
rank.5.spoken = cinco
rank.6.spoken = seis
rank.7.spoken = sete
rank.8.spoken = oito

# ---- Moves ---------------------------------------------------------------------------------------
# Portuguese scoresheet letters: R(ei) D(ama) T(orre) B(ispo) C(avalo): "Cf3", "Txd1", "Bb5+".
move.letters = R D T B C
# Spoken as Portuguese players read notation: "cavalo efe três", "cavalo toma em é cinco",
# "cavalo bê dê sete", "peão é toma em dê cinco", "peão retoma" (a recapture on the same square),
# "roque pequeno", "é oito, promoção a dama", "dama gê quatro, xeque". {piece} is the bare noun.
move.piece.spoken = {piece} {to}
move.piece_capture.spoken = {piece} toma em {to}
move.piece_from.spoken = {piece} {from} {to}
move.piece_from_capture.spoken = {piece} {from} toma em {to}
move.pawn.spoken = {to}
move.pawn_capture.spoken = peão {file} toma em {to}
move.recapture.spoken = {piece} retoma
move.castle_short.spoken = roque pequeno
move.castle_long.spoken = roque grande
move.promotion.spoken = {move}, promoção a {piece}
move.check.spoken = {move}, xeque
move.mate.spoken = {move}, xeque-mate
moves.join.spoken = {a}, {b}

# ---- Respellings (spoken) ------------------------------------------------------------------------
# Words the voice misreads, respelled in every spoken line (src/coach/catalog.h). An initial "x"
# is unstable: right in "xeque" alone, but "s" in "xeque-mate" ("seque-mate"), "xeques" and half the
# time "xadrez" ("sadrez"): "ch" is the same sound, always read right ("xeque" in "xeque-mate" is a
# word of its own, so one key covers both). "en passant" the French way (the voice says "em
# passante", with the t). "troco" in "a troco de nada" is read with the open o of the verb ("eu
# troco"): every line has the noun; a line with the verb would need its own .spoken line.
respell.xeque = cheque
respell.xeques = cheques
respell.xadrez = chadrez
respell.en = ã
respell.passant = passã
respell.troco = trôco

# ---- Numbers -------------------------------------------------------------------------------------
