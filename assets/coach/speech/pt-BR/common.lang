# ---- Squares, files and ranks (spoken) -----------------------------------------------------------
# Files are said by the Brazilian names of their letters (á, bê, cê, dê, é, efe, gê, agá), so that
# "a4" is not heard as the article "a" and "e4" not as the conjunction "e": e4 = "é quatro",
# f5 = "efe cinco", h7 = "agá sete". A square takes no article: "para {sq}", "em {sq}", "de {sq}",
# or "a casa {sq}" (never "no {sq}" / "na {sq}").
# The e is written "éh" for the voice: a bare "é" melts into the word before it ("toma em é cinco" is
# said "toma em cinco", "para é quatro" "para quatro", "até é quatro" "até quatro"); "éh" is the same
# letter, held a little longer, and is heard far more often (36 times in 54 against 24, as in
# European Portuguese).
square.spoken = {file} {rank}
file.a.spoken = á
file.b.spoken = bê
file.c.spoken = cê
file.d.spoken = dê
file.e.spoken = éh
file.f.spoken = efe
file.g.spoken = gê
file.h.spoken = agá
rank.1.spoken = um
rank.2.spoken = dois
rank.3.spoken = três
rank.4.spoken = quatro
rank.5.spoken = cinco
rank.6.spoken = seis
rank.7.spoken = sete
rank.8.spoken = oito

# ---- Moves ---------------------------------------------------------------------------------------
# Brazilian scoresheet letters: R(ei) D(ama) T(orre) B(ispo) C(avalo): "Cf3", "Bxc4", "Txd1".
move.letters = R D T B C
# Spoken as Brazilian players read notation: "cavalo efe três", "cavalo toma em é cinco",
# "cavalo bê dê sete", "é toma em dê cinco", "peão retoma", "roque pequeno", "é oito, promoção a
# dama", "dama gê quatro, xeque". {piece} is the bare noun here (piece.<type>.nom).
move.piece.spoken = {piece} {to}
move.piece_capture.spoken = {piece} toma em {to}
move.piece_from.spoken = {piece} {from} {to}
move.piece_from_capture.spoken = {piece} {from} toma em {to}
move.pawn.spoken = {to}
move.pawn_capture.spoken = {file} toma em {to}
move.recapture.spoken = {piece} retoma
move.castle_short.spoken = roque pequeno
move.castle_long.spoken = roque grande
move.promotion.spoken = {move}, promoção a {piece}
move.check.spoken = {move}, xeque
move.mate.spoken = {move}, xeque-mate
moves.join.spoken = {a}, {b}

# ---- Respellings (spoken) ------------------------------------------------------------------------
# Words the voice misreads, respelled in every spoken line (src/coach/catalog.h; the findings are in
# docs/PRONUNCIATION.md). The voice is the European Portuguese one: these only fix a wrong reading,
# they do not try for a Brazilian accent. An initial "x" is unstable: often right in "xeque" alone,
# but "s" in "xeque-mate" ("sec mate"), "xeques" ("sex"), "um xeque" and "xadrez" ("sadrez"): "ch"
# is the same sound and always read right ("xeque" in "xeque-mate" is a word of its own, so one key
# covers both). "en passant" is said "em passante", with the t: the French nasals instead.
respell.xeque = cheque
respell.xeques = cheques
respell.xadrez = chadrez
respell.en = ã
respell.passant = passã
# Nouns read with the open o of the verb ("eu tróco", "eu tórno"): "a troco de nada" (heard "a troca
# de nada" 6 times in 6, "troco" 4 in 6 respelled) and "em torno de" (every use is the noun; a line
# with the verb would need its own .spoken line).
respell.troco = trôco
respell.torno = tôrno
# Eponyms: the voice reads a w as in English and a j as in "jogo" ("Nimzo-witch", "Nash-dorf",
# "Tarta-call", "Horweeds", "Fajaro-wix"): spelled as Brazilian players say them, stressed as the
# names are.
respell.fajarowicz = faiaróvitch
respell.najdorf = naidorf
respell.nimzowitsch = nimzóvitch
respell.winawer = vináver
respell.bogoljubow = bogoliúbov
respell.tartakower = tartakóver
respell.janowski = ianóvski
respell.horwitz = hórvitz

# ---- Numbers -------------------------------------------------------------------------------------
# Spoken number words, Brazilian forms (dezesseis, dezessete, dezenove, quatorze). 21-99 compose as
# "{tens} e {units}" ("vinte e três"), 201-999 as "{hundreds} e {rest}" ("trezentos e quarenta e
# cinco"). 100 is "cem" alone but "cento" before the rest: 101-199 are listed. The form "f" is the
# feminine before a feminine noun ("uma peça", "duas casas", "vinte e uma vezes", "duzentas
# partidas"); the bare number is masculine ("um lance", "dois pontos"). Only the round hundreds have
# a feminine word: 201-999 before a feminine noun keep "duzentos..." (no feminine counted noun of the
# coach reaches 200: pieces, squares, positions, inaccuracies, times). Move numbers stay cardinal, as
# Portuguese says them ("no lance vinte e um"): no ordinal forms are needed.
