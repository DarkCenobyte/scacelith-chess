# ---- Counted nouns ---------------------------------------------------------------------------------
# Brazilian Portuguese plural rule (assets/i18n): one (0 and 1) | other, so 0 takes the singular
# ("0 erro"): a line about none says "nenhum erro" instead of a count. Feminine nouns say their number
# with the form "f": "uma posição", "duas peças", "vinte e uma vezes".
count.move = {n} lance|{n} lances
count.point = {n} ponto|{n} pontos
count.pawn = {n} peão|{n} peões
count.piece = {n:f} peça|{n:f} peças
count.mistake = {n} erro|{n} erros
count.blunder = {n} erro grave|{n} erros graves
count.inaccuracy = {n:f} imprecisão|{n:f} imprecisões
count.game = {n:f} partida|{n:f} partidas
count.time = {n:f} vez|{n:f} vezes
count.square = {n:f} casa|{n:f} casas
count.position = {n:f} posição|{n:f} posições
# "{n:f}" in a line says a bare number in the feminine ("uma", "duas", "vinte e uma"); it is a count
# key so that the form also works outside the counted nouns (and the form check knows it).
count.f = {n:f}|{n:f}
# More counted nouns for the review and appraisal lines: "{n:check}" = "dois xeques", "{n:capture}" =
# "três capturas" (pawns included, unlike "peça"), "{n:attacker}" / "{n:defender}" = "dois atacantes",
# "um defensor" (the pieces that attack or defend a square).
count.check = {n} xeque|{n} xeques
count.capture = {n:f} captura|{n:f} capturas
count.attacker = {n} atacante|{n} atacantes
count.defender = {n} defensor|{n} defensores
# Percentages (accuracy): "{acc:percent}" = "85%" in the subtitles, "oitenta e cinco por cento" spoken.
count.percent = {n}%|{n}%
count.percent.spoken = {n} por cento|{n} por cento

# ---- Evaluations (the strongest levels) ------------------------------------------------------------
# From the listener's point of view. {x} = pawns with one decimal (number.decimal), {n} = moves (a bare
# number: "mate em três", the word "lances" understood).
eval.up = +{x}
eval.up.spoken = mais {x}
eval.down = −{x}
eval.down.spoken = menos {x}
eval.even = 0,0
eval.even.spoken = igualdade
eval.mate_win = mate em {n}
eval.mate_loss = mate em {n} contra você
