# A decimal number: Italian writes a decimal comma ("1,3") and says "uno virgola tre".
number.decimal = {int},{frac}
number.decimal.spoken = {int} virgola {frac}

# ---- Counted nouns ---------------------------------------------------------------------------------
# Italian plural rule (assets/i18n): one (exactly 1) | other (0 included: "zero mosse"). The "one"
# form says its number with the form of the noun's gender ("una mossa", "un punto"); the "other" form
# says the bare number ("ventuno mosse"). Spoken, "una imprecisione" elides to "un’imprecisione"
# (the subtitles write "1 imprecisione").
count.move = {n:f} mossa|{n} mosse
count.point = {n:m} punto|{n} punti
count.pawn = {n:m} pedone|{n} pedoni
count.piece = {n:m} pezzo|{n} pezzi
count.mistake = {n:m} errore|{n} errori
count.blunder = {n:m} errore grave|{n} errori gravi
count.inaccuracy = {n:f} imprecisione|{n} imprecisioni
count.inaccuracy.spoken = un’imprecisione|{n} imprecisioni
count.game = {n:f} partita|{n} partite
count.time = {n:f} volta|{n} volte
count.square = {n:f} casa|{n} case
count.position = {n:f} posizione|{n} posizioni
# More counted nouns for the review, appraisal and analysis lines: "{m:check}" = "uno scacco" /
# "3 scacchi", "{n:capture}" = "una cattura", "{n:captured}" = "un pezzo catturato" / "3 pezzi
# catturati" (the participle agrees with the number: "{n:piece} captured"), "{n:attacker}" /
# "{n:defender}" = "2 attaccanti", "un difensore", "{n:best_move}" = "5 mosse migliori".
count.check = {n} scacco|{n} scacchi
count.capture = {n:f} cattura|{n} catture
count.captured = {n:m} pezzo catturato|{n} pezzi catturati
count.attacker = {n:m} attaccante|{n} attaccanti
count.defender = {n:m} difensore|{n} difensori
count.best_move = {n:f} mossa migliore|{n} mosse migliori
# Percentages (accuracy): "{acc:percent}" = "85%" in the subtitles, "ottantacinque per cento" spoken.
count.percent = {n}%|{n}%
count.percent.spoken = {n} per cento|{n} per cento
# "{n:m}" / "{n:f}" say a bare number before a masculine / feminine noun, or alone in the feminine
# ("matto in {m:f}" = "matto in una", "ne hai corrette {m:f}"); the subtitles write the digits.
# They are count keys so that the forms also work outside the counted nouns (and the form check
# knows them).
count.m = {n:m}|{n:m}
count.f = {n:f}|{n:f}

# ---- Evaluations (the strongest levels) ------------------------------------------------------------
# From the listener's point of view. {x} = pawns with one decimal (number.decimal), {n} = moves.
# {n} is a bare number here: the form "f" says "matto in una" (mossa) for a mate in one.
eval.up = +{x}
eval.up.spoken = più {x}
eval.down = −{x}
eval.down.spoken = meno {x}
eval.even = 0,0
eval.even.spoken = parità
eval.mate_win = matto in {n:f}
eval.mate_loss = matto in {n:f} contro di te

# ---- Forms of the phase names (appraisal.lang {text}) -------------------------------------------
# appraisal.phase.* carry their article ("l’apertura", "il mediogioco", "il finale"). With a form,
# "{text:<form>}" says: di = "dell’apertura", a = "all’apertura", da = "dall’apertura", in =
# "nell’apertura" ("Hai giocato benissimo {text:in}."), su = "sull’apertura", bare = "apertura" (no
# article), o = the ending that agrees with the phase (l’apertura: a; il mediogioco, il finale: o).
appraisal.phase.opening.di = dell’apertura
appraisal.phase.opening.a = all’apertura
appraisal.phase.opening.da = dall’apertura
appraisal.phase.opening.in = nell’apertura
appraisal.phase.opening.su = sull’apertura
appraisal.phase.opening.bare = apertura
appraisal.phase.opening.o = a
appraisal.phase.middlegame.di = del mediogioco
appraisal.phase.middlegame.a = al mediogioco
appraisal.phase.middlegame.da = dal mediogioco
appraisal.phase.middlegame.in = nel mediogioco
appraisal.phase.middlegame.su = sul mediogioco
appraisal.phase.middlegame.bare = mediogioco
appraisal.phase.middlegame.o = o
appraisal.phase.endgame.di = del finale
appraisal.phase.endgame.a = al finale
appraisal.phase.endgame.da = dal finale
appraisal.phase.endgame.in = nel finale
appraisal.phase.endgame.su = sul finale
appraisal.phase.endgame.bare = finale
appraisal.phase.endgame.o = o
