# ---- Squares, files and ranks (spoken) -----------------------------------------------------------
# Files are said by the Italian names of their letters, ranks by number words (the opening texts use
# the same words): "e quattro", "effe tre", "di cinque", "acca sette", "ci sei".
square.spoken = {file} {rank}
file.a.spoken = a
file.b.spoken = bi
file.c.spoken = ci
file.d.spoken = di
file.e.spoken = e
file.f.spoken = effe
file.g.spoken = gi
file.h.spoken = acca
rank.1.spoken = uno
rank.2.spoken = due
rank.3.spoken = tre
rank.4.spoken = quattro
rank.5.spoken = cinque
rank.6.spoken = sei
rank.7.spoken = sette
rank.8.spoken = otto

# ---- Moves ---------------------------------------------------------------------------------------
# Italian scoresheet letters (FSI): R(e) D(onna) T(orre) A(lfiere) C(avallo): "Cf3", "Txd1", "e8=D".
move.letters = R D T A C
# Spoken as Italian players read notation: "cavallo effe tre", "cavallo prende in e cinque",
# "cavallo bi di due" (Nbd2), "pedone e prende in di cinque", "pedone riprende" (a recapture in a
# line), "arrocco corto", "e otto, promozione a donna", "donna gi quattro, scacco",
# "torre di otto, scacco matto". {piece} is the noun alone (piece.<type>.nom).
move.piece.spoken = {piece} {to}
move.piece_capture.spoken = {piece} prende in {to}
move.piece_from.spoken = {piece} {from} {to}
move.piece_from_capture.spoken = {piece} {from} prende in {to}
move.pawn.spoken = {to}
move.pawn_capture.spoken = pedone {file} prende in {to}
move.recapture.spoken = {piece} riprende
move.castle_short.spoken = arrocco corto
move.castle_long.spoken = arrocco lungo
move.promotion.spoken = {move}, promozione a {piece}
move.check.spoken = {move}, scacco
move.mate.spoken = {move}, scacco matto
moves.join.spoken = {a}, {b}

# ---- Respellings (spoken) ------------------------------------------------------------------------
# Words the voice misreads, respelled in every spoken line, opening texts included (src/coach/catalog.h;
# the findings are in docs/PRONUNCIATION.md). Whole words only: an apostrophe or a hyphen ends a word
# ("l’en passant", "Caro-Kann").
# "fianchetto" is read with the c of "cena" (heard "fiancetto" 11 times in 21, right 7): k keeps the
# hard c (right 16 in 21, never "fiancetto").
respell.fianchetto = fianketto
respell.fianchetti = fianketti
# "en passant" the French way, as Italian players say it: the voice says "en passant" with its t
# (heard "in passante", a t 19 times in 21; 6 in 21 respelled). "en" is only this French word here.
respell.en = an
respell.passant = passàn
# "lettone" (gambetto lettone) is stressed on the first syllable, "lèttone" (heard "letto" 7 times in
# 9); the accent puts the stress back on the o (heard right 8 times in 9).
respell.lettone = lettóne
# "settima" (the seventh rank) loses its stress on the first syllable (heard "settimana" 6 times in 9);
# marked, it is heard right 9 times in 9.
respell.settima = sèttima
# Foreign words: Pirc ends in ts (the voice says "pirch", heard "Pirce", "Peach"), Grand Prix the French
# way (the d and the x were said), the French "clou" is "clu" (the voice says "clo-u", heard "Clau").
respell.pirc = Pirts
respell.grand = Gran
respell.prix = Prì
respell.clou = clu

# ---- Numbers -------------------------------------------------------------------------------------
# Spoken number words, one word each as Italian writes them. 21-99 compose as "{tens}{units}"
# ("ventidue", "quarantasei") except where Italian changes the joint, listed: a ten drops its final
# vowel before uno and otto ("ventuno", "trentotto"), and a final tre takes an accent ("ventitré").
# Hundreds: "cento", then "{n}cento" ("duecento" ... "novecento"); 101-999 compose as
# "{hundreds}{rest}" ("centoventi", "trecentoquarantadue") except, listed: x01 keeps the o of cento
# ("centouno", "duecentouno"), x03 takes the accent ("centotré"), and cento drops its o before otto
# and ottanta ("centotto", "centottanta", "novecentottantotto").
# Forms: "m" = before a masculine noun ("un punto", "un errore"), "f" = before a feminine noun or
# alone for a feminine one ("una mossa", "matto in una"); the bare word is the counting form ("uno",
# also right before s + consonant: "uno scacco"). Only 1 changes: 21, 31 ... stay "ventuno"
# ("ventuno mosse"), and x01 is listed so that no form reaches its "uno" ("centouno punti").
