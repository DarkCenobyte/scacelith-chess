# Croatian plural rule (assets/i18n): one (1, 21, 31, 101 ...; not 11) | few (2-4, 22-24 ...; not
# 12-14) | other (0, 5-20, 25-30, 111 ...). The base key is the nominative; case keys for the
# sentences that need them:
#   {n:mistake}       nominative: "{n:mistake}" = "jedna pogreška / dvije pogreške / pet pogrešaka"
#   {n:mistake_acc}   accusative: "Bijeli je napravio {n:mistake_acc}." = "jednu pogrešku", also
#                     after "uz": "uz {n:mistake_acc}"
#   {n:move_gen}      genitive (after nakon, do, od, bez, iz ...): "nakon {n:move_gen}" = "nakon
#                     jednog poteza / dva poteza / pet poteza"
#   {n:move_loc}      locative, also the dative: "mat u {m:move_loc}" = "mat u jednom potezu / u dva
#                     poteza / u pet poteza" (the Croatian way to say "mate in N")
