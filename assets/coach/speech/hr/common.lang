# Coach speech (Croatian): the building blocks every line uses (src/coach/catalog.cpp renders them).
# Same keys as assets/coach/speech/en/common.lang, plus the grammatical forms Croatian needs.
# Standard Croatian (ijekavian) and the chess words of Croatian chess books: kralj, dama, top, lovac,
# skakač, pješak; šah, mat, pat, remi, rokada. Croatian forms, never Serbian ones: obrana, sustav,
# točno, pješak, bijeli, vrijeme (not odbrana, sistem, tačno, pešak, beli, vreme).
# Register: the coach says "ti" to the player (the game menus stay formal, "vi"). The coach is male
# ("odigrao sam", "bio sam siguran"); the player's gender is unknown: no second-person past tense or
# conditional ("odigrao si", "mogao bi"), no adjective or participle agreeing with the player
# ("siguran", "spreman"): present or future tense, "ako uzmeš", impersonal forms ("trebalo je",
# "moglo se") and noun phrases instead. Short possessives: tvog, tvom, mog, mom, svog, svom.

# ---- Pieces --------------------------------------------------------------------------------------
# Nouns: pješak, skakač, lovac, top, dama (f), kralj. Animacy: pješak, skakač, lovac and kralj are
# animate (accusative = genitive: "uzmi mog skakača"); top is inanimate (accusative = nominative:
# "uzmi moj top", the standard form; "topa" is colloquial). Genders: m = masculine animate,
# mi = masculine inanimate (top), f = feminine (dama). Owner patterns: a pattern without a gender
# suffix is the masculine one (both animacies), ".f" the feminine, ".mi" only where the inanimate
# masculine differs (the accusative). Owners: your = tvoj, my = moj; the Analysis mode names a piece
# by its side, nobody being "ti" or "ja" there: white = bijeli, black = crni ("bijeli skakač",
# "crnu damu"). EVERY form below is defined for all six pieces and all four owners, and works the
# same for {your}, {your2}, {my}, {my2}, {t1}, {t2} and the Analysis {piece}.
# With the possessive (tvoj / moj / bijeli / crni), the seven cases:
#   nom       tvoj skakač / tvoja dama               "{your} je vezan{your:ag}." (the default)
#   gen       tvog skakača / tvoje dame              "Iza {your:gen} stoji {t1}."
#   dat       tvom skakaču / tvojoj dami             "{my} prijeti {your:dat}."
#   acc       tvog skakača / tvoju damu / tvoj top   "Uzmi {my:acc}!"
#   loc       tvom skakaču / tvojoj dami             "Sve ovisi o {my:loc}."
#   ins       tvojim skakačem / tvojom damom         "Pred {your:ins} je slobodan put."
#   voc       tvoj skakaču / tvoja damo              (not used yet)
# The reflexive possessive "svoj" when the owner is the subject of the clause (the player of an
# imperative, the coach saying "ja", the side in Analysis): Croatian says "svoj" there, not "tvoj".
#   refl_gen  svog skakača / svoje dame              "Ne ostaj bez {your:refl_gen}."
#   refl_dat  svom skakaču / svojoj dami             "Pomozi {your:refl_dat}."
#   refl_acc  svog skakača / svoju damu / svoj top   "Razvij {your:refl_acc}."
#   refl_loc  svom skakaču / svojoj dami             "Razmisli o {your:refl_loc}."
#   refl_ins  svojim skakačem / svojom damom         "Uzmi {my:acc} {your:refl_ins}."
# Without a possessive (the kind of piece; "Uzmi damom!" is more natural than "tvojom damom"):
#   bare      skakač / dama                          "Ovo je {your:bare}: kreće se u obliku slova L."
#   bare_gen  skakača / dame                         "Čuvaj se {my:bare_gen}!"
#   bare_dat  skakaču / dami                         "Pomozi {your:bare_dat}."
#   bare_acc  skakača / damu / top                   "Uzmi {my:bare_acc}!"
#   bare_loc  skakaču / dami                         "Razmisli o {your:bare_loc}."
#   bare_ins  skakačem / damom                       "Igraj {your:bare_ins}."
# Pronouns for the piece (same words for every owner). Croatian drops subject pronouns: "pron" only
# for emphasis or contrast. The clitics (ga, ju, mu, joj) stand second in their clause; after a
# preposition use the full forms. The feminine accusative clitic is "ju" (standard Croatian), never
# "je", which would read as "is".
#   pron           on / ona                          "Samo {your:pron} brani to polje."
#   pron_acc       ga / ju (clitic)                  "Uzmi {my:pron_acc}!", "{my} {your:pron_acc} napada."
#   pron_acc_full  njega / nju                       "Pazi na {your:pron_acc_full}."
#   pron_gen       njega / nje                       "{t2} stoji iza {t1:pron_gen}."
#   pron_dat       mu / joj (clitic)                 "Ne možeš {your:pron_dat} pomoći."
#   pron_loc       njemu / njoj (= stressed dative)  "Sve ovisi o {my:pron_loc}.", "prema {my:pron_loc}"
#   pron_ins       njim / njom                       "Pred {your:pron_ins} nema ničega."
#   poss           njegov / njezin: the stem of "its"; add the ending of the possessed noun:
#                  "{your:poss}o polje" = "njegovo / njezino polje", "{your:poss}i pješaci". When the
#                  piece is the subject of the clause, "svoj" instead: "{your} je iza svojih pješaka."
# The relative pronoun "which", agreeing with the piece:
#   rel            koji / koja                       "{my}, {my:rel} stoji na {sq}, ..."
#   rel_acc        kojeg / koju / koji (top)         "{your}, {your:rel_acc} ostavljaš bez obrane, ..."
#   rel_gen        kojeg / koje                      "{t1}, iza {t1:rel_gen} stoji {t2}, ..."
#   rel_loc        kojem / kojoj (also the dative)   "{my}, o {my:rel_loc} sve ovisi, ..."
#   rel_ins        kojim / kojom                     "{my}, pred {my:rel_ins} nema ničega, ..."
# Agreement endings, empty for a masculine piece. Glue one to a word that agrees with the piece, and
# say the piece placeholder itself first (the coach points at the piece on its first placeholder):
#   ag    "" / "a"    passive participles and adjectives without a fleeting a (vezan, napadnut,
#                     zarobljen, izgubljen, nebranjen, nezaštićen, izložen, otvoren, prespor, sam):
#                     "{your} je vezan{your:ag}." = "Tvoj skakač je vezan." / "Tvoja dama je vezana."
#   agi   "i" / "a"   comparatives and long adjectives: "{my} je jač{my:agi}." = "jači" / "jača"
#   pt    "o" / "la"  past tense of verbs whose masculine ends in a vowel + o (bio, imao, ostao, pao,
#                     uzeo, stajao, branio, trebao): "{my} je bi{my:pt} nebranjen{my:ag}."
#   pt2   "ao" / "la" the same for consonant stems (mogao, pobjegao, našao, otišao, došao):
#                     "{my} ne bi mog{my:pt2} pobjeći." = "mogao" / "mogla"
# Adjectives with a fleeting a (slobodan / slobodna, siguran / sigurna) and verbs with ije / je in
# the stem (visio / visjela, vidio / vidjela, htio / htjela) fit none of these: rephrase, or use the
# present ("{my} visi").
