# Coach speech (Croatian): the review of the player's moves (src/coach/review.cpp, review_explain.cpp).
# Same keys and variants as assets/coach/speech/en/review.lang (its header documents every placeholder).
#
# Placeholders: {your} {your2} = the player's piece with "tvoj", {my} {my2} = the coach's piece with
# "moj", {t1} {t2} = a piece of EITHER side (the possessive comes with it). Case forms from
# common.lang: gen dat acc loc ins, refl_* ("svoj" when the player or the coach is the subject:
# "Pogledaj {your:refl_acc}"), bare_ins ("igrati damom"), pron_* (ga / ju, mu / joj, njega / nje),
# rel, poss, and the endings ag pt pt2 agi glued to a word that agrees with the piece
# ("vezan{your:ag}", "bi{my:pt}", "mog{your:pt2}", "sigurnij{your:agi}"; ag only in the nominative).
# Counted nouns: {m:move_loc} "mat u 2 poteza", {pts:point_acc} "gubiš 3 boda", {n:time} "3 puta",
# {n:attacker} / {n2:defender_gen} "3 napadača protiv 2 branitelja", {n:square_acc}, {n:move_acc};
# "Mate in {m}" uses {m:mv} ("mat u 4", spoken "mat u četiri poteza"). A verb never agrees with a
# counted noun (its form changes with the number): the lines are phrased around it.
# {text} = a mate pattern name (name.pattern.*, nominative, after "zove se" and "to je").
# Rules the lines follow (see the glossary): the coach says "ti" and is male ("odigrao sam"); no
# second-person past tense or conditional and no adjective agreeing with the player ("propustio si",
# "mogao bi", "siguran"): present or future tense, impersonal forms ("moglo se", "bolje je bilo
# {best}", "propušten je mat", "promaklo ti je") and nouns instead.
# A move is often introduced by "potez" ("Potez {best} bio je bolji", "nakon poteza {move}",
# "potezom {best}"): the spoken move ("skakač uzima na e pet") contains a verb, and "potez" carries
# the case and the masculine agreement. Squares: "na {sq}", "na polju {sq}", "s polja {sq}", never
# an ending on {sq}. Levels 1-2: simple words, at most about 15 words per sentence; 5-6: terse.

# ---- Announcements (either side's move) -------------------------------------------------------
# The player gives check (levels 1-2: say what it means).
ann.check.human.b1 = Šah! Moj kralj je napadnut.
ann.check.human.b1.2 = Šah! Napadaš mog kralja.
ann.check.human.b1.3 = To je šah! Moj kralj mora izaći iz šaha.
ann.check.human = Šah.
ann.check.human.2 = Šah!
ann.check.human.3 = I to je šah.
# The coach gives check.
ann.check.coach = Šah!
ann.check.coach.2 = Šah.
ann.check.coach.3 = I šah!
# Once per game at levels 1-2, right after the coach's first check ({your} = the player's king).
ann.check.coach.first = To znači da je {your} napadnut{your:ag}. Moraš {your:pron_acc} izvući iz šaha.
ann.check.coach.first.2 = Šah znači da je {your} napadnut{your:ag}. Pomakni {your:pron_acc}, zakloni {your:pron_acc} ili uzmi moju figuru.
ann.double_check.coach = Dvostruki šah! Dvije moje figure odjednom napadaju tvog kralja, pa se kralj mora pomaknuti.
ann.double_check.coach.2 = To je dvostruki šah: sad pomaže samo potez kraljem.
ann.double_check.human = Dvostruki šah! Dvije tvoje figure odjednom napadaju mog kralja, pa se kralj mora pomaknuti.
ann.double_check.human.2 = Dvostruki šah! Sad me može spasiti samo potez kraljem.
# The player checkmates the coach.
ann.mate.human.b1 = Mat! Pobjeda je tvoja! Moj kralj ne može pobjeći.
ann.mate.human.b1.2 = To je mat! Bravo, partija je tvoja!
ann.mate.human.b1.3 = Mat! Moj kralj je u klopci. Čestitam!
ann.mate.human = Mat. Dobro odigrano.
ann.mate.human.2 = To je mat. Čestitam.
ann.mate.human.3 = Mat! Lijepo izvedeno.
# The coach checkmates the player.
ann.mate.coach.b1 = To je mat. Tvoj kralj nema izlaza.
ann.mate.coach.b1.2 = Mat. Tvoj kralj je napadnut i ne može pobjeći.
ann.mate.coach.b1.3 = Bojim se da je to mat. Tvoj kralj ne može umaknuti.
ann.mate.coach = Mat.
ann.mate.coach.2 = I to je mat.
ann.mate.coach.3 = Mat, nažalost.

# ---- Verdicts (the first sentence about a bad move) --------------------------------------------
ex.verdict.blunder.b1 = Ups! Tim potezom nešto poklanjaš.
ex.verdict.blunder.b1.2 = Pazi! Taj te potez može skupo stajati.
ex.verdict.blunder.b1.3 = Oh, čekaj. S tim potezom nešto ne valja.
ex.verdict.blunder.b2 = Hmm, taj potez ima jednu manu.
ex.verdict.blunder.b2.2 = To je velika pogreška.
ex.verdict.blunder.b2.3 = Pazi, tim potezom nešto gubiš.
ex.verdict.blunder.b3 = To je gruba pogreška.
ex.verdict.blunder.b3.2 = Potez {move} je prava pogreška.
ex.verdict.blunder.b3.3 = Joj, potez {move} je velika pogreška.
ex.verdict.blunder.b4 = Potez {move} je gruba pogreška.
ex.verdict.blunder.b4.2 = Potez {move} je ozbiljna pogreška.
ex.verdict.blunder.b4.3 = Bojim se da je to gruba pogreška.
ex.verdict.blunder.b5 = {move} je ozbiljna pogreška.
ex.verdict.blunder.b5.2 = {move} je gruba pogreška.
ex.verdict.blunder.b5.3 = {move} je skupa pogreška.
ex.verdict.blunder.b6 = {move} je teška pogreška.
ex.verdict.blunder.b6.2 = {move} je gruba pogreška.
ex.verdict.blunder.b6.3 = {move}? Gruba pogreška.
# A blunder that leaves the coach's threat standing (levels 1-2: the threat the engine found after the
# coach's last move is what the reply carries out).
ex.verdict.ignored.b1 = Ups! Moja prijetnja ostala je bez odgovora.
ex.verdict.ignored.b1.2 = Pazi! Moja je prijetnja još uvijek bila tu.
ex.verdict.ignored.b1.3 = Oh, čekaj. A što je s mojom prijetnjom?
ex.verdict.ignored.b2 = Hmm, moja je prijetnja još uvijek bila tu.
ex.verdict.ignored.b2.2 = Na moju prijetnju nije bilo odgovora.
ex.verdict.ignored.b2.3 = Pazi, na moju prijetnju trebalo je odgovoriti.
ex.verdict.mistake.b3 = To nije dobar potez.
ex.verdict.mistake.b3.2 = Hmm, potez {move} ima jednu manu.
ex.verdict.mistake.b3.3 = To je pogreška.
ex.verdict.mistake.b4 = Potez {move} je pogreška.
ex.verdict.mistake.b4.2 = Potez {move} nije dobar.
ex.verdict.mistake.b4.3 = To je pogreška.
ex.verdict.mistake.b5 = {move} je očita pogreška.
ex.verdict.mistake.b5.2 = {move} je pogreška.
ex.verdict.mistake.b5.3 = {move} nije dobar potez.
ex.verdict.mistake.b6 = {move} je pogreška.
ex.verdict.mistake.b6.2 = {move}? Pogreška.
ex.verdict.mistake.b6.3 = Nikako {move}.
# A dubious move (an inaccuracy; a costly move with nothing concrete to show while still better):
# only the better move is named ({best} is pointed at), never a scenario.
ex.verdict.inaccuracy.b3 = Nije loše, ali potez {best} bio je malo bolji.
ex.verdict.inaccuracy.b3.2 = Potez {best} bio je malo točniji.
ex.verdict.inaccuracy.b3.3 = Mali propust: ovdje je bilo bolje {best}.
ex.verdict.inaccuracy.b4 = Netočnost: točnije je bilo {best}.
ex.verdict.inaccuracy.b4.2 = Mala netočnost. Malo bolje bilo je {best}.
ex.verdict.inaccuracy.b4.3 = Nije baš najbolje: točnije je bilo {best}.
ex.verdict.inaccuracy.b5 = {move} je neprecizno; jače je bilo {best}.
ex.verdict.inaccuracy.b5.2 = Malo neprecizno. Ja bih igrao {best}.
ex.verdict.inaccuracy.b5.3 = Potez {best} bio je točniji nego {move}.
ex.verdict.inaccuracy.b6 = {move} je neprecizno; {best}.
ex.verdict.inaccuracy.b6.2 = Neprecizno. {best}.
ex.verdict.inaccuracy.b6.3 = Bolje je bilo {best}.
# Level 6, an inaccuracy at the bottom of its class (deeper searches often clear it): a hedged word.
ex.verdict.inaccuracy.maybe = Možda je bilo malo točnije {best}.
ex.verdict.inaccuracy.maybe.2 = Ja bih možda igrao {best}.
# A dubious move that loses material (levels 3-6): the remark alone, never "a bit better" (at level 6
# under 6 points, the hedged word above unless a piece is lost).
ex.verdict.dubious = Taj potez izgleda sumnjivo.
ex.verdict.dubious.2 = Taj mi se potez čini sumnjivim.
# Something good was missed (levels 1-2).
ex.verdict.missed.b1 = Oh, čekaj! Promaklo ti je nešto dobro.
ex.verdict.missed.b1.2 = Pogledaj još jednom! Bilo je nešto bolje.
ex.verdict.missed.b1.3 = Stani, tu je bila prilika za tebe!
ex.verdict.missed.b2 = Tu ti je promakla prilika.
ex.verdict.missed.b2.2 = Hmm, bilo je nešto bolje.
ex.verdict.missed.b2.3 = Čekaj, tu ti se nudio izvrstan potez.

# ---- The better move (levels 3-6; {best} is pointed at) ----------------------------------------
# {line} (level 5) holds the moves that follow {best}, not {best} itself.
ex.better.b3 = Bolje je bilo {best}.
ex.better.b3.2 = Potez {best} bio je bolji.
ex.better.b3.3 = Umjesto toga, dobro je bilo {best}.
ex.better.b4 = Jače je bilo {best}.
ex.better.b4.2 = Pravi potez bio je {best}.
ex.better.b4.3 = Bolje je bilo {best}.
ex.better.b5 = {best}, s idejom {line}.
ex.better.b5.2 = Trebalo je igrati {best}: {line}.
ex.better.b5.3 = Bolje je bilo {best}, a zatim {line}.
ex.better.b6 = {best}: {eval}.
ex.better.b6.2 = Umjesto toga {best}, {eval}.
ex.better.b6.3 = Nakon {best}: {eval}.

# ---- A blunder without a reason the coach can give reliably --------------------------------------
# The piece that had the better move ({your}, pointed at), said before the takeback offer; the move
# itself is not named. ex.hint.move: the same without the piece.
ex.hint.b1 = Postojao je bolji potez {your:ins}.
ex.hint.b1.2 = {your} ima{your:pt} je bolji potez.
ex.hint.b2 = {your} ima{your:pt} je bolji potez.
ex.hint.b2.2 = Postojao je bolji potez {your:ins}.
ex.hint.b3 = {your} ima{your:pt} je bolji potez.
ex.hint.b3.2 = {your:ins} se moglo i bolje.
ex.hint.b4 = {your} ima{your:pt} je bolji potez.
ex.hint.b4.2 = Pogledaj još jednom {your:refl_acc}: ima{your:pt} je nešto bolje.
ex.hint.b5 = {your} ima{your:pt} je jači potez.
ex.hint.b5.2 = Postojao je jači potez {your:ins}.
ex.hint.b6 = {your} je mog{your:pt2} bolje.
ex.hint.b6.2 = Pogledaj opet {your:refl_acc}.
ex.hint.move = Postojao je bolji potez.
ex.hint.move.2 = Tu ti se nudio bolji potez.
# The same when the better move plainly wins material for good (the move played wins and loses
# none); the move is still not named.
ex.hint.gain.b1 = {your} ima{your:pt} je bolji potez. Taj potez dobiva materijal.
ex.hint.gain.b1.2 = Postojao je bolji potez {your:ins}. Taj potez dobiva materijal.
ex.hint.gain.b2 = {your} ima{your:pt} je bolji potez. Taj potez dobiva materijal.
ex.hint.gain.b2.2 = Postojao je potez {your:ins} koji dobiva materijal.
ex.hint.gain.b3 = {your} ima{your:pt} je bolji potez, koji dobiva materijal.
ex.hint.gain.b3.2 = Postojao je potez {your:ins} koji dobiva materijal.
ex.hint.gain.b4 = {your} ima{your:pt} je potez koji dobiva materijal.
ex.hint.gain.b4.2 = Pogledaj još jednom {your:refl_acc}: ima{your:pt} je potez koji dobiva materijal.
ex.hint.gain.b5 = {your} ima{your:pt} je jači potez, koji dobiva materijal.
ex.hint.gain.b5.2 = Postojao je potez {your:ins} koji dobiva materijal.
ex.hint.gain.b6 = {your} ima{your:pt} je potez koji dobiva materijal.
ex.hint.gain.b6.2 = Pogledaj opet {your:refl_acc}: mogao se dobiti materijal.
# Levels 1-2: the better move as the piece and its square, said when the offer is declined (or
# when none can be made); levels 3-6 say ex.better.
ex.reveal.b1 = Bolji je bio potez {your:ins} na {sq}.
ex.reveal.b1.2 = {your} je mog{your:pt2} ići na {sq}. To je bilo bolje.
ex.reveal.b2 = Bolje je bilo {your:bare_ins} na {sq}.
ex.reveal.b2.2 = Bolji je bio potez {your:ins} na {sq}.

# ---- Putting the demonstration back (levels 1-4; silent from level 5) --------------------------
ex.rewind.b1 = Vratimo figure na mjesto.
ex.rewind.b1.2 = Sad ću sve vratiti kako je bilo.
ex.rewind.b1.3 = Postavit ću figure natrag.
ex.rewind.b2 = Vratimo sve natrag.
ex.rewind.b2.2 = Natrag na prethodnu poziciju.
ex.rewind.b2.3 = Vratit ću figure na mjesto.
ex.rewind.b3 = Vraćamo se partiji.
ex.rewind.b3.2 = Vratimo se.
ex.rewind.b3.3 = Natrag na poziciju.
ex.rewind.b4 = Natrag na partiju.
ex.rewind.b4.2 = Natrag.
ex.rewind.b4.3 = Vratimo se.

