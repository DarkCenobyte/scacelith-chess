# ---- Demonstration narration: one short line per move shown on the board ------------------------
# Levels 4-6: just the move.
demo.move = {move}.
demo.move.2 = {move}.
demo.move.3 = Tada {move}.
# Levels 1-3, the coach's moves.
demo.my.move = {my} eina į {sq}.
demo.my.move.2 = Statau {my:refl_acc} į {sq}.
demo.my.move.3 = Tada {my} eina į {sq}.
demo.my.take = Kertu {your:acc}.
demo.my.take.2 = {my} kerta {your:acc}.
demo.my.take.3 = Ir aš kertu {your:acc}.
demo.my.check = {my} eina į {sq}. Šachas.
demo.my.check.2 = Šachas: {my} stoja į {sq}.
demo.my.check.3 = {my} į {sq} – šachas!
demo.my.mate = {my} eina į {sq}. Matas.
demo.my.mate.2 = O {my} į {sq} – jau matas.
demo.my.mate.3 = {my} į {sq}. Tai matas.
# Levels 1-3, the coach's in-between move: a capture, a check or a quiet move played first while a
# bigger piece of the player's ({t1}) is attacked; the next move of the coach's takes it.
demo.my.first.take = Pirmiausia {my} kerta {your:acc}. {t1} palauks.
demo.my.first.take.2 = Iš pradžių {my} kerta {your:acc}. {t1} niekur nedings.
demo.my.first.check = {my} kerta {your:acc}, ir tai šachas! {t1} palauks.
demo.my.first.check.2 = Pirmiausia {my} kerta {your:acc} su šachu. {t1} niekur nedings.
demo.my.first.check_move = Pirmiausia šachas: {my} eina į {sq}. {t1} palauks.
demo.my.first.check_move.2 = {my} eina į {sq}: pirma šachas! {t1} niekur nedings.
demo.my.first.move = Pirmiausia {my} eina į {sq}. {t1} palauks.
demo.my.first.move.2 = Iš pradžių {my} į {sq}. {t1} niekur nedings.
# The piece that moves was attacked itself: it takes something before it can be taken.
demo.my.first.attacked = {my} puolam{my:agr_as_a}, todėl {my:pron} pirmiausia kerta {your:acc}.
demo.my.first.attacked.2 = {my} puolam{my:agr_as_a}: {my:pron} pirmiausia pačiumpa {your:acc}.
# Levels 4-6, the same in-between move.
demo.first = Pirmiausia {move}: {t1} palauks.
demo.first.2 = Iš pradžių {move}. {t1} niekur nedings.
# After the rewind when no takeback is offered: the coach's real move comes next.
demo.play_on = Dabar darau savo ėjimą.
demo.play_on.2 = O štai mano tikrasis ėjimas.
demo.play_on.3 = O dabar einu iš tikrųjų.
# Levels 1-3, the player's moves (what they would play).
demo.your.move = Tu eitum {your:refl_ins} į {sq}.
demo.your.move.2 = Tarkime, eini {your:refl_ins} į {sq}.
demo.your.move.3 = Tada {your} eina į {sq}.
demo.your.take = Tu kirstum {my:acc}.
demo.your.take.2 = Kerti {my:acc} {your:refl_ins}.
demo.your.take.3 = Tada kerti {my:acc}.
demo.your.back = Tu kerti atgal.
demo.your.back.2 = Kerti atgal langelyje {sq}.
demo.your.back.3 = Ir tu kerti atgal.
demo.your.king = Tavo karaliui tenka trauktis.
demo.your.king.2 = Karalius turi pasitraukti – į {sq}.
