# Coach speech (Lithuanian): the review of the player's moves (src/coach/review.cpp, review_explain.cpp).
# Same keys and variants as assets/coach/speech/en/review.lang (its header documents every placeholder).
#
# Register: the coach says "tu" (singular imperative: "Pažiūrėk", "Kirsk"); the coach is male ("Aš būčiau
# ėjęs {best}"). The player's gender is unknown: finite verbs only for the player ("praleidai", "galėjai",
# "laimėjai"), never an adjective, participle or half-participle about the player ("būtum paskelbęs",
# "pirmas", "eidamas" are avoided; "galėjai paskelbti", "pirmiau", "prieš statant" instead).
# "You're 3 points down" = "atsilieki {pts:point_ins}" (trimis taškais); "you've lost 3 points" =
# "netenki {pts:point_gen}" / "praradai {pts:point_acc}"; "worth 3" = "vert{your:agr_as_a} {n:point_gen}".
# "Mate in N" = "matas per {m:move_acc}" (per du ėjimus); the bare "{m}" of level 6 = "{m:mv_acc}"
# (written "matas per 3", spoken "per tris ėjimus").
# Pieces carry their possessive; forms from common.lang: gen dat acc ins, refl_* ("savo" whenever the
# player or the coach is the subject, imperatives included: "Pažiūrėk į {your:refl_acc}"), pron
# pron_gen pron_dat pron_acc, rel_acc, and the endings agr_as_a ("surišt{your:agr_as_a}" = surištas /
# surišta), agr_us_i, agr_is_e. Squares stand after a preposition or next to "langelis": "į {sq}",
# "iš {sq}", "langelyje {sq}", "langelis {sq}". Moves are named with "ėjimas" when a case is needed
# ("ėjimu {best}", "po {move}"), and a move as a sentence subject is linked with a dash ("{move} –
# šiurkšti klaida").
# Terms: šiurkšti klaida (blunder), netikslumas, abejotinas ėjimas, šakutė ("{reply} šakute puola
# {t1:acc} ir {t2:acc}"), pradūrimas (pradurti), surišimas (surišti), atidengtas puolimas, patas,
# kabo (hanging), už dyką (for free), įkalintas (trapped), paskutinė horizontalė (back rank; "paskutinė
# eilė" at levels 1-2), praeivis, opozicija, kvadrato taisyklė, pėstininkų endšpilis, rikių pora,
# lengvosios figūros (minor pieces), mainai (a trade, plural only).

# ---- Announcements (either side's move) -------------------------------------------------------
# The player gives check (levels 1-2: say what it means).
ann.check.human.b1 = Šachas! Mano karalius puolamas.
ann.check.human.b1.2 = Šachas! Tu puoli mano karalių.
ann.check.human.b1.3 = Tai šachas! Mano karaliui reikia nuo jo pasitraukti.
ann.check.human = Šachas.
ann.check.human.2 = Šachas!
ann.check.human.3 = O tai šachas.
# The coach gives check.
ann.check.coach = Šachas!
ann.check.coach.2 = Šachas.
ann.check.coach.3 = Ir šachas!
# Once per game at levels 1-2, right after the coach's first check ({your} = the player's king).
ann.check.coach.first = Tai reiškia, kad {your} puolam{your:agr_as_a}. Turi {your:pron_acc} apsaugoti nuo šacho.
ann.check.coach.first.2 = Šachas reiškia, kad {your} puolam{your:agr_as_a}. Patrauk {your:pron_acc}, užsidenk arba kirsk mano figūrą.
ann.double_check.coach = Dvigubas šachas! Dvi mano figūros iš karto puola tavo karalių, todėl jis turi trauktis.
ann.double_check.coach.2 = Tai dvigubas šachas: dabar padės tik karaliaus ėjimas.
ann.double_check.human = Dvigubas šachas! Dvi tavo figūros iš karto puola mano karalių, todėl jis turi trauktis.
ann.double_check.human.2 = Dvigubas šachas! Dabar mane išgelbės tik karaliaus ėjimas.
# The player checkmates the coach.
ann.mate.human.b1 = Matas! Tu laimėjai! Mano karalius negali pabėgti.
ann.mate.human.b1.2 = Tai matas! Šaunu, laimėjai partiją!
ann.mate.human.b1.3 = Šachas ir matas! Mano karalius įkalintas. Sveikinu!
ann.mate.human = Matas. Gerai sužaista.
ann.mate.human.2 = Tai matas. Sveikinu.
ann.mate.human.3 = Matas! Puikiai sužaista.
# The coach checkmates the player.
ann.mate.coach.b1 = Tai matas. Tavo karaliui nėra išeities.
ann.mate.coach.b1.2 = Matas. Tavo karalius puolamas ir negali pabėgti.
ann.mate.coach.b1.3 = Deja, tai matas. Tavo karaliui nebėra kur trauktis.
ann.mate.coach = Matas.
ann.mate.coach.2 = Štai ir matas.
ann.mate.coach.3 = Matas, deja.

# ---- Verdicts (the first sentence about a bad move) --------------------------------------------
ex.verdict.blunder.b1 = Oi! Šis ėjimas kai ką atiduoda.
ex.verdict.blunder.b1.2 = Atsargiai! Šis ėjimas gali brangiai kainuoti.
ex.verdict.blunder.b1.3 = Oi, palauk. Su šiuo ėjimu kažkas negerai.
ex.verdict.blunder.b2 = Hm, šis ėjimas turi trūkumą.
ex.verdict.blunder.b2.2 = Tai didelė klaida.
ex.verdict.blunder.b2.3 = Atsargiai, šis ėjimas tau kai ką kainuoja.
ex.verdict.blunder.b3 = Tai šiurkšti klaida.
ex.verdict.blunder.b3.2 = {move} – tikra klaida.
ex.verdict.blunder.b3.3 = Oi, {move} – didelė klaida.
ex.verdict.blunder.b4 = {move} – šiurkšti klaida.
ex.verdict.blunder.b4.2 = {move} – rimta klaida.
ex.verdict.blunder.b4.3 = Deja, tai šiurkšti klaida.
ex.verdict.blunder.b5 = {move} – rimta klaida.
ex.verdict.blunder.b5.2 = {move} – šiurkšti klaida.
ex.verdict.blunder.b5.3 = {move} – brangiai kainuojanti klaida.
ex.verdict.blunder.b6 = {move} – rimta klaida.
ex.verdict.blunder.b6.2 = {move} – šiurkšti klaida.
ex.verdict.blunder.b6.3 = {move}? Šiurkšti klaida.
# A blunder that leaves the coach's threat standing (levels 1-2: the threat the engine found after the
# coach's last move is what the reply carries out).
ex.verdict.ignored.b1 = Oi! Neatsakei į mano grėsmę.
ex.verdict.ignored.b1.2 = Atsargiai! Mano grėsmė niekur nedingo.
ex.verdict.ignored.b1.3 = Oi, palauk. Pamiršai mano grėsmę.
ex.verdict.ignored.b2 = Hm, mano grėsmė vis dar liko.
ex.verdict.ignored.b2.2 = Palikai mano grėsmę be atsako.
ex.verdict.ignored.b2.3 = Atsargiai, neatsakei į mano grėsmę.
ex.verdict.mistake.b3 = Tai nėra geras ėjimas.
ex.verdict.mistake.b3.2 = Hm, su ėjimu {move} kažkas negerai.
ex.verdict.mistake.b3.3 = Tai klaida.
ex.verdict.mistake.b4 = {move} – klaida.
ex.verdict.mistake.b4.2 = {move} – negeras ėjimas.
ex.verdict.mistake.b4.3 = Tai klaida.
ex.verdict.mistake.b5 = {move} – akivaizdi klaida.
ex.verdict.mistake.b5.2 = {move} – klaida.
ex.verdict.mistake.b5.3 = {move} – nekoks ėjimas.
ex.verdict.mistake.b6 = {move} – klaida.
ex.verdict.mistake.b6.2 = {move}? Klaida.
ex.verdict.mistake.b6.3 = Tik ne {move}.
# A dubious move (an inaccuracy; a costly move with nothing concrete to show while still better):
# only the better move is named ({best} is pointed at), never a scenario.
ex.verdict.inaccuracy.b3 = Neblogai, bet {best} buvo kiek geresnis.
ex.verdict.inaccuracy.b3.2 = {best} buvo šiek tiek tikslesnis.
ex.verdict.inaccuracy.b3.3 = Nedidelis netikslumas: čia geriau buvo {best}.
ex.verdict.inaccuracy.b4 = Netiksliai: {best} buvo tikslesnis.
ex.verdict.inaccuracy.b4.2 = Nedidelis netikslumas. {best} buvo kiek geresnis.
ex.verdict.inaccuracy.b4.3 = Ne visai geriausia: {best} buvo tikslesnis.
ex.verdict.inaccuracy.b5 = {move} – netikslu; {best} buvo stipresnis.
ex.verdict.inaccuracy.b5.2 = Šiek tiek netiksliai. Aš būčiau ėjęs {best}.
ex.verdict.inaccuracy.b5.3 = {best} buvo tikslesnis už {move}.
ex.verdict.inaccuracy.b6 = {move} – netikslu; {best}.
ex.verdict.inaccuracy.b6.2 = Netiksliai. {best}.
ex.verdict.inaccuracy.b6.3 = Geriau buvo {best}.
# Level 6, an inaccuracy at the bottom of its class (deeper searches often clear it): a hedged word.
ex.verdict.inaccuracy.maybe = Galbūt {best} buvo kiek tikslesnis.
ex.verdict.inaccuracy.maybe.2 = Gal aš būčiau ėjęs {best}.
# A dubious move that loses material (levels 3-6): the remark alone, never "a bit better" (at level 6
# under 6 points, the hedged word above unless a piece is lost).
ex.verdict.dubious = Šis ėjimas atrodo abejotinas.
ex.verdict.dubious.2 = Šis ėjimas, regis, abejotinas.
# Something good was missed (levels 1-2).
ex.verdict.missed.b1 = Oi, palauk! Praleidai kai ką gero.
ex.verdict.missed.b1.2 = Pažiūrėk dar kartą! Buvo kai kas geresnio.
ex.verdict.missed.b1.3 = Palauk, čia turėjai progą!
ex.verdict.missed.b2 = Čia praleidai progą.
ex.verdict.missed.b2.2 = Hm, buvo kai kas geresnio.
ex.verdict.missed.b2.3 = Palauk, čia turėjai puikų ėjimą.

# ---- The better move (levels 3-6; {best} is pointed at) ----------------------------------------
# {line} (level 5) holds the moves that follow {best}, not {best} itself.
ex.better.b3 = Geriau buvo {best}.
ex.better.b3.2 = {best} buvo geresnis ėjimas.
ex.better.b3.3 = Vietoj to gerai buvo {best}.
ex.better.b4 = Stipriau buvo {best}.
ex.better.b4.2 = Teisingas ėjimas buvo {best}.
ex.better.b4.3 = Geriau buvo {best}.
ex.better.b5 = {best} su idėja {line}.
ex.better.b5.2 = Reikėjo {best}: {line}.
ex.better.b5.3 = Geriau buvo {best}, o toliau {line}.
ex.better.b6 = {best}: {eval}.
ex.better.b6.2 = Vietoj to {best}, {eval}.
ex.better.b6.3 = Po {best} – {eval}.

# ---- A blunder without a reason the coach can give reliably --------------------------------------
# The piece that had the better move ({your}, pointed at), said before the takeback offer; the move
# itself is not named. ex.hint.move: the same without the piece.
ex.hint.b1 = Buvo geresnis ėjimas {your:ins}.
ex.hint.b1.2 = {your} turėjo geresnį ėjimą.
ex.hint.b2 = {your} turėjo geresnį ėjimą.
ex.hint.b2.2 = Buvo geresnis ėjimas {your:ins}.
ex.hint.b3 = {your} turėjo geresnį ėjimą.
ex.hint.b3.2 = {your:ins} buvo galima eiti geriau.
ex.hint.b4 = {your} turėjo geresnį ėjimą.
ex.hint.b4.2 = Dar kartą pažiūrėk į {your:refl_acc}: {your:pron} turėjo kai ką geresnio.
ex.hint.b5 = {your} turėjo stipresnį ėjimą.
ex.hint.b5.2 = Buvo stipresnis ėjimas {your:ins}.
ex.hint.b6 = {your} galėjo geriau.
ex.hint.b6.2 = Dar kartą pažiūrėk į {your:refl_acc}.
ex.hint.move = Buvo geresnis ėjimas.
ex.hint.move.2 = Čia turėjai geresnį ėjimą.
# The same when the better move plainly wins material for good (the move played wins and loses
# none); the move is still not named.
ex.hint.gain.b1 = {your} turėjo geresnį ėjimą. Tas ėjimas laimi medžiagos.
ex.hint.gain.b1.2 = Buvo geresnis ėjimas {your:ins}. Jis laimi medžiagos.
ex.hint.gain.b2 = {your} turėjo geresnį ėjimą. Tas ėjimas laimi medžiagos.
ex.hint.gain.b2.2 = Buvo ėjimas {your:ins}, kuris laimi medžiagos.
ex.hint.gain.b3 = {your} turėjo geresnį ėjimą – tokį, kuris laimi medžiagos.
ex.hint.gain.b3.2 = Buvo ėjimas {your:ins}, kuris laimi medžiagos.
ex.hint.gain.b4 = {your} turėjo ėjimą, kuris laimi medžiagos.
ex.hint.gain.b4.2 = Dar kartą pažiūrėk į {your:refl_acc}: {your:pron} turėjo ėjimą, laiminantį medžiagos.
ex.hint.gain.b5 = {your} turėjo stipresnį ėjimą, laiminantį medžiagos.
ex.hint.gain.b5.2 = Buvo ėjimas {your:ins}, laimintis medžiagos.
ex.hint.gain.b6 = {your} turėjo ėjimą, laiminantį medžiagos.
ex.hint.gain.b6.2 = Dar kartą pažiūrėk į {your:refl_acc}: buvo galima laimėti medžiagos.
# Levels 1-2: the better move as the piece and its square, said when the offer is declined (or
# when none can be made); levels 3-6 say ex.better.
ex.reveal.b1 = Geresnis ėjimas buvo {your:ins} į {sq}.
ex.reveal.b1.2 = {your} galėjo eiti į {sq}. Taip būtų buvę geriau.
ex.reveal.b2 = {your} į {sq} – štai geresnis ėjimas.
ex.reveal.b2.2 = Geresnis ėjimas buvo {your:ins} į {sq}.

