# ---- Squares, files and ranks (spoken) -----------------------------------------------------------
# The voice says a square as Lithuanian players read it: the file's letter name, then the rank as a
# cardinal number: e4 = "e keturi", f3 = "ef trys", b5 = "bė penki", h7 = "ha septyni". The a and the h
# are written "aa" and "haa" (a long a, as the letter names are said): a short "a" melts into a vowel
# before it ("į a penki" heard "į penki") and "ha" loses its h there ("langelio ha aštuoni" heard
# "langelio aštuoni"); see docs/PRONUNCIATION.md.
square.spoken = {file} {rank}
file.a.spoken = aa
file.b.spoken = bė
file.c.spoken = cė
file.d.spoken = dė
file.e.spoken = e
file.f.spoken = ef
file.g.spoken = gė
file.h.spoken = haa
rank.1.spoken = vienas
rank.2.spoken = du
rank.3.spoken = trys
rank.4.spoken = keturi
rank.5.spoken = penki
rank.6.spoken = šeši
rank.7.spoken = septyni
rank.8.spoken = aštuoni

# ---- Moves ---------------------------------------------------------------------------------------
# Lithuanian notation letters: K(aralius) V(aldovė) B(okštas) R(ikis) Ž(irgas): "Žf3", "Rb5", "Vxd8".
# Careful, false friends: B is the rook and R the bishop.
move.letters = K V B R Ž
# Spoken as Lithuanian players read notation: "žirgas ef trys", "žirgas kerta e penki", "žirgas bė dė
# septyni", "e kerta dė penki", "pėstininkas kerta" (a recapture on the same square), "trumpoji
# rokiruotė", "valdovė gė keturi, šachas". {piece} is always the nominative here, so the promotion names
# the new piece after a colon ("virsta valdove" would need the instrumental): "e aštuoni, virsmas: valdovė".
move.piece.spoken = {piece} {to}
move.piece_capture.spoken = {piece} kerta {to}
move.piece_from.spoken = {piece} {from} {to}
move.piece_from_capture.spoken = {piece} {from} kerta {to}
move.pawn.spoken = {to}
move.pawn_capture.spoken = {file} kerta {to}
move.recapture.spoken = {piece} kerta
move.castle_short.spoken = trumpoji rokiruotė
move.castle_long.spoken = ilgoji rokiruotė
move.promotion.spoken = {move}, virsmas: {piece}
move.check.spoken = {move}, šachas
move.mate.spoken = {move}, matas
moves.join.spoken = {a}, {b}

# ---- Respellings (spoken) ------------------------------------------------------------------------
# Words the voice misreads, said otherwise in every spoken line (opening lines included); see
# docs/PRONUNCIATION.md. Lithuanian names en passant "kirtimas prasilenkiant"; lesson.ep.what says the
# French words as "an pasan" in its .spoken line.
# "Hm," before a sentence is read with a vowel ("Ham", "Kam"): "hmm" is hummed.
respell.hm = hmm
# Grand Prix (ataka): the voice says the d and the x ("grand priks"); French, as players say it.
respell.grand = gran
respell.prix = pri
# Nimco-indų: before the hyphen the c is read as k ("Nimko-indų"); "Nimtso" keeps the ts.
respell.nimco = nimtso

# ---- Numbers -------------------------------------------------------------------------------------
# Spoken number words; the plain word is the masculine nominative. 21-99 compose as "{tens} {units}"
# ("dvidešimt trys"), 101-999 as "{hundreds} {rest}" ("šimtas dvidešimt"); every hundred is listed.
# In a compound number only the last word takes a form ("dvidešimt vienos", "dvidešimt pirmajame"),
# as Lithuanian usage leaves the tens unchanged.
