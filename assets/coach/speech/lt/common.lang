# Lithuanian plural rule (assets/i18n): one (1, 21, 31, 101 ...: singular "vienas ėjimas") | few (2-9,
# 22-29 ...: plural "trys ėjimai") | other (0, 10-20, 30, 40 ...: genitive plural "dešimt ėjimų").
# count.<noun> is the nominative; count.<noun>_gen, _dat, _acc, _ins, _loc are the other cases, with
# the number in the same case: "{n:mistake_acc}" = "padarei dvi klaidas", "{m:move_gen}" = "reikia
# trijų ėjimų", "{pts:point_ins}" = "atsilieki dviem taškais", "{n:game_loc}" = "dviejose partijose".
# In the "other" slot the noun stays in the genitive plural and the number word takes the case
# ("dešimties ėjimų", "dešimčia taškų"). Feminine nouns use the "f" number forms in the "one" and
# "few" slots. After a negated verb use _gen ("nepadarei nė {n:mistake_gen}").
