# Coach speech (Arabic, Modern Standard Arabic): the building blocks every line uses
# (src/coach/catalog.cpp renders them). Same keys as assets/coach/speech/en/common.lang, plus the
# forms Arabic needs.
# Register: the coach speaks MSA and addresses the player in the second person singular. The
# player's gender is unknown: the lines prefer forms that are gender-neutral in unvowelled writing
# (the suffix ـك, verbal nouns: "عليك الخروج من الكش", noun phrases); imperatives and present
# tense verbs are masculine, the conventional default ("خذ", "حرّك"). The coach is male: his own
# adjectives are masculine ("أنا مستعد", "موافق").
# Past-tense verbs of the player ("استسلمت", "خرجت", "لمست") are also read "I resigned", "I got
# out", "I touched": use them only where the context rules out the coach (هزمتني، لكنك قاتلت);
# otherwise a noun phrase ("انتهت المباراة باستسلامك", "لم يعد ملِكك في كش").
# Chess words follow the game UI (assets/i18n/ar.lang) and the opening texts: بيدق حصان فيل رخ
# وزير ملك, كش, كش مات, التبييت, الترقية, الجمود (الباط), التعادل, ورقة التسجيل, إيلو.

# ---- Pieces --------------------------------------------------------------------------------------
# Every piece noun is masculine (the queen is الوزير), so verbs, adjectives and pronouns referring
# to a piece are always masculine: "{my} يغادر الرقعة", "خذه", "{your} مثبَّت".
# piece.<type>.nom is the bare indefinite noun. The possessive is a suffix: owner patterns glue ـك
# (your) or ـي (my) to it: {your} = حصانك, {my} = حصاني. Written Arabic does not show the case
# endings, so one form, "nom", serves every position: subject, object, after a preposition
# ("ب{your}" = برخّك) and as the second term of a construct ("عمود {my}" = عمود رخّي).
# Spoken moves put the article in front of the bare noun ("ال{piece}" = الحصان).
# Diacritics only where the voice or the reader could misread: رخّ (shadda, so that رخّي is not
# read رخيّ; the lesson lines write it the same way) and ملِك in the possessives (ملِكي = "my king", not مَلَكي "royal" or مُلكي "my
# property"), set as whole phrases below.
piece.pawn.gender = m
piece.knight.gender = m
piece.bishop.gender = m
piece.rook.gender = m
piece.queen.gender = m
piece.king.gender = m
piece.pawn.nom = بيدق
piece.knight.nom = حصان
piece.bishop.nom = فيل
piece.rook.nom = رخّ
piece.queen.nom = وزير
piece.king.nom = ملك
owner.your.nom = {piece}ك
owner.my.nom = {piece}ي
phrase.your.king.nom = ملِكك
phrase.my.king.nom = ملِكي
# The Analysis mode names a piece by its side, nobody being "you" or "I" there: the article and
# the (masculine) colour adjective, "الحصان الأبيض", "الوزير الأسود". A preposition is glued to it
# ("ب{piece}" = بالحصان الأبيض); never "ل" ("لال" must be written "لل").
owner.white.nom = ال{piece} الأبيض
owner.black.nom = ال{piece} الأسود

# ---- Squares, files and ranks (spoken) -----------------------------------------------------------
# The voice drops Latin letters and reads digits in English: file letters are spelled as Arabic
# letter names and ranks are number words, as in the opening texts: e4 = "إي أربعة", f5 = "إف
# خمسة", a8 = "إيه ثمانية", h7 = "إتش سبعة". Ranks keep the citation form (اثنان).
square.spoken = {file} {rank}
file.a.spoken = إيه
file.b.spoken = بي
file.c.spoken = سي
file.d.spoken = دي
file.e.spoken = إي
file.f.spoken = إف
file.g.spoken = جي
file.h.spoken = إتش
rank.1.spoken = واحد
rank.2.spoken = اثنان
rank.3.spoken = ثلاثة
rank.4.spoken = أربعة
rank.5.spoken = خمسة
rank.6.spoken = ستة
rank.7.spoken = سبعة
rank.8.spoken = ثمانية

# ---- Moves ---------------------------------------------------------------------------------------
# Scoresheet letters: Arab federations use the Latin letters K Q R B N (assets/i18n/ar.lang,
# scoresheet.pieces), so "{move:letters}" shows "Nf3".
move.letters = K Q R B N
# Spoken as Arabic players read notation: "الحصان إلى إف ثلاثة", "الحصان يأخذ في إي خمسة",
# "الحصان من بي إلى دي سبعة", "بيدق إي يأخذ في دي خمسة", "البيدق يستردّ" (recapture, the opening
# texts' verb), "تبييت قصير" / "تبييت طويل" (the opening texts say "يبيّت طويلًا"), "إي ثمانية،
# مع الترقية إلى وزير", "...، كش", "...، كش مات". {piece} is the bare noun, so the patterns add
# the article ("ال{piece}") and the promotion keeps it indefinite ("إلى وزير").
move.piece.spoken = ال{piece} إلى {to}
move.piece_capture.spoken = ال{piece} يأخذ في {to}
move.piece_from.spoken = ال{piece} من {from} إلى {to}
move.piece_from_capture.spoken = ال{piece} من {from} يأخذ في {to}
move.pawn.spoken = {to}
move.pawn_capture.spoken = بيدق {file} يأخذ في {to}
move.recapture.spoken = ال{piece} يستردّ
move.castle_short.spoken = تبييت قصير
move.castle_long.spoken = تبييت طويل
move.promotion.spoken = {move}، مع الترقية إلى {piece}
move.check.spoken = {move}، كش
move.mate.spoken = {move}، كش مات
moves.join.spoken = {a}، {b}

# ---- Numbers -------------------------------------------------------------------------------------
