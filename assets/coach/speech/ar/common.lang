# ---- Counted nouns ---------------------------------------------------------------------------------
# Arabic plural rule (assets/i18n): zero (0) | one (1) | two (2) | few (3-10, 103-110 ...) |
# many (11-99, 111-199 ...) | other (100-102, 200-202 ...).
# one: the noun + واحد/واحدة, no digit ("نقلة واحدة", as the UI); two: the dual, no digit, in the
# oblique case (نقلتين، خطأين: after a preposition or as an object; a sentence that needs the
# nominative dual (نقلتان) must be phrased around it); few: number + plural (gender polarity:
# "{n:f}" for feminine nouns: ثلاث نقلات، ثلاثة أخطاء); many: number + singular accusative
# (إحدى عشرة نقلة، خمسة عشر بيدقًا); other: number + singular genitive (مئة نقلة); zero: as the UI.
# Nouns: نقلة (f), نقطة (f), بيدق (m), قطعة (f), خطأ (m), خطأ فادح (m, the UI's blunder), نقلة غير
# دقيقة (f, inaccuracy), مباراة (f), مرة (f), مربع (m).
count.move = {n} نقلة|نقلة واحدة|نقلتين|{n:f} نقلات|{n:f} نقلة|{n:f} نقلة
count.point = {n} نقطة|نقطة واحدة|نقطتين|{n:f} نقاط|{n:f} نقطة|{n:f} نقطة
count.pawn = {n} بيدق|بيدق واحد|بيدقين|{n} بيادق|{n} بيدقًا|{n} بيدق
count.piece = {n} قطعة|قطعة واحدة|قطعتين|{n:f} قطع|{n:f} قطعة|{n:f} قطعة
count.mistake = {n} خطأ|خطأ واحد|خطأين|{n} أخطاء|{n} خطأً|{n} خطأ
count.blunder = {n} خطأ فادح|خطأ فادح واحد|خطأين فادحين|{n} أخطاء فادحة|{n} خطأً فادحًا|{n} خطأ فادح
count.inaccuracy = {n} نقلة غير دقيقة|نقلة غير دقيقة واحدة|نقلتين غير دقيقتين|{n:f} نقلات غير دقيقة|{n:f} نقلة غير دقيقة|{n:f} نقلة غير دقيقة
count.game = {n} مباراة|مباراة واحدة|مباراتين|{n:f} مباريات|{n:f} مباراة|{n:f} مباراة
count.time = {n} مرة|مرة واحدة|مرتين|{n:f} مرات|{n:f} مرة|{n:f} مرة
count.square = {n} مربع|مربع واحد|مربعين|{n} مربعات|{n} مربعًا|{n} مربع
# "{n:f}" in a line says a bare number in the feminine (a feminine noun understood: "تساوي {n:f}" =
# "worth three (points)"); one is written out. "{n:mv}" says the number with نقلة in speech and the
# digits alone in writing. They are count keys so that the form check knows them.
count.f = {n:f}|واحدة|{n:f}|{n:f}|{n:f}|{n:f}
count.mv = {n:mv}|{n:mv}|{n:mv}|{n:mv}|{n:mv}|{n:mv}

# ---- Evaluations (the strongest levels) ------------------------------------------------------------
# From the listener's point of view. {x} = pawns with one decimal (number.decimal), {n} = moves.
# {n} is a bare number here (count keys do not apply): "mv" says it with نقلة ("كش مات في ثلاث
# نقلات"); the subtitles keep the short "كش مات في 3".
eval.up = +{x}
eval.up.spoken = زائد {x}
eval.down = −{x}
eval.down.spoken = ناقص {x}
eval.even = 0.0
eval.even.spoken = تكافؤ
eval.mate_win = كش مات في {n:mv}
eval.mate_loss = كش مات ضدك في {n:mv}
