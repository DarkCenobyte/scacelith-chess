<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The macOS app bundle's Info.plist. tools/macos/make-app.sh fills in the version of
     cmake/version.cmake: in full (1.0.0-beta.2) in the texts, MAJOR.MINOR.PATCH in the version
     keys, which take numbers only. -->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Scacelith</string>
	<key>CFBundleExecutable</key>
	<string>Scacelith</string>
	<key>CFBundleIconFile</key>
	<string>Scacelith</string>
	<key>CFBundleIdentifier</key>
	<string>com.scacelith.Scacelith</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Scacelith</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>@SCACELITH_VERSION_CORE@</string>
	<key>CFBundleVersion</key>
	<string>@SCACELITH_VERSION_CORE@</string>
	<key>CFBundleGetInfoString</key>
	<string>Scacelith @SCACELITH_VERSION@</string>
	<key>CFBundleSupportedPlatforms</key>
	<array>
		<string>MacOSX</string>
	</array>
	<key>LSMinimumSystemVersion</key>
	<string>26.0</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.board-games</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSHumanReadableCopyright</key>
	<string>Scacelith @SCACELITH_VERSION@. Free software under the GNU General Public License v3.0.</string>
</dict>
</plist>
