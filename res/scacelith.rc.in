#include <windows.h>

// The application icon: Explorer shows the first icon group, the window class loads id 1
// (src/platform/platform_win32.cpp).
1 ICON "@SCACELITH_ICON_ICO@"

1 VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Scacelith"
            VALUE "FileDescription", "Scacelith - photorealistic chess"
            VALUE "FileVersion", "@SCACELITH_VERSION@"
            VALUE "InternalName", "Scacelith"
            VALUE "LegalCopyright", "GPL-3.0-or-later"
            VALUE "OriginalFilename", "Scacelith.exe"
            VALUE "ProductName", "Scacelith"
            VALUE "ProductVersion", "@SCACELITH_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

1 24 "scacelith.manifest"
