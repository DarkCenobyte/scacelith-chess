// Checkerboard min/max half-resolution depth + matching normal. Alternating the closest and the
// farthest sample of each 2x2 quad keeps both sides of every silhouette represented, which makes
// the joint-bilateral upsampling of half-resolution effects robust.
#include "shaders/post/post_common.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D uDepth;
layout(binding = 1) uniform sampler2D uNormalRough;
layout(binding = 0, r32f) uniform writeonly image2D oHalfDepth;
layout(binding = 1, rgba8) uniform writeonly image2D oHalfNormal;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, ivec2(post.halfSize.xy)))) return;
    ivec2 base = p * 2;
    ivec2 maxP = ivec2(post.renderSize.xy) - 1;
    bool takeClosest = ((p.x + p.y) & 1) == 0;
    float best = takeClosest ? -1.0 : 2.0;
    ivec2 bestP = base;
    for (int k = 0; k < 4; ++k) {
        ivec2 q = min(base + ivec2(k & 1, k >> 1), maxP);
        float d = texelFetch(uDepth, q, 0).r;
        if (!(d >= 0.0 && d <= 1.0)) d = 0.0;
        if (takeClosest ? d > best : d < best) { best = d; bestP = q; }
    }
    vec3 n = texelFetch(uNormalRough, bestP, 0).xyz;
    float ln = dot(n, n);
    n = ln > 1e-6 && !badValue(n) ? n * inversesqrt(ln) : vec3(0.0, 1.0, 0.0);
    imageStore(oHalfDepth, p, vec4(best > 0.0 ? linearFromRaw(best) : SKY_DEPTH));
    imageStore(oHalfNormal, p, vec4(n * 0.5 + 0.5, 1.0));
}
