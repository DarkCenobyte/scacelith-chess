// Bloom upsample: 3x3 tent filter of the next (smaller) level blended with this level's
// downsample. lerp (not add) keeps the pyramid energy conserving: the result is a normalised
// sum of increasingly wide blurs weighted (1-s), s(1-s), s^2(1-s), ...
#include "shaders/post/post_common.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D uDown;
layout(binding = 1) uniform sampler2D uUp;
layout(binding = 0, rgba16f) uniform writeonly image2D oDst;
layout(location = 1) uniform int uLevel;  // destination level (uUp is read at uLevel + 1)

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dsize = imageSize(oDst);
    if (any(greaterThanEqual(p, dsize))) return;
    vec2 uv = (vec2(p) + 0.5) / vec2(dsize);
    float lod = float(uLevel + 1);
    vec2 t = 1.0 / vec2(textureSize(uUp, uLevel + 1));
    vec3 up = textureLod(uUp, uv + vec2(-t.x, -t.y), lod).rgb + textureLod(uUp, uv + vec2(t.x, -t.y), lod).rgb +
              textureLod(uUp, uv + vec2(-t.x, t.y), lod).rgb + textureLod(uUp, uv + vec2(t.x, t.y), lod).rgb;
    up += 2.0 * (textureLod(uUp, uv + vec2(-t.x, 0.0), lod).rgb + textureLod(uUp, uv + vec2(t.x, 0.0), lod).rgb +
                 textureLod(uUp, uv + vec2(0.0, -t.y), lod).rgb + textureLod(uUp, uv + vec2(0.0, t.y), lod).rgb);
    up += 4.0 * textureLod(uUp, uv, lod).rgb;
    up *= 1.0 / 16.0;
    vec3 down = textureLod(uDown, uv, float(uLevel)).rgb;
    imageStore(oDst, p, vec4(sanitize(mix(down, up, post.bloom.y)), 1.0));
}
