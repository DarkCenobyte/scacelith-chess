// Captures the sky (atmosphere + clouds, no sun disk) into the TEXUNIT_SKY cubemap.
#include "shaders/include/common.glsl"
#include "shaders/lighting/lighting_ubo.glsl"
#include "shaders/lighting/atmosphere.glsl"
#include "shaders/lighting/sky_common.glsl"
#include "shaders/lighting/cubemap.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D uSkyTransmittance;
layout(binding = 1) uniform sampler2D uSkyView;
layout(rgba16f, binding = 0) uniform writeonly imageCube uOut;
uniform int uSize;

void main() {
    ivec3 id = ivec3(gl_GlobalInvocationID);
    if (id.x >= uSize || id.y >= uSize) return;
    vec3 d = cubeDir(id.z, (vec2(id.xy) + 0.5) / float(uSize));
    vec3 c = skyRadiance(uSkyTransmittance, uSkyView, d, false, true);
    imageStore(uOut, id, vec4(min(c, vec3(60000.0)), 1.0));
}
