// Atmosphere transmittance LUT (256x64), Bruneton parametrisation.
#include "shaders/include/common.glsl"
#include "shaders/lighting/atmosphere.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(rgba16f, binding = 0) uniform writeonly image2D uOut;
uniform float uMieScale;

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(px, ivec2(TRANSMITTANCE_LUT_SIZE)))) return;
    vec2 uv = clamp(atmoUnSubUv((vec2(px) + 0.5) / TRANSMITTANCE_LUT_SIZE, TRANSMITTANCE_LUT_SIZE), 0.0, 1.0);
    float r, mu;
    transmittanceParams(uv, r, mu);
    vec3 ro = vec3(0.0, r, 0.0);
    vec3 rd = vec3(sqrt(max(1.0 - mu * mu, 0.0)), mu, 0.0);
    float tTop = max(raySphere(ro, rd, ATMO_TOP), 0.0);
    const int N = 40;
    float dt = tTop / float(N);
    vec3 od = vec3(0.0);
    for (int i = 0; i < N; ++i) {
        float h = length(ro + rd * ((float(i) + 0.5) * dt)) - ATMO_BOTTOM;
        od += atmoMedium(max(h, 0.0), uMieScale).extinction * dt;
    }
    imageStore(uOut, px, vec4(exp(-od), 1.0));
}
