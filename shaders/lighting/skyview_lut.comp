// Sky-view LUT (192x108): in-scattered luminance around the viewer per unit solar illuminance,
// including the distant ground below the horizon. Recomputed when the sun moves.
#include "shaders/include/common.glsl"
#include "shaders/lighting/atmosphere.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D uTransmittance;
layout(binding = 1) uniform sampler2D uMultiScat;
layout(rgba16f, binding = 0) uniform writeonly image2D uOut;
uniform float uMieScale;
uniform float uAltitude;   // km
uniform vec3 uSunDir;

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(px, ivec2(SKYVIEW_LUT_SIZE)))) return;
    float r = ATMO_BOTTOM + uAltitude;
    float vzc, lvc;
    skyViewParams((vec2(px) + 0.5) / SKYVIEW_LUT_SIZE, r, vzc, lvc);
    float sunCos = clamp(uSunDir.y, -1.0, 1.0);
    vec3 sunDir = vec3(sqrt(max(1.0 - sunCos * sunCos, 0.0)), sunCos, 0.0);
    float vzs = sqrt(max(1.0 - vzc * vzc, 0.0));
    vec3 rd = vec3(vzs * lvc, vzc, vzs * sqrt(max(1.0 - lvc * lvc, 0.0)));
    vec3 thr, fms;
    vec3 L = atmoIntegrate(vec3(0.0, r, 0.0), rd, sunDir, 32, uMieScale, false, true, uTransmittance, uMultiScat, true, thr, fms);
    imageStore(uOut, px, vec4(L, 1.0));
}
