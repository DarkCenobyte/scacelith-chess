+inline float handProxyDist(const HandProxy& h, vec3 p, bool withThumb = true) {
+    // Palm: a rounded slab, back at x -0.013, palm at +0.012, its edges curving towards the palm side,
+    // from the carpal dome to the knuckles (distance: the shell's implicit over its gradient).
+    float t = smoothstep(-0.012f, -0.070f, p.y);
+    float halfZ = lerp(0.0214f, 0.0358f, t), zc = lerp(0.0f, 0.0022f, t), halfX = lerp(0.0132f, 0.0117f, t);
