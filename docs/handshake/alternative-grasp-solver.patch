+inline HandProxy handProxy(const Skeleton& sk, vec3 forearm, const FingerPose& fp) {
+    HandProxy h;
+    for (int f = 0; f < 4; ++f) h.mcp[f] = sk.restOffset[fingerBone(Side::Right, f + 1, 0)];
+    h.forearm = normalize(forearm);
