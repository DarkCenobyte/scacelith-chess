+                        const float r = half[f][j];
+                        for (int k = 0; k <= 4; ++k) {
+                            const vec3 p = s + (e - s) * (float(k) / 4.0f), pl = m::transformPoint(toPartner, p);
+                            const float palm = r - palmSlab(pl);
+                            const float fore = r - (segDist(p, wrist + cuffDir * 0.02f, elbow) - 0.023f);
+                            const float cuff = m::dot(p - wrist, cuffDir) > -0.002f ? r - (m::length(p - wrist) - 0.023f) : -1.0f;
+                            const float d = std::max(palm, std::max(fore, cuff));
+                            if (d > deepest) {
+                                deepest = d;
+                                deepestT = t;
+                                deepestIn = palm >= std::max(fore, cuff) ? "palm" : fore >= cuff ? "forearm" : "wrist cuff";
+                            }
+                        }
+                    }
+                if (!gripped) continue;
+                for (int f = 1; f <= 4; ++f) {   // the pad's skin, 72% along the distal phalanx
+                    const Bone b3 = Bone(ThumbR1 + f * 3 + 2);
+                    const vec3 padLocal = m::normalize(sk.restOffset[b3]) * (0.72f * sk.boneLength[b3]) + vec3(half[f][2], 0, 0);
+                    const vec3 pad = m::transformPoint(toPartner, m::transformPoint(own[b3], padLocal));
+                    padBack = std::min(padBack, -pad.x);
+                    padYmin = std::min(padYmin, pad.y);
+                    padYmax = std::max(padYmax, pad.y);
+                }
+                const vec3 a0 = own[ThumbR1].translation(), a1 = own[ThumbR2].translation(), b0 = par[ThumbR1].translation(), b1 = par[ThumbR2].translation();
+                for (int k = 0; k <= 8; ++k) thumbs = std::min(thumbs, segDist(a0 + (a1 - a0) * (float(k) / 8.0f), b0, b1));
+                // Crossing of the hand axes, seen along the palm normal.
+                const vec3 n = m::normalize(own[HandR].c[0].xyz()), fa = -m::normalize(own[HandR].c[1].xyz()), fb = m::normalize(par[HandR].c[1].xyz());
+                const vec3 pa = m::normalize(fa - n * m::dot(fa, n)), pb = m::normalize(fb - n * m::dot(fb, n));
+                const float cross = std::acos(m::clamp(m::dot(pa, pb), -1.0f, 1.0f)) / m::DEG;
+                crossMin = std::min(crossMin, cross);
+                crossMax = std::max(crossMax, cross);
+            }
+        }
+        std::fprintf(stderr, "  right vs %s-handed: deepest phalanx in the partner %.1f mm (%s, t=%.3f s); gripped: pads %.1f mm behind the partner's palm "
+                             "mid-plane, %.0f..%.0f mm from its wrist, thumbs %.1f mm apart, hands crossing at %.0f..%.0f deg\n",
+                     play == Side::Right ? "right" : "left", deepest * 1000.0f, deepestIn, deepestT, padBack * 1000.0f, -padYmax * 1000.0f, -padYmin * 1000.0f,
+                     thumbs * 1000.0f, crossMin, crossMax);
+        CHECK(deepest < 0.001f);
+        CHECK(padBack > 0.008f);
+        CHECK(-padYmax > 0.015f && -padYmin < 0.085f);   // between the wrist (+15 mm) and the knuckles
+        CHECK(thumbs > 0.020f);
+        CHECK(crossMin > 35.0f && crossMax < 65.0f);
+    }
+}
