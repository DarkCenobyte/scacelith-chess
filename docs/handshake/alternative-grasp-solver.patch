+    fingerFrames(sk, Side::Right, fp, Thumb, fr);
+    for (int j = 0; j < 3; ++j) {
+        h.thumbA[j] = fr[j].translation();
+        h.thumbB[j] = j < 2 ? fr[j + 1].translation() : fingerTipFrom(sk, Side::Right, fr, Thumb);
+    }
+    return h;
