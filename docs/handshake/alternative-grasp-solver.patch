+// Closes long finger f of fp onto the partner (signed distance 'dist' in one's hand frame): MCP,
+// PIP and DIP close together, the middle joint fastest; a phalanx that comes within 'gap' of the
+// partner stops its joint and the joints before it (the fingers wrap the partner's hand).
+template <class Dist>
+inline void curlOnto(const Skeleton& sk, FingerPose& fp, int f, const Dist& dist, float gap = 0.0008f) {
+    const float rate[3] = {1.0f, 1.5f, 0.9f}, top[3] = {1.50f, 1.75f, 1.15f};
+    auto clearance = [&](const FingerPose& p, int j) {   // phalanx j of finger f: nearest approach
+        mat4 fr[3];
+        fingerFrames(sk, Side::Right, p, f, fr);
+        vec3 a = fr[j].translation(), e = j < 2 ? fr[j + 1].translation() : fingerTipFrom(sk, Side::Right, fr, f);
+        float best = 1e9f;
+        for (int k = 0; k <= 4; ++k) {
+            float u = float(k) / 4.0f;
+            float r = phalanxHalf(f, j) * (j == 2 && k == 4 ? 0.85f : 1.0f);   // (the rounded fingertip)
+            best = std::min(best, dist(a + (e - a) * u) - r);
+        }
+        return best;
+    };
+    bool moving[3] = {true, true, true};
+    for (int it = 0; it < 300; ++it) {
+        if (!moving[0] && !moving[1] && !moving[2]) break;
+        FingerPose t = fp;
+        for (int j = 0; j < 3; ++j)
+            if (moving[j]) t.v[f][j + 1] = std::min(top[j], t.v[f][j + 1] + rate[j] * 0.01f);
+        int hit = -1;
+        for (int j = 0; j < 3; ++j)
+            if (clearance(t, j) < gap) hit = j;
+        if (hit >= 0) {
+            for (int j = 0; j <= hit; ++j) moving[j] = false;
+            continue;
+        }
+        fp = t;
+        for (int j = 0; j < 3; ++j)
+            if (fp.v[f][j + 1] >= top[j]) moving[j] = false;
+    }
+}
