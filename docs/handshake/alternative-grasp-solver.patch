+// ---- Handshake grasp -------------------------------------------------------------------------
+// Both robots shake right hands and plan the same clasp from shared data (the clasp point C and
+// these constants), so the partner's hand is the image of one's own under a half turn about the
+// vertical through C. Seen from one's own hand (right-hand convention: palm +X, fingers -Y, thumb
+// +Z) that image only depends on the pitch of the fingers below the horizontal in the vertical
+// palm plane (the two hands cross at twice that) and on the hand point put on C (the anchor).
+// The fingers are then closed onto a simplified model of that partner hand.
+constexpr float kShakePitch = 0.52f;      // fingers 30 deg down: the hands cross at 60 deg
+constexpr float kShakeSlide = 0.115f;     // partner's wrist from one's own, along the palm plane (m)
+constexpr float kShakePalms = 0.0255f;    // between the two hands' mid-planes (the palms just touch)
+constexpr float kShakeLift = 0.007f;      // the hands above C (m): the lowest fingers clear the pieces at the pumps' bottom
+
+inline vec3 shakeUp(float pitch) { return vec3(0, std::sin(pitch), std::cos(pitch)); }        // the vertical, hand frame
+inline vec3 shakeAlong(float pitch) { return vec3(0, -std::cos(pitch), std::sin(pitch)); }    // horizontal, towards the partner
+// Hand point (right-hand convention) put on C: half the palms' distance in front of the palm's
+// mid-plane, half the slide towards the partner (there, the thumb-index web), kShakeLift below.
+inline vec3 shakeAnchor(float pitch = kShakePitch) {
+    return vec3(kShakePalms * 0.5f, 0, 0) + shakeAlong(pitch) * (kShakeSlide * 0.5f) - shakeUp(pitch) * kShakeLift;
+}
+// The partner's hand frame in one's own (right-hand convention): the half turn about the vertical
+// through the anchor.
+inline mat4 shakePartner(float pitch, vec3 anchor) {
+    const vec3 u = shakeUp(pitch);
+    auto turn = [&](vec3 v) { return u * (2.0f * dot(v, u)) - v; };
+    mat4 m;
+    m.c[0] = vec4(turn(vec3(1, 0, 0)), 0.0f);
+    m.c[1] = vec4(turn(vec3(0, 1, 0)), 0.0f);
+    m.c[2] = vec4(turn(vec3(0, 0, 1)), 0.0f);
+    m.c[3] = vec4(anchor + turn(-anchor), 1.0f);
+    return m;
+}
+
+// Porcelain half thickness (m, towards the pad) of each phalanx, from the hand model; for the thumb:
+// the thenar's capsule, then its two phalanges.
+inline float phalanxHalf(int f, int j) {
+    static const float t[5][3] = {{0.0118f, 0.0080f, 0.0065f},
+                                  {0.0057f, 0.00475f, 0.00375f},
+                                  {0.0059f, 0.00495f, 0.00395f},
+                                  {0.0055f, 0.00455f, 0.00365f},
+                                  {0.0047f, 0.00385f, 0.00305f}};
+    return t[f][j];
+}
+
+// What one's fingers close on: a simplified robot hand (right-hand convention, its own frame):
+// the palm with its thickness and rounded, forward-curving edges (the porcelain shell's section),
