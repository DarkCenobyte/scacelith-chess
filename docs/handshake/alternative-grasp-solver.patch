+// Thumb axis segments (hand frame, right-hand convention) of pose fp.
+inline void thumbSegments(const Skeleton& sk, const FingerPose& fp, vec3 a[3], vec3 b[3]) {
+    mat4 fr[3];
+    fingerFrames(sk, Side::Right, fp, Thumb, fr);
+    for (int j = 0; j < 3; ++j) {
+        a[j] = fr[j].translation();
+        b[j] = j < 2 ? fr[j + 1].translation() : fingerTipFrom(sk, Side::Right, fr, Thumb);
