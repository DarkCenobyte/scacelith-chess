+    float gx = qx * qx * qx / (n4 * n4 * n4), gz = qz * qz * qz / (n4 * n4 * n4);
+    vec3 grad(gx / halfX, 0.0f, gx * (-9.0f * z) / halfX + gz / halfZ);
