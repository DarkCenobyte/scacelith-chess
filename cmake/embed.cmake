# Embeds every file of the given directories, and the given single files, into the executable with
# the assembler's .incbin directive (no conversion step, fast for large files). Paths are relative
# to ROOT. Produces ${OUT_CPP} which defines g_embeddedFiles / g_embeddedFileCount (see
# src/core/embedded.h).
#
# The assembler block follows the object format of the target: ELF (Linux) and PE/COFF (Windows)
# take the C names as they are, in .rodata / .rdata. Mach-O (macOS) gives every C symbol a leading
# underscore, and its read-only data goes to __TEXT,__const (the files hold no pointers, so no
# relocation needs the writable __DATA,__const). Apple's linker also splits a section into atoms at
# its symbols (.subsections_via_symbols) and may drop or move each one on its own: .alt_entry keeps
# each end label inside the atom of its file. The ELF and PE output does not depend on that branch
# (the same generated file as before).
function(scacelith_embed_files OUT_CPP ROOT)
    set(files)
    foreach(item ${ARGN})
        if(IS_DIRECTORY "${ROOT}/${item}")
            file(GLOB_RECURSE found CONFIGURE_DEPENDS "${ROOT}/${item}/*")
            list(APPEND files ${found})
        else()
            list(APPEND files "${ROOT}/${item}")
        endif()
    endforeach()
    list(SORT files)
    if(APPLE)
        set(mangle "_")
    else()
        set(mangle "")
    endif()
    set(asm "")
    set(decl "")
    set(table "")
    set(idx 0)
    foreach(f ${files})
        file(RELATIVE_PATH rel "${ROOT}" "${f}")
        if(rel MATCHES "(^|/)\\." OR rel MATCHES "~$")
            continue()
        endif()
        set(sym "scacelith_emb_${idx}")
        set(alt "")
        if(APPLE)
            set(alt "    \".alt_entry ${mangle}${sym}_end\\n\"\n")
        endif()
        string(APPEND asm "    \".balign 16\\n\"\n    \".globl ${mangle}${sym}\\n\"\n    \"${mangle}${sym}:\\n\"\n    \".incbin \\\"${f}\\\"\\n\"\n    \".byte 0\\n\"\n    \".globl ${mangle}${sym}_end\\n\"\n${alt}    \"${mangle}${sym}_end:\\n\"\n")
        string(APPEND decl "extern \"C\" const unsigned char ${sym}[];\nextern \"C\" const unsigned char ${sym}_end[];\n")
        string(APPEND table "    {\"${rel}\", ${sym}, size_t(${sym}_end - ${sym} - 1)},\n")
        math(EXPR idx "${idx} + 1")
    endforeach()
    set(content "// Generated by cmake/embed.cmake -- do not edit.\n#include \"core/embedded.h\"\n\n")
    if(APPLE)
        string(APPEND content "#define EMB_SECTION \".section __TEXT,__const\\n\"\n")
    else()
        string(APPEND content "#if defined(_WIN32)\n#define EMB_SECTION \".section .rdata,\\\"dr\\\"\\n\"\n#else\n#define EMB_SECTION \".section .rodata\\n\"\n#endif\n")
    endif()
    string(APPEND content "__asm__(\n    EMB_SECTION\n${asm}    \".text\\n\");\n\n${decl}\n")
    string(APPEND content "extern const embedded::File g_embeddedFiles[] = {\n${table}    {nullptr, nullptr, 0}};\n")
    string(APPEND content "extern const size_t g_embeddedFileCount = ${idx};\n")
    file(WRITE "${OUT_CPP}.tmp" "${content}")
    file(COPY_FILE "${OUT_CPP}.tmp" "${OUT_CPP}" ONLY_IF_DIFFERENT)
    set_source_files_properties("${OUT_CPP}" PROPERTIES OBJECT_DEPENDS "${files}")
endfunction()
