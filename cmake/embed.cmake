# Embeds every file of the given directories into the executable with the assembler's .incbin
# directive (no conversion step, fast for large files). Produces ${OUT_CPP} which defines
# g_embeddedFiles / g_embeddedFileCount (see src/core/embedded.h).
function(scacelith_embed_files OUT_CPP ROOT)
    set(files)
    foreach(dir ${ARGN})
        file(GLOB_RECURSE found CONFIGURE_DEPENDS "${ROOT}/${dir}/*")
        list(APPEND files ${found})
    endforeach()
    list(SORT files)
    set(asm "")
    set(decl "")
    set(table "")
    set(idx 0)
    foreach(f ${files})
        file(RELATIVE_PATH rel "${ROOT}" "${f}")
        if(rel MATCHES "(^|/)\\." OR rel MATCHES "~$")
            continue()
        endif()
        set(sym "scacelith_emb_${idx}")
        string(APPEND asm "    \".balign 16\\n\"\n    \".globl ${sym}\\n\"\n    \"${sym}:\\n\"\n    \".incbin \\\"${f}\\\"\\n\"\n    \".byte 0\\n\"\n    \".globl ${sym}_end\\n\"\n    \"${sym}_end:\\n\"\n")
        string(APPEND decl "extern \"C\" const unsigned char ${sym}[];\nextern \"C\" const unsigned char ${sym}_end[];\n")
        string(APPEND table "    {\"${rel}\", ${sym}, size_t(${sym}_end - ${sym} - 1)},\n")
        math(EXPR idx "${idx} + 1")
    endforeach()
    set(content "// Generated by cmake/embed.cmake -- do not edit.\n#include \"core/embedded.h\"\n\n")
    string(APPEND content "#if defined(_WIN32)\n#define EMB_SECTION \".section .rdata,\\\"dr\\\"\\n\"\n#else\n#define EMB_SECTION \".section .rodata\\n\"\n#endif\n")
    string(APPEND content "__asm__(\n    EMB_SECTION\n${asm}    \".text\\n\");\n\n${decl}\n")
    string(APPEND content "extern const embedded::File g_embeddedFiles[] = {\n${table}    {nullptr, nullptr, 0}};\n")
    string(APPEND content "extern const size_t g_embeddedFileCount = ${idx};\n")
    file(WRITE "${OUT_CPP}.tmp" "${content}")
    file(COPY_FILE "${OUT_CPP}.tmp" "${OUT_CPP}" ONLY_IF_DIFFERENT)
    set_source_files_properties("${OUT_CPP}" PROPERTIES OBJECT_DEPENDS "${files}")
endfunction()
